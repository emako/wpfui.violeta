<vio:ShellWindow
    x:Class="ToolBarOverflowRepro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ToolBarOverflowRepro"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="ToolBar Overflow Repro"
    Width="1024"
    Height="640"
    ExtendsContentIntoTitleBar="True"
    FontSize="12"
    Left="40"
    Top="40"
    WindowBackdropType="Mica"
    WindowStartupLocation="Manual">
    <ui:Grid RowDefinitions="Auto,*,Auto">
        <vio:TitleBar
            Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
            Grid.Row="0"
            BackButtonVisibility="Collapsed"
            IsIconVisible="False"
            IsInactiveAppearanceEnabled="True"
            IsTitleVisible="False"
            PaneToggleButtonVisibility="Collapsed">
            <vio:TitleBar.CustomHeader>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="REPRO" />
                    <vio:TabStrip
                        x:Name="tabStrip"
                        Height="27"
                        Margin="10,0,0,0"
                        Padding="0,8,0,0"
                        VerticalAlignment="Stretch"
                        FontSize="13"
                        IndicatorAnimation="Fluent"
                        IsSeparatorVisible="False">
                        <vio:TabStripItem
                            x:Name="tabHome"
                            Padding="13,0"
                            Content="Home"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <vio:TabStripItem
                            x:Name="tabSettings"
                            Padding="13,0"
                            Content="Settings"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <vio:TabStripItem
                            x:Name="tabTools"
                            Padding="13,0"
                            Content="Tools"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            IsSelected="True" />
                    </vio:TabStrip>
                </StackPanel>
            </vio:TitleBar.CustomHeader>
        </vio:TitleBar>

        <!--  Keep-alive panel host: tab pages are toggled Visible / Collapsed, never removed  -->
        <Grid x:Name="pageHost" Grid.Row="1">
            <Grid x:Name="pageHome" Visibility="Collapsed">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Text="Home page" />
            </Grid>
            <Grid x:Name="pageSettings" Visibility="Collapsed">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Text="Settings page" />
            </Grid>
            <local:ToolsPage x:Name="pageTools" />
        </Grid>

        <TextBlock
            x:Name="textStatus"
            Grid.Row="2"
            Margin="10,4,10,8"
            FontFamily="Consolas"
            FontSize="11"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
    </ui:Grid>
</vio:ShellWindow>
