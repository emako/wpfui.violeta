<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <LangVersion>preview</LangVersion>
        <AssemblyTitle>Wpf.Ui.Violeta Gallery</AssemblyTitle>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <ApplicationIcon>Resources\Images\wpfui.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wpf.Ui.Violeta\Wpf.Ui.Violeta.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="FluentUI.HarmonyOS.Assets" Version="1.0.0" />
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Resources\Images\*.ico" />
        <Resource Include="Resources\Images\*.png" />
		<Resource Include="$(NuGetPackageRoot)\FluentUI.HarmonyOS.Assets\1.0.0\assets\HarmonyOS_Sans_SC\HarmonyOS_Sans_SC_Regular.ttf">
			<Link>Resources\Fonts\HarmonyOS_Sans_SC_Regular.ttf</Link>
		</Resource>
    </ItemGroup>

</Project>
