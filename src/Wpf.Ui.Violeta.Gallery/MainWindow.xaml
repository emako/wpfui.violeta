                    </vio:NavigationViewItem.MenuItems>
                </vio:NavigationViewItem>

                <vio:NavigationViewItem Content="{I18N {x:Static lang:LangKeys.Gallery_Nav_Media}}" Tag="media">
                    <vio:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE8B9;" />
                    </vio:NavigationViewItem.Icon>
                    <vio:NavigationViewItem.MenuItems>
                        <vio:NavigationViewItem Content="Image" Tag="media/image" />
