<vio:ShellWindow
    x:Class="Wpf.Ui.Violeta.Gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:compat="clr-namespace:Wpf.Ui.Violeta.Controls.Compat;assembly=Wpf.Ui.Violeta"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="{I18N {x:Static lang:LangKeys.Gallery_AppTitle}}"
    Width="1280"
    Height="800"
    ExtendsContentIntoTitleBar="True"
    Icon="/Resources/Images/wpfui.ico"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <vio:ShellWindow.InputBindings>
        <KeyBinding
            Key="F"
            Command="{Binding ElementName=AutoSuggestBox, Path=FocusCommand}"
            Modifiers="Control" />
    </vio:ShellWindow.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <vio:TitleBar
            x:Name="GalleryTitleBar"
            Title="{I18N {x:Static lang:LangKeys.Gallery_AppTitle}}"
            Grid.Row="0"
            BackButtonClick="GalleryTitleBar_OnBackButtonClick"
            Icon="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
            IsBackButtonEnabled="False"
            PaneToggleButtonClick="GalleryTitleBar_OnPaneToggleButtonClick">
            <vio:TitleBar.CustomHeader>
                <TextBlock
                    Margin="8,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{I18N {x:Static lang:LangKeys.Gallery_AppTitle}}"
                    Visibility="Collapsed" />
            </vio:TitleBar.CustomHeader>
            <vio:TitleBar.CustomFooter>
                <StackPanel
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Language}}" />
                    <ComboBox
                        x:Name="LanguageComboBox"
                        MinWidth="110"
                        Margin="8,0,12,0"
                        SelectionChanged="LanguageComboBox_OnSelectionChanged">
                        <ComboBoxItem
                            Content="{I18N {x:Static lang:LangKeys.Sample_1e81fc32fe}}"
                            IsSelected="True"
                            Tag="zh-Hans" />
                        <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_d0bb8c23f6}}" Tag="zh-Hant" />
                        <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_78463a384a}}" Tag="en" />
                        <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_f32ced6a9b}}" Tag="ja" />
                    </ComboBox>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Theme}}" />
                    <ComboBox
                        x:Name="ThemeComboBox"
                        MinWidth="100"
                        Margin="8,0,0,0"
                        SelectionChanged="ThemeComboBox_OnSelectionChanged">
                        <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Gallery_Theme_System}}" />
                        <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Gallery_Theme_Dark}}" IsSelected="True" />
                        <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Gallery_Theme_Light}}" />
                    </ComboBox>
                </StackPanel>
            </vio:TitleBar.CustomFooter>
        </vio:TitleBar>

        <vio:NavigationView
            x:Name="GalleryNav"
            Grid.Row="1"
            Margin="16,0,16,16"
            AlwaysShowHeader="{I18N {x:Static lang:LangKeys.Sample_f827cf462f}}"
            BackRequested="GalleryNav_OnBackRequested"
            CompactPaneLength="52"
            Header="{I18N {x:Static lang:LangKeys.Gallery_Welcome}}"
            IsBackButtonVisible="Visible"
            IsBackEnabled="True"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="True"
            OpenPaneLength="260"
            PaneTitle="{I18N {x:Static lang:LangKeys.Gallery_PaneTitle}}"
            SelectionChanged="GalleryNav_OnSelectionChanged">
            <vio:NavigationView.AutoSuggestBox>
                <ui:AutoSuggestBox
                    x:Name="AutoSuggestBox"
                    AutomationProperties.AutomationId="NavigationAutoSuggestBox"
                    PlaceholderText="{I18N {x:Static lang:LangKeys.Gallery_SearchPlaceholder}}">
                    <ui:AutoSuggestBox.Icon>
                        <ui:IconSourceElement>
                            <ui:SymbolIconSource Symbol="Search24" />
                        </ui:IconSourceElement>
                    </ui:AutoSuggestBox.Icon>
                </ui:AutoSuggestBox>
            </vio:NavigationView.AutoSuggestBox>

            <vio:NavigationView.MenuItems>
                <vio:NavigationViewItem
                    x:Name="HomeItem"
                    Content="{I18N {x:Static lang:LangKeys.Gallery_Nav_Home}}"
                    Tag="home">
                    <vio:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE80F;" />
                    </vio:NavigationViewItem.Icon>
                </vio:NavigationViewItem>

                <vio:NavigationViewItem Content="{I18N {x:Static lang:LangKeys.Gallery_Nav_Design}}" Tag="design">
