                    </vio:NavigationViewItem.Icon>
                    <vio:NavigationViewItem.MenuItems>
                        <vio:NavigationViewItem Content="TextBox" Tag="text/textbox" />
                        <vio:NavigationViewItem Content="PasswordBox" Tag="text/password-box" />
                        <vio:NavigationViewItem Content="RichTextBox" Tag="text/rich-text-box" />
                        <vio:NavigationViewItem Content="AutoSuggestBox" Tag="text/auto-suggest-box" />
                        <vio:NavigationViewItem Content="SearchBox" Tag="text/search-box" />
                        <vio:NavigationViewItem Content="PinCode" Tag="basic-input/pin-code" />
