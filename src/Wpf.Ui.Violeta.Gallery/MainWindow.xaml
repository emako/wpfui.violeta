                    </vio:NavigationViewItem.MenuItems>
                </vio:NavigationViewItem>

                <vio:NavigationViewItem Content="{I18N {x:Static lang:LangKeys.Gallery_Nav_TextDisplay}}" Tag="text-display">
                    <vio:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" />
                    </vio:NavigationViewItem.Icon>
                    <vio:NavigationViewItem.MenuItems>
                        <vio:NavigationViewItem Content="Label" Tag="text/label" />
                        <vio:NavigationViewItem Content="TextBlock" Tag="text/text-block" />
