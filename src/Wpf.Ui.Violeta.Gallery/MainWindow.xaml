                    </vio:NavigationViewItem.MenuItems>
                </vio:NavigationViewItem>

                <vio:NavigationViewItem Content="{I18N {x:Static lang:LangKeys.Gallery_Nav_Pickers}}" Tag="pickers">
                    <vio:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE8B7;" />
                    </vio:NavigationViewItem.Icon>
                    <vio:NavigationViewItem.MenuItems>
                        <vio:NavigationViewItem Content="ValuePicker" Tag="selectors/value-picker" />
                        <vio:NavigationViewItem Content="ColorPicker" Tag="selectors/color-picker" />
                        <vio:NavigationViewItem Content="SwatchPicker" Tag="selectors/swatch-picker" />
                        <vio:NavigationViewItem Content="DatePicker" Tag="date-time/date-picker" />
                        <vio:NavigationViewItem Content="TimePicker" Tag="date-time/time-picker" />
                        <vio:NavigationViewItem Content="CalendarDatePicker" Tag="date-time/calendar-date-picker" />
                        <vio:NavigationViewItem Content="CalendarDateTimePicker" Tag="date-time/calendar-date-time-picker" />
                        <vio:NavigationViewItem Content="TimeBoxPicker" Tag="date-time/time-box-picker" />
                        <vio:NavigationViewItem Content="TimeBox" Tag="date-time/time-box" />
                        <vio:NavigationViewItem Content="Calendar" Tag="date-time/calendar" />
                        <vio:NavigationViewItem Content="FilePicker" Tag="op-system/file-picker" />
                        <vio:NavigationViewItem Content="OpenFolderDialog" Tag="dialogs/open-folder-dialog" />
                    </vio:NavigationViewItem.MenuItems>
                </vio:NavigationViewItem>

                <vio:NavigationViewItem Content="{I18N {x:Static lang:LangKeys.Gallery_Nav_Dialogs}}" Tag="dialogs">
                    <vio:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE8BD;" />
                    </vio:NavigationViewItem.Icon>
                    <vio:NavigationViewItem.MenuItems>
                        <vio:NavigationViewItem Content="ContentDialog" Tag="dialogs/content-dialog" />
                        <vio:NavigationViewItem Content="MessageBox" Tag="dialogs/message-box" />
                        <vio:NavigationViewItem Content="PendingBox" Tag="dialogs/pending-box" />
                        <vio:NavigationViewItem Content="TaskDialog" Tag="dialogs/task-dialog" />
                        <vio:NavigationViewItem Content="NativeMessageBox" Tag="dialogs/native-message-box" />
                        <vio:NavigationViewItem Content="CredentialDialog" Tag="dialogs/credential-dialog" />
                        <vio:NavigationViewItem Content="Flyout" Tag="dialogs/flyout" />
                        <vio:NavigationViewItem Content="FluentPopup" Tag="dialogs/fluent-popup" />
                        <vio:NavigationViewItem Content="TeachingTip" Tag="dialogs/teaching-tip" />
                    </vio:NavigationViewItem.MenuItems>
                </vio:NavigationViewItem>

                <vio:NavigationViewItem Content="{I18N {x:Static lang:LangKeys.Gallery_Nav_Notifications}}" Tag="notifications">
                    <vio:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE789;" />
                    </vio:NavigationViewItem.Icon>
                    <vio:NavigationViewItem.MenuItems>
                        <vio:NavigationViewItem Content="Snackbar" Tag="notifications/snackbar" />
                        <vio:NavigationViewItem Content="Toast" Tag="notifications/toast" />
                        <vio:NavigationViewItem Content="Banner" Tag="notifications/banner" />
                        <vio:NavigationViewItem Content="Notification" Tag="notifications/notification" />
                        <vio:NavigationViewItem Content="TrayIcon" Tag="notifications/tray-icon" />
                    </vio:NavigationViewItem.MenuItems>
                </vio:NavigationViewItem>

                <vio:NavigationViewItem Content="{I18N {x:Static lang:LangKeys.Gallery_Nav_Collections}}" Tag="collections">
                    <vio:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE9D9;" />
                    </vio:NavigationViewItem.Icon>
                    <vio:NavigationViewItem.MenuItems>
                        <vio:NavigationViewItem Content="DataGrid" Tag="collections/data-grid" />
                        <vio:NavigationViewItem Content="ListBox" Tag="collections/list-box" />
                        <vio:NavigationViewItem Content="ListView" Tag="collections/list-view" />
                        <vio:NavigationViewItem Content="TreeView" Tag="collections/tree-view" />
                        <vio:NavigationViewItem Content="TreeListView" Tag="collections/tree-list-view" />
                        <vio:NavigationViewItem Content="TreeModelListView" Tag="collections/tree-model-list-view" />
                        <vio:NavigationViewItem Content="FlipView" Tag="collections/flip-view" />
                        <vio:NavigationViewItem Content="Carousel" Tag="collections/carousel" />
                        <vio:NavigationViewItem Content="CardCarousel" Tag="collections/card-carousel" />
                        <vio:NavigationViewItem Content="Pagination" Tag="collections/pagination" />
                        <vio:NavigationViewItem Content="Timeline" Tag="collections/timeline" />
                    </vio:NavigationViewItem.MenuItems>
                </vio:NavigationViewItem>

                <vio:NavigationViewItem Content="{I18N {x:Static lang:LangKeys.Gallery_Nav_Navigation}}" Tag="navigation">
                    <vio:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE700;" />
                    </vio:NavigationViewItem.Icon>
                    <vio:NavigationViewItem.MenuItems>
                        <vio:NavigationViewItem Content="NavigationView" Tag="navigation/navigation-view" />
                        <vio:NavigationViewItem Content="BreadcrumbBar" Tag="navigation/breadcrumb-bar" />
                        <vio:NavigationViewItem Content="Menu" Tag="navigation/menu" />
                        <vio:NavigationViewItem Content="ToolBar" Tag="navigation/tool-bar" />
                        <vio:NavigationViewItem Content="TabControl" Tag="navigation/tab-control" />
                        <vio:NavigationViewItem Content="TabView" Tag="navigation/tab-view" />
                        <vio:NavigationViewItem Content="TabStrip" Tag="navigation/tab-strip" />
                        <vio:NavigationViewItem Content="Anchor" Tag="navigation/anchor" />
                    </vio:NavigationViewItem.MenuItems>
                </vio:NavigationViewItem>

                <vio:NavigationViewItem Content="{I18N {x:Static lang:LangKeys.Gallery_Nav_Layout}}" Tag="layout">
                    <vio:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE8A5;" />
                    </vio:NavigationViewItem.Icon>
                    <vio:NavigationViewItem.MenuItems>
                        <vio:NavigationViewItem Content="CardControl" Tag="layout/card-control" />
                        <vio:NavigationViewItem Content="CardAction" Tag="layout/card-action" />
                        <vio:NavigationViewItem Content="AutoGrid" Tag="layout/auto-grid" />
                        <vio:NavigationViewItem Content="Border" Tag="layout/border" />
                        <vio:NavigationViewItem Content="DropShadowChrome" Tag="layout/drop-shadow-chrome" />
                        <vio:NavigationViewItem Content="AspectRatioLayout" Tag="layout/aspect-ratio-layout" />
