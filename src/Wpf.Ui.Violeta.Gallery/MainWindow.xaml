                </vio:NavigationViewItem>

                <vio:NavigationViewItem Content="{I18N {x:Static lang:LangKeys.Gallery_Nav_ComboBox}}" Tag="combo-box">
                    <vio:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE70D;" />
                    </vio:NavigationViewItem.Icon>
                    <vio:NavigationViewItem.MenuItems>
                        <vio:NavigationViewItem Content="ComboBox" Tag="basic-input/combo-box" />
