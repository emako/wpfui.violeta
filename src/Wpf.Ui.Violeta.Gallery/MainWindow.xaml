<vio:ShellWindow
    x:Class="Wpf.Ui.Violeta.Gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:compat="clr-namespace:Wpf.Ui.Violeta.Controls.Compat;assembly=Wpf.Ui.Violeta"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="{I18N {x:Static lang:LangKeys.Gallery_AppTitle}}"
    Width="1280"
    Height="800"
    ExtendsContentIntoTitleBar="True"
    Icon="/Resources/Images/wpfui.ico"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <vio:ShellWindow.InputBindings>
        <KeyBinding
            Key="F"
            Command="{Binding ElementName=AutoSuggestBox, Path=FocusCommand}"
            Modifiers="Control" />
    </vio:ShellWindow.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <vio:TitleBar
            x:Name="GalleryTitleBar"
            Title="{I18N {x:Static lang:LangKeys.Gallery_AppTitle}}"
            Grid.Row="0"
            BackButtonClick="GalleryTitleBar_OnBackButtonClick"
            Icon="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
            IsBackButtonEnabled="False"
            PaneToggleButtonClick="GalleryTitleBar_OnPaneToggleButtonClick">
            <vio:TitleBar.CustomHeader>
                <TextBlock
                    Margin="8,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{I18N {x:Static lang:LangKeys.Gallery_AppTitle}}"
                    Visibility="Collapsed" />
            </vio:TitleBar.CustomHeader>
            <vio:TitleBar.CustomFooter>
                <StackPanel
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Language}}" />
                    <ComboBox
                        x:Name="LanguageComboBox"
                        MinWidth="110"
                        Margin="8,0,12,0"
                        SelectionChanged="LanguageComboBox_OnSelectionChanged">
                        <ComboBoxItem
                            Content="简体中文"
                            IsSelected="True"
                            Tag="zh-Hans" />
                        <ComboBoxItem Content="繁體中文" Tag="zh-Hant" />
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="日本語" Tag="ja" />
                    </ComboBox>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Theme}}" />
                    <ComboBox
                        x:Name="ThemeComboBox"
                        MinWidth="100"
                        Margin="8,0,0,0"
                        SelectionChanged="ThemeComboBox_OnSelectionChanged">
                        <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Gallery_Theme_System}}" />
                        <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Gallery_Theme_Dark}}" IsSelected="True" />
                        <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Gallery_Theme_Light}}" />
                    </ComboBox>
                </StackPanel>
            </vio:TitleBar.CustomFooter>
        </vio:TitleBar>

        <vio:NavigationView
            x:Name="GalleryNav"
            Grid.Row="1"
            Margin="16,0,16,16"
            AlwaysShowHeader="True"
            BackRequested="GalleryNav_OnBackRequested"
            CompactPaneLength="52"
            Header="{I18N {x:Static lang:LangKeys.Gallery_Welcome}}"
            IsBackButtonVisible="Visible"
            IsBackEnabled="True"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="True"
            OpenPaneLength="260"
            PaneTitle="{I18N {x:Static lang:LangKeys.Gallery_PaneTitle}}"
            SelectionChanged="GalleryNav_OnSelectionChanged">
            <vio:NavigationView.AutoSuggestBox>
                <ui:AutoSuggestBox
                    x:Name="AutoSuggestBox"
                    AutomationProperties.AutomationId="NavigationAutoSuggestBox"
                    PlaceholderText="{I18N {x:Static lang:LangKeys.Gallery_SearchPlaceholder}}">
                    <ui:AutoSuggestBox.Icon>
                        <ui:IconSourceElement>
                            <ui:SymbolIconSource Symbol="Search24" />
                        </ui:IconSourceElement>
                    </ui:AutoSuggestBox.Icon>
                </ui:AutoSuggestBox>
            </vio:NavigationView.AutoSuggestBox>

            <vio:NavigationView.MenuItems>
                <vio:NavigationViewItem
                    x:Name="HomeItem"
                    Content="{I18N {x:Static lang:LangKeys.Gallery_Nav_Home}}"
                    Tag="home">
                    <vio:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE80F;" />
                    </vio:NavigationViewItem.Icon>
                </vio:NavigationViewItem>

                <vio:NavigationViewItem Content="{I18N {x:Static lang:LangKeys.Gallery_Nav_Design}}" Tag="design">
                    <vio:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE790;" />
                    </vio:NavigationViewItem.Icon>
                    <vio:NavigationViewItem.MenuItems>
                        <vio:NavigationViewItem Content="Typography" Tag="design/typography" />
                        <vio:NavigationViewItem Content="Icons" Tag="design/icons" />
                        <vio:NavigationViewItem Content="Colors" Tag="design/colors" />
                    </vio:NavigationViewItem.MenuItems>
                </vio:NavigationViewItem>

                <vio:NavigationViewItem Content="{I18N {x:Static lang:LangKeys.Gallery_Nav_AllSamples}}" Tag="all">
                    <vio:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xEA37;" />
                    </vio:NavigationViewItem.Icon>
                </vio:NavigationViewItem>

                <vio:NavigationViewItemSeparator />

                <vio:NavigationViewItem Content="{I18N {x:Static lang:LangKeys.Gallery_Nav_Buttons}}" Tag="buttons">
                    <vio:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE73E;" />
                    </vio:NavigationViewItem.Icon>
                    <vio:NavigationViewItem.MenuItems>
                        <vio:NavigationViewItem Content="Button" Tag="basic-input/button" />
                        <vio:NavigationViewItem Content="RepeatButton" Tag="basic-input/repeat-button" />
                        <vio:NavigationViewItem Content="DropDownButton" Tag="basic-input/drop-down-button" />
                        <vio:NavigationViewItem Content="HyperlinkButton" Tag="basic-input/hyperlink-button" />
                        <vio:NavigationViewItem Content="ToggleButton" Tag="basic-input/toggle-button" />
                        <vio:NavigationViewItem Content="SplitButton" Tag="basic-input/split-button" />
                        <vio:NavigationViewItem Content="LoadingButton" Tag="basic-input/loading-button" />
                        <vio:NavigationViewItem Content="CopyButton" Tag="basic-input/copy-button" />
                        <vio:NavigationViewItem Content="GoBackButton" Tag="basic-input/go-back-button" />
                        <vio:NavigationViewItem Content="ToggleButtonGroup" Tag="basic-input/toggle-button-group" />
                    </vio:NavigationViewItem.MenuItems>
                </vio:NavigationViewItem>

                <vio:NavigationViewItem Content="{I18N {x:Static lang:LangKeys.Gallery_Nav_Selection}}" Tag="selection">
                    <vio:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE739;" />
                    </vio:NavigationViewItem.Icon>
                    <vio:NavigationViewItem.MenuItems>
                        <vio:NavigationViewItem Content="CheckBox" Tag="basic-input/check-box" />
                        <vio:NavigationViewItem Content="RadioButton" Tag="basic-input/radio-button" />
                        <vio:NavigationViewItem Content="ToggleSwitch" Tag="basic-input/toggle-switch" />
                        <vio:NavigationViewItem Content="Rating" Tag="basic-input/rating" />
                        <vio:NavigationViewItem Content="ThumbRate" Tag="basic-input/thumb-rate" />
                    </vio:NavigationViewItem.MenuItems>
                </vio:NavigationViewItem>

                <vio:NavigationViewItem Content="{I18N {x:Static lang:LangKeys.Gallery_Nav_Sliders}}" Tag="sliders">
                    <vio:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE76B;" />
                    </vio:NavigationViewItem.Icon>
                    <vio:NavigationViewItem.MenuItems>
