<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.OpSystem.OpSystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:ctrl="clr-namespace:Wpf.Ui.Violeta.Gallery.Controls"
    Title="操作系统"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="操作系统" />
            <TextBlock
                Margin="0,0,0,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="与 Windows 系统 API 交互的示例：剪贴板与文件选择对话框。"
                TextWrapping="Wrap" />
            <WrapPanel>
                <ctrl:SampleCard
                    Width="260"
                    Title="Clipboard"
                    Description="读写系统剪贴板文本"
                    Glyph="&#xE77F;"
                    NavigateTag="op-system/clipboard" />
                <ctrl:SampleCard
                    Width="260"
                    Title="FilePicker"
                    Description="OpenFileDialog / SaveFileDialog"
                    Glyph="&#xE8E5;"
                    NavigateTag="op-system/file-picker" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
