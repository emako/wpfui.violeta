<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.OpSystem.OpSystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:gallery="clr-namespace:Wpf.Ui.Violeta.Gallery"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Nav_OpSystem}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Nav_OpSystem}}" />
            <TextBlock
                Margin="0,0,0,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Sample_cb36623ef8}}"
                TextWrapping="Wrap" />
            <WrapPanel>
                <ui:CardAction
                    Width="260"
                    Height="80"
                    Margin="0,0,12,12"
                    Command="{x:Static gallery:GalleryNavigator.NavigateCommand}"
                    CommandParameter="op-system/clipboard">
                    <ui:CardAction.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="28" Glyph="&#xE77F;" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="Clipboard" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Appearance="Secondary" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{I18N {x:Static lang:LangKeys.Sample_c4e39190f1}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:CardAction>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
