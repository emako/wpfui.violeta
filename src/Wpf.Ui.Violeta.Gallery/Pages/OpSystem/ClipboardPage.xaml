<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.OpSystem.ClipboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="Clipboard"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Clipboard" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="复制到剪贴板" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="将下方文本写入系统剪贴板。"
                        TextWrapping="Wrap" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:Button
                            Click="CopyTextToClipboard_Click"
                            Content="复制文本到剪贴板" />
                        <TextBlock
                            x:Name="TextCopiedNotice"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="已复制到剪贴板！"
                            Visibility="Collapsed" />
                    </ui:StackPanel>
                    <ui:TextBox
                        x:Name="TextToCopyTextBox"
                        Margin="0,12,0,0"
                        MinLines="4"
                        Text="This text will be copied to the clipboard." />
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="从剪贴板粘贴" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="读取当前剪贴板中的文本内容。"
                        TextWrapping="Wrap" />
                    <ui:Button
                        Click="PasteTextFromClipboard_Click"
                        Content="从剪贴板粘贴文本" />
                    <TextBlock
                        Margin="0,12,0,4"
                        Text="剪贴板内容："
                        TextDecorations="Underline" />
                    <TextBlock
                        x:Name="ClipboardContentText"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="点击上方按钮读取"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
