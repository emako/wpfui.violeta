<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.OpSystem.FilePickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="FilePicker"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="FilePicker" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_4634be5ac1}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_bbb630278a}}"
                        TextWrapping="Wrap" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="16">
                        <ui:Button Click="OpenFile_Click" Content="{I18N {x:Static lang:LangKeys.Sample_6cfd8797ec}}" />
                        <TextBlock
                            x:Name="OpenedFilePathText"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </ui:StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_86ebf9a041}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_f8df5a8bca}}"
                        TextWrapping="Wrap" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="16">
                        <ui:Button Click="OpenPicture_Click" Content="{I18N {x:Static lang:LangKeys.Sample_e2fb29cf31}}" />
                        <TextBlock
                            x:Name="OpenedPicturePathText"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </ui:StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_a074a4a7c5}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_1c91fe2647}}"
                        TextWrapping="Wrap" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="16">
                        <ui:Button Click="OpenMultiple_Click" Content="{I18N {x:Static lang:LangKeys.Sample_d44c79bb8c}}" />
                        <TextBlock
                            x:Name="OpenedMultiplePathText"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </ui:StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_aaa4b65e5c}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Microsoft.Win32.OpenFolderDialog（.NET 8+）。"
                        TextWrapping="Wrap" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="16">
                        <ui:Button Click="OpenFolder_Click" Content="{I18N {x:Static lang:LangKeys.Sample_b00f8cb915}}" />
                        <TextBlock
                            x:Name="OpenedFolderPathText"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </ui:StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_7f2c95cd69}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_a10fab8639}}"
                        TextWrapping="Wrap" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            MinWidth="80"
                            VerticalAlignment="Center"
                            Text="{I18N {x:Static lang:LangKeys.Sample_b9c52d9a85}}" />
                        <ui:TextBox
                            x:Name="FileToSaveNameTextBox"
                            MinWidth="180"
                            PlaceholderText="{I18N {x:Static lang:LangKeys.Sample_d31088e654}}" />
                        <TextBlock VerticalAlignment="Center" Text=".txt" />
                    </ui:StackPanel>
                    <ui:StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            MinWidth="80"
                            VerticalAlignment="Center"
                            Text="{I18N {x:Static lang:LangKeys.Sample_5636766102}}" />
                        <ui:TextBox
                            x:Name="FileToSaveContentsTextBox"
                            MinWidth="210"
                            PlaceholderText="{I18N {x:Static lang:LangKeys.Sample_7518aac27a}}" />
                    </ui:StackPanel>
                    <ui:StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="16">
                        <ui:Button Click="SaveFile_Click" Content="{I18N {x:Static lang:LangKeys.Sample_7f2c95cd69}}" />
                        <TextBlock
                            x:Name="SavedFileNoticeText"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Visibility="Collapsed" />
                    </ui:StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
