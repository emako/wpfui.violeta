<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Text.EmojiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:emoji="http://schemas.lepo.co/wpfui/2022/xaml/emoji"
    Title="Emoji"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <vio:Page.Resources>
        <sys:String x:Key="SampleText">Hello! 😁🎀🇬🇧👨‍👦👨🏻‍👩🏿‍👧🏽‍👦🏽‍‍😶‍🌫️</sys:String>
        <sys:String x:Key="EditableText" xml:space="preserve">I💖emoji! Edit me, or use the picker😄&#x0a;🐍🏍️📞🍰☘️🖋️💩</sys:String>
        <sys:String x:Key="FlagsText">🏁🇨🇭🇺🇳🇸🇰🏳️‍⚧️🏴󠁧󠁢󠁷󠁬󠁳󠁿🇧🇷🇦🇺🏳️‍🌈🇳🇵</sys:String>
        <DrawingImage x:Key="DrawingImageSource" emoji:EmojiImage.Source="🏇" emoji:EmojiImage.DrawPadding="False" />
    </vio:Page.Resources>
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,4"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Emoji" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Color emoji rendering based on emoji.wpf (COLR/CPAL via Segoe UI Emoji)."
                TextWrapping="Wrap" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="EmojiedTextBlock vs TextBlock" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Native TextBlock may show monochrome glyphs; EmojiedTextBlock renders color emoji."
                        TextWrapping="Wrap" />
                    <Border
                        Margin="0,0,0,8"
                        Padding="8"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <TextBlock
                            FontFamily="Segoe UI Emoji, Segoe UI"
                            FontSize="24"
                            Text="{StaticResource SampleText}"
                            TextWrapping="Wrap" />
                    </Border>
                    <Border
                        Padding="8"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <emoji:EmojiedTextBlock
                            FontSize="24"
                            Text="{StaticResource SampleText}"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="EmojiImage" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Attach EmojiImage.Source to Image, or build a DrawingImage."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Width="48"
                            Height="48"
                            Margin="0,0,12,0"
                            Source="{StaticResource DrawingImageSource}" />
                        <Image
                            Width="48"
                            Height="48"
                            emoji:EmojiImage.Source="🦑" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="EmojiPicker" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Pick an emoji and insert it into the text box."
                        TextWrapping="Wrap" />
                    <DockPanel LastChildFill="True">
                        <emoji:EmojiPicker
                            x:Name="Picker"
                            Width="40"
                            Height="40"
                            Margin="0,0,8,0"
                            VerticalAlignment="Top"
                            DockPanel.Dock="Left"
                            EmojiPicked="OnEmojiPicked"
                            Selection="🍣" />
                        <emoji:EmojiedTextBox
                            x:Name="Editor"
                            MinHeight="96"
                            AcceptsReturn="True"
                            FontSize="20"
                            Text="{StaticResource EditableText}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Flags" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Windows-style flag glyphs (when available)."
                        TextWrapping="Wrap" />
                    <emoji:EmojiedTextBlock
                        FontSize="28"
                        Text="{StaticResource FlagsText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
