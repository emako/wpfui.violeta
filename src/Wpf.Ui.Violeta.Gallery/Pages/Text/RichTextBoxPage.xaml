<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Text.RichTextBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="RichTextBox"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="RichTextBox" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="普通 RichTextBox" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="标准 WPF 富文本编辑器，支持 FlowDocument。" />
                    <RichTextBox
                        Height="160"
                        HorizontalAlignment="Stretch">
                        <FlowDocument>
                            <Paragraph>
                                <Run FontWeight="SemiBold">FlowDocument 示例</Run>
                                <LineBreak />
                                <Run>RichTextBox 可以编辑包含</Run>
                                <Run FontStyle="Italic">多种格式</Run>
                                <Run>的文档内容。</Run>
                            </Paragraph>
                            <Paragraph>
                                <Run>支持</Run>
                                <Run FontWeight="Bold">粗体</Run>
                                <Run>、</Run>
                                <Run FontStyle="Italic">斜体</Run>
                                <Run>与</Run>
                                <Run TextDecorations="Underline">下划线</Run>
                                <Run>等内联样式。</Run>
                            </Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="ui:RichTextBox" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Wpf.Ui 风格的 RichTextBox。" />
                    <ui:RichTextBox Height="120" HorizontalAlignment="Stretch">
                        <FlowDocument>
                            <Paragraph>
                                <Run>Wpf.Ui RichTextBox with FlowDocument content.</Run>
                            </Paragraph>
                        </FlowDocument>
                    </ui:RichTextBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
