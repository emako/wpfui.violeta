<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Text.SelectableTextBlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="SelectableTextBlock"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="SelectableTextBlock" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="可选中文本" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="可拖拽选中并右键复制，支持多种语义样式。" />
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="120"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="Default" />
                            <vio:SelectableTextBlock Text="Default — drag to select, right-click to copy." />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="120"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="Secondary" />
                            <vio:SelectableTextBlock Style="{StaticResource SecondarySelectableTextBlock}" Text="Secondary text colour." />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="120"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="Tertiary" />
                            <vio:SelectableTextBlock Style="{StaticResource TertiarySelectableTextBlock}" Text="Tertiary text colour." />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="120"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="Success" />
                            <vio:SelectableTextBlock Style="{StaticResource SuccessSelectableTextBlock}" Text="Success text colour." />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="120"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="Warning" />
                            <vio:SelectableTextBlock Style="{StaticResource WarningSelectableTextBlock}" Text="Warning text colour." />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="120"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="Danger" />
                            <vio:SelectableTextBlock Style="{StaticResource DangerSelectableTextBlock}" Text="Danger text colour." />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="120"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="Mark" />
                            <vio:SelectableTextBlock Style="{StaticResource MarkSelectableTextBlock}" Text="Mark highlight background." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                MinWidth="120"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="Underline" />
                            <vio:SelectableTextBlock Style="{StaticResource UnderlineSelectableTextBlock}" Text="Underline decoration." />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
