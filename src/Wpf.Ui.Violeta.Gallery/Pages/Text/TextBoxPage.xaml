<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Text.TextBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_Textbox}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_Textbox}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_87d0142c20}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_3a5fe68601}}" />
                    <TextBox
                        Width="320"
                        HorizontalAlignment="Left"
                        Text="{I18N {x:Static lang:LangKeys.Sample_c884cdba0a}}" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_fec7f8fb9e}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_1f9d2d95b3}}" />
                    <StackPanel>
                        <ui:TextBox
                            Width="320"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            PlaceholderText="{I18N {x:Static lang:LangKeys.Sample_cdd6fe7d2f}}"
                            Text="{I18N {x:Static lang:LangKeys.Sample_f9783871d2}}" />
                        <ui:TextBox
                            Width="320"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            ClearButtonEnabled="False"
                            PlaceholderText="{I18N {x:Static lang:LangKeys.Sample_61b0c7c3e4}}"
                            Text="{I18N {x:Static lang:LangKeys.Sample_4089352c97}}" />
                        <ui:TextBox
                            Width="320"
                            HorizontalAlignment="Left"
                            IsEnabled="False"
                            PlaceholderText="{I18N {x:Static lang:LangKeys.Sample_710ad08b11}}"
                            Text="{I18N {x:Static lang:LangKeys.Sample_b9f5c797eb}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_7269b2e6d4}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_d5e7922721}}" />
                    <StackPanel>
                        <TextBox
                            Width="320"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            AcceptsReturn="True"
                            Style="{DynamicResource TextBlockTextBoxStyle}"
                            Text="{I18N {x:Static lang:LangKeys.Sample_7e51a09629}}"
                            TextWrapping="Wrap" />
                        <ui:TextBox
                            Width="320"
                            HorizontalAlignment="Left"
                            AcceptsReturn="True"
                            Style="{DynamicResource TextBlockUiTextBoxStyle}"
                            Text="{I18N {x:Static lang:LangKeys.Sample_d5ea1ead59}}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
