<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Text.TextBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="TextBox"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="TextBox" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="普通 TextBox" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="标准 WPF TextBox。" />
                    <TextBox
                        Width="320"
                        HorizontalAlignment="Left"
                        Text="Hello, Wpf.Ui.Violeta" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="ui:TextBox" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Wpf.Ui TextBox，支持占位符与清除按钮。" />
                    <StackPanel>
                        <ui:TextBox
                            Width="320"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            PlaceholderText="请输入内容..."
                            Text="带清除按钮" />
                        <ui:TextBox
                            Width="320"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            ClearButtonEnabled="False"
                            PlaceholderText="无清除按钮"
                            Text="ClearButtonEnabled=False" />
                        <ui:TextBox
                            Width="320"
                            HorizontalAlignment="Left"
                            IsEnabled="False"
                            PlaceholderText="禁用"
                            Text="Disabled" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="TextBlock 外观样式" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="使用 TextBlockTextBoxStyle / TextBlockUiTextBoxStyle 呈现为文本块外观。" />
                    <StackPanel>
                        <TextBox
                            Width="320"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            AcceptsReturn="True"
                            Style="{DynamicResource TextBlockTextBoxStyle}"
                            Text="TextBox with TextBlockTextBoxStyle&#x0a;More lines..."
                            TextWrapping="Wrap" />
                        <ui:TextBox
                            Width="320"
                            HorizontalAlignment="Left"
                            AcceptsReturn="True"
                            Style="{DynamicResource TextBlockUiTextBoxStyle}"
                            Text="ui:TextBox with TextBlockUiTextBoxStyle&#x0a;More lines..."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
