<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Text.NumberDisplayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="NumberDisplayer"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="NumberDisplayer" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Animated value transition" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="NumberDisplayer interpolates between old and new values with a smooth rolling effect."
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,0,0,16"
                        HorizontalAlignment="Left"
                        Click="Change_Click"
                        Content="Change" />
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock
                            Margin="0,0,0,4"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="Int32Displayer" />
                        <vio:Int32Displayer FontSize="24" Value="{Binding IntValue}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock
                            Margin="0,0,0,4"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="Int64Displayer" />
                        <vio:Int64Displayer FontSize="24" Value="{Binding LongValue}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock
                            Margin="0,0,0,4"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="DoubleDisplayer (N2)" />
                        <vio:DoubleDisplayer
                            FontSize="24"
                            StringFormat="N2"
                            Value="{Binding DoubleValue}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,4"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="DateDisplay (yyyy-MM-dd)" />
                        <vio:DateDisplay
                            FontSize="24"
                            StringFormat="yyyy-MM-dd"
                            Value="{Binding DateValue}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Selectable" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Set IsSelectable=&quot;True&quot; to allow selecting and copying the displayed text."
                        TextWrapping="Wrap" />
                    <StackPanel Margin="0,0,0,8">
                        <vio:Int32Displayer
                            FontSize="20"
                            IsSelectable="True"
                            Value="{Binding IntValue}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <vio:Int64Displayer
                            FontSize="20"
                            IsSelectable="True"
                            Value="{Binding LongValue}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <vio:DoubleDisplayer
                            FontSize="20"
                            IsSelectable="True"
                            StringFormat="N2"
                            Value="{Binding DoubleValue}" />
                    </StackPanel>
                    <StackPanel>
                        <vio:DateDisplay
                            FontSize="20"
                            IsSelectable="True"
                            StringFormat="yyyy-MM-dd"
                            Value="{Binding DateValue}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
