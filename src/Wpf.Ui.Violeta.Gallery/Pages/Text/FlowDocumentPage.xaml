<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Text.FlowDocumentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_FlowDocument}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <vio:Page.Resources>
        <FlowDocument
            x:Key="NeptuneFlowDocument"
            x:Shared="False"
            ColumnWidth="400"
            IsHyphenationEnabled="True"
            IsOptimalParagraphEnabled="True">
            <Section FontSize="12">
                <Paragraph>
                    <Bold>
                        <Run Text="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_Title}}" />
                    </Bold>
                    <Run Text="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_Intro}}" />
                    <Figure
                        Width="140"
                        Height="50"
                        Background="GhostWhite"
                        HorizontalAnchor="PageLeft"
                        HorizontalOffset="100"
                        VerticalOffset="20">
                        <Paragraph
                            Background="Beige"
                            FontStyle="Italic"
                            Foreground="DarkGreen"
                            TextAlignment="Left">
                            <Run Text="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_Figure1}}" />
                        </Paragraph>
                    </Figure>
                    <Floater
                        Width="285"
                        Background="GhostWhite"
                        HorizontalAlignment="Left">
                        <Table CellSpacing="5">
                            <Table.Columns>
                                <TableColumn Width="155" />
                                <TableColumn Width="130" />
                            </Table.Columns>
                            <TableRowGroup>
                                <TableRow>
                                    <TableCell ColumnSpan="3">
                                        <Paragraph>
                                            <Run Text="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_StatsTitle}}" />
                                        </Paragraph>
                                    </TableCell>
                                </TableRow>
                                <TableRow Background="LightGoldenrodYellow" FontSize="12">
                                    <TableCell>
                                        <Paragraph FontWeight="Bold">
                                            <Run Text="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_MeanDistance}}" />
                                        </Paragraph>
                                    </TableCell>
                                    <TableCell>
                                        <Paragraph>
                                            <Run Text="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_MeanDistance_Value}}" />
                                        </Paragraph>
                                    </TableCell>
                                </TableRow>
                                <TableRow Background="LightGray" FontSize="12">
                                    <TableCell>
                                        <Paragraph FontWeight="Bold">
                                            <Run Text="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_MeanDiameter}}" />
                                        </Paragraph>
                                    </TableCell>
                                    <TableCell>
                                        <Paragraph>
                                            <Run Text="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_MeanDiameter_Value}}" />
                                        </Paragraph>
                                    </TableCell>
                                </TableRow>
                                <TableRow Background="LightGoldenrodYellow" FontSize="12">
                                    <TableCell>
                                        <Paragraph FontWeight="Bold">
                                            <Run Text="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_Mass}}" />
                                        </Paragraph>
                                    </TableCell>
                                    <TableCell>
                                        <Paragraph>
                                            <Run Text="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_Mass_Value}}" />
                                        </Paragraph>
                                    </TableCell>
                                </TableRow>
                                <TableRow>
                                    <TableCell ColumnSpan="4">
                                        <Paragraph FontSize="10" FontStyle="Italic">
                                            <Run Text="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_SourcePrefix}}" />
                                            <Hyperlink
                                                NavigateUri="https://en.wikipedia.org/wiki/Neptune"
                                                RequestNavigate="OnHyperlinkRequestNavigate">
                                                <Run Text="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_SourceLink}}" />
                                            </Hyperlink>
                                            <Run Text="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_SourceSuffix}}" />
                                        </Paragraph>
                                    </TableCell>
                                </TableRow>
                            </TableRowGroup>
                        </Table>
                    </Floater>
                </Paragraph>
                <Paragraph>
                    <Run Text="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_Structure}}" />
                </Paragraph>
                <Paragraph>
                    <Figure
                        Width="140"
                        Height="50"
                        Background="GhostWhite"
                        HorizontalAnchor="PageCenter"
                        TextAlignment="Left"
                        WrapDirection="Both">
                        <Paragraph
                            Background="Beige"
                            FontStyle="Italic"
                            Foreground="DarkGreen">
                            <Run Text="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_Figure2}}" />
                        </Paragraph>
                    </Figure>
                    <Run Text="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_Discovery}}" />
                </Paragraph>
            </Section>
        </FlowDocument>
    </vio:Page.Resources>
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,8"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_FlowDocument}}" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_Desc}}"
                TextWrapping="Wrap" />

            <Border
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <TabControl MinHeight="440">
                    <TabItem Header="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_ScrollViewer}}">
                        <FlowDocumentScrollViewer
                            Margin="8"
                            Document="{StaticResource NeptuneFlowDocument}"
                            IsToolBarVisible="True" />
                    </TabItem>
                    <TabItem Header="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_PageViewer}}">
                        <FlowDocumentPageViewer Margin="8" Document="{StaticResource NeptuneFlowDocument}" />
                    </TabItem>
                    <TabItem Header="{I18N {x:Static lang:LangKeys.Gallery_FlowDocument_Reader}}">
                        <FlowDocumentReader Margin="8" Document="{StaticResource NeptuneFlowDocument}" />
                    </TabItem>
                </TabControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
