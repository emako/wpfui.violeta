<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Text.SearchBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="SearchBox"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="SearchBox" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="vio:SearchBox" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="对齐 WinUI SearchBox：QueryChanged（输入/清除）、QuerySubmitted（回车提交）。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <vio:SearchBox
                            x:Name="SearchBox"
                            Grid.Column="0"
                            Width="320"
                            HorizontalAlignment="Left"
                            PlaceholderText="Search..."
                            QueryChanged="OnQueryChanged"
                            QuerySubmitted="OnQuerySubmitted" />
                        <CheckBox
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Content="显示清除按钮"
                            IsChecked="{Binding ElementName=SearchBox, Path=ClearButtonEnabled}" />
                    </Grid>
                    <TextBlock
                        x:Name="QueryChangedResult"
                        Margin="0,12,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="QueryChanged：—" />
                    <TextBlock
                        x:Name="QuerySubmittedResult"
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="QuerySubmitted：—" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="自定义图标" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="可通过 Icon 属性替换默认搜索图标。" />
                    <vio:SearchBox
                        Width="320"
                        HorizontalAlignment="Left"
                        PlaceholderText="Filter files...">
                        <vio:SearchBox.Icon>
                            <ui:SymbolIcon Symbol="Filter24" />
                        </vio:SearchBox.Icon>
                    </vio:SearchBox>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="禁用状态" />
                    <vio:SearchBox
                        Width="320"
                        HorizontalAlignment="Left"
                        IsEnabled="False"
                        PlaceholderText="Disabled"
                        Text="Cannot edit" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
