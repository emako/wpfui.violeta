<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Text.OutlineTextBlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_OutlineTextBlock}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_OutlineTextBlock}}" />

            <!--  Basic  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_OutlineTextBlock_BasicTitle}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_OutlineTextBlock_BasicDesc}}"
                        TextWrapping="Wrap" />
                    <vio:OutlineTextBlock
                        Margin="0,0,0,8"
                        Text="{I18N {x:Static lang:LangKeys.Sample_OutlineTextBlock_SampleText}}"
                        TextWrapping="Wrap" />
                    <vio:OutlineTextBlock
                        Margin="0,0,0,8"
                        FontSize="30"
                        Fill="{DynamicResource SystemFillColorSuccessBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_OutlineTextBlock_SampleText}}" />
                    <vio:OutlineTextBlock
                        FontSize="30"
                        FontStyle="Italic"
                        Text="{I18N {x:Static lang:LangKeys.Sample_OutlineTextBlock_SampleText}}" />
                </StackPanel>
            </Border>

            <!--  Stroke  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_OutlineTextBlock_StrokeTitle}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_OutlineTextBlock_StrokeDesc}}"
                        TextWrapping="Wrap" />
                    <vio:OutlineTextBlock
                        Margin="0,0,0,8"
                        FontSize="50"
                        Fill="{DynamicResource SystemFillColorCriticalBrush}"
                        Stroke="{DynamicResource SystemAccentColorPrimaryBrush}"
                        StrokeThickness="2"
                        Text="{I18N {x:Static lang:LangKeys.Sample_OutlineTextBlock_SampleText}}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <vio:OutlineTextBlock
                        Margin="0,0,0,8"
                        FontSize="72"
                        FontWeight="Bold"
                        Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                        Stroke="{DynamicResource SystemFillColorCriticalBrush}"
                        StrokeThickness="4"
                        Text="{I18N {x:Static lang:LangKeys.Sample_OutlineTextBlock_ShortText}}" />
                    <vio:OutlineTextBlock
                        Margin="0,0,0,8"
                        FontSize="72"
                        FontWeight="Bold"
                        Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                        Stroke="{DynamicResource SystemFillColorCriticalBrush}"
                        StrokePosition="Outside"
                        StrokeThickness="4"
                        Text="{I18N {x:Static lang:LangKeys.Sample_OutlineTextBlock_ShortText}}" />
                    <vio:OutlineTextBlock
                        FontSize="72"
                        FontWeight="Bold"
                        Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                        Stroke="{DynamicResource SystemFillColorCriticalBrush}"
                        StrokePosition="Inside"
                        StrokeThickness="4"
                        Text="{I18N {x:Static lang:LangKeys.Sample_OutlineTextBlock_ShortText}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
