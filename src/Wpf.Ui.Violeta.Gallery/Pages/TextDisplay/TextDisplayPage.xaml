<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.TextDisplay.TextDisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctrl="clr-namespace:Wpf.Ui.Violeta.Gallery.Controls"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="文本显示"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="文本显示" />
            <TextBlock
                Margin="0,0,0,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="点击卡片进入对应控件演示页面。"
                TextWrapping="Wrap" />
            <WrapPanel>
                <ctrl:SampleCard Width="260" Title="Label" Description="标签文本" Glyph="&#xE8D2;" NavigateTag="text/label" />
                <ctrl:SampleCard Width="260" Title="TextBlock" Description="文本块" Glyph="&#xE8C8;" NavigateTag="text/text-block" />
                <ctrl:SampleCard Width="260" Title="SelectableTextBlock" Description="可选中复制的文本块" Glyph="&#xE8C8;" NavigateTag="text/selectable-text-block" />
                <ctrl:SampleCard Width="260" Title="Hyperlink" Description="Fluent 风格超链接" Glyph="&#xE71B;" NavigateTag="text/hyperlink" />
                <ctrl:SampleCard Width="260" Title="BoolStateTextBlock" Description="布尔状态文本显示" Glyph="&#xE8FB;" NavigateTag="text/bool-state-text-block" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
