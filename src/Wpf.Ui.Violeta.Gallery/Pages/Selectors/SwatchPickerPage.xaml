<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Selectors.SwatchPickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,8"
                FontSize="20"
                FontWeight="SemiBold"
                Text="SwatchPicker" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="即时提交的 Fluent 风格色块选择器，支持行、网格、尺寸、圆角、禁用和键盘选择。"
                TextWrapping="Wrap" />
            <Border
                Padding="16"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Popup picker" />
                    <vio:SwatchPicker
                        x:Name="PopupPicker"
                        Margin="0,12,0,0"
                        SelectedValueChanged="OnSelectedValueChanged">
                        <vio:SwatchPicker.ItemsSource>
                            <x:Array Type="{x:Type vio:Swatch}">
                                <vio:Swatch Color="#0078D4" Value="Blue" />
                                <vio:Swatch Color="#8764B8" Value="Purple" />
                                <vio:Swatch Color="#00B7C3" Value="Teal" />
                                <vio:Swatch Color="#107C10" Value="Green" />
                                <vio:Swatch Color="#FFB900" Value="Yellow" />
                                <vio:Swatch Color="#D13438" Value="Red" />
                                <vio:Swatch
                                    IsEnabled="False"
                                    Color="#808080"
                                    Value="Disabled" />
                            </x:Array>
                        </vio:SwatchPicker.ItemsSource>
                    </vio:SwatchPicker>
                    <TextBlock Margin="0,12,0,0" Text="{Binding SelectedValue, ElementName=PopupPicker, StringFormat=SelectedValue: {0}}" />
                </StackPanel>
            </Border>
            <Border
                Margin="0,16,0,0"
                Padding="16"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Selection shapes" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="选中态在色块内部绘制强调色描边，中间留出背景色间隙，配合悬停放大、按下回弹与描边收束动效。点击色块试试。"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,16,0,0"
                        FontWeight="SemiBold"
                        Text="Square" />
                    <WrapPanel x:Name="SquareRow" Margin="0,8,0,0">
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="0"
                            Color="#FE1921" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="0"
                            Color="#FE7900" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="0"
                            Color="#FEC12E" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="0"
                            Color="#8FCF56" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="0"
                            Color="#00AF53" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="0"
                            Color="#00AEEC" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="0"
                            Color="#006DBC" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="0"
                            Color="#011F5E" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="0"
                            Color="#702F9D" />
                    </WrapPanel>

                    <TextBlock
                        Margin="0,16,0,0"
                        FontWeight="SemiBold"
                        Text="Circular" />
                    <WrapPanel x:Name="CircularRow" Margin="0,8,0,0">
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="18"
                            Color="#FE1921" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="18"
                            Color="#FE7900" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="18"
                            IsSelected="True"
                            Color="#FEC12E" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="18"
                            Color="#8FCF56" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="18"
                            Color="#00AF53" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="18"
                            Color="#00AEEC" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="18"
                            Color="#006DBC" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="18"
                            Color="#011F5E" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="18"
                            Color="#702F9D" />
                    </WrapPanel>

                    <TextBlock
                        Margin="0,16,0,0"
                        FontWeight="SemiBold"
                        Text="Rounded" />
                    <WrapPanel x:Name="RoundedRow" Margin="0,8,0,0">
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="4"
                            Color="#FE1921" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="4"
                            Color="#FE7900" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="4"
                            Color="#FEC12E" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="4"
                            Color="#8FCF56" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="4"
                            Color="#00AF53" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="4"
                            Color="#00AEEC" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="4"
                            Color="#006DBC" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="4"
                            Color="#011F5E" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="4"
                            Color="#702F9D" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border
                Margin="0,16,0,0"
                Padding="16"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Standalone swatches" />
                    <WrapPanel Margin="0,12,0,0">
                        <vio:Swatch
                            Width="20"
                            Height="20"
                            Margin="2"
                            CornerRadius="0"
                            Color="#0078D4" />
                        <vio:Swatch
                            Width="24"
                            Height="24"
                            Margin="2"
                            CornerRadius="4"
                            Color="#8764B8" />
                        <vio:Swatch
                            Width="28"
                            Height="28"
                            Margin="2"
                            CornerRadius="14"
                            Color="#00B7C3" />
                        <vio:Swatch
                            Width="32"
                            Height="32"
                            Margin="2"
                            Color="#D13438" />
                        <vio:Swatch
                            Width="32"
                            Height="32"
                            Margin="2"
                            IsEnabled="False"
                            Color="#808080" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
