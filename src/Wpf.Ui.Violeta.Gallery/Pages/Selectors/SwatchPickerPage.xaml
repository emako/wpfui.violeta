<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Selectors.SwatchPickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,8"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_SwatchPicker}}" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Sample_64d984a4b3}}"
                TextWrapping="Wrap" />
            <Border
                Padding="16"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_3157b6de96}}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_a3d4b2e49b}}"
                        TextWrapping="Wrap" />
                    <vio:SwatchPicker
                        x:Name="PopupPicker"
                        Margin="0,12,0,0"
                        SelectedValueChanged="OnSelectedValueChanged"
                        SwatchShape="Rounded"
                        SwatchSize="28">
                        <vio:SwatchPicker.ItemsSource>
                            <x:Array Type="{x:Type vio:Swatch}">
                                <vio:Swatch Color="#0078D4" Value="Blue" />
                                <vio:Swatch Color="#8764B8" Value="Purple" />
                                <vio:Swatch Color="#00B7C3" Value="Teal" />
                                <vio:Swatch Color="#107C10" Value="Green" />
                                <vio:Swatch Color="#FFB900" Value="Yellow" />
                                <vio:Swatch Color="#D13438" Value="Red" />
                                <vio:Swatch
                                    IsEnabled="False"
                                    Color="#808080"
                                    Value="Disabled" />
                            </x:Array>
                        </vio:SwatchPicker.ItemsSource>
                    </vio:SwatchPicker>
                    <TextBlock Margin="0,12,0,0" Text="{Binding SelectedValue, ElementName=PopupPicker, StringFormat=SelectedValue: {0}}" />
                </StackPanel>
            </Border>
            <Border
                Margin="0,16,0,0"
                Padding="16"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_StatusBar_GridTitle}}" />
                    <vio:SwatchPicker
                        x:Name="GridPicker"
                        Margin="0,12,0,0"
                        ColumnCount="4"
                        Layout="Grid"
                        Spacing="6"
                        SwatchShape="Circular"
                        SwatchSize="32">
                        <vio:SwatchPicker.ItemsSource>
                            <x:Array Type="{x:Type vio:Swatch}">
                                <vio:Swatch Color="#FE1921" Value="Red" />
                                <vio:Swatch Color="#FE7900" Value="Orange" />
                                <vio:Swatch Color="#FEC12E" Value="Yellow" />
                                <vio:Swatch Color="#8FCF56" Value="Lime" />
                                <vio:Swatch Color="#00AF53" Value="Green" />
                                <vio:Swatch Color="#00AEEC" Value="Cyan" />
                                <vio:Swatch Color="#006DBC" Value="Blue" />
                                <vio:Swatch Color="#702F9D" Value="Purple" />
                            </x:Array>
                        </vio:SwatchPicker.ItemsSource>
                    </vio:SwatchPicker>
                    <TextBlock Margin="0,12,0,0" Text="{Binding SelectedValue, ElementName=GridPicker, StringFormat=SelectedValue: {0}}" />
                </StackPanel>
            </Border>
            <Border
                Margin="0,16,0,0"
                Padding="16"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_0daf56c1c8}}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_13a67d4cc8}}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,16,0,0"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_ceb46ca115}}" />
                    <WrapPanel x:Name="SquareRow" Margin="0,8,0,0">
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="0"
                            Color="#FE1921" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="0"
                            Color="#FE7900" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="0"
                            Color="#FEC12E" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="0"
                            Color="#8FCF56" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="0"
                            Color="#00AF53" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="0"
                            Color="#00AEEC" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="0"
                            Color="#006DBC" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="0"
                            Color="#011F5E" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="0"
                            Color="#702F9D" />
                    </WrapPanel>

                    <TextBlock
                        Margin="0,16,0,0"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_ae2fd93db7}}" />
                    <WrapPanel x:Name="CircularRow" Margin="0,8,0,0">
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="18"
                            Color="#FE1921" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="18"
                            Color="#FE7900" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="18"
                            IsSelected="True"
                            Color="#FEC12E" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="18"
                            Color="#8FCF56" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="18"
                            Color="#00AF53" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="18"
                            Color="#00AEEC" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="18"
                            Color="#006DBC" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="18"
                            Color="#011F5E" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="18"
                            Color="#702F9D" />
                    </WrapPanel>

                    <TextBlock
                        Margin="0,16,0,0"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_bef2481eda}}" />
                    <WrapPanel x:Name="RoundedRow" Margin="0,8,0,0">
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="4"
                            Color="#FE1921" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="4"
                            Color="#FE7900" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="4"
                            Color="#FEC12E" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="4"
                            Color="#8FCF56" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="4"
                            Color="#00AF53" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="4"
                            Color="#00AEEC" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="4"
                            Color="#006DBC" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="4"
                            Color="#011F5E" />
                        <vio:Swatch
                            Width="36"
                            Height="36"
                            Margin="2,0"
                            Click="OnShapeSwatchClick"
                            CornerRadius="4"
                            Color="#702F9D" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border
                Margin="0,16,0,0"
                Padding="16"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_3dd55e39f8}}" />
                    <WrapPanel Margin="0,12,0,0">
                        <vio:Swatch
                            Width="20"
                            Height="20"
                            Margin="2"
                            CornerRadius="0"
                            Color="#0078D4" />
                        <vio:Swatch
                            Width="24"
                            Height="24"
                            Margin="2"
                            CornerRadius="4"
                            Color="#8764B8" />
                        <vio:Swatch
                            Width="28"
                            Height="28"
                            Margin="2"
                            CornerRadius="14"
                            Color="#00B7C3" />
                        <vio:Swatch
                            Width="32"
                            Height="32"
                            Margin="2"
                            Color="#D13438" />
                        <vio:Swatch
                            Width="32"
                            Height="32"
                            Margin="2"
                            IsEnabled="False"
                            Color="#808080" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
