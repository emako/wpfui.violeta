<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Selectors.SwatchPickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock Margin="0,0,0,8" FontSize="20" FontWeight="SemiBold" Text="SwatchPicker" />
            <TextBlock Margin="0,0,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="即时提交的 Fluent 风格色块选择器，支持行、网格、尺寸、圆角、禁用和键盘选择。" TextWrapping="Wrap" />
            <Border Padding="16" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Popup picker" />
                    <vio:SwatchPicker x:Name="PopupPicker" Margin="0,12,0,0" SelectedValueChanged="OnSelectedValueChanged">
                        <vio:SwatchPicker.ItemsSource>
                            <x:Array Type="{x:Type vio:Swatch}">
                                <vio:Swatch Value="Blue" Color="#0078D4" />
                                <vio:Swatch Value="Purple" Color="#8764B8" />
                                <vio:Swatch Value="Teal" Color="#00B7C3" />
                                <vio:Swatch Value="Green" Color="#107C10" />
                                <vio:Swatch Value="Yellow" Color="#FFB900" />
                                <vio:Swatch Value="Red" Color="#D13438" />
                                <vio:Swatch Value="Disabled" Color="#808080" IsEnabled="False" />
                            </x:Array>
                        </vio:SwatchPicker.ItemsSource>
                    </vio:SwatchPicker>
                    <TextBlock Margin="0,12,0,0" Text="{Binding SelectedValue, ElementName=PopupPicker, StringFormat=SelectedValue: {0}}" />
                </StackPanel>
            </Border>
            <Border Margin="0,16,0,0" Padding="16" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Standalone swatches" />
                    <WrapPanel Margin="0,12,0,0">
                        <vio:Swatch Margin="2" Width="20" Height="20" Color="#0078D4" CornerRadius="0" />
                        <vio:Swatch Margin="2" Width="24" Height="24" Color="#8764B8" CornerRadius="4" />
                        <vio:Swatch Margin="2" Width="28" Height="28" Color="#00B7C3" CornerRadius="14" />
                        <vio:Swatch Margin="2" Width="32" Height="32" Color="#D13438" IsSelected="True" />
                        <vio:Swatch Margin="2" Width="32" Height="32" Color="#808080" IsEnabled="False" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
