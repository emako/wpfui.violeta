<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Selectors.ColorPickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_ColorPicker}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <ScrollViewer
            Grid.Column="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,24">
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="{I18N {x:Static lang:LangKeys.Gallery_Page_ColorPicker}}" />
                <TextBlock
                    Margin="0,0,0,12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{I18N {x:Static lang:LangKeys.Sample_91ae62d859}}"
                    TextWrapping="Wrap" />

                <Border
                    Padding="16"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <!--
                        Stack vertically: Default (300) + Simple (320) side-by-side overflows typical
                        Gallery widths and ScrollViewer clips the right edge (missing slider corners / half thumb).
                    -->
                    <StackPanel>
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{I18N {x:Static lang:LangKeys.Sample_18c63459a2}}" />
                            <vio:ColorView
                                x:Name="DefaultColorView"
                                Color="#39C5BB"
                                IsAccentColorsVisible="{Binding IsOn, ElementName=ToggleAccentColors}"
                                IsAlphaEnabled="{Binding IsOn, ElementName=ToggleAlphaEnabled}"
                                IsAlphaVisible="{Binding IsOn, ElementName=ToggleAlphaVisible}"
                                IsColorComponentsVisible="{Binding IsOn, ElementName=ToggleColorComponents}"
                                IsColorModelVisible="{Binding IsOn, ElementName=ToggleColorModel}"
                                IsColorPaletteVisible="{Binding IsOn, ElementName=ToggleColorPalette}"
                                IsColorPreviewVisible="{Binding IsOn, ElementName=ToggleColorPreview}"
                                IsColorSpectrumSliderVisible="{Binding IsOn, ElementName=ToggleColorSpectrumSlider}"
                                IsColorSpectrumVisible="{Binding IsOn, ElementName=ToggleColorSpectrum}"
                                IsComponentSliderVisible="{Binding IsOn, ElementName=ToggleComponentSlider}"
                                IsComponentTextInputVisible="{Binding IsOn, ElementName=ToggleComponentTextInput}"
                                IsHexInputVisible="{Binding IsOn, ElementName=ToggleHexInput}" />
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <vio:ColorPicker
                                    Margin="0,0,12,0"
                                    Color="{Binding Color, ElementName=DefaultColorView, Mode=TwoWay}"
                                    IsAccentColorsVisible="{Binding IsOn, ElementName=ToggleAccentColors}"
                                    IsAlphaEnabled="{Binding IsOn, ElementName=ToggleAlphaEnabled}"
                                    IsAlphaVisible="{Binding IsOn, ElementName=ToggleAlphaVisible}"
                                    IsColorComponentsVisible="{Binding IsOn, ElementName=ToggleColorComponents}"
                                    IsColorModelVisible="{Binding IsOn, ElementName=ToggleColorModel}"
                                    IsColorPaletteVisible="{Binding IsOn, ElementName=ToggleColorPalette}"
                                    IsColorPreviewVisible="{Binding IsOn, ElementName=ToggleColorPreview}"
                                    IsColorSpectrumSliderVisible="{Binding IsOn, ElementName=ToggleColorSpectrumSlider}"
                                    IsColorSpectrumVisible="{Binding IsOn, ElementName=ToggleColorSpectrum}"
                                    IsComponentSliderVisible="{Binding IsOn, ElementName=ToggleComponentSlider}"
                                    IsComponentTextInputVisible="{Binding IsOn, ElementName=ToggleComponentTextInput}"
                                    IsHexInputVisible="{Binding IsOn, ElementName=ToggleHexInput}" />
                                <vio:ColorPicker
                                    Color="{Binding Color, ElementName=DefaultColorView, Mode=TwoWay}"
                                    IsAccentColorsVisible="{Binding IsOn, ElementName=ToggleAccentColors}"
                                    IsAlphaEnabled="{Binding IsOn, ElementName=ToggleAlphaEnabled}"
                                    IsAlphaVisible="{Binding IsOn, ElementName=ToggleAlphaVisible}"
                                    IsColorComponentsVisible="{Binding IsOn, ElementName=ToggleColorComponents}"
                                    IsColorModelVisible="{Binding IsOn, ElementName=ToggleColorModel}"
                                    IsColorPaletteVisible="{Binding IsOn, ElementName=ToggleColorPalette}"
                                    IsColorPreviewVisible="{Binding IsOn, ElementName=ToggleColorPreview}"
                                    IsColorSpectrumSliderVisible="{Binding IsOn, ElementName=ToggleColorSpectrumSlider}"
                                    IsColorSpectrumVisible="{Binding IsOn, ElementName=ToggleColorSpectrum}"
                                    IsComponentSliderVisible="{Binding IsOn, ElementName=ToggleComponentSlider}"
                                    IsComponentTextInputVisible="{Binding IsOn, ElementName=ToggleComponentTextInput}"
                                    IsHexInputVisible="{Binding IsOn, ElementName=ToggleHexInput}"
                                    Style="{DynamicResource HexColorPicker}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,24,0,0">
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{I18N {x:Static lang:LangKeys.Sample_1fbb1e3943}}" />
                            <vio:ColorView
                                x:Name="SimpleColorView"
                                Color="{Binding Color, ElementName=DefaultColorView, Mode=TwoWay}"
                                IsAccentColorsVisible="{Binding IsOn, ElementName=ToggleAccentColors}"
                                IsAlphaEnabled="{Binding IsOn, ElementName=ToggleAlphaEnabled}"
                                IsAlphaVisible="{Binding IsOn, ElementName=ToggleAlphaVisible}"
                                IsColorSpectrumSliderVisible="{Binding IsOn, ElementName=ToggleColorSpectrumSlider}"
                                Style="{DynamicResource SimpleColorView}" />
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <vio:ColorPicker
                                    Margin="0,0,12,0"
                                    Color="{Binding Color, ElementName=DefaultColorView, Mode=TwoWay}"
                                    IsAccentColorsVisible="{Binding IsOn, ElementName=ToggleAccentColors}"
                                    IsAlphaEnabled="{Binding IsOn, ElementName=ToggleAlphaEnabled}"
                                    IsAlphaVisible="{Binding IsOn, ElementName=ToggleAlphaVisible}"
                                    IsColorSpectrumSliderVisible="{Binding IsOn, ElementName=ToggleColorSpectrumSlider}"
                                    Style="{DynamicResource SimpleColorPicker}" />
                                <vio:ColorPicker
                                    Color="{Binding Color, ElementName=DefaultColorView, Mode=TwoWay}"
                                    IsAccentColorsVisible="{Binding IsOn, ElementName=ToggleAccentColors}"
                                    IsAlphaEnabled="{Binding IsOn, ElementName=ToggleAlphaEnabled}"
                                    IsAlphaVisible="{Binding IsOn, ElementName=ToggleAlphaVisible}"
                                    IsColorSpectrumSliderVisible="{Binding IsOn, ElementName=ToggleColorSpectrumSlider}"
                                    Style="{DynamicResource HexSimpleColorPicker}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Column="1"
            Padding="12"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_37ee4cf592}}" />
                    <vio:ToggleSwitch
                        x:Name="ToggleAccentColors"
                        Margin="0,0,0,8"
                        Header="{I18N {x:Static lang:LangKeys.Sample_e1715873b6}}"
                        IsOn="True"
                        OffContent="{x:Null}"
                        OnContent="{x:Null}" />
                    <vio:ToggleSwitch
                        x:Name="ToggleAlphaEnabled"
                        Margin="0,0,0,8"
                        Header="{I18N {x:Static lang:LangKeys.Sample_d4a3649959}}"
                        IsOn="True"
                        OffContent="{x:Null}"
                        OnContent="{x:Null}" />
                    <vio:ToggleSwitch
                        x:Name="ToggleAlphaVisible"
                        Margin="0,0,0,8"
                        Header="{I18N {x:Static lang:LangKeys.Sample_3ef12e7ae5}}"
                        IsOn="True"
                        OffContent="{x:Null}"
                        OnContent="{x:Null}" />
                    <vio:ToggleSwitch
                        x:Name="ToggleColorComponents"
                        Margin="0,0,0,8"
                        Header="{I18N {x:Static lang:LangKeys.Sample_364c264fb7}}"
                        IsOn="True"
                        OffContent="{x:Null}"
                        OnContent="{x:Null}" />
                    <vio:ToggleSwitch
                        x:Name="ToggleColorModel"
                        Margin="0,0,0,8"
                        Header="{I18N {x:Static lang:LangKeys.Sample_e4ca56bee4}}"
                        IsOn="True"
                        OffContent="{x:Null}"
                        OnContent="{x:Null}" />
                    <vio:ToggleSwitch
                        x:Name="ToggleColorPalette"
                        Margin="0,0,0,8"
                        Header="{I18N {x:Static lang:LangKeys.Sample_197139f5c5}}"
                        IsOn="True"
                        OffContent="{x:Null}"
                        OnContent="{x:Null}" />
                    <vio:ToggleSwitch
                        x:Name="ToggleColorPreview"
                        Margin="0,0,0,8"
                        Header="{I18N {x:Static lang:LangKeys.Sample_f2579cf82c}}"
                        IsOn="True"
                        OffContent="{x:Null}"
                        OnContent="{x:Null}" />
                    <vio:ToggleSwitch
                        x:Name="ToggleColorSpectrum"
                        Margin="0,0,0,8"
                        Header="{I18N {x:Static lang:LangKeys.Sample_0f273844b1}}"
                        IsOn="True"
                        OffContent="{x:Null}"
                        OnContent="{x:Null}" />
                    <vio:ToggleSwitch
                        x:Name="ToggleColorSpectrumSlider"
                        Margin="0,0,0,8"
                        Header="{I18N {x:Static lang:LangKeys.Sample_83f3616584}}"
                        IsOn="True"
                        OffContent="{x:Null}"
                        OnContent="{x:Null}" />
                    <vio:ToggleSwitch
                        x:Name="ToggleComponentSlider"
                        Margin="0,0,0,8"
                        Header="{I18N {x:Static lang:LangKeys.Sample_2d66358181}}"
                        IsOn="True"
                        OffContent="{x:Null}"
                        OnContent="{x:Null}" />
                    <vio:ToggleSwitch
                        x:Name="ToggleComponentTextInput"
                        Margin="0,0,0,8"
                        Header="{I18N {x:Static lang:LangKeys.Sample_7e3f81feac}}"
                        IsOn="True"
                        OffContent="{x:Null}"
                        OnContent="{x:Null}" />
                    <vio:ToggleSwitch
                        x:Name="ToggleHexInput"
                        Margin="0,0,0,16"
                        Header="{I18N {x:Static lang:LangKeys.Sample_6159b1d323}}"
                        IsOn="True"
                        OffContent="{x:Null}"
                        OnContent="{x:Null}" />

                    <Separator Margin="0,0,0,12" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="Color: " />
                        <Run Text="{Binding Color, ElementName=DefaultColorView, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="HsvColor: " />
                        <Run Text="{Binding HsvColor, ElementName=DefaultColorView, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</vio:Page>
