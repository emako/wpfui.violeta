<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Selectors.SelectorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:gallery="clr-namespace:Wpf.Ui.Violeta.Gallery"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="选择器"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock Margin="0,0,0,16" FontSize="20" FontWeight="SemiBold" Text="选择器" />
            <TextBlock
                Margin="0,0,0,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="点击卡片进入对应控件演示页面。"
                TextWrapping="Wrap" />
            <WrapPanel>
                <ui:CardAction
                    Width="260"
                    Height="80"
                    Margin="0,0,12,12"
                    Command="{x:Static gallery:GalleryNavigator.NavigateCommand}"
                    CommandParameter="selectors/multi-combo-box">
                    <ui:CardAction.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="28" Glyph="&#xE8A5;" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="MultiComboBox" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Appearance="Secondary" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="多选下拉框，支持标签展示与搜索" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction
                    Width="260"
                    Height="80"
                    Margin="0,0,12,12"
                    Command="{x:Static gallery:GalleryNavigator.NavigateCommand}"
                    CommandParameter="selectors/cascading-combo-box">
                    <ui:CardAction.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="28" Glyph="&#xE8FD;" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="CascadingComboBox" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Appearance="Secondary" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="父子级联选择下拉框" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction
                    Width="260"
                    Height="80"
                    Margin="0,0,12,12"
                    Command="{x:Static gallery:GalleryNavigator.NavigateCommand}"
                    CommandParameter="selectors/tag-combo-box">
                    <ui:CardAction.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="28" Glyph="&#xE8EC;" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="TagComboBox" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Appearance="Secondary" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="以标签形式展示选项" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction
                    Width="260"
                    Height="80"
                    Margin="0,0,12,12"
                    Command="{x:Static gallery:GalleryNavigator.NavigateCommand}"
                    CommandParameter="selectors/tree-combo-box">
                    <ui:CardAction.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="28" Glyph="&#xE71A;" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="TreeComboBox" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Appearance="Secondary" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="层级树形结构下拉选择" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction
                    Width="260"
                    Height="80"
                    Margin="0,0,12,12"
                    Command="{x:Static gallery:GalleryNavigator.NavigateCommand}"
                    CommandParameter="selectors/value-picker">
                    <ui:CardAction.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="28" Glyph="&#xE81E;" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="ValuePicker" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Appearance="Secondary" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="多列滚轮选择器" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction
                    Width="260"
                    Height="80"
                    Margin="0,0,12,12"
                    Command="{x:Static gallery:GalleryNavigator.NavigateCommand}"
                    CommandParameter="selectors/color-picker">
                    <ui:CardAction.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="28" Glyph="&#xE790;" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="ColorPicker" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Appearance="Secondary" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="光谱 / 调色板颜色选择" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:CardAction>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
