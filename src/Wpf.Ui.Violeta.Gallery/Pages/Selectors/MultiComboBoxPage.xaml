<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Selectors.MultiComboBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="MultiComboBox"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock Margin="0,0,0,16" FontSize="20" FontWeight="SemiBold" Text="MultiComboBox" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="ItemsSource 绑定" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="支持多选、标签展示、搜索过滤。" />
                    <vio:MultiComboBox
                        x:Name="MultiComboBoxDemo"
                        MaxWidth="400"
                        HorizontalAlignment="Left"
                        SelectionChanged="MultiComboBoxDemo_OnSelectionChanged" />
                    <TextBlock
                        x:Name="MultiComboBoxResultText"
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="已选择：(无)" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="XAML 声明选项" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="直接在 XAML 中声明 MultiComboBoxItem。" />
                    <vio:MultiComboBox
                        Width="240"
                        MaxWidth="400"
                        MaxDropDownHeight="300"
                        HorizontalAlignment="Left">
                        <vio:MultiComboBoxItem Content="Option A" />
                        <vio:MultiComboBoxItem Content="Option B" />
                        <vio:MultiComboBoxItem Content="Option C" />
                        <vio:MultiComboBoxItem Content="Option D" />
                        <vio:MultiComboBoxItem Content="Option E" />
                    </vio:MultiComboBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
