<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Media.GravatarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_Gravatar}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_Gravatar}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Gravatar_Samples}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Gravatar_Samples_Desc}}"
                        TextWrapping="Wrap" />
                    <UniformGrid
                        Width="240"
                        Height="240"
                        HorizontalAlignment="Left"
                        Columns="3"
                        Rows="3">
                        <vio:Gravatar Id="User1" />
                        <vio:Gravatar Id="User2" />
                        <vio:Gravatar Id="User3" Style="{DynamicResource GravatarCircleStyle}" />
                        <vio:Gravatar Id="User4" />
                        <vio:Gravatar Id="User5" Style="{DynamicResource GravatarCircleStyle}" />
                        <vio:Gravatar Id="User6" />
                        <vio:Gravatar Id="User7" Style="{DynamicResource GravatarCircleStyle}" />
                        <vio:Gravatar Id="User8" />
                        <vio:Gravatar Id="User9" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Gravatar_Live}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Gravatar_Live_Desc}}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:Gravatar
                            Width="180"
                            Height="180"
                            Id="{Binding Text, ElementName=IdTextBox}"
                            Padding="14" />
                        <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,4"
                                Text="{I18N {x:Static lang:LangKeys.Gallery_Gravatar_IdLabel}}" />
                            <ui:TextBox
                                x:Name="IdTextBox"
                                Width="220"
                                Text="User1" />
                            <TextBlock
                                Margin="0,16,0,8"
                                Text="{I18N {x:Static lang:LangKeys.Gallery_Gravatar_Circle}}" />
                            <vio:Gravatar
                                Width="96"
                                Height="96"
                                Id="{Binding Text, ElementName=IdTextBox}"
                                Style="{DynamicResource GravatarCircleStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
