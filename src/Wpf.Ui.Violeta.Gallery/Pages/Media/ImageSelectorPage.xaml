<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Media.ImageSelectorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_ImageSelector}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,8"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_ImageSelector}}" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Sample_ImageSelector_Intro}}"
                TextWrapping="Wrap" />

            <!--  HC-style showcase: all variants centered  -->
            <Border
                Margin="0,0,0,16"
                Padding="32"
                MinHeight="220"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_ImageSelector_BasicTitle}}" />
                    <TextBlock
                        Margin="0,0,0,20"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_ImageSelector_BasicDesc}}"
                        TextWrapping="Wrap" />
                    <WrapPanel HorizontalAlignment="Center">
                        <vio:ImageSelector
                            Width="100"
                            Height="100"
                            Margin="16"
                            ImageSelected="OnImageSelected"
                            ImageUnselected="OnImageUnselected" />
                        <vio:ImageSelector
                            Width="100"
                            Height="100"
                            Margin="16"
                            CornerRadius="50"
                            ImageSelected="OnImageSelected"
                            ImageUnselected="OnImageUnselected" />
                        <vio:ImageSelector
                            Width="100"
                            Height="100"
                            Margin="16"
                            CornerRadius="50"
                            StrokeDashArray="10,5"
                            ImageSelected="OnImageSelected"
                            ImageUnselected="OnImageUnselected" />
                        <vio:ImageSelector
                            Width="100"
                            Height="100"
                            Margin="16"
                            BorderBrush="{DynamicResource SystemFillColorSuccessBrush}"
                            CornerRadius="50"
                            ImageSelected="OnImageSelected"
                            ImageUnselected="OnImageUnselected" />
                        <vio:ImageSelector
                            Width="100"
                            Height="100"
                            Margin="16"
                            BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                            CornerRadius="50"
                            StrokeDashArray="10,5,10"
                            ImageSelected="OnImageSelected"
                            ImageUnselected="OnImageUnselected" />
                        <vio:ImageSelector
                            Width="100"
                            Height="100"
                            Margin="16"
                            BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                            BorderThickness="2"
                            CornerRadius="10"
                            StrokeThickness="2"
                            ImageSelected="OnImageSelected"
                            ImageUnselected="OnImageUnselected" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!--  Interactive + event feedback  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_ImageSelector_EventsTitle}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_ImageSelector_EventsDesc}}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:ImageSelector
                            x:Name="DemoSelector"
                            Width="120"
                            Height="120"
                            Margin="0,0,24,0"
                            CornerRadius="12"
                            ImageSelected="OnDemoImageSelected"
                            ImageUnselected="OnDemoImageUnselected" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,8"
                                FontWeight="SemiBold"
                                Text="{I18N {x:Static lang:LangKeys.Sample_ImageSelector_StatusLabel}}" />
                            <TextBlock
                                x:Name="StatusText"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_ImageSelector_StatusIdle}}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
