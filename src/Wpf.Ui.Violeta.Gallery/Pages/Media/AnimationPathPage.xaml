        <Geometry x:Key="HeartGeometry">M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41 0.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z</Geometry>
    </vio:Page.Resources>
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_AnimationPath}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_AnimationPath_Basic}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_AnimationPath_Basic_Desc}}"
                        TextWrapping="Wrap" />
                    <Viewbox
                        Width="200"
                        Height="200"
                        HorizontalAlignment="Left">
                        <vio:AnimationPath
                            x:Name="DemoPath"
                            Width="1024"
                            Height="1024"
                            Data="{StaticResource GithubGeometry}"
                            Duration="0:0:6"
                            Stretch="Uniform"
                            Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                            StrokeThickness="10" />
                    </Viewbox>
                    <ui:Button
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left"
                        Click="OnTogglePlayingClick"
                        Content="{I18N {x:Static lang:LangKeys.Gallery_AnimationPath_TogglePlay}}" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_AnimationPath_HoldEnd}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_AnimationPath_HoldEnd_Desc}}"
                        TextWrapping="Wrap" />
                    <Viewbox
                        Width="160"
                        Height="160"
                        HorizontalAlignment="Left">
                        <vio:AnimationPath
                            Width="24"
                            Height="24"
                            Data="{StaticResource HeartGeometry}"
                            Duration="0:0:3"
                            FillBehavior="HoldEnd"
                            RepeatBehavior="Forever"
                            Stretch="Uniform"
                            Stroke="{DynamicResource SystemFillColorCriticalBrush}"
                            StrokeThickness="1.2" />
                    </Viewbox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
