<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Media.PersonPicturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="PersonPicture"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock Margin="0,0,0,16" FontSize="20" FontWeight="SemiBold" Text="PersonPicture" />
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock Margin="0,0,0,4" FontSize="14" FontWeight="SemiBold" Text="PersonPicture — 人物头像" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="支持显示名、缩写、角标与图片源。"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:PersonPicture
                            Margin="0,0,16,0"
                            BadgeGlyph="&#xE765;"
                            BadgeNumber="1"
                            DisplayName="James Bond"
                            Initials="JB" />
                        <vio:PersonPicture
                            Margin="0,0,16,0"
                            ProfilePicture="pack://application:,,,/Wpf.Ui.Violeta.Gallery;component/Resources/Images/ProfilePicture.ico" />
                        <vio:PersonPicture DisplayName="Alice" Initials="A" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
