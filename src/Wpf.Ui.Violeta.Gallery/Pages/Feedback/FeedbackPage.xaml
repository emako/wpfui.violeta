<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Feedback.FeedbackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:gallery="clr-namespace:Wpf.Ui.Violeta.Gallery"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Sample_450e7ae75d}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock Margin="0,0,0,16" FontSize="20" FontWeight="SemiBold" Text="{I18N {x:Static lang:LangKeys.Sample_450e7ae75d}}" />
            <TextBlock
                Margin="0,0,0,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Sample_ca4cd621e4}}"
                TextWrapping="Wrap" />
            <WrapPanel>
                <ui:CardAction
                    Width="260"
                    Height="80"
                    Margin="0,0,12,12"
                    Command="{x:Static gallery:GalleryNavigator.NavigateCommand}"
                    CommandParameter="feedback/transitioning-content-control">
                    <ui:CardAction.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="28" Glyph="&#xE8AB;" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{I18N {x:Static lang:LangKeys.Gallery_Page_TransitioningContentControl}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Appearance="Secondary" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{I18N {x:Static lang:LangKeys.Sample_e3bb7cc30f}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction
                    Width="260"
                    Height="80"
                    Margin="0,0,12,12"
                    Command="{x:Static gallery:GalleryNavigator.NavigateCommand}"
                    CommandParameter="feedback/running-block">
                    <ui:CardAction.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="28" Glyph="&#xE8CB;" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{I18N {x:Static lang:LangKeys.Gallery_Page_RunningBlock}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Appearance="Secondary" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{I18N {x:Static lang:LangKeys.Sample_c732c7aa7d}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction
                    Width="260"
                    Height="80"
                    Margin="0,0,12,12"
                    Command="{x:Static gallery:GalleryNavigator.NavigateCommand}"
                    CommandParameter="feedback/async-box">
                    <ui:CardAction.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="28" Glyph="&#xE895;" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{I18N {x:Static lang:LangKeys.Gallery_Page_AsyncBox}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Appearance="Secondary" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{I18N {x:Static lang:LangKeys.Sample_7c7205efaa}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction
                    Width="260"
                    Height="80"
                    Margin="0,0,12,12"
                    Command="{x:Static gallery:GalleryNavigator.NavigateCommand}"
                    CommandParameter="feedback/splash">
                    <ui:CardAction.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="28" Glyph="&#xE8B9;" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{I18N {x:Static lang:LangKeys.Gallery_Page_Splash}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Appearance="Secondary" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{I18N {x:Static lang:LangKeys.Sample_0954ff825c}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction
                    Width="260"
                    Height="80"
                    Margin="0,0,12,12"
                    Command="{x:Static gallery:GalleryNavigator.NavigateCommand}"
                    CommandParameter="feedback/exception-report">
                    <ui:CardAction.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="28" Glyph="&#xE783;" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{I18N {x:Static lang:LangKeys.Gallery_Page_ExceptionReport}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Appearance="Secondary" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{I18N {x:Static lang:LangKeys.Sample_576ff61712}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:CardAction>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
