<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Feedback.FeedbackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:ctrl="clr-namespace:Wpf.Ui.Violeta.Gallery.Controls"
    Title="反馈控件"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock Margin="0,0,0,16" FontSize="20" FontWeight="SemiBold" Text="反馈控件" />
            <TextBlock
                Margin="0,0,0,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="点击卡片进入对应控件演示页面。"
                TextWrapping="Wrap" />
            <WrapPanel>
                <ctrl:SampleCard
                    Width="260"
                    Title="TransitioningContentControl"
                    Description="内容切换过渡动画"
                    Glyph="&#xE8AB;"
                    NavigateTag="feedback/transitioning-content-control" />
                <ctrl:SampleCard
                    Width="260"
                    Title="RunningBlock"
                    Description="跑马灯滚动文本"
                    Glyph="&#xE8CB;"
                    NavigateTag="feedback/running-block" />
                <ctrl:SampleCard
                    Width="260"
                    Title="AsyncBox"
                    Description="异步内容加载容器"
                    Glyph="&#xE895;"
                    NavigateTag="feedback/async-box" />
                <ctrl:SampleCard
                    Width="260"
                    Title="Splash"
                    Description="启动闪屏"
                    Glyph="&#xE8B9;"
                    NavigateTag="feedback/splash" />
                <ctrl:SampleCard
                    Width="260"
                    Title="ExceptionReport"
                    Description="异常报告对话框"
                    Glyph="&#xE783;"
                    NavigateTag="feedback/exception-report" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
