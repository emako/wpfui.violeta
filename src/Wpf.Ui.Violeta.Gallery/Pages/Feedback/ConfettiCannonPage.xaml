<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Feedback.ConfettiCannonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_ConfettiCannon}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d"
    vio:ConfettiCannon.Token="ConfettiCannonDemo">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,8"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_ConfettiCannon}}" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Sample_ConfettiCannon_Intro}}"
                TextWrapping="Wrap" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_ConfettiCannon_PresetsTitle}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_ConfettiCannon_PresetsDesc}}"
                        TextWrapping="Wrap" />
                    <WrapPanel>
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ButtonBasicCannon_OnClick"
                            Content="{I18N {x:Static lang:LangKeys.Sample_ConfettiCannon_Basic}}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ButtonRandomDirection_OnClick"
                            Content="{I18N {x:Static lang:LangKeys.Sample_ConfettiCannon_Random}}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ButtonRealisticLook_OnClick"
                            Content="{I18N {x:Static lang:LangKeys.Sample_ConfettiCannon_Realistic}}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ButtonFireworks_OnClick"
                            Content="{I18N {x:Static lang:LangKeys.Sample_ConfettiCannon_Fireworks}}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ButtonStars_OnClick"
                            Content="{I18N {x:Static lang:LangKeys.Sample_ConfettiCannon_Stars}}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ButtonSnow_OnClick"
                            Content="{I18N {x:Static lang:LangKeys.Sample_ConfettiCannon_Snow}}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ButtonSchoolPride_OnClick"
                            Content="{I18N {x:Static lang:LangKeys.Sample_ConfettiCannon_SchoolPride}}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_ConfettiCannon_CanvasTitle}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_ConfettiCannon_CanvasDesc}}"
                        TextWrapping="Wrap" />
                    <ui:Button
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left"
                        Click="ButtonCustomCanvas_OnClick"
                        Content="{I18N {x:Static lang:LangKeys.Sample_ConfettiCannon_CustomCanvas}}" />
                    <vio:ConfettiCannonContainer>
                        <Border
                            MinWidth="320"
                            Height="240"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8" />
                    </vio:ConfettiCannonContainer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
