<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Feedback.TransitioningContentControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="TransitioningContentControl"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock Margin="0,0,0,16" FontSize="20" FontWeight="SemiBold" Text="TransitioningContentControl" />
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock Margin="0,0,0,4" FontSize="14" FontWeight="SemiBold" Text="TransitioningContentControl — 过渡内容" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="内容切换时播放过渡动画，支持多种动画方向。"
                        TextWrapping="Wrap" />
                    <Border
                        Height="60"
                        Margin="0,0,0,8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="6">
                        <vio:TransitioningContentControl
                            x:Name="TransitionContent"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Transition="Right">
                            <TextBlock
                                x:Name="TransitionText"
                                FontSize="16"
                                Text="Slide 1 — 欢迎使用 Violeta" />
                        </vio:TransitioningContentControl>
                    </Border>
                    <WrapPanel>
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="PrevSlide_Click"
                            Content="◀ 上一个" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="NextSlide_Click"
                            Content="下一个 ▶" />
                        <ComboBox
                            x:Name="TransitionTypeComboBox"
                            Margin="0,0,0,8"
                            SelectionChanged="TransitionType_SelectionChanged">
                            <ComboBoxItem Content="Right" IsSelected="True" Tag="Right" />
                            <ComboBoxItem Content="Left" Tag="Left" />
                            <ComboBoxItem Content="Up" Tag="Up" />
                            <ComboBoxItem Content="Down" Tag="Down" />
                            <ComboBoxItem Content="Normal" Tag="Normal" />
                        </ComboBox>
                    </WrapPanel>
                    <TextBlock
                        x:Name="TransitionStatusText"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Slide 1/4 | Right" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
