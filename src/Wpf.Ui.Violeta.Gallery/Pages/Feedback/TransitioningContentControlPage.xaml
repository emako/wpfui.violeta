<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Feedback.TransitioningContentControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="TransitioningContentControl"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock Margin="0,0,0,16" FontSize="20" FontWeight="SemiBold" Text="TransitioningContentControl" />
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock Margin="0,0,0,4" FontSize="14" FontWeight="SemiBold" Text="{I18N {x:Static lang:LangKeys.Sample_ed093b889a}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_a970d9d633}}"
                        TextWrapping="Wrap" />
                    <Border
                        Height="60"
                        Margin="0,0,0,8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="6">
                        <vio:TransitioningContentControl
                            x:Name="TransitionContent"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="{I18N {x:Static lang:LangKeys.Sample_05f27e568a}}"
                            RestartTransitionOnContentChange="True"
                            Transition="Right">
                            <vio:TransitioningContentControl.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="16" Text="{Binding}" />
                                </DataTemplate>
                            </vio:TransitioningContentControl.ContentTemplate>
                        </vio:TransitioningContentControl>
                    </Border>
                    <WrapPanel>
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="PrevSlide_Click"
                            Content="{I18N {x:Static lang:LangKeys.Sample_608443e0b4}}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="NextSlide_Click"
                            Content="{I18N {x:Static lang:LangKeys.Sample_7d817bc13f}}" />
                        <ComboBox
                            x:Name="TransitionTypeComboBox"
                            Margin="0,0,0,8"
                            SelectionChanged="TransitionType_SelectionChanged">
                            <ComboBoxItem Content="Right" IsSelected="True" Tag="Right" />
                            <ComboBoxItem Content="Left" Tag="Left" />
                            <ComboBoxItem Content="Up" Tag="Up" />
                            <ComboBoxItem Content="Down" Tag="Down" />
                            <ComboBoxItem Content="Normal" Tag="Normal" />
                        </ComboBox>
                    </WrapPanel>
                    <TextBlock
                        x:Name="TransitionStatusText"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Slide 1/4 | Right" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
