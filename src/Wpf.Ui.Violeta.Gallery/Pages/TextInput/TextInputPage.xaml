                    Margin="0,0,12,12"
                    Command="{x:Static gallery:GalleryNavigator.NavigateCommand}"
                    CommandParameter="basic-input/ipv4-box">
                    <ui:CardAction.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="28" Glyph="&#xE774;" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="IPv4Box" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
