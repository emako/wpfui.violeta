<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Design.ThemeColorApproachPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_ThemeColorApproach}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <vio:Page.Resources>
        <vio:ToBrushConverter x:Key="ToBrushConverter" />
    </vio:Page.Resources>
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,8"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_ThemeColorApproach}}" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeColor_Desc}}"
                TextWrapping="Wrap" />

            <!-- Light → Dark -->
            <TextBlock
                Margin="0,0,0,8"
                FontSize="16"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeColor_LightToDark}}" />
            <TextBlock
                Margin="0,0,0,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeColor_LightToDark_Desc}}"
                TextWrapping="Wrap" />

            <Border
                Margin="0,0,0,20"
                Padding="16"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeColor_PickLight}}" />
                        <vio:ColorPicker
                            Color="{Binding LightColor, Mode=TwoWay}"
                            IsAlphaEnabled="True"
                            IsAlphaVisible="True"
                            IsHexInputVisible="True" />
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeColor_BaseL}}" />
                            <ui:NumberBox
                                MaxDecimalPlaces="3"
                                Maximum="99.9"
                                Minimum="0"
                                Value="{Binding BaseL, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeColor_BaseL_Hint}}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <UniformGrid
                        Grid.Column="1"
                        Columns="2"
                        Rows="1">
                        <Border
                            Margin="0,0,8,0"
                            Padding="16"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontWeight="SemiBold"
                                    Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeColor_LightSwatch}}" />
                                <Border
                                    Height="96"
                                    Background="{Binding LightColor, Converter={StaticResource ToBrushConverter}}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8" />
                                <vio:SelectableTextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="Consolas"
                                    Text="{Binding LightHex, Mode=OneWay}" />
                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeColor_IsLight}}" />
                                    <Run Text=": " />
                                    <Run Text="{Binding IsLightText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="8,0,0,0"
                            Padding="16"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontWeight="SemiBold"
                                    Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeColor_DarkSwatch}}" />
                                <Border
                                    Height="96"
                                    Background="{Binding DarkColor, Converter={StaticResource ToBrushConverter}}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8" />
                                <vio:SelectableTextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="Consolas"
                                    Text="{Binding DarkHex, Mode=OneWay}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeColor_AutoCalc}}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Accent palette -->
            <TextBlock
                Margin="0,8,0,8"
                FontSize="16"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeColor_AccentPalette}}" />
            <TextBlock
                Margin="0,0,0,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeColor_AccentPalette_Desc}}"
                TextWrapping="Wrap" />

            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <UniformGrid Columns="7">
                    <StackPanel Margin="0,0,6,0">
                        <Border
                            Height="56"
                            Background="{Binding AccentLight3, Converter={StaticResource ToBrushConverter}}"
                            CornerRadius="6,0,0,6" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="11"
                            Text="Light3"
                            TextAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,0">
                        <Border Height="56" Background="{Binding AccentLight2, Converter={StaticResource ToBrushConverter}}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="11"
                            Text="Light2"
                            TextAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,0">
                        <Border Height="56" Background="{Binding AccentLight1, Converter={StaticResource ToBrushConverter}}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="11"
                            Text="Light1"
                            TextAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,0">
                        <Border Height="56" Background="{Binding AccentBase, Converter={StaticResource ToBrushConverter}}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="Accent"
                            TextAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,0">
                        <Border Height="56" Background="{Binding AccentDark1, Converter={StaticResource ToBrushConverter}}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="11"
                            Text="Dark1"
                            TextAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,0">
                        <Border Height="56" Background="{Binding AccentDark2, Converter={StaticResource ToBrushConverter}}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="11"
                            Text="Dark2"
                            TextAlignment="Center" />
                    </StackPanel>
                    <StackPanel>
                        <Border
                            Height="56"
                            Background="{Binding AccentDark3, Converter={StaticResource ToBrushConverter}}"
                            CornerRadius="0,6,6,0" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="11"
                            Text="Dark3"
                            TextAlignment="Center" />
                    </StackPanel>
                </UniformGrid>
            </Border>

            <TextBlock
                Margin="0,0,0,8"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeColor_PrimaryAccent}}" />
            <TextBlock
                Margin="0,0,0,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeColor_PrimaryAccent_Desc}}"
                TextWrapping="Wrap" />

            <UniformGrid Columns="2">
                <Border
                    Margin="0,0,8,0"
                    Padding="16"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeColor_PrimaryForLight}}" />
                        <Border
                            Height="48"
                            Background="{Binding PrimaryAccentLight, Converter={StaticResource ToBrushConverter}}"
                            CornerRadius="6" />
                    </StackPanel>
                </Border>
                <Border
                    Margin="8,0,0,0"
                    Padding="16"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeColor_PrimaryForDark}}" />
                        <Border
                            Height="48"
                            Background="{Binding PrimaryAccentDark, Converter={StaticResource ToBrushConverter}}"
                            CornerRadius="6" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
