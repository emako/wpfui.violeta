<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Design.ThemeBrushPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_ThemeBrush}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,8"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_ThemeBrush}}" />
            <TextBlock
                Margin="0,0,0,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeBrush_Desc}}"
                TextWrapping="Wrap" />

            <ui:Button
                Margin="0,0,0,20"
                HorizontalAlignment="Left"
                Appearance="Primary"
                Click="OnToggleThemeClick"
                Content="{I18N {x:Static lang:LangKeys.Gallery_ThemeRefresh_ToggleTheme}}" />

            <UniformGrid Columns="3">
                <Border
                    Margin="0,0,8,0"
                    Padding="20"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeBrush_ColorString}}" />
                        <TextBlock
                            Margin="0,0,0,12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeBrush_ColorString_Desc}}"
                            TextWrapping="Wrap" />
                        <Border
                            Width="160"
                            Height="72"
                            HorizontalAlignment="Left"
                            BorderThickness="3"
                            CornerRadius="8">
                            <Border.Background>
                                <vio:ThemeBrush Light="#FFCCE5FF" Dark="#FF1A3A5C" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <vio:ThemeBrush Light="#999999" Dark="#666666" />
                            </Border.BorderBrush>
                        </Border>
                    </StackPanel>
                </Border>

                <Border
                    Margin="4,0,4,0"
                    Padding="20"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeBrush_DynamicResource}}" />
                        <TextBlock
                            Margin="0,0,0,12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeBrush_DynamicResource_Desc}}"
                            TextWrapping="Wrap" />
                        <Border
                            Width="160"
                            Height="72"
                            HorizontalAlignment="Left"
                            BorderThickness="3"
                            CornerRadius="8">
                            <Border.Background>
                                <vio:ThemeBrush
                                    Light="{DynamicResource AccentFillColorDefaultBrush}"
                                    Dark="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <vio:ThemeBrush
                                    Light="{DynamicResource ControlElevationBorderBrush}"
                                    Dark="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            </Border.BorderBrush>
                        </Border>
                    </StackPanel>
                </Border>

                <Border
                    Margin="8,0,0,0"
                    Padding="20"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeBrush_Mixed}}" />
                        <TextBlock
                            Margin="0,0,0,12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Gallery_ThemeBrush_Mixed_Desc}}"
                            TextWrapping="Wrap" />
                        <Border
                            Width="160"
                            Height="72"
                            HorizontalAlignment="Left"
                            BorderThickness="3"
                            CornerRadius="8">
                            <Border.Background>
                                <vio:ThemeBrush Light="#FFFFFFFF" Dark="{DynamicResource ApplicationBackgroundBrush}" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <vio:ThemeBrush Light="{DynamicResource ControlElevationBorderBrush}" Dark="#888888" />
                            </Border.BorderBrush>
                        </Border>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
