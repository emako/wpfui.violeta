                            Height="1"
                            Margin="0,4,0,4"
                            Background="{DynamicResource LeftNavigationViewSeparatorBrush}" />
                        <vio:SelectableTextBlock
                            Margin="0,8,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="LeftNavigationViewSeparatorBrush" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Margin="0,16,0,0"
