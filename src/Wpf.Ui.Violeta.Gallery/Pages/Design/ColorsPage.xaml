                Text="Special brushes and common sample-card combinations used across the Gallery."
                TextWrapping="Wrap" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    MinHeight="140"
                    Padding="12"
                    Background="{DynamicResource StripedBackgroundBrush}"
