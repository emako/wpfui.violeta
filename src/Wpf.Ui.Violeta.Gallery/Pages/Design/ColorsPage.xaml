<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Design.ColorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="Colors"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,8"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Colors" />
            <TextBlock
                Margin="0,0,0,8"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Sample_b248c77928}}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,0,0,24"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="The colors below are provided as part of WPF UI. Reference them with DynamicResource bindings."
                TextWrapping="Wrap" />

            <!-- Text -->
            <TextBlock
                Margin="0,0,0,0"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Text" />
            <Border
                Margin="0,12,0,0"
                Padding="12"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="For UI labels and static text" />
                    <TextBlock
                        Margin="0,12,0,12"
                        HorizontalAlignment="Center"
                        FontSize="42"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Aa" />
                </StackPanel>
            </Border>
            <Grid MinHeight="120" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Background="{DynamicResource TextFillColorPrimaryBrush}"
                    CornerRadius="8,0,0,8"
                    TextElement.Foreground="{DynamicResource TextFillColorInverseBrush}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Text / Primary" />
                        <TextBlock Grid.Row="1" Text="Rest or hover" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="TextFillColorPrimaryBrush" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="1"
                    Background="{DynamicResource TextFillColorSecondaryBrush}"
                    TextElement.Foreground="{DynamicResource TextFillColorInverseBrush}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Text / Secondary" />
                        <TextBlock Grid.Row="1" Text="Rest or hover" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="TextFillColorSecondaryBrush" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="2"
                    Background="{DynamicResource TextFillColorTertiaryBrush}"
                    TextElement.Foreground="{DynamicResource TextFillColorInverseBrush}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Text / Tertiary" />
                        <TextBlock Grid.Row="1" Text="Pressed only" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="TextFillColorTertiaryBrush" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="3"
                    Background="{DynamicResource TextFillColorDisabledBrush}"
                    CornerRadius="0,8,8,0"
                    TextElement.Foreground="{DynamicResource TextFillColorInverseBrush}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Text / Disabled" />
                        <TextBlock Grid.Row="1" Text="Disabled only" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="TextFillColorDisabledBrush" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Accent Text -->
            <TextBlock
                Margin="0,48,0,0"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Accent Text" />
            <Border
                Margin="0,12,0,0"
                Padding="12"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Recommended for links" />
                    <TextBlock
                        Margin="0,12,0,12"
                        HorizontalAlignment="Center"
                        FontSize="42"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Text="Aa" />
                </StackPanel>
            </Border>
            <Grid MinHeight="120" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Background="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    CornerRadius="8,0,0,8"
                    TextElement.Foreground="{DynamicResource TextFillColorInverseBrush}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Accent Text / Primary" />
                        <TextBlock Grid.Row="1" Text="Rest or hover" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="AccentTextFillColorPrimaryBrush" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="1"
                    Background="{DynamicResource AccentTextFillColorSecondaryBrush}"
                    TextElement.Foreground="{DynamicResource TextFillColorInverseBrush}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Accent Text / Secondary" />
                        <TextBlock Grid.Row="1" Text="Rest or hover" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="AccentTextFillColorSecondaryBrush" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="2"
                    Background="{DynamicResource AccentTextFillColorTertiaryBrush}"
                    TextElement.Foreground="{DynamicResource TextFillColorInverseBrush}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Accent Text / Tertiary" />
                        <TextBlock Grid.Row="1" Text="Pressed only" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="AccentTextFillColorTertiaryBrush" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="3"
                    Background="{DynamicResource AccentTextFillColorDisabledBrush}"
                    CornerRadius="0,8,8,0"
                    TextElement.Foreground="{DynamicResource TextFillColorInverseBrush}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Accent Text / Disabled" />
                        <TextBlock Grid.Row="1" Text="Disabled only" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="AccentTextFillColorDisabledBrush" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Text on Accent -->
            <TextBlock
                Margin="0,48,0,0"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Text on Accent" />
            <Border
                Margin="0,12,0,0"
                Padding="12"
                Background="{DynamicResource AccentFillColorDefaultBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="Used on accent-colored surfaces" />
                    <TextBlock
                        Margin="0,12,0,12"
                        HorizontalAlignment="Center"
                        FontSize="42"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                        Text="Aa" />
                </StackPanel>
            </Border>
            <Grid MinHeight="120" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    CornerRadius="8,0,0,8">
                    <Grid Margin="12" TextElement.Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="On Accent / Primary" />
                        <TextBlock Grid.Row="1" Text="Rest" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="TextOnAccentFillColorPrimaryBrush" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <Grid Margin="12" TextElement.Foreground="{DynamicResource TextOnAccentFillColorSecondaryBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="On Accent / Secondary" />
                        <TextBlock Grid.Row="1" Text="Secondary" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="TextOnAccentFillColorSecondaryBrush" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <Grid Margin="12" TextElement.Foreground="{DynamicResource TextOnAccentFillColorDisabledBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="On Accent / Disabled" />
                        <TextBlock Grid.Row="1" Text="Disabled" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="TextOnAccentFillColorDisabledBrush" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="3"
                    Background="{DynamicResource AccentFillColorSelectedTextBackgroundBrush}"
                    CornerRadius="0,8,8,0">
                    <Grid Margin="12" TextElement.Foreground="{DynamicResource TextOnAccentFillColorSelectedTextBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="On Accent / Selected" />
                        <TextBlock Grid.Row="1" Text="Selected text" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="TextOnAccentFillColorSelectedTextBrush" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Accent Fill -->
            <TextBlock
                Margin="0,48,0,0"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Accent Fill" />
            <Grid MinHeight="120" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    CornerRadius="8,0,0,8"
                    TextElement.Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Accent / Default" />
                        <TextBlock Grid.Row="1" Text="Rest" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="AccentFillColorDefaultBrush" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="1"
                    Background="{DynamicResource AccentFillColorSecondaryBrush}"
                    TextElement.Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Accent / Secondary" />
                        <TextBlock Grid.Row="1" Text="Hover" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="AccentFillColorSecondaryBrush" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="2"
                    Background="{DynamicResource AccentFillColorTertiaryBrush}"
                    TextElement.Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Accent / Tertiary" />
                        <TextBlock Grid.Row="1" Text="Pressed" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="AccentFillColorTertiaryBrush" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="3"
                    Background="{DynamicResource AccentFillColorDisabledBrush}"
                    CornerRadius="0,8,8,0"
                    TextElement.Foreground="{DynamicResource TextFillColorInverseBrush}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Accent / Disabled" />
                        <TextBlock Grid.Row="1" Text="Disabled" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="AccentFillColorDisabledBrush" />
                    </Grid>
                </Border>
            </Grid>

            <!-- System Accent -->
            <TextBlock
                Margin="0,48,0,0"
                FontSize="16"
                FontWeight="SemiBold"
                Text="System Accent" />
            <Grid MinHeight="120" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Background="{DynamicResource SystemAccentBrush}"
                    CornerRadius="8,0,0,8"
                    TextElement.Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="System Accent" />
                        <TextBlock Grid.Row="1" Text="Base" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="SystemAccentBrush" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="1"
                    TextElement.Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource SystemAccentColorPrimary}" />
                    </Border.Background>
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Primary" />
                        <TextBlock Grid.Row="1" Text="Color key" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="SystemAccentColorPrimary" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="2"
                    TextElement.Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                    </Border.Background>
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Secondary" />
                        <TextBlock Grid.Row="1" Text="Color key" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="SystemAccentColorSecondary" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="3"
                    CornerRadius="0,8,8,0"
                    TextElement.Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource SystemAccentColorTertiary}" />
                    </Border.Background>
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Tertiary" />
                        <TextBlock Grid.Row="1" Text="Color key" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="SystemAccentColorTertiary" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Control Fill -->
            <TextBlock
                Margin="0,48,0,0"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Control Fill" />
            <Grid MinHeight="120" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8,0,0,8">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Default" />
                        <TextBlock Grid.Row="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Rest" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="ControlFillColorDefaultBrush" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="1"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,1">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Secondary" />
                        <TextBlock Grid.Row="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Hover" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="ControlFillColorSecondaryBrush" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="2"
                    Background="{DynamicResource ControlFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,1">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Tertiary" />
                        <TextBlock Grid.Row="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Pressed" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="ControlFillColorTertiaryBrush" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="3"
                    Background="{DynamicResource ControlFillColorDisabledBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,1">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Disabled" />
                        <TextBlock Grid.Row="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Disabled" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="ControlFillColorDisabledBrush" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="4"
                    Background="{DynamicResource ControlFillColorInputActiveBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0,8,8,0">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Input Active" />
                        <TextBlock Grid.Row="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Focused input" />
                        <vio:SelectableTextBlock Grid.Row="2" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Grid}}" TextWrapping="Wrap" Text="ControlFillColorInputActiveBrush" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Control Strong / Solid / Subtle -->
            <TextBlock
                Margin="0,48,0,0"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Control Strong / Solid / Subtle" />
            <Grid MinHeight="120" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                    CornerRadius="8,0,0,8"
                    TextElement.Foreground="{DynamicResource TextFillColorInverseBrush}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Strong / Default" />
                        <TextBlock Grid.Row="1" Text="Strong fill" />
