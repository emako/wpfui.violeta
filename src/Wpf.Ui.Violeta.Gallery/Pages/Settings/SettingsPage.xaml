<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Settings}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_Title}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_Language}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_Language_Desc}}"
                        TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Gallery_Language}}" />
                        <ComboBox
                            x:Name="LanguageComboBox"
                            Grid.Column="1"
                            MinWidth="180"
                            HorizontalAlignment="Left"
                            SelectionChanged="LanguageComboBox_OnSelectionChanged">
                            <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_1e81fc32fe}}" Tag="zh-Hans" />
                            <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_d0bb8c23f6}}" Tag="zh-Hant" />
                            <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_78463a384a}}" Tag="en" />
                            <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_f32ced6a9b}}" Tag="ja" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_Appearance}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_Appearance_Desc}}"
                        TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Gallery_Theme}}" />
                        <ComboBox
                            x:Name="ThemeComboBox"
                            Grid.Column="1"
                            MinWidth="180"
                            HorizontalAlignment="Left"
                            SelectionChanged="ThemeComboBox_OnSelectionChanged">
                            <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Gallery_Theme_System}}" />
                            <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Gallery_Theme_Dark}}" IsSelected="True" />
                            <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Gallery_Theme_Light}}" />
                        </ComboBox>
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,12,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_Backdrop}}" />
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,12,0,0"
                            Orientation="Horizontal">
                            <ComboBox
                                x:Name="BackdropComboBox"
                                MinWidth="180"
                                VerticalAlignment="Center"
                                SelectionChanged="BackdropComboBox_OnSelectionChanged">
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Gallery_Settings_Backdrop_None}}" Tag="None" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Gallery_Settings_Backdrop_Auto}}" Tag="Auto" />
                                <ComboBoxItem
                                    Content="{I18N {x:Static lang:LangKeys.Sample_097ea7163a}}"
                                    IsSelected="True"
                                    Tag="Mica" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_920809ad6f}}" Tag="Acrylic" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_5a9bcd254e}}" Tag="Tabbed" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_78a7ffd4c6}}" Tag="Acrylic10" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_b5ea8ebb08}}" Tag="Acrylic11" />
                            </ComboBox>
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_Backdrop_Experimental}}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            Grid.Row="2"
                            Margin="0,16,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_FollowSystemAccent}}" />
                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,16,0,0"
                            Orientation="Horizontal">
                            <ui:ToggleSwitch
                                x:Name="FollowSystemAccentToggle"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Checked="FollowSystemAccentToggle_OnChanged"
                                Unchecked="FollowSystemAccentToggle_OnChanged" />
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_Backdrop_Experimental}}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            Grid.Row="3"
                            Margin="0,16,0,0"
                            VerticalAlignment="Top"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_AccentColor}}" />
                        <StackPanel
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="0,12,0,0"
                            Orientation="Horizontal">
                        <WrapPanel
                            x:Name="AccentSwatchPanel">
                            <vio:Swatch
                                Width="32"
                                Height="32"
                                Margin="0,4,8,4"
                                Click="AccentSwatch_OnClick"
                                CornerRadius="6"
                                ToolTip="{I18N {x:Static lang:LangKeys.Sample_9c9aabab3f}}"
                                Color="#0078D4"
                                Value="#0078D4" />
                            <vio:Swatch
                                Width="32"
                                Height="32"
                                Margin="0,4,8,4"
                                Click="AccentSwatch_OnClick"
                                CornerRadius="6"
                                ToolTip="{I18N {x:Static lang:LangKeys.Sample_b9ba865fec}}"
                                Color="#8764B8"
                                Value="#8764B8" />
                            <vio:Swatch
                                Width="32"
                                Height="32"
                                Margin="0,4,8,4"
                                Click="AccentSwatch_OnClick"
                                CornerRadius="6"
                                ToolTip="{I18N {x:Static lang:LangKeys.Sample_e20385a2b4}}"
                                Color="#00B7C3"
                                Value="#00B7C3" />
                            <vio:Swatch
                                Width="32"
                                Height="32"
                                Margin="0,4,8,4"
                                Click="AccentSwatch_OnClick"
                                CornerRadius="6"
                                ToolTip="{I18N {x:Static lang:LangKeys.Sample_d382816a3c}}"
                                Color="#107C10"
                                Value="#107C10" />
                            <vio:Swatch
                                Width="32"
                                Height="32"
                                Margin="0,4,8,4"
                                Click="AccentSwatch_OnClick"
                                CornerRadius="6"
                                ToolTip="{I18N {x:Static lang:LangKeys.Sample_51e6cd92b6}}"
                                Color="#FFB900"
                                Value="#FFB900" />
                            <vio:Swatch
                                Width="32"
                                Height="32"
                                Margin="0,4,8,4"
                                Click="AccentSwatch_OnClick"
                                CornerRadius="6"
                                ToolTip="{I18N {x:Static lang:LangKeys.Sample_ee38e4d5dd}}"
                                Color="#D13438"
                                Value="#D13438" />
                            <vio:Swatch
                                Width="32"
                                Height="32"
                                Margin="0,4,8,4"
                                Click="AccentSwatch_OnClick"
                                CornerRadius="6"
                                ToolTip="{I18N {x:Static lang:LangKeys.Sample_909cea0c97}}"
                                Color="#FF8C00"
                                Value="#FF8C00" />
                            <vio:Swatch
                                Width="32"
                                Height="32"
                                Margin="0,4,8,4"
                                Click="AccentSwatch_OnClick"
                                CornerRadius="6"
                                ToolTip="{I18N {x:Static lang:LangKeys.Sample_b91cc2c141}}"
                                Color="#E3008C"
                                Value="#E3008C" />
                        </WrapPanel>
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_Backdrop_Experimental}}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_CloseToTray}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_CloseToTray_Desc}}"
                        TextWrapping="Wrap" />
                    <ui:ToggleSwitch
                        x:Name="CloseToTrayToggle"
                        HorizontalAlignment="Left"
                        Checked="CloseToTrayToggle_OnChanged"
                        Unchecked="CloseToTrayToggle_OnChanged" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_About}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_About_Desc}}"
                        TextWrapping="Wrap" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_LibraryVersion}}" />
                        <TextBlock
                            x:Name="LibraryVersionText"
                            Grid.Column="1"
                            Text="{I18N {x:Static lang:LangKeys.Sample_dfba37c389}}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_Runtime}}" />
                        <TextBlock
                            x:Name="RuntimeVersionText"
                            Grid.Column="1"
                            Text="-" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <ui:FontIcon
                        HorizontalAlignment="Left"
                        FontFamily="{DynamicResource SymbolThemeFontFamily}"
                        FontSize="20"
                        Glyph="&#xE713;" />
                    <TextBlock
                        Margin="0,10,0,0"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_NavItem}}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_NavItem_Desc}}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
