                        <ui:TextBlock Appearance="Secondary" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{I18N {x:Static lang:LangKeys.Gallery_Home_Status_Desc}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
