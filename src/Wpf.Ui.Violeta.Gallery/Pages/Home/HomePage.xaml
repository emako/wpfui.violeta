                    </ui:CardAction.Icon>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{I18N {x:Static lang:LangKeys.Gallery_Nav_TextInput}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
