                    </ui:CardAction.Icon>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{I18N {x:Static lang:LangKeys.Gallery_Nav_NumberInput}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Appearance="Secondary" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{I18N {x:Static lang:LangKeys.Gallery_Home_NumberInput_Desc}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
