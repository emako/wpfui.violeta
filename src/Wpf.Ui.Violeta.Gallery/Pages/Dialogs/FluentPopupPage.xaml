<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Dialogs.FluentPopupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_FluentPopup}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_FluentPopup}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Page_FluentPopup}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_8187a6e35a}}" />

                    <!--
                        FluentWpfCore demo uses a bright host (#CC6699FF). Acrylic over a same-tone
                        dark card looks solid even when blur works — stage a colorful field so the
                        frosted glass is obvious in both light and dark themes.
                    -->
                    <Border
                        Padding="16"
                        Background="#CC6699FF"
                        CornerRadius="8">
                        <ui:StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel>
                                <TextBlock Foreground="#E0FFFFFF" Text="{I18N {x:Static lang:LangKeys.Sample_6160a53ece}}" />
                                <ToggleButton
                                    x:Name="PopupSlideToggle"
                                    Margin="0,4,0,0"
                                    Content="{I18N {x:Static lang:LangKeys.Sample_5eab39ac7f}}" />
                                <vio:FluentPopup
                                    Background="{DynamicResource FluentPopupBackground}"
                                    ExtPopupAnimation="Slide"
                                    IsOpen="{Binding IsChecked, ElementName=PopupSlideToggle, Mode=TwoWay}"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=PopupSlideToggle}"
                                    StaysOpen="False"
                                    WindowCorner="Round">
                                    <Grid Width="180" Height="120" Background="Transparent">
                                        <StackPanel Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{I18N {x:Static lang:LangKeys.Sample_e74a0d0f02}}"
                                                TextAlignment="Center" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{I18N {x:Static lang:LangKeys.Sample_53fe1601e3}}"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </vio:FluentPopup>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Foreground="#E0FFFFFF" Text="{I18N {x:Static lang:LangKeys.Sample_04e0385c10}}" />
                                <ToggleButton
                                    x:Name="PopupFadeToggle"
                                    Margin="0,4,0,0"
                                    Content="{I18N {x:Static lang:LangKeys.Sample_eb71826e17}}" />
                                <vio:FluentPopup
                                    Background="{DynamicResource FluentPopupBackground}"
                                    ExtPopupAnimation="Fade"
                                    IsOpen="{Binding IsChecked, ElementName=PopupFadeToggle, Mode=TwoWay}"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=PopupFadeToggle}"
                                    StaysOpen="False"
                                    WindowCorner="Round">
                                    <Grid Width="180" Height="120" Background="Transparent">
                                        <StackPanel Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{I18N {x:Static lang:LangKeys.Sample_e74a0d0f02}}"
                                                TextAlignment="Center" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{I18N {x:Static lang:LangKeys.Sample_2d81d2656d}}"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </vio:FluentPopup>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Foreground="#E0FFFFFF" Text="{I18N {x:Static lang:LangKeys.Sample_7dcc93b8e7}}" />
                                <ToggleButton
                                    x:Name="PopupNoneToggle"
                                    Margin="0,4,0,0"
                                    Content="{I18N {x:Static lang:LangKeys.Sample_02922129e5}}" />
                                <vio:FluentPopup
                                    Background="#3300AAFF"
                                    ExtPopupAnimation="None"
                                    IsOpen="{Binding IsChecked, ElementName=PopupNoneToggle, Mode=TwoWay}"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=PopupNoneToggle}"
                                    StaysOpen="False"
                                    WindowCorner="Round">
                                    <Grid Width="180" Height="120" Background="Transparent">
                                        <StackPanel Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{I18N {x:Static lang:LangKeys.Sample_e74a0d0f02}}"
                                                TextAlignment="Center" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{I18N {x:Static lang:LangKeys.Sample_b98b98380c}}"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </vio:FluentPopup>
                            </StackPanel>
                        </ui:StackPanel>
                    </Border>

                    <TextBlock
                        Margin="0,16,0,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Material (Win11)" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Mica / MicaAlt / SystemAcrylic use DWM system backdrop (desktop wallpaper) — independent of host fill color. Requires Windows 11 22621+."
                        TextWrapping="Wrap" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Mica" />
                            <ToggleButton
                                x:Name="PopupMicaToggle"
                                Margin="0,4,0,0"
                                Content="Open Mica" />
                            <vio:FluentPopup
                                Background="Transparent"
                                ExtPopupAnimation="None"
                                IsOpen="{Binding IsChecked, ElementName=PopupMicaToggle, Mode=TwoWay}"
                                Material="Mica"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=PopupMicaToggle}"
                                StaysOpen="False"
                                WindowCorner="Round">
                                <Grid Width="180" Height="120" Background="Transparent">
                                    <StackPanel Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="Mica" TextAlignment="Center" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="DWMSBT_MAINWINDOW"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </vio:FluentPopup>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Mica Alt" />
                            <ToggleButton
                                x:Name="PopupMicaAltToggle"
                                Margin="0,4,0,0"
                                Content="Open Mica Alt" />
                            <vio:FluentPopup
                                Background="Transparent"
                                ExtPopupAnimation="None"
                                IsOpen="{Binding IsChecked, ElementName=PopupMicaAltToggle, Mode=TwoWay}"
                                Material="MicaAlt"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=PopupMicaAltToggle}"
                                StaysOpen="False"
                                WindowCorner="Round">
                                <Grid Width="180" Height="120" Background="Transparent">
                                    <StackPanel Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="Mica Alt" TextAlignment="Center" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="DWMSBT_TABBEDWINDOW"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </vio:FluentPopup>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="System Acrylic" />
                            <ToggleButton
                                x:Name="PopupSystemAcrylicToggle"
                                Margin="0,4,0,0"
                                Content="Open System Acrylic" />
                            <vio:FluentPopup
                                Background="Transparent"
                                ExtPopupAnimation="None"
                                IsOpen="{Binding IsChecked, ElementName=PopupSystemAcrylicToggle, Mode=TwoWay}"
                                Material="SystemAcrylic"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=PopupSystemAcrylicToggle}"
                                StaysOpen="False"
                                WindowCorner="Round">
                                <Grid Width="180" Height="120" Background="Transparent">
                                    <StackPanel Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="System Acrylic" TextAlignment="Center" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="DWMSBT_TRANSIENTWINDOW"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </vio:FluentPopup>
                        </StackPanel>
                    </ui:StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
