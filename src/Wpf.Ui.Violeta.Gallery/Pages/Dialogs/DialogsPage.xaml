<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Dialogs.DialogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:ctrl="clr-namespace:Wpf.Ui.Violeta.Gallery.Controls"
    Title="对话框"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock Margin="0,0,0,16" FontSize="20" FontWeight="SemiBold" Text="对话框" />
            <TextBlock
                Margin="0,0,0,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="点击卡片进入对应控件演示页面。"
                TextWrapping="Wrap" />
            <WrapPanel>
                <ctrl:SampleCard
                    Width="260"
                    Title="ContentDialog"
                    Description="异步内容对话框"
                    Glyph="&#xE8BD;"
                    NavigateTag="dialogs/content-dialog" />
                <ctrl:SampleCard
                    Width="260"
                    Title="MessageBox"
                    Description="带图标的消息框"
                    Glyph="&#xE8F2;"
                    NavigateTag="dialogs/message-box" />
                <ctrl:SampleCard
                    Width="260"
                    Title="PendingBox"
                    Description="异步等待对话框"
                    Glyph="&#xE916;"
                    NavigateTag="dialogs/pending-box" />
                <ctrl:SampleCard
                    Width="260"
                    Title="TaskDialog"
                    Description="原生 Win32 TaskDialog"
                    Glyph="&#xE8BD;"
                    NavigateTag="dialogs/task-dialog" />
                <ctrl:SampleCard
                    Width="260"
                    Title="NativeMessageBox"
                    Description="原生 Win32 MessageBox"
                    Glyph="&#xE8F2;"
                    NavigateTag="dialogs/native-message-box" />
                <ctrl:SampleCard
                    Width="260"
                    Title="CredentialDialog"
                    Description="Windows 安全凭据对话框"
                    Glyph="&#xE72E;"
                    NavigateTag="dialogs/credential-dialog" />
                <ctrl:SampleCard
                    Width="260"
                    Title="OpenFolderDialog"
                    Description="原生文件夹选择对话框"
                    Glyph="&#xE8B7;"
                    NavigateTag="dialogs/open-folder-dialog" />
                <ctrl:SampleCard
                    Width="260"
                    Title="Flyout"
                    Description="ui:Flyout 弹出层"
                    Glyph="&#xE71B;"
                    NavigateTag="dialogs/flyout" />
                <ctrl:SampleCard
                    Width="260"
                    Title="FluentPopup"
                    Description="Fluent 风格弹出层"
                    Glyph="&#xE71B;"
                    NavigateTag="dialogs/fluent-popup" />
                <ctrl:SampleCard
                    Width="260"
                    Title="TeachingTip"
                    Description="教学提示浮层"
                    Glyph="&#xE8BD;"
                    NavigateTag="dialogs/teaching-tip" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
