<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Dialogs.CredentialDialogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="CredentialDialog"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock Margin="0,0,0,16" FontSize="20" FontWeight="SemiBold" Text="CredentialDialog" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Windows Security CredentialDialog" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="基于 CredUIPromptForWindowsCredentials 的 Windows 安全凭据对话框，支持保存密码、凭据缓存与 Windows 凭据管理器读写。" />
                    <TextBlock
                        Margin="0,0,0,8"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="Target（凭据目标名）" />
                    <ui:TextBox
                        x:Name="TargetTextBox"
                        Margin="0,0,0,12"
                        Text="Wpf.Ui.Violeta.Gallery.Sample" />
                    <WrapPanel>
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ShowCredentialDialog_Click"
                            Content="输入凭据"
                            Tag="Prompt" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ShowCredentialDialog_Click"
                            Content="可保存密码"
                            Tag="SaveChecked" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ShowCredentialDialog_Click"
                            Content="使用应用缓存"
                            Tag="AppCache" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,12,0,8"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="凭据管理" />
                    <WrapPanel>
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ShowCredentialDialog_Click"
                            Content="读取已保存凭据"
                            Tag="Retrieve" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ShowCredentialDialog_Click"
                            Content="删除凭据"
                            Tag="Delete" />
                    </WrapPanel>
                    <TextBlock
                        x:Name="CredentialDialogResultText"
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="结果：(等待操作)" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
