<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Dialogs.CredentialDialogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_CredentialDialog}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock Margin="0,0,0,16" FontSize="20" FontWeight="SemiBold" Text="{I18N {x:Static lang:LangKeys.Gallery_Page_CredentialDialog}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_df66e389cb}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_1766a8666a}}" />
                    <TextBlock
                        Margin="0,0,0,8"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_a0e354a6b7}}" />
                    <ui:TextBox
                        x:Name="TargetTextBox"
                        Margin="0,0,0,12"
                        Text="{I18N {x:Static lang:LangKeys.Sample_adfad5098d}}" />
                    <WrapPanel>
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ShowCredentialDialog_Click"
                            Content="{I18N {x:Static lang:LangKeys.Sample_83fb2119f7}}"
                            Tag="Prompt" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ShowCredentialDialog_Click"
                            Content="{I18N {x:Static lang:LangKeys.Sample_7a1c9b5e2b}}"
                            Tag="SaveChecked" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ShowCredentialDialog_Click"
                            Content="{I18N {x:Static lang:LangKeys.Sample_9af21fa553}}"
                            Tag="AppCache" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,12,0,8"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_483b1a6a0b}}" />
                    <WrapPanel>
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ShowCredentialDialog_Click"
                            Content="{I18N {x:Static lang:LangKeys.Sample_e2b1998a54}}"
                            Tag="Retrieve" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ShowCredentialDialog_Click"
                            Content="{I18N {x:Static lang:LangKeys.Sample_db5f3f8829}}"
                            Tag="Delete" />
                    </WrapPanel>
                    <TextBlock
                        x:Name="CredentialDialogResultText"
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_e35e9417ad}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
