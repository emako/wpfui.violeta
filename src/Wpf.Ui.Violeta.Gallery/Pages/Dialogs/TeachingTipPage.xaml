<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Dialogs.TeachingTipPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_TeachingTip}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_TeachingTip}}" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Sample_78636353a3}}"
                TextWrapping="Wrap" />

            <!--  Targeted tip  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_97b0645e3d}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_4d3cc18eb2}}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="TargetedTipButton"
                        HorizontalAlignment="Left"
                        Click="ShowTargetedTip_Click"
                        Content="{I18N {x:Static lang:LangKeys.Sample_81bb2fcc61}}" />
                    <vio:TeachingTip
                        x:Name="TargetedTeachingTip"
                        Title="{I18N {x:Static lang:LangKeys.Sample_4a2e02c6c4}}"
                        ActionButtonContent="{I18N {x:Static lang:LangKeys.Sample_5a9663b095}}"
                        CloseButtonContent="{I18N {x:Static lang:LangKeys.Sample_6a03d07c60}}"
                        PreferredPlacement="Bottom"
                        Subtitle="You can switch Light / Dark themes anytime from the title bar."
                        Target="{Binding ElementName=TargetedTipButton}">
                        <vio:TeachingTip.IconSource>
                            <vio:SymbolIconSource Symbol="Refresh" />
                        </vio:TeachingTip.IconSource>
                    </vio:TeachingTip>
                </StackPanel>
            </Border>

            <!--  Untargeted + light dismiss  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_3c1f4d95f5}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_f5403ebf57}}"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Left"
                        Click="ShowUntargetedTip_Click"
                        Content="{I18N {x:Static lang:LangKeys.Sample_e0370534a1}}" />
                    <vio:TeachingTip
                        x:Name="UntargetedTeachingTip"
                        Title="{I18N {x:Static lang:LangKeys.Sample_675801d96a}}"
                        ActionButtonContent="{I18N {x:Static lang:LangKeys.Sample_d59048f21f}}"
                        CloseButtonContent="{I18N {x:Static lang:LangKeys.Sample_c8a59e7135}}"
                        IsLightDismissEnabled="True"
                        PlacementMargin="20"
                        PreferredPlacement="Auto"
                        Subtitle="This tip is not attached to a specific control." />
                </StackPanel>
            </Border>

            <!--  Hero content  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_ba968ba1aa}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_ca50c39bef}}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="HeroTipButton"
                        HorizontalAlignment="Left"
                        Click="ShowHeroTip_Click"
                        Content="{I18N {x:Static lang:LangKeys.Sample_f8eeba813d}}" />
                    <vio:TeachingTip
                        x:Name="HeroTeachingTip"
                        Title="{I18N {x:Static lang:LangKeys.Sample_4c13e4f695}}"
                        CloseButtonContent="{I18N {x:Static lang:LangKeys.Sample_6a03d07c60}}"
                        PreferredPlacement="Right"
                        Target="{Binding ElementName=HeroTipButton}">
                        <vio:TeachingTip.HeroContent>
                            <Border
                                Height="120"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_e0a67c8c63}}" />
                            </Border>
                        </vio:TeachingTip.HeroContent>
                        <vio:TeachingTip.Content>
                            <TextBlock
                                Text="{I18N {x:Static lang:LangKeys.Sample_89ff0e22aa}}"
                                TextWrapping="Wrap" />
                        </vio:TeachingTip.Content>
                    </vio:TeachingTip>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
