<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Dialogs.TeachingTipPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="TeachingTip"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="TeachingTip" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Sample_78636353a3}}"
                TextWrapping="Wrap" />

            <!--  Targeted tip  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Targeted TeachingTip" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_4d3cc18eb2}}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="TargetedTipButton"
                        HorizontalAlignment="Left"
                        Click="ShowTargetedTip_Click"
                        Content="Show targeted tip" />
                    <vio:TeachingTip
                        x:Name="TargetedTeachingTip"
                        Title="Change themes without hassle"
                        ActionButtonContent="Toggle theme"
                        CloseButtonContent="Got it!"
                        PreferredPlacement="Bottom"
                        Subtitle="You can switch Light / Dark themes anytime from the title bar."
                        Target="{Binding ElementName=TargetedTipButton}">
                        <vio:TeachingTip.IconSource>
                            <vio:SymbolIconSource Symbol="Refresh" />
                        </vio:TeachingTip.IconSource>
                    </vio:TeachingTip>
                </StackPanel>
            </Border>

            <!--  Untargeted + light dismiss  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Untargeted + Light Dismiss" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_f5403ebf57}}"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Left"
                        Click="ShowUntargetedTip_Click"
                        Content="Show untargeted tip" />
                    <vio:TeachingTip
                        x:Name="UntargetedTeachingTip"
                        Title="Welcome to TeachingTip"
                        ActionButtonContent="Learn more"
                        CloseButtonContent="Dismiss"
                        IsLightDismissEnabled="True"
                        PlacementMargin="20"
                        PreferredPlacement="Auto"
                        Subtitle="This tip is not attached to a specific control." />
                </StackPanel>
            </Border>

            <!--  Hero content  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Hero content" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_ca50c39bef}}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="HeroTipButton"
                        HorizontalAlignment="Left"
                        Click="ShowHeroTip_Click"
                        Content="Show hero tip" />
                    <vio:TeachingTip
                        x:Name="HeroTeachingTip"
                        Title="Feature highlight"
                        CloseButtonContent="Got it!"
                        PreferredPlacement="Right"
                        Target="{Binding ElementName=HeroTipButton}">
                        <vio:TeachingTip.HeroContent>
                            <Border
                                Height="120"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Hero" />
                            </Border>
                        </vio:TeachingTip.HeroContent>
                        <vio:TeachingTip.Content>
                            <TextBlock
                                Text="Hero content sits above the title and body. Use it for illustrations or media."
                                TextWrapping="Wrap" />
                        </vio:TeachingTip.Content>
                    </vio:TeachingTip>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
