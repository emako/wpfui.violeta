<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Notifications.TrayIconPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="TrayIcon"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="TrayIcon" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="系统托盘图标" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="Gallery 启动时已通过 TrayIconHost 创建真实托盘图标。关闭主窗口会最小化到托盘；双击托盘图标或使用右键菜单可显示/隐藏窗口。" />
                    <TextBlock
                        Margin="0,0,0,8"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap"
                        Text="右键菜单提供：显示/隐藏、显示通知、重启、退出。真正退出请使用托盘菜单中的「退出」。" />
                    <WrapPanel>
                        <ui:Button
                            Margin="0,0,8,8"
                            Appearance="Primary"
                            Click="ShowTrayBalloon_Click"
                            Content="显示托盘气球通知" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="HideToTray_Click"
                            Content="隐藏到托盘" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ShowFromTray_Click"
                            Content="从托盘显示窗口" />
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
