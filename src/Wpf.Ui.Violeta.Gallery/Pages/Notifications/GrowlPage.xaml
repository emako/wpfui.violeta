<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Notifications.GrowlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_Growl}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,8"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_Growl}}" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Stacked in-window / desktop notifications inspired by HandyControl Growl, themed with WPF-UI colors."
                TextWrapping="Wrap" />

            <!--  Window  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Window" />
                    <WrapPanel>
                        <ui:Button Margin="0,0,8,8" Click="Info_Click" Content="Info" />
                        <ui:Button Margin="0,0,8,8" Click="Success_Click" Content="Success" />
                        <ui:Button Margin="0,0,8,8" Click="Warning_Click" Content="Warning" />
                        <ui:Button Margin="0,0,8,8" Click="Error_Click" Content="Error" />
                        <ui:Button Margin="0,0,8,8" Click="Fatal_Click" Content="Fatal" />
                        <ui:Button Margin="0,0,8,8" Click="Ask_Click" Content="Ask" />
                        <ui:Button Margin="0,0,8,8" Click="Clear_Click" Content="Clear" Appearance="Secondary" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!--  Desktop (Global)  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Desktop (Global)" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Shows on a topmost transparent window over the desktop."
                        TextWrapping="Wrap" />
                    <WrapPanel>
                        <ui:Button Margin="0,0,8,8" Click="InfoGlobal_Click" Content="Info" />
                        <ui:Button Margin="0,0,8,8" Click="SuccessGlobal_Click" Content="Success" />
                        <ui:Button Margin="0,0,8,8" Click="WarningGlobal_Click" Content="Warning" />
                        <ui:Button Margin="0,0,8,8" Click="ErrorGlobal_Click" Content="Error" />
                        <ui:Button Margin="0,0,8,8" Click="FatalGlobal_Click" Content="Fatal" />
                        <ui:Button Margin="0,0,8,8" Click="AskGlobal_Click" Content="Ask" />
                        <ui:Button Margin="0,0,8,8" Click="ClearGlobal_Click" Content="Clear" Appearance="Secondary" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!--  Token panel  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Token panel" />
                        <TextBlock
                            Margin="0,0,0,12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Route messages into a dedicated StackPanel via Growl.Token."
                            TextWrapping="Wrap" />
                        <WrapPanel>
                            <ui:Button Margin="0,0,8,8" Click="TokenInfo_Click" Content="Info" />
                            <ui:Button Margin="0,0,8,8" Click="TokenSuccess_Click" Content="Success" />
                            <ui:Button Margin="0,0,8,8" Click="TokenClear_Click" Content="Clear" Appearance="Secondary" />
                        </WrapPanel>
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        MinHeight="180"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel vio:Growl.Token="GrowlDemoToken" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
