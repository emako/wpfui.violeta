<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Notifications.SnackbarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_Snackbar}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <Grid>
        <ScrollViewer>
            <StackPanel Margin="24,16,24,24">
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="{I18N {x:Static lang:LangKeys.Gallery_Page_Snackbar}}" />

                <Border
                    Margin="0,0,0,16"
                    Padding="20"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{I18N {x:Static lang:LangKeys.Sample_c1cff8854d}}" />
                        <TextBlock
                            Margin="0,0,0,12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Sample_c0280b33ba}}"
                            TextWrapping="Wrap" />
                        <ui:StackPanel Orientation="Horizontal" Spacing="16">
                            <ui:Button Click="ShowSnackbar_Click" Content="{I18N {x:Static lang:LangKeys.Sample_727f3b0153}}" />
                            <ComboBox
                                x:Name="AppearanceComboBox"
                                MinWidth="140"
                                SelectedIndex="1">
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_074de7e7c2}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_0c7d6cf194}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_d8c7e04c8e}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_330363dfc5}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_764a2caff0}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_990816b607}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Gallery_Theme_Light}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Gallery_Theme_Dark}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_3d97194308}}" />
                            </ComboBox>
                        </ui:StackPanel>
                        <TextBlock
                            Margin="0,12,0,4"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Sample_961787b91f}}" />
                        <Slider
                            x:Name="TimeoutSlider"
                            AutoToolTipPlacement="BottomRight"
                            AutoToolTipPrecision="0"
                            IsSnapToTickEnabled="True"
                            Maximum="5"
                            Minimum="1"
                            TickFrequency="1"
                            TickPlacement="BottomRight"
                            Value="2" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ui:SnackbarPresenter
            x:Name="SnackbarPresenter"
            VerticalAlignment="Bottom" />
    </Grid>
</vio:Page>
