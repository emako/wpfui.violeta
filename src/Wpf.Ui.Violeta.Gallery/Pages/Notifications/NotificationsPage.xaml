<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Notifications.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:ctrl="clr-namespace:Wpf.Ui.Violeta.Gallery.Controls"
    Title="通知"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock Margin="0,0,0,16" FontSize="20" FontWeight="SemiBold" Text="通知" />
            <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="点击卡片进入对应控件演示页面。" TextWrapping="Wrap" />
            <WrapPanel>
                <ctrl:SampleCard
                    Width="260"
                    Title="Snackbar"
                    Description="底部轻量通知"
                    Glyph="&#xE7E7;"
                    NavigateTag="notifications/snackbar" />
                <ctrl:SampleCard
                    Width="260"
                    Title="Toast"
                    Description="弹出式轻量通知"
                    Glyph="&#xE7E7;"
                    NavigateTag="notifications/toast" />
                <ctrl:SampleCard
                    Width="260"
                    Title="Banner"
                    Description="内嵌横幅通知"
                    Glyph="&#xE789;"
                    NavigateTag="notifications/banner" />
                <ctrl:SampleCard
                    Width="260"
                    Title="TrayIcon"
                    Description="系统托盘图标与菜单"
                    Glyph="&#xE8A5;"
                    NavigateTag="notifications/tray-icon" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
