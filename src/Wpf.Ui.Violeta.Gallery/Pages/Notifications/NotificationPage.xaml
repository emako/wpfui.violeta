<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Notifications.NotificationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_Notification}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_Notification}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_8b46c3bc9e}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="{I18N {x:Static lang:LangKeys.Sample_758ba147c8}}" />
                    <WrapPanel>
                        <ui:Button
                            Margin="0,0,8,8"
                            Appearance="Primary"
                            Click="ShowInformation_Click"
                            Content="{I18N {x:Static lang:LangKeys.Sample_a82be0f551}}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ShowWarning_Click"
                            Content="{I18N {x:Static lang:LangKeys.Sample_900c70fa5f}}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ShowError_Click"
                            Content="{I18N {x:Static lang:LangKeys.Sample_7030ff6470}}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ShowNone_Click"
                            Content="{I18N {x:Static lang:LangKeys.Gallery_Settings_Backdrop_None}}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
