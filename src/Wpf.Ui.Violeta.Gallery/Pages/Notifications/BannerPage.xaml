<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Notifications.BannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="Banner"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Banner" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_30859ecb19}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_671acfcae8}}" />
                    <StackPanel>
                        <vio:Banner
                            Margin="0,0,0,8"
                            Content="{I18N {x:Static lang:LangKeys.Sample_618dd07189}}"
                            Type="Information" />
                        <vio:Banner
                            Margin="0,0,0,8"
                            Content="{I18N {x:Static lang:LangKeys.Sample_f1f6027baa}}"
                            Type="Success" />
                        <vio:Banner
                            Margin="0,0,0,8"
                            Content="{I18N {x:Static lang:LangKeys.Sample_9fd77757e8}}"
                            Type="Warning" />
                        <vio:Banner Content="{I18N {x:Static lang:LangKeys.Sample_3acbae2b62}}" Type="Error" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
