<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Status.ShieldPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_Shield}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_Shield}}" />

            <!--  Basic  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_Shield_BasicTitle}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_Shield_BasicDesc}}"
                        TextWrapping="Wrap" />
                    <WrapPanel>
                        <vio:Shield
                            Margin="0,0,8,8"
                            Color="#1182c3"
                            Status="&gt;=4.0"
                            Subject=".net" />
                        <vio:Shield
                            Margin="0,0,8,8"
                            Color="#1182c3"
                            Status="7.0"
                            Subject="c#" />
                        <vio:Shield
                            Margin="0,0,8,8"
                            Color="#1182c3"
                            Status="2017"
                            Subject="IDE" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!--  Colors  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_Shield_ColorsTitle}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_Shield_ColorsDesc}}"
                        TextWrapping="Wrap" />
                    <WrapPanel>
                        <vio:Shield
                            Margin="0,0,8,8"
                            Status="{I18N {x:Static lang:LangKeys.Sample_Shield_StatusAccent}}"
                            Subject="accent" />
                        <vio:Shield
                            Margin="0,0,8,8"
                            Color="#2ea043"
                            Status="{I18N {x:Static lang:LangKeys.Sample_Shield_StatusSuccess}}"
                            Subject="build" />
                        <vio:Shield
                            Margin="0,0,8,8"
                            Color="#d29922"
                            Status="{I18N {x:Static lang:LangKeys.Sample_Shield_StatusWarning}}"
                            Subject="coverage" />
                        <vio:Shield
                            Margin="0,0,8,8"
                            Color="#f85149"
                            Status="{I18N {x:Static lang:LangKeys.Sample_Shield_StatusDanger}}"
                            Subject="tests" />
                        <vio:Shield
                            Margin="0,0,8,8"
                            Color="#8957e5"
                            Status="MIT"
                            Subject="license" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
