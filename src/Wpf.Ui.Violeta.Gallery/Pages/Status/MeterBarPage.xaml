<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Status.MeterBarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_MeterBar}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,8"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_MeterBar}}" />
            <TextBlock
                Margin="0,0,0,20"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Sample_MeterBar_Intro}}"
                TextWrapping="Wrap" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Horizontal" />
                    <vio:MeterBar Total="100000">
                        <vio:MeterBarItem
                            Title="Research"
                            ToolTip="Research · ¥42,000"
                            ValueText="¥42,000"
                            Value="42000" />
                        <vio:MeterBarItem
                            Title="Marketing"
                            ToolTip="Marketing · ¥18,000"
                            ValueText="¥18,000"
                            Value="18000" />
                        <vio:MeterBarItem
                            Title="Operations"
                            ToolTip="Operations · ¥9,000"
                            ValueText="¥9,000"
                            Value="9000" />
                    </vio:MeterBar>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Vertical" />
                    <vio:MeterBar Legend="Vertical" Total="256">
                        <vio:MeterBarItem
                            Title="Apps"
                            ToolTip="Apps · 86 GB"
                            ValueText="86 GB"
                            Value="86" />
                        <vio:MeterBarItem
                            Title="Documents"
                            ToolTip="Documents · 24 GB"
                            ValueText="24 GB"
                            Value="24" />
                        <vio:MeterBarItem
                            Title="Photos"
                            ToolTip="Photos · 18 GB"
                            ValueText="18 GB"
                            Value="18" />
                        <vio:MeterBarItem
                            Title="Other"
                            ToolTip="Other · 12 GB"
                            ValueText="12 GB"
                            Value="12" />
                    </vio:MeterBar>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="None" />
                    <vio:MeterBar Legend="None" Total="160">
                        <vio:MeterBarItem
                            Title="Design"
                            ToolTip="Design · 48 h"
                            ValueText="48 h"
                            Value="48" />
                        <vio:MeterBarItem
                            Title="Development"
                            ToolTip="Development · 72 h"
                            ValueText="72 h"
                            Value="72" />
                        <vio:MeterBarItem
                            Title="Testing"
                            ToolTip="Testing · 24 h"
                            ValueText="24 h"
                            Value="24" />
                    </vio:MeterBar>
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="ItemsSource" />
                    <vio:MeterBar ItemsSource="{Binding DataPlanUsages}" Total="{Binding DataPlanTotal}">
                        <vio:MeterBar.ItemContainerStyle>
                            <Style TargetType="vio:MeterBarItem">
                                <Setter Property="Title" Value="{Binding Name}" />
                                <Setter Property="Value" Value="{Binding Used}" />
                                <Setter Property="ValueText" Value="{Binding UsedText}" />
                                <Setter Property="ToolTip" Value="{Binding UsedText}" />
                            </Style>
                        </vio:MeterBar.ItemContainerStyle>
                    </vio:MeterBar>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
