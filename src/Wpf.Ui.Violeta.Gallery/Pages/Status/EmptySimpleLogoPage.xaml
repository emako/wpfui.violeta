<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Status.EmptySimpleLogoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_EmptySimpleLogo}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_EmptySimpleLogo}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_EmptySimpleLogo_BasicTitle}}" />
                    <TextBlock
                        Margin="0,0,0,16"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_EmptySimpleLogo_BasicDesc}}"
                        TextWrapping="Wrap" />
                    <Border
                        Padding="32,40"
                        Background="{DynamicResource EmptySimpleLogoPreviewBackgroundBrush}"
                        CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center">
                            <Rectangle
                                Width="64"
                                Height="41"
                                Fill="{DynamicResource EmptySimpleLogo}" />
                            <TextBlock
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_EmptySimpleLogo_NoData}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_EmptySimpleLogo_SizesTitle}}" />
                    <TextBlock
                        Margin="0,0,0,16"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_EmptySimpleLogo_SizesDesc}}"
                        TextWrapping="Wrap" />
                    <Border
                        Padding="24,32"
                        Background="{DynamicResource EmptySimpleLogoPreviewBackgroundBrush}"
                        CornerRadius="8">
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <Rectangle
                                Width="48"
                                Height="31"
                                Margin="0,0,24,0"
                                VerticalAlignment="Bottom"
                                Fill="{DynamicResource EmptySimpleLogo}" />
                            <Rectangle
                                Width="64"
                                Height="41"
                                Margin="0,0,24,0"
                                VerticalAlignment="Bottom"
                                Fill="{DynamicResource EmptySimpleLogo}" />
                            <Rectangle
                                Width="96"
                                Height="62"
                                VerticalAlignment="Bottom"
                                Fill="{DynamicResource EmptySimpleLogo}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
