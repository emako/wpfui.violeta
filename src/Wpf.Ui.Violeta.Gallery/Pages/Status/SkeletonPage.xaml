<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Status.SkeletonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_Skeleton}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock Margin="0,0,0,16" FontSize="20" FontWeight="SemiBold" Text="{I18N {x:Static lang:LangKeys.Gallery_Page_Skeleton}}" />
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock Margin="0,0,0,4" FontSize="14" FontWeight="SemiBold" Text="{I18N {x:Static lang:LangKeys.Sample_2ad0b1dc17}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_3444fcb679}}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <CheckBox
                            x:Name="LoadingCheckBox"
                            VerticalAlignment="Center"
                            Content="{I18N {x:Static lang:LangKeys.Sample_88d35241c6}}"
                            IsChecked="True"
                            Checked="LoadingState_Changed"
                            Unchecked="LoadingState_Changed" />
                        <CheckBox
                            x:Name="ActiveCheckBox"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Content="{I18N {x:Static lang:LangKeys.Sample_0205bd4439}}"
                            IsChecked="True"
                            Checked="LoadingState_Changed"
                            Unchecked="LoadingState_Changed" />
                    </StackPanel>
                    <vio:Skeleton
                        x:Name="DemoSkeleton"
                        Height="20"
                        Margin="0,0,0,8"
                        IsActive="True"
                        IsLoading="True" />
                    <vio:Skeleton
                        x:Name="DemoSkeleton2"
                        Height="20"
                        MaxWidth="360"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        IsActive="True"
                        IsLoading="True" />
                    <vio:Skeleton
                        x:Name="DemoSkeleton3"
                        Width="200"
                        Height="32"
                        HorizontalAlignment="Left"
                        IsActive="True"
                        IsLoading="True">
                        <TextBlock VerticalAlignment="Center" Text="{I18N {x:Static lang:LangKeys.Sample_ca7917af58}}" />
                    </vio:Skeleton>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
