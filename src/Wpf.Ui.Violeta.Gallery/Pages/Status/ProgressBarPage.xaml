<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Status.ProgressBarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_ProgressBar}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_ProgressBar}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{I18N {x:Static lang:LangKeys.Sample_a2d00c353d}}" />
                        <TextBlock
                            Margin="0,0,0,12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Sample_cae8c05701}}"
                            TextWrapping="Wrap" />
                        <ProgressBar
                            IsIndeterminate="True"
                            vio:ProgressBarHelper.ShowError="{Binding IsChecked, ElementName=IndeterminateErrorRB, FallbackValue=False, TargetNullValue=False}"
                            vio:ProgressBarHelper.ShowPaused="{Binding IsChecked, ElementName=IndeterminatePausedRB, FallbackValue=False, TargetNullValue=False}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" MinWidth="120">
                        <TextBlock Margin="0,0,0,8" Text="{I18N {x:Static lang:LangKeys.Sample_afb4119954}}" />
                        <RadioButton
                            x:Name="IndeterminateRunningRB"
                            Content="{I18N {x:Static lang:LangKeys.Sample_5bda814c4a}}"
                            GroupName="IndeterminateProgressState"
                            IsChecked="True" />
                        <RadioButton
                            x:Name="IndeterminatePausedRB"
                            Content="{I18N {x:Static lang:LangKeys.Sample_e99180abf4}}"
                            GroupName="IndeterminateProgressState" />
                        <RadioButton
                            x:Name="IndeterminateErrorRB"
                            Content="{I18N {x:Static lang:LangKeys.Sample_7030ff6470}}"
                            GroupName="IndeterminateProgressState" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{I18N {x:Static lang:LangKeys.Sample_9aa2f68b8e}}" />
                        <TextBlock
                            Margin="0,0,0,12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Sample_b1a86a3a9f}}"
                            TextWrapping="Wrap" />
                        <ProgressBar
                            x:Name="DeterminateBar"
                            Maximum="100"
                            Value="35"
                            vio:ProgressBarHelper.ShowError="{Binding IsChecked, ElementName=DeterminateErrorRB, FallbackValue=False, TargetNullValue=False}"
                            vio:ProgressBarHelper.ShowPaused="{Binding IsChecked, ElementName=DeterminatePausedRB, FallbackValue=False, TargetNullValue=False}" />
                        <Slider
                            Margin="0,12,0,0"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding Value, ElementName=DeterminateBar, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" MinWidth="120">
                        <TextBlock Margin="0,0,0,8" Text="{I18N {x:Static lang:LangKeys.Sample_afb4119954}}" />
                        <RadioButton
                            x:Name="DeterminateRunningRB"
                            Content="{I18N {x:Static lang:LangKeys.Sample_5bda814c4a}}"
                            GroupName="DeterminateProgressState"
                            IsChecked="True" />
                        <RadioButton
                            x:Name="DeterminatePausedRB"
                            Content="{I18N {x:Static lang:LangKeys.Sample_e99180abf4}}"
                            GroupName="DeterminateProgressState" />
                        <RadioButton
                            x:Name="DeterminateErrorRB"
                            Content="{I18N {x:Static lang:LangKeys.Sample_7030ff6470}}"
                            GroupName="DeterminateProgressState" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
