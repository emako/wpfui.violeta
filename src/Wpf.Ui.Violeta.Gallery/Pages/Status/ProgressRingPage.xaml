<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Status.ProgressRingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="ProgressRing"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="ProgressRing" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Indeterminate" />
                        <TextBlock
                            Margin="0,0,0,12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Sample_5d47c178f6}}"
                            TextWrapping="Wrap" />
                        <ui:ProgressRing
                            HorizontalAlignment="Left"
                            IsIndeterminate="True"
                            vio:ProgressRingHelper.IsActive="{Binding IsChecked, ElementName=IndeterminateActiveToggle, FallbackValue=True, TargetNullValue=True}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" MinWidth="120" VerticalAlignment="Center">
                        <ui:ToggleSwitch
                            x:Name="IndeterminateActiveToggle"
                            Content="IsActive"
                            IsChecked="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Determinate" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_ad4a69520c}}"
                        TextWrapping="Wrap" />
                    <ui:ProgressRing
                        x:Name="DeterminateRing"
                        HorizontalAlignment="Left"
                        IsIndeterminate="False"
                        Progress="{Binding Value, ElementName=ProgressSlider}"
                        vio:ProgressRingHelper.IsActive="{Binding IsChecked, ElementName=DeterminateActiveToggle, FallbackValue=True, TargetNullValue=True}" />
                    <DockPanel Margin="0,16,0,0" LastChildFill="True">
                        <ui:ToggleSwitch
                            x:Name="DeterminateActiveToggle"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Content="IsActive"
                            DockPanel.Dock="Right"
                            IsChecked="True" />
                        <Slider
                            x:Name="ProgressSlider"
                            Maximum="100"
                            Minimum="0"
                            Value="40" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
