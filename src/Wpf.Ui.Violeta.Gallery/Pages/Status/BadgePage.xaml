<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Status.BadgePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_Badge}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock Margin="0,0,0,16" FontSize="20" FontWeight="SemiBold" Text="{I18N {x:Static lang:LangKeys.Gallery_Page_Badge}}" />
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock Margin="0,0,0,4" FontSize="14" FontWeight="SemiBold" Text="{I18N {x:Static lang:LangKeys.Sample_e8f31fbc7e}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_7f7f2ab305}}"
                        TextWrapping="Wrap" />
                    <WrapPanel>
                        <vio:Badge Margin="16" BadgeContent="5" OverflowCount="99">
                            <Border
                                Width="48"
                                Height="48"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4" />
                        </vio:Badge>
                        <vio:Badge Margin="16" BadgeContent="120" OverflowCount="99">
                            <Border
                                Width="48"
                                Height="48"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4" />
                        </vio:Badge>
                        <vio:Badge Margin="16" Dot="True">
                            <Border
                                Width="48"
                                Height="48"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4" />
                        </vio:Badge>
                        <vio:Badge Margin="16" BadgeContent="3" CornerPosition="BottomRight">
                            <Border
                                Width="48"
                                Height="48"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4" />
                        </vio:Badge>
                        <vio:Badge
                            Margin="16"
                            BadgeBackground="#2ea043"
                            BadgeContent="{I18N {x:Static lang:LangKeys.Sample_24d459a814}}"
                            CornerPosition="TopLeft">
                            <Border
                                Width="48"
                                Height="48"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4" />
                        </vio:Badge>
                        <vio:Badge Margin="16" BadgeContent="5">
                            <TextBlock VerticalAlignment="Center" FontSize="14" Text="{I18N {x:Static lang:LangKeys.Sample_41de6d6cfb}}" />
                        </vio:Badge>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
