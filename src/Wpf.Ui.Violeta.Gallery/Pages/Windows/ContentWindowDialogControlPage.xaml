<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Windows.ContentWindowDialogControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_ContentWindowDialogControl}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_ContentWindowDialogControl}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.ContentWindowDialogControl_DescTitle}}" />
                    <TextBlock
                        Margin="0,0,0,16"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.ContentWindowDialogControl_DescBody}}"
                        TextWrapping="Wrap" />
                    <WrapPanel>
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="OpenDefaultDialogWindow_Click"
                            Appearance="Primary"
                            Content="{I18N {x:Static lang:LangKeys.ContentWindowDialogControl_OpenDefault}}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="OpenConfirmOnlyDialogWindow_Click"
                            Appearance="Secondary"
                            Content="{I18N {x:Static lang:LangKeys.ContentWindowDialogControl_OpenConfirmOnly}}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="OpenCloseAlignedDialogWindow_Click"
                            Appearance="Secondary"
                            Content="{I18N {x:Static lang:LangKeys.ContentWindowDialogControl_OpenWithClose}}" />
                    </WrapPanel>
                    <TextBlock
                        x:Name="ResultText"
                        Margin="0,12,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_e35e9417ad}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
