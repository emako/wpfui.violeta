<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Navigation.SegmentedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="Segmented"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,4"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Segmented" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="WinUI-style mutually exclusive selector. Selected segment uses a subtle fill and an accent underline."
                TextWrapping="Wrap" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="View mode" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Icon-only segments, matching UniGetUI's List / Grid / Icons switcher." />
                    <StackPanel Orientation="Horizontal">
                        <vio:Segmented x:Name="ViewModeSegmented" SelectedIndex="2">
                            <vio:SegmentedItem ToolTip="List">
                                <Viewbox Width="18" Height="18">
                                    <Grid Width="16" Height="16">
                                        <Path
                                            Data="M 3,3 m -1.2,0 a 1.2,1.2 0 1,0 2.4,0 a 1.2,1.2 0 1,0 -2.4,0
                                                  M 3,8 m -1.2,0 a 1.2,1.2 0 1,0 2.4,0 a 1.2,1.2 0 1,0 -2.4,0
                                                  M 3,13 m -1.2,0 a 1.2,1.2 0 1,0 2.4,0 a 1.2,1.2 0 1,0 -2.4,0"
                                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=vio:SegmentedItem}}" />
                                        <Path
                                            Data="M 6,3 H 14 M 6,8 H 14 M 6,13 H 14"
                                            Fill="Transparent"
                                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=vio:SegmentedItem}}"
                                            StrokeEndLineCap="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="1.5" />
                                    </Grid>
                                </Viewbox>
                            </vio:SegmentedItem>
                            <vio:SegmentedItem ToolTip="Grid">
                                <Viewbox Width="18" Height="18">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="M 4,2 H 2 V 6 H 4   M 6,3 H 14   M 6,5 H 14
                                              M 4,10 H 2 V 14 H 4 M 6,11 H 14  M 6,13 H 14"
                                        Fill="Transparent"
                                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=vio:SegmentedItem}}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Miter"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1" />
                                </Viewbox>
                            </vio:SegmentedItem>
                            <vio:SegmentedItem ToolTip="Icons">
                                <Viewbox Width="18" Height="18">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="M 2,2 H 6 V 6 H 2 Z M 10,2 H 14 V 6 H 10 Z M 2,10 H 6 V 14 H 2 Z M 10,10 H 14 V 14 H 10 Z"
                                        Fill="Transparent"
                                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=vio:SegmentedItem}}"
                                        StrokeThickness="1.3" />
                                </Viewbox>
                            </vio:SegmentedItem>
                        </vio:Segmented>
                        <TextBlock
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="SelectedIndex: " />
                            <Run Text="{Binding SelectedIndex, ElementName=ViewModeSegmented, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Text" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Plain labels. Keyboard: Tab into the control, then Left / Right." />
                    <vio:Segmented>
                        <vio:SegmentedItem Content="Day" IsSelected="True" />
                        <vio:SegmentedItem Content="Week" />
                        <vio:SegmentedItem Content="Month" />
                    </vio:Segmented>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Icon + text" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="SegmentedItem.Icon before Content." />
                    <vio:Segmented>
                        <vio:SegmentedItem Content="Home" IsSelected="True">
                            <vio:SegmentedItem.Icon>
                                <ui:SymbolIcon FontSize="16" Symbol="Home24" />
                            </vio:SegmentedItem.Icon>
                        </vio:SegmentedItem>
                        <vio:SegmentedItem Content="Search">
                            <vio:SegmentedItem.Icon>
                                <ui:SymbolIcon FontSize="16" Symbol="Search24" />
                            </vio:SegmentedItem.Icon>
                        </vio:SegmentedItem>
                        <vio:SegmentedItem Content="Settings">
                            <vio:SegmentedItem.Icon>
                                <ui:SymbolIcon FontSize="16" Symbol="Settings24" />
                            </vio:SegmentedItem.Icon>
                        </vio:SegmentedItem>
                    </vio:Segmented>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Disabled" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Individual segments or the whole control can be disabled." />
                    <ui:StackPanel Orientation="Horizontal" Spacing="16">
                        <vio:Segmented>
                            <vio:SegmentedItem Content="Active" IsSelected="True" />
                            <vio:SegmentedItem Content="Preview" />
                            <vio:SegmentedItem Content="Unavailable" IsEnabled="False" />
                        </vio:Segmented>
                        <vio:Segmented IsEnabled="False">
                            <vio:SegmentedItem Content="One" IsSelected="True" />
                            <vio:SegmentedItem Content="Two" />
                            <vio:SegmentedItem Content="Three" />
                        </vio:Segmented>
                    </ui:StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
