<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Navigation.ToolBarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="ToolBar"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="ToolBar" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="vio:ToolBar 溢出（Flyout）" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="拖动下方滑块缩小可用宽度。空间不足时项会移入 Compat Flyout（控件原样搬迁，不是 MenuItem）。"
                        TextWrapping="Wrap" />
                    <Slider
                        x:Name="OverflowWidthSlider"
                        Margin="0,0,0,12"
                        Maximum="560"
                        Minimum="120"
                        Value="280" />
                    <Border
                        Width="{Binding ElementName=OverflowWidthSlider, Path=Value}"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <vio:ToolBar>
                            <Button Content="New" Style="{StaticResource ToolBarButtonStyle}" ToolTip="新建" />
                            <Button Content="Open" Style="{StaticResource ToolBarButtonStyle}" ToolTip="打开" />
                            <Button Content="Save" Style="{StaticResource ToolBarButtonStyle}" ToolTip="保存" />
                            <Separator />
                            <Button Content="Cut" Style="{StaticResource ToolBarButtonStyle}" ToolTip="剪切" />
                            <Button Content="Copy" Style="{StaticResource ToolBarButtonStyle}" ToolTip="复制" />
                            <Button Content="Paste" Style="{StaticResource ToolBarButtonStyle}" ToolTip="粘贴" />
                            <Button Content="Undo" Style="{StaticResource ToolBarButtonStyle}" ToolTip="撤销" />
                            <Button Content="Redo" Style="{StaticResource ToolBarButtonStyle}" ToolTip="重做" />
                        </vio:ToolBar>
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="OverflowMode：Always / Never / AsNeeded" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Help 始终进溢出；Save 永不溢出；其余按需挤出。"
                        TextWrapping="Wrap" />
                    <Border
                        Width="260"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <vio:ToolBar>
                            <Button
                                Content="Save"
                                Style="{StaticResource ToolBarButtonStyle}"
                                vio:ToolBar.OverflowMode="Never" />
                            <Button Content="Open" Style="{StaticResource ToolBarButtonStyle}" />
                            <Button Content="Cut" Style="{StaticResource ToolBarButtonStyle}" />
                            <Button Content="Copy" Style="{StaticResource ToolBarButtonStyle}" />
                            <Button Content="Paste" Style="{StaticResource ToolBarButtonStyle}" />
                            <Button
                                Content="Help"
                                Style="{StaticResource ToolBarButtonStyle}"
                                vio:ToolBar.OverflowMode="Always" />
                        </vio:ToolBar>
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="ShowOverflowMenu = False" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="放不下的项仍会从主栏移除，但不显示溢出按钮 / Flyout。"
                        TextWrapping="Wrap" />
                    <Border
                        Width="200"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <vio:ToolBar ShowOverflowMenu="False">
                            <Button Content="One" Style="{StaticResource ToolBarButtonStyle}" />
                            <Button Content="Two" Style="{StaticResource ToolBarButtonStyle}" />
                            <Button Content="Three" Style="{StaticResource ToolBarButtonStyle}" />
                            <Button Content="Four" Style="{StaticResource ToolBarButtonStyle}" />
                            <Button Content="Five" Style="{StaticResource ToolBarButtonStyle}" />
                        </vio:ToolBar>
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="图标按钮 + Flyout 溢出" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="溢出区仍是原来的 Button，图标与命令保持不变。"
                        TextWrapping="Wrap" />
                    <Border
                        Width="220"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <vio:ToolBar>
                            <Button Style="{StaticResource ToolBarButtonStyle}" ToolTip="新建">
                                <ui:SymbolIcon Symbol="DocumentAdd24" />
                            </Button>
                            <Button Style="{StaticResource ToolBarButtonStyle}" ToolTip="打开">
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </Button>
                            <Button Style="{StaticResource ToolBarButtonStyle}" ToolTip="保存">
                                <ui:SymbolIcon Symbol="Save24" />
                            </Button>
                            <Separator />
                            <Button Style="{StaticResource ToolBarButtonStyle}" ToolTip="剪切">
                                <ui:SymbolIcon Symbol="Cut24" />
                            </Button>
                            <Button Style="{StaticResource ToolBarButtonStyle}" ToolTip="复制">
                                <ui:SymbolIcon Symbol="Copy24" />
                            </Button>
                            <Button Style="{StaticResource ToolBarButtonStyle}" ToolTip="粘贴">
                                <ui:SymbolIcon Symbol="ClipboardPaste24" />
                            </Button>
                            <Button Style="{StaticResource ToolBarButtonStyle}" ToolTip="撤销">
                                <ui:SymbolIcon Symbol="ArrowUndo24" />
                            </Button>
                            <Button Style="{StaticResource ToolBarButtonStyle}" ToolTip="重做">
                                <ui:SymbolIcon Symbol="ArrowRedo24" />
                            </Button>
                        </vio:ToolBar>
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="对比：系统 ToolBar" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="WPF 内置 ToolBar + ToolBarTray（溢出仍为系统 Popup 面板，非 Violeta Flyout）。"
                        TextWrapping="Wrap" />
                    <ToolBarTray IsLocked="True">
                        <ToolBar Width="280">
                            <Button Content="One" />
                            <Button Content="Two" />
                            <Button Content="Three" />
                            <Button Content="Four" />
                            <Button Content="Five" />
                            <Button Content="Six" />
                            <Button Content="Seven" />
                            <Button Content="Eight" />
                        </ToolBar>
                    </ToolBarTray>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
