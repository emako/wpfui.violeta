<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Navigation.ToolBarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="ToolBar"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="ToolBar" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="标准 ToolBar" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="WPF ToolBar 使用 Wpf.Ui Fluent 样式（Button / ToggleButton / Separator）。"
                        TextWrapping="Wrap" />
                    <ToolBarTray>
                        <ToolBar>
                            <Button Content="New" ToolTip="新建" />
                            <Button Content="Open" ToolTip="打开" />
                            <Button Content="Save" ToolTip="保存" />
                            <Separator />
                            <Button Content="Cut" ToolTip="剪切" />
                            <Button Content="Copy" ToolTip="复制" />
                            <Button Content="Paste" ToolTip="粘贴" />
                        </ToolBar>
                    </ToolBarTray>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="图标按钮" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="配合 ui:SymbolIcon 展示图标工具栏，适合编辑器与文档应用。"
                        TextWrapping="Wrap" />
                    <ToolBarTray>
                        <ToolBar>
                            <Button ToolTip="新建">
                                <ui:SymbolIcon Symbol="DocumentAdd24" />
                            </Button>
                            <Button ToolTip="打开">
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </Button>
                            <Button ToolTip="保存">
                                <ui:SymbolIcon Symbol="Save24" />
                            </Button>
                            <Separator />
                            <Button ToolTip="剪切">
                                <ui:SymbolIcon Symbol="Cut24" />
                            </Button>
                            <Button ToolTip="复制">
                                <ui:SymbolIcon Symbol="Copy24" />
                            </Button>
                            <Button ToolTip="粘贴">
                                <ui:SymbolIcon Symbol="ClipboardPaste24" />
                            </Button>
                            <Separator />
                            <Button ToolTip="撤销">
                                <ui:SymbolIcon Symbol="ArrowUndo24" />
                            </Button>
                            <Button ToolTip="重做">
                                <ui:SymbolIcon Symbol="ArrowRedo24" />
                            </Button>
                        </ToolBar>
                    </ToolBarTray>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="ToggleButton 与混合控件" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="ToolBar 会自动应用 ToggleButton / CheckBox 样式，也可放入 ComboBox 等控件。"
                        TextWrapping="Wrap" />
                    <ToolBarTray>
                        <ToolBar>
                            <ToggleButton ToolTip="加粗">
                                <ui:SymbolIcon Symbol="TextBold24" />
                            </ToggleButton>
                            <ToggleButton IsChecked="True" ToolTip="斜体">
                                <ui:SymbolIcon Symbol="TextItalic24" />
                            </ToggleButton>
                            <ToggleButton ToolTip="下划线">
                                <ui:SymbolIcon Symbol="TextUnderline24" />
                            </ToggleButton>
                            <Separator />
                            <ComboBox
                                Width="120"
                                SelectedIndex="0"
                                ToolTip="字号">
                                <ComboBoxItem Content="12 pt" />
                                <ComboBoxItem Content="14 pt" />
                                <ComboBoxItem Content="16 pt" />
                                <ComboBoxItem Content="18 pt" />
                            </ComboBox>
                            <Separator />
                            <CheckBox Content="自动换行" IsChecked="True" />
                        </ToolBar>
                    </ToolBarTray>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="多行 ToolBarTray" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="同一 Tray 可放置多条 ToolBar；Band / BandIndex 控制行与顺序。拖动手柄可重排（未锁定时）。"
                        TextWrapping="Wrap" />
                    <ToolBarTray>
                        <ToolBar Band="0" Header="文件">
                            <Button>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="DocumentAdd24" />
                                    <TextBlock VerticalAlignment="Center" Text="新建" />
                                </StackPanel>
                            </Button>
                            <Button>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="FolderOpen24" />
                                    <TextBlock VerticalAlignment="Center" Text="打开" />
                                </StackPanel>
                            </Button>
                            <Button>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="Save24" />
                                    <TextBlock VerticalAlignment="Center" Text="保存" />
                                </StackPanel>
                            </Button>
                        </ToolBar>
                        <ToolBar Band="0" BandIndex="1" Header="编辑">
                            <Button ToolTip="剪切">
                                <ui:SymbolIcon Symbol="Cut24" />
                            </Button>
                            <Button ToolTip="复制">
                                <ui:SymbolIcon Symbol="Copy24" />
                            </Button>
                            <Button ToolTip="粘贴">
                                <ui:SymbolIcon Symbol="ClipboardPaste24" />
                            </Button>
                        </ToolBar>
                        <ToolBar Band="1" Header="视图">
                            <ToggleButton Content="标尺" />
                            <ToggleButton Content="网格" IsChecked="True" />
                            <ToggleButton Content="状态栏" IsChecked="True" />
                        </ToolBar>
                    </ToolBarTray>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="锁定与溢出" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="IsLocked 隐藏拖动手柄；宽度不足时右侧溢出按钮收纳多余项（缩小窗口宽度可观察）。"
                        TextWrapping="Wrap" />
                    <ToolBarTray IsLocked="True">
                        <ToolBar Width="280">
                            <Button Content="One" />
                            <Button Content="Two" />
                            <Button Content="Three" />
                            <Button Content="Four" />
                            <Button Content="Five" />
                            <Button Content="Six" />
                            <Button Content="Seven" />
                            <Button Content="Eight" />
                            <Button Content="Nine" />
                            <Button Content="Ten" />
                        </ToolBar>
                    </ToolBarTray>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
