<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Navigation.MenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="Menu"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Menu" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_0f69e5cbfd}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Menu uses ui:ControlHelper.IconFontSize=18 for top-level / submenu icons."
                        TextWrapping="Wrap" />
                    <Menu FontSize="14" ui:ControlHelper.IconFontSize="18">
                        <ui:MenuItem Header="File" Icon="{ui:SymbolIcon Document24}">
                            <ui:MenuItem Header="New" InputGestureText="CTRL+N" />
                            <ui:MenuItem Header="Open..." InputGestureText="CTRL+O" />
                            <ui:MenuItem Header="Save" InputGestureText="CTRL+S" />
                            <ui:MenuItem Header="Save As..." InputGestureText="CTRL+SHIFT+S" />
                            <Separator />
                            <ui:MenuItem Header="Recent">
                                <!-- string Icon → FontIcon (Glyph), FontFamily=SymbolThemeFontFamily, size from IconFontSize -->
                                <ui:MenuItem Header="Project A.sln" Icon="&#xE8A5;" />
                                <ui:MenuItem Header="Project B.sln" Icon="&#xE8A5;" />
                                <ui:MenuItem Header="More">
                                    <ui:MenuItem Header="Archive 2024" />
                                    <ui:MenuItem Header="Archive 2025" />
                                    <ui:MenuItem Header="Archive 2026" />
                                </ui:MenuItem>
                            </ui:MenuItem>
                            <Separator />
                            <ui:MenuItem Header="Exit" />
                        </ui:MenuItem>
                        <ui:MenuItem Header="Edit" Icon="{ui:SymbolIcon DocumentEdit20}">
                            <ui:MenuItem Header="Undo" InputGestureText="CTRL+Z" />
                            <Separator />
                            <ui:MenuItem Header="Cut" InputGestureText="CTRL+X" />
                            <ui:MenuItem Header="Copy" InputGestureText="CTRL+C" />
                            <ui:MenuItem Header="Paste" InputGestureText="CTRL+V" />
                            <ui:MenuItem IsEnabled="False" />
                            <Separator />
                            <ui:MenuItem
                                Header="Word wrap"
                                InputGestureText="CTRL+SHIFT+W"
                                IsCheckable="True"
                                IsChecked="True" />
                            <ui:MenuItem Header="Find..." InputGestureText="CTRL+F" />
                            <ui:MenuItem Header="Find next" InputGestureText="F3" />
                            <Separator />
                            <ui:MenuItem Header="Select All" InputGestureText="CTRL+A" />
                        </ui:MenuItem>
                        <ui:MenuItem Header="View" Icon="{ui:SymbolIcon Eye24}">
                            <ui:MenuItem Header="Zoom">
                                <ui:MenuItem Header="Zoom In" InputGestureText="CTRL++" />
                                <ui:MenuItem Header="Zoom Out" InputGestureText="CTRL+-" />
                                <ui:MenuItem Header="Reset" InputGestureText="CTRL+0" />
                            </ui:MenuItem>
                            <ui:MenuItem Header="Layout">
                                <ui:MenuItem
                                    Header="Single column"
                                    IsCheckable="True"
                                    IsChecked="True" />
                                <ui:MenuItem Header="Two columns" IsCheckable="True" />
                                <ui:MenuItem Header="Three columns" IsCheckable="True" />
                            </ui:MenuItem>
                            <Separator />
                            <ui:MenuItem Header="Full screen" InputGestureText="F11" />
                        </ui:MenuItem>
                        <Separator />
                        <ui:MenuItem Icon="{ui:SymbolIcon TextBold20}" />
                        <ui:MenuItem Icon="{ui:SymbolIcon TextItalic20}" />
                        <ui:MenuItem Icon="{ui:SymbolIcon TextUnderline20}" />
                    </Menu>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="ContextMenu (Placement=Bottom)" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Left: ContextMenu IconFontSize=20 (all icons). Middle item overrides to 12 via Icon FontSize (wins). Right DropDown unchanged."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,12,0"
                            Click="OnOpenContextMenuClick"
                            Content="IconFontSize on menu"
                            Icon="{ui:SymbolIcon ChevronDown24}">
                            <ui:Button.ContextMenu>
                                <ContextMenu ui:ControlHelper.IconFontSize="20">
                                    <ui:MenuItem Header="New" Icon="&#xE8A5;" />
                                    <ui:MenuItem Header="Open..." Icon="&#xE838;" />
                                    <ui:MenuItem Header="Save (Icon FontSize=12 wins)">
                                        <ui:MenuItem.Icon>
                                            <ui:SymbolIcon FontSize="12" Symbol="Save24" />
                                        </ui:MenuItem.Icon>
                                    </ui:MenuItem>
                                    <ui:MenuItem
                                        ui:ControlHelper.IconFontSize="28"
                                        Header="Share (item = 28)"
                                        Icon="&#xE72D;">
                                        <ui:MenuItem Header="Copy link" Icon="&#xE8C8;" />
                                        <ui:MenuItem Header="Email" Icon="&#xE715;" />
                                    </ui:MenuItem>
                                    <Separator />
                                    <ui:MenuItem Header="Exit" />
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                        </ui:Button>
                        <vio:DropDownButton Content="DropDownButton" Icon="{ui:SymbolIcon Fluent24}">
                            <vio:DropDownButton.Flyout>
                                <ContextMenu>
                                    <MenuItem Header="Add" />
                                    <MenuItem Header="Remove" />
                                    <MenuItem Header="Send">
                                        <MenuItem Header="As email" />
                                        <MenuItem Header="As file" />
                                        <MenuItem Header="To device">
                                            <MenuItem Header="Phone" />
                                            <MenuItem Header="Tablet" />
                                            <MenuItem Header="Desktop" />
                                        </MenuItem>
                                    </MenuItem>
                                    <MenuItem Header="Hello" />
                                </ContextMenu>
                            </vio:DropDownButton.Flyout>
                        </vio:DropDownButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="ContextMenu (right-click)" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Right-click below. ContextMenu sets IconFontSize=22 for all item icons."
                        TextWrapping="Wrap" />
                    <Border
                        Height="96"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Border.ContextMenu>
                            <ContextMenu ui:ControlHelper.IconFontSize="22">
                                <ui:MenuItem
                                    Header="Cut"
                                    Icon="{ui:SymbolIcon Cut24}"
                                    InputGestureText="CTRL+X" />
                                <ui:MenuItem
                                    Header="Copy"
                                    Icon="{ui:SymbolIcon Copy24}"
                                    InputGestureText="CTRL+C" />
                                <ui:MenuItem
                                    Header="Paste"
                                    Icon="{ui:SymbolIcon ClipboardPaste24}"
                                    InputGestureText="CTRL+V" />
                                <ui:MenuItem Header="Paste special">
                                    <ui:MenuItem Header="Keep text only" />
                                    <ui:MenuItem Header="Merge formatting" />
                                    <ui:MenuItem Header="Keep source formatting" />
                                </ui:MenuItem>
                                <Separator />
                                <ui:MenuItem Header="Select All" InputGestureText="CTRL+A" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Right-click here" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
