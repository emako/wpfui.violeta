<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Navigation.TabStripPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_TabStrip}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_TabStrip}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_09321a3297}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_319fe31ff0}}" />
                    <vio:TabStrip IndicatorAnimation="Fluent">
                        <vio:TabStripItem Content="{I18N {x:Static lang:LangKeys.Sample_3b878279a0}}" IsSelected="True" />
                        <vio:TabStripItem Content="{I18N {x:Static lang:LangKeys.Sample_3ec365dd53}}" />
                        <vio:TabStripItem Content="{I18N {x:Static lang:LangKeys.Gallery_Settings}}" />
                        <vio:TabStripItem Content="{I18N {x:Static lang:LangKeys.Sample_16d2b386b2}}" />
                    </vio:TabStrip>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_c09d2052d1}}" />
                    <vio:TabStrip Margin="0,8,0,0" IndicatorAnimation="Lengthening">
                        <vio:TabStripItem Content="{I18N {x:Static lang:LangKeys.Sample_3b878279a0}}" IsSelected="True" />
                        <vio:TabStripItem Content="{I18N {x:Static lang:LangKeys.Sample_3ec365dd53}}" />
                        <vio:TabStripItem Content="{I18N {x:Static lang:LangKeys.Gallery_Settings}}" />
                        <vio:TabStripItem Content="{I18N {x:Static lang:LangKeys.Sample_16d2b386b2}}" />
                    </vio:TabStrip>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_a5e9b0abe6}}" />
                    <vio:TabStrip Margin="0,8,0,12" Style="{DynamicResource CardTabStripStyle}">
                        <vio:TabStripItem Content="{I18N {x:Static lang:LangKeys.Sample_3b878279a0}}" IsSelected="True" />
                        <vio:TabStripItem Content="{I18N {x:Static lang:LangKeys.Sample_3ec365dd53}}" />
                        <vio:TabStripItem Content="{I18N {x:Static lang:LangKeys.Gallery_Settings}}" />
                        <vio:TabStripItem Content="{I18N {x:Static lang:LangKeys.Sample_16d2b386b2}}" />
                    </vio:TabStrip>
                    <vio:TabStrip Style="{DynamicResource ButtonTabStripStyle}">
                        <vio:TabStripItem Content="{I18N {x:Static lang:LangKeys.Sample_b1c94ca2fb}}" IsSelected="True" />
                        <vio:TabStripItem Content="{I18N {x:Static lang:LangKeys.Sample_4d3d769b81}}" />
                        <vio:TabStripItem Content="{I18N {x:Static lang:LangKeys.Sample_e99180abf4}}" />
                        <vio:TabStripItem Content="{I18N {x:Static lang:LangKeys.Sample_7d69b3cb4c}}" />
                    </vio:TabStrip>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_4402da40de}}" />
                    <vio:TabStrip Margin="0,8,0,0">
                        <vio:TabStripItem Content="{I18N {x:Static lang:LangKeys.Sample_4d3d769b81}}" IsSelected="True" />
                        <vio:TabStripItem Content="{I18N {x:Static lang:LangKeys.Sample_31fde7b05a}}" />
                        <vio:TabStripItem Content="{I18N {x:Static lang:LangKeys.Sample_453e6aa38d}}" IsEnabled="False" />
                    </vio:TabStrip>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
