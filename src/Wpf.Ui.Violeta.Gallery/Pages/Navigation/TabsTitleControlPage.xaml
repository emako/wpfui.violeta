<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Navigation.TabsTitleControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_TabsTitleControl}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_TabsTitleControl}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_8a641c5767}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_a724993e93}}" />
                    <vio:TabsTitleControl
                        x:Name="DemoTabs"
                        MinHeight="220"
                        AddTab="OnAddTab">
                        <vio:TabsTitleControlItem
                            Header="{I18N {x:Static lang:LangKeys.Gallery_Nav_Home}}"
                            IsSelected="True"
                            TextIcon="&#xE80F;">
                            <TextBlock
                                Margin="16"
                                Text="{I18N {x:Static lang:LangKeys.Sample_1bedbb9cef}}" />
                        </vio:TabsTitleControlItem>
                        <vio:TabsTitleControlItem
                            Header="{I18N {x:Static lang:LangKeys.Sample_f28128b38e}}"
                            TextIcon="&#xE8A5;">
                            <TextBlock
                                Margin="16"
                                Text="{I18N {x:Static lang:LangKeys.Sample_ca9bec0e51}}" />
                        </vio:TabsTitleControlItem>
                        <vio:TabsTitleControlItem
                            Header="{I18N {x:Static lang:LangKeys.Gallery_Settings}}"
                            TextIcon="&#xE713;">
                            <TextBlock
                                Margin="16"
                                Text="{I18N {x:Static lang:LangKeys.Sample_0f17a34a89}}" />
                        </vio:TabsTitleControlItem>
                    </vio:TabsTitleControl>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_0a2067aea1}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_244b326080}}" />
                    <vio:TabsTitleControl MinHeight="180" ShowAddButton="False">
                        <vio:TabsTitleControlItem
                            Header="{I18N {x:Static lang:LangKeys.Sample_3c5e891bff}}"
                            IsClosable="False"
                            IsSelected="True"
                            TextIcon="&#xE735;">
                            <TextBlock
                                Margin="16"
                                Text="{I18N {x:Static lang:LangKeys.Sample_6343675fe8}}" />
                        </vio:TabsTitleControlItem>
                        <vio:TabsTitleControlItem
                            Header="{I18N {x:Static lang:LangKeys.Sample_2c09e798bf}}"
                            IsClosable="True"
                            TextIcon="&#xE70F;">
                            <TextBlock
                                Margin="16"
                                Text="{I18N {x:Static lang:LangKeys.Sample_49874e6470}}" />
                        </vio:TabsTitleControlItem>
                    </vio:TabsTitleControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
