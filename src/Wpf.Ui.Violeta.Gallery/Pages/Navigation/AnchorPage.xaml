<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Navigation.AnchorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_Anchor}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,16"
            FontSize="20"
            FontWeight="SemiBold"
            Text="{I18N {x:Static lang:LangKeys.Gallery_Page_Anchor}}" />

        <Border
            Grid.Row="1"
            Padding="20"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <vio:Anchor
                    Grid.Column="0"
                    VerticalAlignment="Top"
                    TargetContainer="{Binding ElementName=AnchorScrollViewer}"
                    TopOffset="12">
                    <vio:AnchorItem AnchorId="sec1" Header="{I18N {x:Static lang:LangKeys.Sample_82a0805a73}}" />
                    <vio:AnchorItem AnchorId="sec2" Header="{I18N {x:Static lang:LangKeys.Sample_f2d02e9add}}">
                        <vio:AnchorItem AnchorId="sec2-1" Header="{I18N {x:Static lang:LangKeys.Sample_1542a2d801}}" />
                        <vio:AnchorItem AnchorId="sec2-2" Header="{I18N {x:Static lang:LangKeys.Sample_606cf8d121}}" />
                    </vio:AnchorItem>
                    <vio:AnchorItem AnchorId="sec3" Header="{I18N {x:Static lang:LangKeys.Sample_49fbc11c73}}" />
                    <vio:AnchorItem AnchorId="sec4" Header="{I18N {x:Static lang:LangKeys.Sample_7a26d26ce2}}" />
                </vio:Anchor>

                <ScrollViewer
                    x:Name="AnchorScrollViewer"
                    Grid.Column="1"
                    Padding="12,0"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            vio:Anchor.Id="sec1"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{I18N {x:Static lang:LangKeys.Sample_82a0805a73}}" />
                        <TextBlock
                            Margin="0,4,0,32"
                            Text="{I18N {x:Static lang:LangKeys.Sample_86a1afd027}}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            vio:Anchor.Id="sec2"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{I18N {x:Static lang:LangKeys.Sample_f2d02e9add}}" />
                        <TextBlock
                            Margin="0,4,0,16"
                            Text="{I18N {x:Static lang:LangKeys.Sample_9c64922ef8}}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            vio:Anchor.Id="sec2-1"
                            Margin="12,0,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{I18N {x:Static lang:LangKeys.Sample_faf9006158}}" />
                        <TextBlock
                            Margin="12,4,0,16"
                            Text="{I18N {x:Static lang:LangKeys.Sample_4473a9e79b}}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            vio:Anchor.Id="sec2-2"
                            Margin="12,0,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{I18N {x:Static lang:LangKeys.Sample_37eed58825}}" />
                        <TextBlock
                            Margin="12,4,0,32"
                            Text="{I18N {x:Static lang:LangKeys.Sample_26ae404d23}}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            vio:Anchor.Id="sec3"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{I18N {x:Static lang:LangKeys.Sample_49fbc11c73}}" />
                        <TextBlock
                            Margin="0,4,0,32"
                            Text="{I18N {x:Static lang:LangKeys.Sample_8e1dd99c8c}}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            vio:Anchor.Id="sec4"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{I18N {x:Static lang:LangKeys.Sample_7a26d26ce2}}" />
                        <TextBlock
                            Margin="0,4,0,48"
                            Text="{I18N {x:Static lang:LangKeys.Sample_1de8eaa668}}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,120"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Sample_af1f5437ae}}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</vio:Page>
