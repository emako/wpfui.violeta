<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Navigation.BreadcrumbBarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="BreadcrumbBar"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <vio:Page.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:BreadcrumbBarItem}}" TargetType="{x:Type ui:BreadcrumbBarItem}">
            <Setter Property="Icon">
                <Setter.Value>
                    <ui:IconSourceElement>
                        <ui:IconSourceElement.IconSource>
                            <ui:SymbolIconSource
                                FontSize="16"
                                FontWeight="Regular"
                                Symbol="ChevronRight24" />
                        </ui:IconSourceElement.IconSource>
                    </ui:IconSourceElement>
                </Setter.Value>
            </Setter>
            <Setter Property="FontWeight" Value="Regular" />
        </Style>
    </vio:Page.Resources>
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="BreadcrumbBar" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="字符串路径" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="ItemsSource 绑定字符串集合，展示层级导航路径。"
                        TextWrapping="Wrap" />
                    <ui:BreadcrumbBar x:Name="StringBreadcrumbBar" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="自定义 ItemTemplate" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="可通过 DataTemplate 自定义每一项的展示内容。"
                        TextWrapping="Wrap" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="12">
                        <ui:BreadcrumbBar x:Name="FolderBreadcrumbBar">
                            <ui:BreadcrumbBar.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" />
                                </DataTemplate>
                            </ui:BreadcrumbBar.ItemTemplate>
                        </ui:BreadcrumbBar>
                        <ui:Button Click="ResetFolders_Click" Content="Reset" />
                    </ui:StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
