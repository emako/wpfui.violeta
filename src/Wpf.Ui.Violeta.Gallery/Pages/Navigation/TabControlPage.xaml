                        <TabItem IsSelected="True">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="StoreMicrosoft16" />
                                    <TextBlock Text="{I18N {x:Static lang:LangKeys.Sample_4b111b983d}}" />
