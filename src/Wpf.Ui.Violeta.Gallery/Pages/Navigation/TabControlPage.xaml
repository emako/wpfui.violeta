                        </TabItem>
                        <TabItem Header="{I18N {x:Static lang:LangKeys.Gallery_Settings_Appearance}}" IsSelected="True">
                            <TextBlock Margin="12" Text="{I18N {x:Static lang:LangKeys.Sample_d12796b557}}" />
                        </TabItem>
                        <TabItem Header="{I18N {x:Static lang:LangKeys.Gallery_Settings_About}}">
                            <TextBlock Margin="12" Text="{I18N {x:Static lang:LangKeys.Sample_e25a537ce9}}" />
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Border>

