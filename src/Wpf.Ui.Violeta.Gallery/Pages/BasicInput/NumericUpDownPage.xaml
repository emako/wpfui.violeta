<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.NumericUpDownPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_NumericUpDown}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_NumericUpDown}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_5d961e79ff}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_2904a01f72}}" />
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_1cb6b64981}}" />
                            <vio:NumericIntUpDown
                                Width="200"
                                Maximum="100"
                                Minimum="-100"
                                PlaceholderText="{I18N {x:Static lang:LangKeys.Sample_88787e0a8d}}"
                                Step="5" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_31f73e0ba4}}" />
                            <vio:NumericDoubleUpDown
                                Width="200"
                                FormatString="N2"
                                Maximum="1"
                                Minimum="0"
                                PlaceholderText="0.00"
                                Step="0.1" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_86fc4ae7d8}}" />
                            <vio:NumericDecimalUpDown
                                Width="200"
                                FormatString="N2"
                                PlaceholderText="{I18N {x:Static lang:LangKeys.Sample_6e5cae44cd}}"
                                Step="0.01" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_aaf18794ce}}" />
                            <vio:NumericByteUpDown Width="200" PlaceholderText="{I18N {x:Static lang:LangKeys.Sample_04a9acc623}}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_61b1603587}}" />
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_851f5ac994}}" />
                            <vio:NumericDoubleUpDown
                                Width="200"
                                FormatString="N2"
                                InnerLeftContent="$"
                                Maximum="9999"
                                Minimum="0"
                                PlaceholderText="0.00" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_4ec1b477cd}}" />
                            <vio:NumericDoubleUpDown
                                Width="200"
                                FormatString="N1"
                                InnerRightContent="kg"
                                Maximum="9999"
                                Minimum="0"
                                PlaceholderText="{I18N {x:Static lang:LangKeys.Sample_7edabf994b}}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_3fea7ca76c}}" />
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_13cef07bc8}}" />
                            <vio:NumericIntUpDown
                                Width="200"
                                PlaceholderText="{I18N {x:Static lang:LangKeys.Sample_925dfa591d}}"
                                ShowButtonSpinner="False" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_7233b8e3ea}}" />
                            <vio:NumericIntUpDown
                                Width="200"
                                IsReadOnly="True"
                                Value="42" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_075ae3d2fc}}" />
                            <vio:NumericIntUpDown
                                Width="200"
                                IsEnabled="False"
                                Value="99" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_d530a2e8e8}}" />
                            <vio:NumericIntUpDown
                                Width="200"
                                AllowDrag="True"
                                Maximum="1000"
                                Minimum="-1000"
                                PlaceholderText="{I18N {x:Static lang:LangKeys.Sample_0929724039}}"
                                Step="10"
                                Value="0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
