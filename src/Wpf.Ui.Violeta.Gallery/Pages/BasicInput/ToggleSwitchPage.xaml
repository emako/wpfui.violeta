<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.ToggleSwitchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_ToggleSwitch}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_ToggleSwitch}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Page_ToggleSwitch}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_3d4319582e}}" />
                    <ui:StackPanel Orientation="Vertical" Spacing="8">
                        <ui:StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock
                                MinWidth="100"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_d6fa5df418}}" />
                            <ui:ToggleSwitch />
                        </ui:StackPanel>
                        <ui:StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock
                                MinWidth="100"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_StatusBar_BasicTitle}}" />
                            <vio:ToggleSwitch />
                        </ui:StackPanel>
                        <ui:StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock
                                MinWidth="100"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_ec3f5ff99b}}" />
                            <vio:ToggleSwitch IsOn="True" />
                        </ui:StackPanel>
                        <ui:StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock
                                MinWidth="100"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_bf50d5e661}}" />
                            <vio:ToggleSwitch Header="{I18N {x:Static lang:LangKeys.Sample_fa524b7254}}" IsOn="True" />
                        </ui:StackPanel>
                        <ui:StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock
                                MinWidth="100"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_fabd943254}}" />
                            <vio:ToggleSwitch OffContent="{I18N {x:Static lang:LangKeys.Sample_dce5379cb9}}" OnContent="{I18N {x:Static lang:LangKeys.Sample_4d775d4cd7}}" />
                        </ui:StackPanel>
                        <ui:StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock
                                MinWidth="100"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_b9f5c797eb}}" />
                            <vio:ToggleSwitch IsEnabled="False" />
                        </ui:StackPanel>
                        <ui:StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock
                                MinWidth="100"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_f944265643}}" />
                            <vio:ToggleSwitch
                                Header="{I18N {x:Static lang:LangKeys.Sample_0a4e486218}}"
                                IsOn="True"
                                IsRightAlignedCompact="True" />
                        </ui:StackPanel>
                    </ui:StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
