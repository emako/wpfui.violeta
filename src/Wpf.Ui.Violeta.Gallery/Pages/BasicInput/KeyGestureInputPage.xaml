<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.KeyGestureInputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="KeyGestureInput"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="KeyGestureInput" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_1dc0650f80}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_5a6fd6d939}}" />
                    <StackPanel>
                        <vio:KeyGestureInput
                            Width="280"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            PlaceholderText="{I18N {x:Static lang:LangKeys.Sample_2c06ec4e6e}}" />
                        <vio:KeyGestureInput
                            Width="280"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            ConsiderKeyModifiers="False"
                            PlaceholderText="Press any single key..." />
                        <vio:KeyGestureInput
                            Width="280"
                            HorizontalAlignment="Left"
                            ClearButtonEnabled="True"
                            IsReadOnly="True"
                            PlaceholderText="Press shortcut, then clear..." />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
