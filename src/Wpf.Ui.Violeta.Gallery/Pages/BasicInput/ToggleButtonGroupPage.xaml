<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.ToggleButtonGroupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_ToggleButtonGroup}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_ToggleButtonGroup}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Page_ToggleButtonGroup}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_c4aadfd0cd}}" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:StackPanel.Resources>
                            <vio:ToggleButtonGroup x:Key="ToggleButtonGroup" IsCanCancel="True" />
                        </ui:StackPanel.Resources>
                        <ToggleButton
                            vio:ToggleButtonGroup.Group="{DynamicResource ToggleButtonGroup}"
                            Content="{I18N {x:Static lang:LangKeys.Sample_ec31383cc7}}"
                            IsChecked="True" />
                        <ToggleButton vio:ToggleButtonGroup.Group="{DynamicResource ToggleButtonGroup}" Content="{I18N {x:Static lang:LangKeys.Sample_9d5f1209e8}}" />
                        <ToggleButton vio:ToggleButtonGroup.Group="{DynamicResource ToggleButtonGroup}" Content="{I18N {x:Static lang:LangKeys.Sample_b7b655045b}}" />
                    </ui:StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_1e0d090cf9}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_60a24f6dd6}}" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:StackPanel.Resources>
                            <vio:ToggleButtonGroup x:Key="MixedToggleGroup" IsCanCancel="True" />
                            <x:Array x:Key="MixedToggleItems" Type="{x:Type sys:String}">
                                <sys:String>A</sys:String>
                                <sys:String>B</sys:String>
                                <sys:String>C</sys:String>
                            </x:Array>
                        </ui:StackPanel.Resources>
                        <ToggleButton
                            vio:ToggleButtonGroup.Group="{DynamicResource MixedToggleGroup}"
                            Content="{I18N {x:Static lang:LangKeys.Sample_ec31383cc7}}"
                            IsChecked="True" />
                        <vio:ToggleComboBox
                            MinWidth="120"
                            vio:ToggleButtonGroup.Group="{DynamicResource MixedToggleGroup}"
                            Content="{I18N {x:Static lang:LangKeys.Sample_9d5f1209e8}}"
                            ItemsSource="{DynamicResource MixedToggleItems}" />
                        <ToggleButton
                            vio:ToggleButtonGroup.Group="{DynamicResource MixedToggleGroup}"
                            Content="{I18N {x:Static lang:LangKeys.Sample_b7b655045b}}" />
                    </ui:StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_d4e90d2491}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_05b03511cb}}" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:StackPanel.Resources>
                            <vio:RadioButtonGroup x:Key="RadioButtonGroup" />
                        </ui:StackPanel.Resources>
                        <RadioButton
                            MinWidth="0"
                            vio:RadioButtonGroup.Group="{DynamicResource RadioButtonGroup}"
                            Content="{I18N {x:Static lang:LangKeys.Sample_ec31383cc7}}"
                            IsChecked="True" />
                        <RadioButton
                            MinWidth="0"
                            vio:RadioButtonGroup.Group="{DynamicResource RadioButtonGroup}"
                            Content="{I18N {x:Static lang:LangKeys.Sample_9d5f1209e8}}" />
                        <RadioButton
                            MinWidth="0"
                            vio:RadioButtonGroup.Group="{DynamicResource RadioButtonGroup}"
                            Content="{I18N {x:Static lang:LangKeys.Sample_b7b655045b}}" />
                    </ui:StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
