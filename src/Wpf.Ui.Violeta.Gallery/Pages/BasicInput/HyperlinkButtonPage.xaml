<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.HyperlinkButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="HyperlinkButton"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="HyperlinkButton" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Hyperlink" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="带 NavigateUri 的超链接按钮。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:HyperlinkButton
                            x:Name="Hyperlink"
                            Grid.Column="0"
                            Content="WPF UI hyperlink"
                            Icon="{ui:SymbolIcon Link24}"
                            NavigateUri="https://lepo.co/" />
                        <CheckBox
                            Grid.Column="1"
                            Checked="DisableHyperlink_Checked"
                            Content="Disable hyperlink"
                            Unchecked="DisableHyperlink_Unchecked" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Icons" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="FontIcon 与 ImageIcon 示例。" />
                    <ui:StackPanel Orientation="Vertical" Spacing="8">
                        <ui:HyperlinkButton
                            Content="FontIcon hyperlink"
                            Icon="{ui:FontIcon '&#x1F308;'}"
                            NavigateUri="https://lepo.co/" />
                        <ui:HyperlinkButton
                            Content="ImageIcon hyperlink"
                            Icon="{ui:ImageIcon 'pack://application:,,,/Wpf.Ui.Violeta.Gallery;component/Resources/Images/wpfui.png'}"
                            NavigateUri="https://lepo.co/" />
                    </ui:StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
