<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.CopyButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="CopyButton"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="CopyButton" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Basic" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Click to copy TextToCopy and play the WinUI-style checkmark animation."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:CopyButton Margin="0,0,8,0" TextToCopy="Hello from CopyButton" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="← click me" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Appearance" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Inherits WPF UI Button appearances."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:CopyButton
                            Margin="0,0,8,0"
                            Appearance="Secondary"
                            TextToCopy="Secondary" />
                        <vio:CopyButton
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            TextToCopy="Primary" />
                        <vio:CopyButton
                            Margin="0,0,8,0"
                            Appearance="Danger"
                            TextToCopy="Danger" />
                        <vio:CopyButton Appearance="Success" TextToCopy="Success" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Icon" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Uses Wpf.Ui Button.Icon. Clear Content when icon-only."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:CopyButton
                            Margin="0,0,8,0"
                            Content="{x:Null}"
                            TextToCopy="SymbolIcon Copy24">
                            <vio:CopyButton.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </vio:CopyButton.Icon>
                        </vio:CopyButton>
                        <vio:CopyButton
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            Content="Copy"
                            FontSize="13"
                            TextToCopy="Icon + text">
                            <vio:CopyButton.Icon>
                                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" />
                            </vio:CopyButton.Icon>
                        </vio:CopyButton>
                        <vio:CopyButton
                            Content="{x:Null}"
                            SuccessGlyph="&#xE8FB;"
                            TextToCopy="Custom success glyph">
                            <vio:CopyButton.Icon>
                                <ui:SymbolIcon Symbol="Clipboard24" />
                            </vio:CopyButton.Icon>
                        </vio:CopyButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Custom click" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Leave TextToCopy empty and handle clipboard yourself; animation still plays on Click."
                        TextWrapping="Wrap" />
                    <ui:TextBox
                        x:Name="CustomTextBox"
                        Margin="0,0,0,12"
                        Text="Custom clipboard payload" />
                    <vio:CopyButton Click="CustomCopyButton_Click" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Beside text" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Typical code / color tile layout."
                        TextWrapping="Wrap" />
                    <Border
                        Padding="12,8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                Text="#FF0078D4" />
                            <vio:CopyButton
                                HorizontalAlignment="Right"
                                Appearance="Secondary"
                                TextToCopy="#FF0078D4" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
