<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.CopyButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_CopyButton}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_CopyButton}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_StatusBar_BasicTitle}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_3098f1d77b}}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:CopyButton Margin="0,0,8,0" TextToCopy="Hello from CopyButton" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Sample_8329093ddf}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_Appearance}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_058f4b0139}}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:CopyButton
                            Margin="0,0,8,0"
                            Appearance="Secondary"
                            TextToCopy="Secondary" />
                        <vio:CopyButton
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            TextToCopy="Primary" />
                        <vio:CopyButton
                            Margin="0,0,8,0"
                            Appearance="Danger"
                            TextToCopy="Danger" />
                        <vio:CopyButton Appearance="Success" TextToCopy="Success" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_fbf399e379}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_0083ea3fa5}}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:CopyButton
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            ui:ControlHelper.IconFontSize="12"
                            TextToCopy="size 12" />
                        <vio:CopyButton
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            TextToCopy="size 16 default" />
                        <vio:CopyButton
                            VerticalAlignment="Center"
                            ui:ControlHelper.IconFontSize="28"
                            TextToCopy="size 28" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_1a93b64678}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_8f97956fd7}}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:CopyButton
                            Margin="0,0,8,0"
                            Content="{x:Null}"
                            ui:ControlHelper.IconFontSize="14"
                            TextToCopy="icon inherit 14">
                            <vio:CopyButton.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </vio:CopyButton.Icon>
                        </vio:CopyButton>
                        <vio:CopyButton
                            Margin="0,0,8,0"
                            Content="{x:Null}"
                            ui:ControlHelper.IconFontSize="22"
                            TextToCopy="icon inherit 22">
                            <vio:CopyButton.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </vio:CopyButton.Icon>
                        </vio:CopyButton>
                        <vio:CopyButton
                            Content="{x:Null}"
                            ui:ControlHelper.IconFontSize="30"
                            TextToCopy="icon inherit 30">
                            <vio:CopyButton.Icon>
                                <ui:SymbolIcon Symbol="Clipboard24" />
                            </vio:CopyButton.Icon>
                        </vio:CopyButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_8dae381aff}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_405bca6066}}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,0">
                            <vio:CopyButton
                                HorizontalAlignment="Center"
                                Content="{x:Null}"
                                ui:ControlHelper.IconFontSize="28"
                                TextToCopy="icon local 12">
                                <vio:CopyButton.Icon>
                                    <ui:SymbolIcon FontSize="12" Symbol="Copy24" />
                                </vio:CopyButton.Icon>
                            </vio:CopyButton>
                            <TextBlock
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_5804482520}}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <vio:CopyButton
                                HorizontalAlignment="Center"
                                Content="{x:Null}"
                                ui:ControlHelper.IconFontSize="28"
                                TextToCopy="icon local 16">
                                <vio:CopyButton.Icon>
                                    <ui:SymbolIcon FontSize="16" Symbol="Copy24" />
                                </vio:CopyButton.Icon>
                            </vio:CopyButton>
                            <TextBlock
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_0ba128aeb4}}" />
                        </StackPanel>
                        <StackPanel>
                            <vio:CopyButton
                                HorizontalAlignment="Center"
                                Content="{x:Null}"
                                ui:ControlHelper.IconFontSize="28"
                                TextToCopy="helper 28">
                                <vio:CopyButton.Icon>
                                    <ui:SymbolIcon Symbol="Copy24" />
                                </vio:CopyButton.Icon>
                            </vio:CopyButton>
                            <TextBlock
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_2a309c7843}}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_dc0a3d4565}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_af320f2b89}}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:CopyButton
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            Content="{I18N {x:Static lang:LangKeys.Sample_79d3abe929}}"
                            FontSize="11"
                            ui:ControlHelper.IconFontSize="22"
                            TextToCopy="small text large icon">
                            <vio:CopyButton.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </vio:CopyButton.Icon>
                        </vio:CopyButton>
                        <vio:CopyButton
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            Content="{I18N {x:Static lang:LangKeys.Sample_79d3abe929}}"
                            FontSize="18"
                            ui:ControlHelper.IconFontSize="12"
                            TextToCopy="large text small icon">
                            <vio:CopyButton.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </vio:CopyButton.Icon>
                        </vio:CopyButton>
                        <vio:CopyButton
                            Appearance="Secondary"
                            Content="{I18N {x:Static lang:LangKeys.Sample_b758336699}}"
                            FontSize="13"
                            ui:ControlHelper.IconFontSize="16"
                            TextToCopy="balanced">
                            <vio:CopyButton.Icon>
                                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" />
                            </vio:CopyButton.Icon>
                        </vio:CopyButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_15c61d5baf}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_77146a4531}}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:CopyButton
                            Margin="0,0,8,0"
                            SuccessGlyph="&#xE8FB;"
                            ui:ControlHelper.IconFontFamily="{DynamicResource SymbolThemeFontFamily}"
                            ui:ControlHelper.IconFontSize="20"
                            TextToCopy="AcceptMedium-style success" />
                        <vio:CopyButton
                            Content="{x:Null}"
                            SuccessGlyph="&#xE73E;"
                            ui:ControlHelper.IconFontSize="24"
                            TextToCopy="Fluent clipboard">
                            <vio:CopyButton.Icon>
                                <ui:SymbolIcon Symbol="Clipboard24" />
                            </vio:CopyButton.Icon>
                        </vio:CopyButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_eab08f976e}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_d04ee88f76}}"
                        TextWrapping="Wrap" />
                    <ui:TextBox
                        x:Name="CustomTextBox"
                        Margin="0,0,0,12"
                        Text="{I18N {x:Static lang:LangKeys.Sample_aaaaf95453}}" />
                    <StackPanel Orientation="Horizontal">
                        <vio:CopyButton
                            Margin="0,0,8,0"
                            Click="CustomCopyButton_Click"
                            Content="{I18N {x:Static lang:LangKeys.Sample_b603b043e8}}"
                            FontSize="12"
                            ui:ControlHelper.IconFontSize="16">
                            <vio:CopyButton.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </vio:CopyButton.Icon>
                        </vio:CopyButton>
                        <vio:CopyButton Click="CustomCopyButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_be085e490f}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_22b093f15e}}"
                        TextWrapping="Wrap" />
                    <Border
                        Padding="12,8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                Text="#FF0078D4" />
                            <vio:CopyButton
                                HorizontalAlignment="Right"
                                Appearance="Secondary"
                                ui:ControlHelper.IconFontSize="14"
                                TextToCopy="#FF0078D4" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
