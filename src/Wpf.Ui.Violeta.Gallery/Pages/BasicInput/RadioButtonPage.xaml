<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.RadioButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_RadioButton}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_RadioButton}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_7c245edeb1}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_7e8aef110d}}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="RadioGroup" Grid.Column="0">
                            <RadioButton
                                Content="{I18N {x:Static lang:LangKeys.Sample_fd577a8bfd}}"
                                GroupName="radio_group_one"
                                IsChecked="True" />
                            <RadioButton Content="{I18N {x:Static lang:LangKeys.Sample_e24963e407}}" GroupName="radio_group_one" />
                            <RadioButton Content="{I18N {x:Static lang:LangKeys.Sample_fbeee6bcd1}}" GroupName="radio_group_one" />
                        </StackPanel>
                        <CheckBox
                            Grid.Column="1"
                            Checked="DisableRadioButtons_Checked"
                            Content="{I18N {x:Static lang:LangKeys.Sample_7f917a32f0}}"
                            Unchecked="DisableRadioButtons_Unchecked" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_9f94e42711}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_feefa735f7}}" />
                    <StackPanel>
                        <RadioButton
                            Content="{I18N {x:Static lang:LangKeys.Sample_fd577a8bfd}}"
                            FlowDirection="RightToLeft"
                            GroupName="radio_group_two"
                            IsChecked="True" />
                        <RadioButton
                            Content="{I18N {x:Static lang:LangKeys.Sample_e24963e407}}"
                            FlowDirection="RightToLeft"
                            GroupName="radio_group_two" />
                        <RadioButton
                            Content="{I18N {x:Static lang:LangKeys.Sample_fbeee6bcd1}}"
                            FlowDirection="RightToLeft"
                            GroupName="radio_group_two" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
