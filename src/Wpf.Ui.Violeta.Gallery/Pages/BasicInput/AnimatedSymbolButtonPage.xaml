                        Text="{I18N {x:Static lang:LangKeys.Sample_8c07d7e61c}}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:AnimatedSymbolButton Margin="0,0,8,0" Kind="GlobalNavigationButton" />
                        <vio:AnimatedSymbolButton Content="{I18N {x:Static lang:LangKeys.Gallery_Page_Menu}}" Kind="GlobalNavigationButton" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
