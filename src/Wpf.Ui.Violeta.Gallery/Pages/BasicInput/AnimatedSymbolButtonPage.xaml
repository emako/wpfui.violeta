<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.AnimatedSymbolButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="AnimatedSymbolButton"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,4"
                FontSize="20"
                FontWeight="SemiBold"
                Text="AnimatedSymbolButton" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Kind mirrors AnimatedVisuals. Override icons via IconFontFamily / IconFontSize / IconGlyph and SecondaryIcon* (two-glyph kinds)."
                TextWrapping="Wrap" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Back" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="AnimatedBackVisualSource — RightToLeft ScaleX (TitleBar / GoBackButton)."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:AnimatedSymbolButton Margin="0,0,8,0" Kind="Back" />
                        <vio:AnimatedSymbolButton Content="Back" Kind="Back" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Settings" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="AnimatedSettingsVisualSource — wind back + full turn (NavigationView settings)."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:AnimatedSymbolButton Margin="0,0,8,0" Kind="Settings" />
                        <vio:AnimatedSymbolButton Content="Settings" Kind="Settings" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="ChevronDownSmall" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="AnimatedChevronDownSmallVisualSource — clipped translate (DropDownButton). Trailing chevron after Content."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:AnimatedSymbolButton Margin="0,0,8,0" Kind="ChevronDownSmall" />
                        <vio:AnimatedSymbolButton
                            Content="More"
                            Kind="ChevronDownSmall" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="ChevronUpDownSmall" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="AnimatedChevronUpDownSmallVisualSource — click toggles IsExpanded (ComboBox chevron)."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:AnimatedSymbolButton Margin="0,0,8,0" Kind="ChevronUpDownSmall" />
                        <vio:AnimatedSymbolButton
                            Content="Open"
                            Kind="ChevronUpDownSmall" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="GlobalNavigationButton" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="AnimatedGlobalNavigationButtonVisualSource — Segoe GlobalNavButton E700 (not Fluent F4E1)."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:AnimatedSymbolButton Margin="0,0,8,0" Kind="GlobalNavigationButton" />
                        <vio:AnimatedSymbolButton Content="Menu" Kind="GlobalNavigationButton" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="CopyToClipboard" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="WinUI Gallery CopyToClipboardSuccessAnimation — copy → Accept (CopyButton)."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:AnimatedSymbolButton
                            Margin="0,0,8,0"
                            Kind="CopyToClipboard"
                            TextToCopy="Hello from AnimatedSymbolButton" />
                        <vio:AnimatedSymbolButton
                            Content="Copy"
                            Kind="CopyToClipboard"
                            TextToCopy="Hello from AnimatedSymbolButton" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
