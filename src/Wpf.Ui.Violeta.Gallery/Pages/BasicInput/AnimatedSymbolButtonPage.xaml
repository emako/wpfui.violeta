                        <vio:AnimatedSymbolButton Margin="0,0,8,0" Kind="ChevronUpDownSmall" />
                        <vio:AnimatedSymbolButton
                            Content="{I18N {x:Static lang:LangKeys.Sample_d7098f5050}}"
                            Kind="ChevronUpDownSmall" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
