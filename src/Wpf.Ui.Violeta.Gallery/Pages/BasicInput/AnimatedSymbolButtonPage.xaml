                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_b9f5c797eb}}" />
                    <StackPanel Orientation="Horizontal">
                        <vio:AnimatedSymbolButton
                            Margin="0,0,8,0"
                            Content="{I18N {x:Static lang:LangKeys.Sample_d26fbd7e76}}"
                            IsEnabled="False"
                            IsLoading="False"
                            Kind="Spin" />
                        <vio:AnimatedSymbolButton
                            Appearance="Primary"
                            Content="{I18N {x:Static lang:LangKeys.Sample_2a342abec2}}"
                            IsEnabled="False"
                            IsLoading="True"
                            Kind="Spin" />
                    </StackPanel>
