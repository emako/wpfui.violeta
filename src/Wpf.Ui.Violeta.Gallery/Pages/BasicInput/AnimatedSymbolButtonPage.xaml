                        Text="{I18N {x:Static lang:LangKeys.Sample_23509bcfde}}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:AnimatedSymbolButton
                            Margin="0,0,8,0"
                            Appearance="Secondary"
                            Click="SpinButton_Click"
                            Content="{I18N {x:Static lang:LangKeys.Sample_939d5345ad}}"
                            Kind="Spin" />
                        <vio:AnimatedSymbolButton
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            Click="SpinButton_Click"
                            Content="{I18N {x:Static lang:LangKeys.Sample_939d5345ad}}"
                            Kind="Spin" />
