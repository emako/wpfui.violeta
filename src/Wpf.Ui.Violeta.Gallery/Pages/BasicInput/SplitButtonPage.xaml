<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.SplitButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="SplitButton"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="SplitButton" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="SplitButton" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_8813989799}}" />
                    <vio:SplitButton Icon="{ui:SymbolIcon PaintBrush24}">
                        <Border
                            Width="35"
                            Height="20"
                            Background="Green"
                            CornerRadius="4" />
                        <vio:SplitButton.Flyout>
                            <ContextMenu>
                                <MenuItem>
                                    <MenuItem.Header>
                                        <Border
                                            Width="35"
                                            Height="20"
                                            Background="Red"
                                            CornerRadius="4" />
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem>
                                    <MenuItem.Header>
                                        <Border
                                            Width="35"
                                            Height="20"
                                            Background="Blue"
                                            CornerRadius="4" />
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem>
                                    <MenuItem.Header>
                                        <Border
                                            Width="35"
                                            Height="20"
                                            Background="White"
                                            CornerRadius="4" />
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </vio:SplitButton.Flyout>
                    </vio:SplitButton>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Custom padding" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_d0dcd65d52}}" />
                    <vio:SplitButton Padding="0" CornerRadius="4">
                        <Border
                            Width="35"
                            Height="25"
                            Background="Green"
                            CornerRadius="4,0,0,4" />
                        <vio:SplitButton.Flyout>
                            <ContextMenu>
                                <MenuItem>
                                    <MenuItem.Header>
                                        <Border
                                            Width="35"
                                            Height="20"
                                            Background="Red"
                                            CornerRadius="4" />
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem>
                                    <MenuItem.Header>
                                        <Border
                                            Width="35"
                                            Height="20"
                                            Background="Blue"
                                            CornerRadius="4" />
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem>
                                    <MenuItem.Header>
                                        <Border
                                            Width="35"
                                            Height="20"
                                            Background="White"
                                            CornerRadius="4" />
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </vio:SplitButton.Flyout>
                    </vio:SplitButton>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
