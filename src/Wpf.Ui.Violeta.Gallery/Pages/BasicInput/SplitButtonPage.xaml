<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.SplitButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_SplitButton}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,4"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_SplitButton}}" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Sample_8813989799}}"
                TextWrapping="Wrap" />

            <!--  1. Basic: primary click + flyout commands  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_866c8bd883}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_SplitButton_PrimaryFlyoutDesc}}" />
                    <StackPanel Orientation="Horizontal">
                        <vio:SplitButton
                            x:Name="SaveSplitButton"
                            Click="SaveSplitButton_OnClick"
                            Content="{I18N {x:Static lang:LangKeys.Sample_be5fbbe34c}}"
                            Icon="{ui:SymbolIcon Save24}">
                            <vio:SplitButton.Flyout>
                                <ContextMenu>
                                    <MenuItem
                                        Click="FlyoutMenuItem_OnClick"
                                        Header="{I18N {x:Static lang:LangKeys.Sample_be5fbbe34c}}"
                                        Tag="Save" />
                                    <MenuItem
                                        Click="FlyoutMenuItem_OnClick"
                                        Header="{I18N {x:Static lang:LangKeys.Sample_b857d6cf4f}}"
                                        Tag="Save As…" />
                                    <Separator />
                                    <MenuItem
                                        Click="FlyoutMenuItem_OnClick"
                                        Header="{I18N {x:Static lang:LangKeys.Sample_af80706065}}"
                                        Tag="Export PDF" />
                                    <MenuItem
                                        Click="FlyoutMenuItem_OnClick"
                                        Header="{I18N {x:Static lang:LangKeys.Sample_5a78b83e98}}"
                                        Tag="Export Image" />
                                </ContextMenu>
                            </vio:SplitButton.Flyout>
                        </vio:SplitButton>
                        <TextBlock
                            x:Name="SaveStatusText"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Sample_136e16706d}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  2. Command + DoubleCommand  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_66fff5b8e3}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_9488273dae}}" />
                    <StackPanel Orientation="Horizontal">
                        <vio:SplitButton
                            x:Name="CommandSplitButton"
                            Command="{Binding PrimaryCommand}"
                            Content="{I18N {x:Static lang:LangKeys.Sample_9639e32cab}}"
                            DoubleCommand="{Binding DoubleCommand}"
                            Icon="{ui:SymbolIcon Checkmark24}">
                            <vio:SplitButton.Flyout>
                                <ContextMenu>
                                    <MenuItem
                                        Click="FlyoutMenuItem_OnClick"
                                        Header="{I18N {x:Static lang:LangKeys.Sample_9639e32cab}}"
                                        Tag="Apply" />
                                    <MenuItem
                                        Click="FlyoutMenuItem_OnClick"
                                        Header="{I18N {x:Static lang:LangKeys.Sample_31fde7b05a}}"
                                        Tag="Preview" />
                                    <MenuItem
                                        Click="FlyoutMenuItem_OnClick"
                                        Header="{I18N {x:Static lang:LangKeys.Sample_4b9c3271dc}}"
                                        Tag="Reset" />
                                </ContextMenu>
                            </vio:SplitButton.Flyout>
                        </vio:SplitButton>
                        <TextBlock
                            x:Name="CommandStatusText"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Sample_136e16706d}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  3. Nested flyout  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_ea43fd3483}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_SplitButton_NestedFlyoutDesc}}" />
                    <StackPanel Orientation="Horizontal">
                        <vio:SplitButton
                            Click="ShareSplitButton_OnClick"
                            Content="{I18N {x:Static lang:LangKeys.Sample_5a95a425f7}}"
                            Icon="{ui:SymbolIcon Share24}">
                            <vio:SplitButton.Flyout>
                                <ContextMenu>
                                    <MenuItem
                                        Click="FlyoutMenuItem_OnClick"
                                        Header="{I18N {x:Static lang:LangKeys.Sample_b758336699}}"
                                        Tag="Copy link" />
                                    <MenuItem Header="{I18N {x:Static lang:LangKeys.Sample_94966d9074}}">
                                        <MenuItem
                                            Click="FlyoutMenuItem_OnClick"
                                            Header="{I18N {x:Static lang:LangKeys.Sample_5f07e1c9a6}}"
                                            Tag="Send as email" />
                                        <MenuItem
                                            Click="FlyoutMenuItem_OnClick"
                                            Header="{I18N {x:Static lang:LangKeys.Sample_cd3668b9d5}}"
                                            Tag="Send as file" />
                                        <MenuItem Header="{I18N {x:Static lang:LangKeys.Sample_0b05d4ec1b}}">
                                            <MenuItem
                                                Click="FlyoutMenuItem_OnClick"
                                                Header="{I18N {x:Static lang:LangKeys.Sample_bcc254b55c}}"
                                                Tag="Send to Phone" />
                                            <MenuItem
                                                Click="FlyoutMenuItem_OnClick"
                                                Header="{I18N {x:Static lang:LangKeys.Sample_36384a9ea3}}"
                                                Tag="Send to Tablet" />
                                            <MenuItem
                                                Click="FlyoutMenuItem_OnClick"
                                                Header="{I18N {x:Static lang:LangKeys.Sample_2310408a63}}"
                                                Tag="Send to Desktop" />
                                        </MenuItem>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem
                                        Click="FlyoutMenuItem_OnClick"
                                        Header="{I18N {x:Static lang:LangKeys.Sample_83611abd5f}}"
                                        Tag="Publish" />
                                </ContextMenu>
                            </vio:SplitButton.Flyout>
                        </vio:SplitButton>
                        <TextBlock
                            x:Name="ShareStatusText"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Sample_136e16706d}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  4. Appearance  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_Appearance}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_SplitButton_AppearanceDesc}}" />
                    <WrapPanel>
                        <vio:SplitButton
                            Margin="0,0,12,8"
                            Appearance="Primary"
                            Click="AppearanceSplitButton_OnClick"
                            Content="{I18N {x:Static lang:LangKeys.Sample_074de7e7c2}}"
                            Tag="Primary">
                            <vio:SplitButton.Flyout>
                                <ContextMenu>
                                    <MenuItem
                                        Click="FlyoutMenuItem_OnClick"
                                        Header="{I18N {x:Static lang:LangKeys.Sample_e04cead454}}"
                                        Tag="Primary · Option A" />
                                    <MenuItem
                                        Click="FlyoutMenuItem_OnClick"
                                        Header="{I18N {x:Static lang:LangKeys.Sample_d581ed5da9}}"
                                        Tag="Primary · Option B" />
                                </ContextMenu>
                            </vio:SplitButton.Flyout>
                        </vio:SplitButton>
                        <vio:SplitButton
                            Margin="0,0,12,8"
                            Appearance="Secondary"
                            Click="AppearanceSplitButton_OnClick"
                            Content="{I18N {x:Static lang:LangKeys.Sample_0c7d6cf194}}"
                            Tag="Secondary">
                            <vio:SplitButton.Flyout>
                                <ContextMenu>
                                    <MenuItem
                                        Click="FlyoutMenuItem_OnClick"
                                        Header="{I18N {x:Static lang:LangKeys.Sample_e04cead454}}"
                                        Tag="Secondary · Option A" />
                                    <MenuItem
                                        Click="FlyoutMenuItem_OnClick"
                                        Header="{I18N {x:Static lang:LangKeys.Sample_d581ed5da9}}"
                                        Tag="Secondary · Option B" />
                                </ContextMenu>
                            </vio:SplitButton.Flyout>
                        </vio:SplitButton>
                        <vio:SplitButton
                            Margin="0,0,12,8"
                            Appearance="Danger"
                            Click="AppearanceSplitButton_OnClick"
                            Content="{I18N {x:Static lang:LangKeys.Sample_990816b607}}"
                            Tag="Danger">
                            <vio:SplitButton.Flyout>
                                <ContextMenu>
                                    <MenuItem
                                        Click="FlyoutMenuItem_OnClick"
                                        Header="{I18N {x:Static lang:LangKeys.Sample_f2a6c498fb}}"
                                        Tag="Danger · Delete" />
                                    <MenuItem
                                        Click="FlyoutMenuItem_OnClick"
                                        Header="{I18N {x:Static lang:LangKeys.Sample_e727b00944}}"
                                        Tag="Danger · Archive" />
                                </ContextMenu>
                            </vio:SplitButton.Flyout>
                        </vio:SplitButton>
                    </WrapPanel>
                    <TextBlock
                        x:Name="AppearanceStatusText"
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_136e16706d}}" />
                </StackPanel>
            </Border>

            <!--  5. Color swatch (interactive)  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_d4f7b9383f}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_SplitButton_ColorSwatchDesc}}" />
                    <StackPanel Orientation="Horizontal">
                        <vio:SplitButton
                            x:Name="ColorSplitButton"
                            Click="ColorSplitButton_OnClick"
                            Icon="{ui:SymbolIcon PaintBrush24}">
                            <Border
                                x:Name="ColorSwatch"
                                Width="35"
                                Height="20"
                                Background="Green"
                                CornerRadius="4" />
                            <vio:SplitButton.Flyout>
                                <ContextMenu>
                                    <MenuItem Click="ColorMenuItem_OnClick" Tag="#E81123">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="35"
                                                    Height="20"
                                                    Background="#E81123"
                                                    CornerRadius="4" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{I18N {x:Static lang:LangKeys.Sample_ee38e4d5dd}}" />
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Click="ColorMenuItem_OnClick" Tag="#107C10">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="35"
                                                    Height="20"
                                                    Background="#107C10"
                                                    CornerRadius="4" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{I18N {x:Static lang:LangKeys.Sample_d382816a3c}}" />
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Click="ColorMenuItem_OnClick" Tag="#0078D4">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="35"
                                                    Height="20"
                                                    Background="#0078D4"
                                                    CornerRadius="4" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{I18N {x:Static lang:LangKeys.Sample_9c9aabab3f}}" />
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Click="ColorMenuItem_OnClick" Tag="#FFFFFF">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="35"
                                                    Height="20"
                                                    Background="White"
                                                    BorderBrush="#808080"
                                                    BorderThickness="1"
                                                    CornerRadius="4" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{I18N {x:Static lang:LangKeys.Sample_2fc96b2704}}" />
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ContextMenu>
                            </vio:SplitButton.Flyout>
                        </vio:SplitButton>
                        <TextBlock
                            x:Name="ColorStatusText"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Sample_136e16706d}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  6. Custom padding  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_5bbbdab07a}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_d0dcd65d52}}" />
                    <vio:SplitButton
                        Padding="0"
                        Click="ColorSplitButton_OnClick"
                        CornerRadius="4">
                        <Border
                            Width="35"
                            Height="25"
                            Background="Green"
                            CornerRadius="4,0,0,4" />
                        <vio:SplitButton.Flyout>
                            <ContextMenu>
                                <MenuItem Click="ColorMenuItem_OnClick" Tag="#E81123">
                                    <MenuItem.Header>
                                        <Border
                                            Width="35"
                                            Height="20"
                                            Background="#E81123"
                                            CornerRadius="4" />
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Click="ColorMenuItem_OnClick" Tag="#107C10">
                                    <MenuItem.Header>
                                        <Border
                                            Width="35"
                                            Height="20"
                                            Background="#107C10"
                                            CornerRadius="4" />
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Click="ColorMenuItem_OnClick" Tag="#0078D4">
                                    <MenuItem.Header>
                                        <Border
                                            Width="35"
                                            Height="20"
                                            Background="#0078D4"
                                            CornerRadius="4" />
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </vio:SplitButton.Flyout>
                    </vio:SplitButton>
                </StackPanel>
            </Border>

            <!--  7. Disabled  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_b9f5c797eb}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_SplitButton_DisabledDesc}}" />
                    <vio:SplitButton
                        Content="{I18N {x:Static lang:LangKeys.Sample_453e6aa38d}}"
                        Icon="{ui:SymbolIcon LockClosed24}"
                        IsEnabled="False">
                        <vio:SplitButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="{I18N {x:Static lang:LangKeys.Sample_054b4f3ea5}}" />
                            </ContextMenu>
                        </vio:SplitButton.Flyout>
                    </vio:SplitButton>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
