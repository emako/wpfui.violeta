<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.IconToggleButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="IconToggleButton"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,4"
                FontSize="20"
                FontWeight="SemiBold"
                Text="IconToggleButton" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Default style shows hover / selected borders. Sample style is flat icon-only. Supports IsThreeState with IndeterminateIcon."
                TextWrapping="Wrap" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Default" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Hover and checked show outer border + fill. Icons: UncheckedIcon / CheckedIcon."
                        TextWrapping="Wrap" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="16">
                        <vio:IconToggleButton
                            CheckedIcon="{ui:SymbolIcon EyeOff24}"
                            ToolTip="Toggle visibility"
                            UncheckedIcon="{ui:SymbolIcon Eye24}" />
                        <vio:IconToggleButton
                            CheckedIcon="{ui:SymbolIcon SpeakerMute24}"
                            IsChecked="True"
                            ToolTip="Mute"
                            UncheckedIcon="{ui:SymbolIcon Speaker224}" />
                        <vio:IconToggleButton
                            CheckedIcon="{ui:SymbolIcon Pin24}"
                            ToolTip="Pin"
                            UncheckedIcon="{ui:SymbolIcon PinOff24}" />
                    </ui:StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Sample (flat)" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="SampleIconToggleButtonStyle — icon swap only, no hover / selected chrome."
                        TextWrapping="Wrap" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="16">
                        <vio:IconToggleButton
                            CheckedIcon="{ui:SymbolIcon EyeOff24}"
                            Style="{StaticResource SampleIconToggleButtonStyle}"
                            ToolTip="Toggle visibility"
                            UncheckedIcon="{ui:SymbolIcon Eye24}" />
                        <vio:IconToggleButton
                            CheckedIcon="{ui:SymbolIcon SpeakerMute24}"
                            IsChecked="True"
                            Style="{StaticResource SampleIconToggleButtonStyle}"
                            ToolTip="Mute"
                            UncheckedIcon="{ui:SymbolIcon Speaker224}" />
                        <vio:IconToggleButton
                            CheckedIcon="{ui:SymbolIcon Pin24}"
                            Style="{StaticResource SampleIconToggleButtonStyle}"
                            ToolTip="Pin"
                            UncheckedIcon="{ui:SymbolIcon PinOff24}" />
                    </ui:StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Three-state" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="IsThreeState=True cycles unchecked → checked → indeterminate. Uses IndeterminateIcon when IsChecked is null."
                        TextWrapping="Wrap" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="16">
                        <vio:IconToggleButton
                            CheckedIcon="{ui:SymbolIcon CheckboxChecked24}"
                            IndeterminateIcon="{ui:SymbolIcon CheckboxIndeterminate24}"
                            IsThreeState="True"
                            ToolTip="Three-state checkbox icons"
                            UncheckedIcon="{ui:SymbolIcon CheckboxUnchecked24}" />
                        <vio:IconToggleButton
                            CheckedIcon="{ui:SymbolIcon Heart24}"
                            IndeterminateIcon="{ui:SymbolIcon HeartBroken24}"
                            IsChecked="{x:Null}"
                            IsThreeState="True"
                            Style="{StaticResource SampleIconToggleButtonStyle}"
                            ToolTip="Sample three-state"
                            UncheckedIcon="{ui:SymbolIcon Heart24}" />
                    </ui:StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Disabled" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Disabled uses ToggleButton disabled brushes (default) or opacity (sample)."
                        TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="16">
                            <vio:IconToggleButton
                                x:Name="DemoIconToggle"
                                CheckedIcon="{ui:SymbolIcon Heart24}"
                                UncheckedIcon="{ui:SymbolIcon Heart24}" />
                            <vio:IconToggleButton
                                x:Name="DemoSampleIconToggle"
                                CheckedIcon="{ui:SymbolIcon Heart24}"
                                Style="{StaticResource SampleIconToggleButtonStyle}"
                                UncheckedIcon="{ui:SymbolIcon Heart24}" />
                        </ui:StackPanel>
                        <CheckBox
                            Grid.Column="1"
                            Checked="DisableIconToggle_Checked"
                            Content="Disable"
                            Unchecked="DisableIconToggle_Unchecked" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
