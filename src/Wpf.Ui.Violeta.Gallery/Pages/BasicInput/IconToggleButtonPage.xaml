<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.IconToggleButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_IconToggleButton}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,4"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_IconToggleButton}}" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Sample_4b919c21a8}}"
                TextWrapping="Wrap" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_18c63459a2}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_99d9bd7a3c}}"
                        TextWrapping="Wrap" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="16">
                        <vio:IconToggleButton
                            CheckedIcon="{ui:SymbolIcon EyeOff24}"
                            ToolTip="{I18N {x:Static lang:LangKeys.Sample_f579716646}}"
                            UncheckedIcon="{ui:SymbolIcon Eye24}" />
                        <vio:IconToggleButton
                            CheckedIcon="{ui:SymbolIcon SpeakerMute24}"
                            IsChecked="True"
                            ToolTip="{I18N {x:Static lang:LangKeys.Sample_00cd7be4cb}}"
                            UncheckedIcon="{ui:SymbolIcon Speaker224}" />
                        <vio:IconToggleButton
                            CheckedIcon="{ui:SymbolIcon Pin24}"
                            ToolTip="{I18N {x:Static lang:LangKeys.Sample_e78e14c5f1}}"
                            UncheckedIcon="{ui:SymbolIcon PinOff24}" />
                    </ui:StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_800a91550a}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_b29235652a}}"
                        TextWrapping="Wrap" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="16">
                        <vio:IconToggleButton
                            CheckedIcon="{ui:SymbolIcon EyeOff24}"
                            Style="{StaticResource SampleIconToggleButtonStyle}"
                            ToolTip="{I18N {x:Static lang:LangKeys.Sample_f579716646}}"
                            UncheckedIcon="{ui:SymbolIcon Eye24}" />
                        <vio:IconToggleButton
                            CheckedIcon="{ui:SymbolIcon SpeakerMute24}"
                            IsChecked="True"
                            Style="{StaticResource SampleIconToggleButtonStyle}"
                            ToolTip="{I18N {x:Static lang:LangKeys.Sample_00cd7be4cb}}"
                            UncheckedIcon="{ui:SymbolIcon Speaker224}" />
                        <vio:IconToggleButton
                            CheckedIcon="{ui:SymbolIcon Pin24}"
                            Style="{StaticResource SampleIconToggleButtonStyle}"
                            ToolTip="{I18N {x:Static lang:LangKeys.Sample_e78e14c5f1}}"
                            UncheckedIcon="{ui:SymbolIcon PinOff24}" />
                    </ui:StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_9908fbe791}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_090c2ca242}}"
                        TextWrapping="Wrap" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="16">
                        <vio:IconToggleButton
                            CheckedIcon="{ui:SymbolIcon CheckboxChecked24}"
                            IndeterminateIcon="{ui:SymbolIcon CheckboxIndeterminate24}"
                            IsThreeState="True"
                            ToolTip="{I18N {x:Static lang:LangKeys.Sample_28b51970d7}}"
                            UncheckedIcon="{ui:SymbolIcon CheckboxUnchecked24}" />
                        <vio:IconToggleButton
                            CheckedIcon="{ui:SymbolIcon Heart24}"
                            IndeterminateIcon="{ui:SymbolIcon HeartBroken24}"
                            IsChecked="{x:Null}"
                            IsThreeState="True"
                            Style="{StaticResource SampleIconToggleButtonStyle}"
                            ToolTip="{I18N {x:Static lang:LangKeys.Sample_2f74655b4c}}"
                            UncheckedIcon="{ui:SymbolIcon Heart24}" />
                    </ui:StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_b9f5c797eb}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_cffe839e03}}"
                        TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="16">
                            <vio:IconToggleButton
                                x:Name="DemoIconToggle"
                                CheckedIcon="{ui:SymbolIcon Heart24}"
                                UncheckedIcon="{ui:SymbolIcon Heart24}" />
                            <vio:IconToggleButton
                                x:Name="DemoSampleIconToggle"
                                CheckedIcon="{ui:SymbolIcon Heart24}"
                                Style="{StaticResource SampleIconToggleButtonStyle}"
                                UncheckedIcon="{ui:SymbolIcon Heart24}" />
                        </ui:StackPanel>
                        <CheckBox
                            Grid.Column="1"
                            Checked="DisableIconToggle_Checked"
                            Content="{I18N {x:Static lang:LangKeys.Sample_bcfaccebf7}}"
                            Unchecked="DisableIconToggle_Unchecked" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
