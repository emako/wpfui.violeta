<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.VirtualJoystickPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="VirtualJoystick"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="VirtualJoystick" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Interactive joystick" />
                    <TextBlock
                        Margin="0,0,0,16"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Drag the knob, or select the joystick and use the arrow keys. The current eight-direction value and normalized vector are displayed below." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <vio:VirtualJoystick
                            x:Name="InteractiveJoystick"
                            Grid.Column="0"
                            Moved="OnJoystickMoved"
                            PadDiameter="160" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Current state" />
                            <TextBlock
                                Margin="0,8,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding ElementName=InteractiveJoystick, Path=CurrentDirection, StringFormat=Direction: {0}}" />
                            <TextBlock
                                x:Name="VectorTextBlock"
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Vector: X 0.00, Y 0.00" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Size" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Adjust the surface diameter to verify dynamic geometry and layout." />
                    <StackPanel Orientation="Horizontal">
                        <Slider
                            x:Name="DiameterSlider"
                            Width="260"
                            Maximum="280"
                            Minimum="80"
                            SmallChange="10"
                            TickFrequency="20"
                            Value="160"
                            ValueChanged="OnDiameterChanged" />
                        <TextBlock
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding ElementName=DiameterSlider, Path=Value, StringFormat={}{0:F0} px}" />
                    </StackPanel>
                    <vio:VirtualJoystick
                        x:Name="ResizableJoystick"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        PadDiameter="{Binding ElementName=DiameterSlider, Path=Value}" />
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Disabled" />
                    <vio:VirtualJoystick
                        HorizontalAlignment="Left"
                        IsEnabled="False"
                        PadDiameter="120" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
