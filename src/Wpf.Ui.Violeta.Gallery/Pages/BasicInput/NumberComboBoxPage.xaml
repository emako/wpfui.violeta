<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.NumberComboBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="NumberComboBox"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="NumberComboBox" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_5d961e79ff}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_b9c4d5e6f7}}" />
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="int (−100…100)" />
                            <vio:NumberIntComboBox
                                Width="200"
                                Maximum="100"
                                Minimum="-100"
                                PlaceholderText="enter int…">
                                <sys:Int32>-100</sys:Int32>
                                <sys:Int32>-50</sys:Int32>
                                <sys:Int32>0</sys:Int32>
                                <sys:Int32>25</sys:Int32>
                                <sys:Int32>50</sys:Int32>
                                <sys:Int32>100</sys:Int32>
                            </vio:NumberIntComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="double (0…1)" />
                            <vio:NumberDoubleComboBox
                                Width="200"
                                FormatString="N2"
                                Maximum="1"
                                Minimum="0"
                                PlaceholderText="0.00">
                                <sys:Double>0</sys:Double>
                                <sys:Double>0.25</sys:Double>
                                <sys:Double>0.5</sys:Double>
                                <sys:Double>0.75</sys:Double>
                                <sys:Double>1</sys:Double>
                            </vio:NumberDoubleComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="decimal" />
                            <vio:NumberDecimalComboBox
                                Width="200"
                                FormatString="N2"
                                PlaceholderText="decimal…">
                                <sys:Decimal>0.01</sys:Decimal>
                                <sys:Decimal>0.1</sys:Decimal>
                                <sys:Decimal>1</sys:Decimal>
                                <sys:Decimal>10</sys:Decimal>
                                <sys:Decimal>100</sys:Decimal>
                            </vio:NumberDecimalComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="byte (0…255)" />
                            <vio:NumberByteComboBox Width="200" PlaceholderText="0-255">
                                <sys:Byte>0</sys:Byte>
                                <sys:Byte>32</sys:Byte>
                                <sys:Byte>64</sys:Byte>
                                <sys:Byte>128</sys:Byte>
                                <sys:Byte>255</sys:Byte>
                            </vio:NumberByteComboBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_61b1603587}}" />
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="prefix" />
                            <vio:NumberDoubleComboBox
                                Width="200"
                                FormatString="N2"
                                InnerLeftContent="$"
                                Maximum="9999"
                                Minimum="0"
                                PlaceholderText="0.00"
                                Value="12.5">
                                <sys:Double>5</sys:Double>
                                <sys:Double>10</sys:Double>
                                <sys:Double>12.5</sys:Double>
                                <sys:Double>20</sys:Double>
                                <sys:Double>50</sys:Double>
                                <sys:Double>100</sys:Double>
                            </vio:NumberDoubleComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="suffix" />
                            <vio:NumberIntComboBox
                                Width="200"
                                InnerRightContent="px"
                                Maximum="96"
                                Minimum="8"
                                PlaceholderText="size"
                                Value="16">
                                <sys:Int32>8</sys:Int32>
                                <sys:Int32>12</sys:Int32>
                                <sys:Int32>14</sys:Int32>
                                <sys:Int32>16</sys:Int32>
                                <sys:Int32>20</sys:Int32>
                                <sys:Int32>24</sys:Int32>
                                <sys:Int32>32</sys:Int32>
                                <sys:Int32>48</sys:Int32>
                            </vio:NumberIntComboBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_3fea7ca76c}}" />
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="read-only" />
                            <vio:NumberIntComboBox
                                Width="200"
                                InnerRightContent="kg"
                                IsReadOnly="True"
                                Value="42">
                                <sys:Int32>42</sys:Int32>
                                <sys:Int32>50</sys:Int32>
                                <sys:Int32>60</sys:Int32>
                            </vio:NumberIntComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="disabled" />
                            <vio:NumberIntComboBox
                                Width="200"
                                InnerRightContent="%"
                                IsEnabled="False"
                                Value="99">
                                <sys:Int32>99</sys:Int32>
                            </vio:NumberIntComboBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
