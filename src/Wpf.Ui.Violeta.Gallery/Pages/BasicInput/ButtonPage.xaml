<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.ButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="Button"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Button" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Standard button" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="标准 WPF Button 控件。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="StandardButton"
                            Grid.Column="0"
                            Content="Standard WPF button" />
                        <CheckBox
                            Grid.Column="1"
                            Checked="DisableButton_Checked"
                            Content="Disable button"
                            Unchecked="DisableButton_Unchecked" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="WPF UI button" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="带 SymbolIcon 的 ui:Button。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button
                            x:Name="UiButton"
                            Grid.Column="0"
                            Content="WPF UI button"
                            Icon="{ui:SymbolIcon Fluent24}" />
                        <CheckBox
                            Grid.Column="1"
                            Checked="DisableUiButton_Checked"
                            Content="Disable button"
                            Unchecked="DisableUiButton_Unchecked" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Primary button" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Appearance=&quot;Primary&quot; 强调样式。" />
                    <ui:Button
                        Appearance="Primary"
                        Content="WPF UI button"
                        Icon="{ui:SymbolIcon Fluent24}" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Icons" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="FontIcon 与 ImageIcon 示例。" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:Button
                            Appearance="Primary"
                            Content="FontIcon"
                            Icon="{ui:FontIcon '&#x1F308;'}" />
                        <ui:Button
                            Appearance="Primary"
                            Content="ImageIcon"
                            Icon="{ui:ImageIcon 'pack://application:,,,/Wpf.Ui.Violeta.Gallery;component/Resources/Images/wpfui.png'}" />
                    </ui:StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Appearance variants" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Primary / Secondary / Success / Caution / Danger 外观，含启用与禁用状态。" />
                    <TextBlock Margin="0,0,0,8" Text="Enabled" />
                    <WrapPanel Margin="0,0,0,12">
                        <ui:Button
                            Margin="4"
                            Appearance="Primary"
                            Content="Primary" />
                        <ui:Button
                            Margin="4"
                            Appearance="Secondary"
                            Content="Secondary" />
                        <ui:Button
                            Margin="4"
                            Appearance="Success"
                            Content="Success" />
                        <ui:Button
                            Margin="4"
                            Appearance="Caution"
                            Content="Caution" />
                        <ui:Button
                            Margin="4"
                            Appearance="Danger"
                            Content="Danger" />
                    </WrapPanel>
                    <TextBlock Margin="0,0,0,8" Text="Disabled" />
                    <WrapPanel>
                        <ui:Button
                            Margin="4"
                            Appearance="Primary"
                            Content="Primary"
                            IsEnabled="False" />
                        <ui:Button
                            Margin="4"
                            Appearance="Secondary"
                            Content="Secondary"
                            IsEnabled="False" />
                        <ui:Button
                            Margin="4"
                            Appearance="Success"
                            Content="Success"
                            IsEnabled="False" />
                        <ui:Button
                            Margin="4"
                            Appearance="Caution"
                            Content="Caution"
                            IsEnabled="False" />
                        <ui:Button
                            Margin="4"
                            Appearance="Danger"
                            Content="Danger"
                            IsEnabled="False" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
