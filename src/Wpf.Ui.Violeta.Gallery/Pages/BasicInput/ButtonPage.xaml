<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.ButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_Button}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_Button}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_14edd6a459}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_30eed26e03}}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="StandardButton"
                            Grid.Column="0"
                            Content="{I18N {x:Static lang:LangKeys.Sample_ff4d6ca0ce}}" />
                        <CheckBox
                            Grid.Column="1"
                            Checked="DisableButton_Checked"
                            Content="{I18N {x:Static lang:LangKeys.Sample_97c56016ab}}"
                            Unchecked="DisableButton_Unchecked" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_459fe7634f}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_541c4daa70}}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button
                            x:Name="UiButton"
                            Grid.Column="0"
                            Content="{I18N {x:Static lang:LangKeys.Sample_459fe7634f}}"
                            Icon="{ui:SymbolIcon Fluent24}" />
                        <CheckBox
                            Grid.Column="1"
                            Checked="DisableUiButton_Checked"
                            Content="{I18N {x:Static lang:LangKeys.Sample_97c56016ab}}"
                            Unchecked="DisableUiButton_Unchecked" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_7c81d84b14}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_c71e9d5bfa}}" />
                    <ui:Button
                        Appearance="Primary"
                        Content="{I18N {x:Static lang:LangKeys.Sample_459fe7634f}}"
                        Icon="{ui:SymbolIcon Fluent24}" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Page_Icons}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_ff8807ee6c}}" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:Button
                            Appearance="Primary"
                            Content="{I18N {x:Static lang:LangKeys.Sample_7e64d5c452}}"
                            Icon="{ui:FontIcon '&#x1F308;'}" />
                        <ui:Button
                            Appearance="Primary"
                            Content="{I18N {x:Static lang:LangKeys.Sample_d17a461c54}}"
                            Icon="{ui:ImageIcon 'pack://application:,,,/Wpf.Ui.Violeta.Gallery;component/Resources/Images/wpfui.png'}" />
                    </ui:StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_8a60003101}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_c1dde7ca84}}" />
                    <TextBlock Margin="0,0,0,8" Text="{I18N {x:Static lang:LangKeys.Sample_00d23a76e4}}" />
                    <WrapPanel Margin="0,0,0,12">
                        <ui:Button
                            Margin="4"
                            Appearance="Primary"
                            Content="{I18N {x:Static lang:LangKeys.Sample_074de7e7c2}}" />
                        <ui:Button
                            Margin="4"
                            Appearance="Secondary"
                            Content="{I18N {x:Static lang:LangKeys.Sample_0c7d6cf194}}" />
                        <ui:Button
                            Margin="4"
                            Appearance="Success"
                            Content="{I18N {x:Static lang:LangKeys.Sample_330363dfc5}}" />
                        <ui:Button
                            Margin="4"
                            Appearance="Caution"
                            Content="{I18N {x:Static lang:LangKeys.Sample_764a2caff0}}" />
                        <ui:Button
                            Margin="4"
                            Appearance="Danger"
                            Content="{I18N {x:Static lang:LangKeys.Sample_990816b607}}" />
                    </WrapPanel>
                    <TextBlock Margin="0,0,0,8" Text="{I18N {x:Static lang:LangKeys.Sample_b9f5c797eb}}" />
                    <WrapPanel>
                        <ui:Button
                            Margin="4"
                            Appearance="Primary"
                            Content="{I18N {x:Static lang:LangKeys.Sample_074de7e7c2}}"
                            IsEnabled="False" />
                        <ui:Button
                            Margin="4"
                            Appearance="Secondary"
                            Content="{I18N {x:Static lang:LangKeys.Sample_0c7d6cf194}}"
                            IsEnabled="False" />
                        <ui:Button
                            Margin="4"
                            Appearance="Success"
                            Content="{I18N {x:Static lang:LangKeys.Sample_330363dfc5}}"
                            IsEnabled="False" />
                        <ui:Button
                            Margin="4"
                            Appearance="Caution"
                            Content="{I18N {x:Static lang:LangKeys.Sample_764a2caff0}}"
                            IsEnabled="False" />
                        <ui:Button
                            Margin="4"
                            Appearance="Danger"
                            Content="{I18N {x:Static lang:LangKeys.Sample_990816b607}}"
                            IsEnabled="False" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_3a573f184a}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_0f00121336}}"
                        TextWrapping="Wrap" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:Button Appearance="Primary">
                            <ui:StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:SymbolIcon Symbol="Save24" />
                                <TextBlock VerticalAlignment="Center" Text="{I18N {x:Static lang:LangKeys.Sample_be5fbbe34c}}" />
                            </ui:StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Primary">
                            <ui:StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:SymbolIcon Symbol="Share24" />
                                <TextBlock VerticalAlignment="Center" Text="{I18N {x:Static lang:LangKeys.Sample_5a95a425f7}}" />
                            </ui:StackPanel>
                        </ui:Button>
                        <ui:Button>
                            <ui:StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:SymbolIcon Symbol="Copy24" />
                                <TextBlock VerticalAlignment="Center" Text="{I18N {x:Static lang:LangKeys.Sample_79d3abe929}}" />
                            </ui:StackPanel>
                        </ui:Button>
                    </ui:StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_0357705cc8}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_3ddf6f22b0}}"
                        TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ui:Button
                                x:Name="RichContentPrimaryButton"
                                Padding="12,8"
                                Appearance="Primary">
                                <ui:StackPanel Orientation="Horizontal" Spacing="10">
                                    <ui:SymbolIcon
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Symbol="CloudArrowUp24" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{I18N {x:Static lang:LangKeys.Sample_91412465ea}}" />
                                        <TextBlock
                                            FontSize="12"
                                            Opacity="0.72"
                                            Text="{I18N {x:Static lang:LangKeys.Sample_bd5d5dfbba}}" />
                                    </StackPanel>
                                </ui:StackPanel>
                            </ui:Button>
                            <ui:Button
                                x:Name="RichContentSuccessButton"
                                Padding="12,8"
                                Appearance="Success">
                                <ui:StackPanel Orientation="Horizontal" Spacing="10">
                                    <ui:SymbolIcon
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Symbol="Checkmark24" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{I18N {x:Static lang:LangKeys.Sample_e83a256e4f}}" />
                                        <TextBlock
                                            FontSize="12"
                                            Opacity="0.72"
                                            Text="{I18N {x:Static lang:LangKeys.Sample_3d6aea7f98}}" />
                                    </StackPanel>
                                </ui:StackPanel>
                            </ui:Button>
                        </ui:StackPanel>
                        <CheckBox
                            Grid.Column="1"
                            Checked="DisableRichContentButton_Checked"
                            Content="{I18N {x:Static lang:LangKeys.Sample_bcfaccebf7}}"
                            Unchecked="DisableRichContentButton_Unchecked" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
