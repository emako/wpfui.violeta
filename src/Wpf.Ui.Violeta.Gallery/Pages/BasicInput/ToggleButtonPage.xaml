<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.ToggleButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_ToggleButton}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_ToggleButton}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_36de458418}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_ee5b0776e9}}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton
                            x:Name="ToggleButtonControl"
                            Grid.Column="0"
                            Content="{I18N {x:Static lang:LangKeys.Sample_af24df2e7d}}" />
                        <CheckBox
                            Grid.Column="1"
                            Checked="DisableToggleButton_Checked"
                            Content="{I18N {x:Static lang:LangKeys.Sample_6612a8bf8c}}"
                            Unchecked="DisableToggleButton_Unchecked" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_cb392954a8}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_80267bf66c}}"
                        TextWrapping="Wrap" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleButton ToolTip="{I18N {x:Static lang:LangKeys.Sample_3b8a43acee}}">
                            <ui:SymbolIcon Symbol="TextBold24" />
                        </ToggleButton>
                        <ToggleButton IsChecked="True" ToolTip="{I18N {x:Static lang:LangKeys.Sample_81d6da77d6}}">
                            <ui:SymbolIcon Symbol="TextItalic24" />
                        </ToggleButton>
                        <ToggleButton ToolTip="{I18N {x:Static lang:LangKeys.Sample_f6f8ea0815}}">
                            <ui:SymbolIcon Symbol="TextUnderline24" />
                        </ToggleButton>
                        <ToggleButton ToolTip="{I18N {x:Static lang:LangKeys.Sample_e78e14c5f1}}">
                            <ui:SymbolIcon Symbol="Pin24" />
                        </ToggleButton>
                    </ui:StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_576e3a8b1c}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_4a4d0ffa97}}"
                        TextWrapping="Wrap" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleButton>
                            <ui:StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:SymbolIcon Symbol="Eye24" />
                                <TextBlock VerticalAlignment="Center" Text="{I18N {x:Static lang:LangKeys.Sample_31fde7b05a}}" />
                            </ui:StackPanel>
                        </ToggleButton>
                        <ToggleButton IsChecked="True">
                            <ui:StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:SymbolIcon Symbol="Speaker224" />
                                <TextBlock VerticalAlignment="Center" Text="{I18N {x:Static lang:LangKeys.Sample_9d07e0e08a}}" />
                            </ui:StackPanel>
                        </ToggleButton>
                        <ToggleButton>
                            <ui:StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:SymbolIcon Symbol="Wifi124" />
                                <TextBlock VerticalAlignment="Center" Text="{I18N {x:Static lang:LangKeys.Sample_fa524b7254}}" />
                            </ui:StackPanel>
                        </ToggleButton>
                        <ToggleButton>
                            <ui:StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:SymbolIcon Symbol="Bluetooth24" />
                                <TextBlock VerticalAlignment="Center" Text="{I18N {x:Static lang:LangKeys.Sample_0a4e486218}}" />
                            </ui:StackPanel>
                        </ToggleButton>
                    </ui:StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_1fa42ff340}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_3f5d0ff650}}"
                        TextWrapping="Wrap" />
                    <ui:StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleButton Padding="12,8">
                            <ui:StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Vertical"
                                Spacing="4">
                                <ui:SymbolIcon HorizontalAlignment="Center" Symbol="Home24" />
                                <TextBlock HorizontalAlignment="Center" Text="{I18N {x:Static lang:LangKeys.Gallery_Nav_Home}}" />
                            </ui:StackPanel>
                        </ToggleButton>
                        <ToggleButton Padding="12,8" IsChecked="True">
                            <ui:StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Vertical"
                                Spacing="4">
                                <ui:SymbolIcon HorizontalAlignment="Center" Symbol="Search24" />
                                <TextBlock HorizontalAlignment="Center" Text="{I18N {x:Static lang:LangKeys.Sample_e5f71fc31e}}" />
                            </ui:StackPanel>
                        </ToggleButton>
                        <ToggleButton Padding="12,8">
                            <ui:StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Vertical"
                                Spacing="4">
                                <ui:SymbolIcon HorizontalAlignment="Center" Symbol="Settings24" />
                                <TextBlock HorizontalAlignment="Center" Text="{I18N {x:Static lang:LangKeys.Gallery_Settings}}" />
                            </ui:StackPanel>
                        </ToggleButton>
                    </ui:StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_0357705cc8}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_68bd106b4f}}"
                        TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ToggleButton x:Name="RichContentToggle" Padding="12,8">
                                <ui:StackPanel Orientation="Horizontal" Spacing="10">
                                    <ui:SymbolIcon
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Symbol="Cloud24" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{I18N {x:Static lang:LangKeys.Sample_d8e87c0927}}" />
                                        <TextBlock
                                            FontSize="12"
                                            Opacity="0.72"
                                            Text="{I18N {x:Static lang:LangKeys.Sample_e3784ee777}}" />
                                    </StackPanel>
                                </ui:StackPanel>
                            </ToggleButton>
                            <ToggleButton
                                x:Name="RichContentCheckedToggle"
                                Padding="12,8"
                                IsChecked="True">
                                <ui:StackPanel Orientation="Horizontal" Spacing="10">
                                    <ui:SymbolIcon
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Symbol="LockClosed24" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{I18N {x:Static lang:LangKeys.Sample_7a2ccf251e}}" />
                                        <TextBlock
                                            FontSize="12"
                                            Opacity="0.72"
                                            Text="{I18N {x:Static lang:LangKeys.Sample_3a7c893a5d}}" />
                                    </StackPanel>
                                </ui:StackPanel>
                            </ToggleButton>
                        </ui:StackPanel>
                        <CheckBox
                            Grid.Column="1"
                            Checked="DisableRichContentToggle_Checked"
                            Content="{I18N {x:Static lang:LangKeys.Sample_bcfaccebf7}}"
                            Unchecked="DisableRichContentToggle_Unchecked" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
