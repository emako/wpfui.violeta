<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.RatingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="Rating"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Rating" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="RatingControl" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="星级评分控件，支持半星。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:RatingControl
                            x:Name="FirstRating"
                            HorizontalAlignment="Left"
                            Value="3" />
                        <StackPanel
                            Grid.Column="1"
                            MinWidth="60"
                            Margin="16,0,16,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="Value:" />
                            <TextBlock Text="{Binding Value, ElementName=FirstRating}" />
                        </StackPanel>
                        <CheckBox
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Checked="DisableFirstRating_Checked"
                            Content="Disable rating"
                            Unchecked="DisableFirstRating_Unchecked" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Full stars only" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="HalfStarEnabled=False 仅整星评分。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:RatingControl
                            x:Name="SecondRating"
                            HorizontalAlignment="Left"
                            HalfStarEnabled="False"
                            Value="4" />
                        <StackPanel
                            Grid.Column="1"
                            MinWidth="60"
                            Margin="16,0,16,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="Value:" />
                            <TextBlock Text="{Binding Value, ElementName=SecondRating}" />
                        </StackPanel>
                        <CheckBox
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Checked="DisableSecondRating_Checked"
                            Content="Disable rating"
                            Unchecked="DisableSecondRating_Unchecked" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
