<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.LoadingButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_LoadingButton}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_LoadingButton}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_ae13e51f99}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_9c22a91217}}" />
                    <StackPanel Orientation="Horizontal">
                        <vio:LoadingButton
                            Margin="0,0,8,0"
                            Content="{I18N {x:Static lang:LangKeys.Sample_583e7924e9}}"
                            IsLoading="True"
                            LoadingPlacement="Left" />
                        <vio:LoadingButton
                            Margin="0,0,8,0"
                            Content="{I18N {x:Static lang:LangKeys.Sample_92b09c7c48}}"
                            IsLoading="True"
                            LoadingPlacement="Right" />
                        <vio:LoadingButton
                            Margin="0,0,8,0"
                            Content="{I18N {x:Static lang:LangKeys.Sample_a4ffdcf0dc}}"
                            IsLoading="True"
                            LoadingPlacement="Top" />
                        <vio:LoadingButton
                            Content="{I18N {x:Static lang:LangKeys.Sample_2ad9d63b69}}"
                            IsLoading="True"
                            LoadingPlacement="Bottom" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Settings_Appearance}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_d20fff90d9}}" />
                    <StackPanel Orientation="Horizontal">
                        <vio:LoadingButton
                            Margin="0,0,8,0"
                            Appearance="Secondary"
                            Content="{I18N {x:Static lang:LangKeys.Sample_0c7d6cf194}}"
                            IsLoading="True"
                            LoadingPlacement="Left" />
                        <vio:LoadingButton
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            Content="{I18N {x:Static lang:LangKeys.Sample_074de7e7c2}}"
                            IsLoading="True"
                            LoadingPlacement="Left" />
                        <vio:LoadingButton
                            Margin="0,0,8,0"
                            Appearance="Danger"
                            Content="{I18N {x:Static lang:LangKeys.Sample_990816b607}}"
                            IsLoading="True"
                            LoadingPlacement="Left" />
                        <vio:LoadingButton
                            Appearance="Success"
                            Content="{I18N {x:Static lang:LangKeys.Sample_330363dfc5}}"
                            IsLoading="True"
                            LoadingPlacement="Left" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_2d7f6c045a}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_23509bcfde}}" />
                    <StackPanel Orientation="Horizontal">
                        <vio:LoadingButton
                            Margin="0,0,8,0"
                            Appearance="Secondary"
                            Click="LoadingButton_Click"
                            Content="{I18N {x:Static lang:LangKeys.Sample_939d5345ad}}"
                            LoadingPlacement="Left" />
                        <vio:LoadingButton
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            Click="LoadingButton_Click"
                            Content="{I18N {x:Static lang:LangKeys.Sample_939d5345ad}}"
                            LoadingPlacement="Left" />
                        <vio:LoadingButton
                            Appearance="Danger"
                            Click="LoadingButton_Click"
                            Content="{I18N {x:Static lang:LangKeys.Sample_939d5345ad}}"
                            LoadingPlacement="Left" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_b9f5c797eb}}" />
                    <StackPanel Orientation="Horizontal">
                        <vio:LoadingButton
                            Margin="0,0,8,0"
                            Content="{I18N {x:Static lang:LangKeys.Sample_d26fbd7e76}}"
                            IsEnabled="False"
                            IsLoading="False" />
                        <vio:LoadingButton
                            Appearance="Primary"
                            Content="{I18N {x:Static lang:LangKeys.Sample_2a342abec2}}"
                            IsEnabled="False"
                            IsLoading="True"
                            LoadingPlacement="Left" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
