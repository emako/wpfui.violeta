<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.LoadingButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="LoadingButton"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="LoadingButton" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Placement" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_9c22a91217}}" />
                    <StackPanel Orientation="Horizontal">
                        <vio:LoadingButton
                            Margin="0,0,8,0"
                            Content="Left"
                            IsLoading="True"
                            LoadingPlacement="Left" />
                        <vio:LoadingButton
                            Margin="0,0,8,0"
                            Content="Right"
                            IsLoading="True"
                            LoadingPlacement="Right" />
                        <vio:LoadingButton
                            Margin="0,0,8,0"
                            Content="Top"
                            IsLoading="True"
                            LoadingPlacement="Top" />
                        <vio:LoadingButton
                            Content="Bottom"
                            IsLoading="True"
                            LoadingPlacement="Bottom" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Appearance" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_d20fff90d9}}" />
                    <StackPanel Orientation="Horizontal">
                        <vio:LoadingButton
                            Margin="0,0,8,0"
                            Appearance="Secondary"
                            Content="Secondary"
                            IsLoading="True"
                            LoadingPlacement="Left" />
                        <vio:LoadingButton
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            Content="Primary"
                            IsLoading="True"
                            LoadingPlacement="Left" />
                        <vio:LoadingButton
                            Margin="0,0,8,0"
                            Appearance="Danger"
                            Content="Danger"
                            IsLoading="True"
                            LoadingPlacement="Left" />
                        <vio:LoadingButton
                            Appearance="Success"
                            Content="Success"
                            IsLoading="True"
                            LoadingPlacement="Left" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Click to load" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_23509bcfde}}" />
                    <StackPanel Orientation="Horizontal">
                        <vio:LoadingButton
                            Margin="0,0,8,0"
                            Appearance="Secondary"
                            Click="LoadingButton_Click"
                            Content="Submit"
                            LoadingPlacement="Left" />
                        <vio:LoadingButton
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            Click="LoadingButton_Click"
                            Content="Submit"
                            LoadingPlacement="Left" />
                        <vio:LoadingButton
                            Appearance="Danger"
                            Click="LoadingButton_Click"
                            Content="Submit"
                            LoadingPlacement="Left" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Disabled" />
                    <StackPanel Orientation="Horizontal">
                        <vio:LoadingButton
                            Margin="0,0,8,0"
                            Content="Not Loading"
                            IsEnabled="False"
                            IsLoading="False" />
                        <vio:LoadingButton
                            Appearance="Primary"
                            Content="Loading + Disabled"
                            IsEnabled="False"
                            IsLoading="True"
                            LoadingPlacement="Left" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
