<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.DropDownButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_DropDownButton}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_DropDownButton}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Page_DropDownButton}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_e44ca4d5c0}}" />
                    <vio:DropDownButton Content="{I18N {x:Static lang:LangKeys.Sample_8b1a9953c4}}" Icon="{ui:SymbolIcon Fluent24}">
                        <vio:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="{I18N {x:Static lang:LangKeys.Sample_1bb125b89c}}" />
                                <MenuItem Header="{I18N {x:Static lang:LangKeys.Sample_1063e38cb5}}" />
                                <MenuItem Header="{I18N {x:Static lang:LangKeys.Sample_94966d9074}}">
                                    <MenuItem Header="{I18N {x:Static lang:LangKeys.Sample_5f07e1c9a6}}" />
                                    <MenuItem Header="{I18N {x:Static lang:LangKeys.Sample_cd3668b9d5}}" />
                                    <MenuItem Header="{I18N {x:Static lang:LangKeys.Sample_0b05d4ec1b}}">
                                        <MenuItem Header="{I18N {x:Static lang:LangKeys.Sample_bcc254b55c}}" />
                                        <MenuItem Header="{I18N {x:Static lang:LangKeys.Sample_36384a9ea3}}" />
                                        <MenuItem Header="{I18N {x:Static lang:LangKeys.Sample_2310408a63}}" />
                                    </MenuItem>
                                </MenuItem>
                                <MenuItem Header="{I18N {x:Static lang:LangKeys.Sample_8b1a9953c4}}" />
                            </ContextMenu>
                        </vio:DropDownButton.Flyout>
                    </vio:DropDownButton>
                </StackPanel>
            </Border>

            <!--  Disabled  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_b9f5c797eb}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_DropDownButton_DisabledDesc}}" />
                    <StackPanel Orientation="Horizontal">
                        <vio:DropDownButton
                            Margin="0,0,12,0"
                            Content="{I18N {x:Static lang:LangKeys.Sample_453e6aa38d}}"
                            Icon="{ui:SymbolIcon LockClosed24}"
                            IsEnabled="False">
                            <vio:DropDownButton.Flyout>
                                <ContextMenu>
                                    <MenuItem Header="{I18N {x:Static lang:LangKeys.Sample_054b4f3ea5}}" />
                                </ContextMenu>
                            </vio:DropDownButton.Flyout>
                        </vio:DropDownButton>
                        <vio:DropDownButton
                            Content="{I18N {x:Static lang:LangKeys.Sample_012f602372}}"
                            Icon="{ui:SymbolIcon LockClosed24}"
                            IsEnabled="False"
                            Style="{StaticResource ToolBarDropDownButtonStyle}">
                            <vio:DropDownButton.Flyout>
                                <ContextMenu>
                                    <MenuItem Header="{I18N {x:Static lang:LangKeys.Sample_054b4f3ea5}}" />
                                </ContextMenu>
                            </vio:DropDownButton.Flyout>
                        </vio:DropDownButton>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
