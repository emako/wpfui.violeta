<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.ToggleComboBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="ToggleComboBox"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,4"
                FontSize="20"
                FontWeight="SemiBold"
                Text="ToggleComboBox" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Sample_ca5e75861e}}"
                TextWrapping="Wrap" />

            <!--  1. Basic toggle  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_9cd21c0453}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_30d371c179}}" />
                    <StackPanel Orientation="Horizontal">
                        <vio:ToggleComboBox
                            x:Name="BasicToggleComboBox"
                            Content="Bold"
                            Icon="{ui:SymbolIcon TextBold24}"
                            SelectionChanged="BasicToggleComboBox_OnSelectionChanged">
                            <vio:ToggleComboBox.ItemsSource>
                                <x:Array Type="{x:Type sys:String}">
                                    <sys:String>Bold</sys:String>
                                    <sys:String>Italic</sys:String>
                                    <sys:String>Underline</sys:String>
                                </x:Array>
                            </vio:ToggleComboBox.ItemsSource>
                        </vio:ToggleComboBox>
                        <TextBlock
                            x:Name="BasicStatusText"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  2. Sync content  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_31c6a2bd46}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_92791c5349}}" />
                    <StackPanel Orientation="Horizontal">
                        <vio:ToggleComboBox
                            Margin="0,0,12,0"
                            Content="{I18N {x:Static lang:LangKeys.Sample_e02ff1e53f}}"
                            SyncContentWithSelection="True">
                            <vio:ToggleComboBox.ItemsSource>
                                <x:Array Type="{x:Type sys:String}">
                                    <sys:String>Red</sys:String>
                                    <sys:String>Green</sys:String>
                                    <sys:String>Blue</sys:String>
                                    <sys:String>Orange</sys:String>
                                </x:Array>
                            </vio:ToggleComboBox.ItemsSource>
                        </vio:ToggleComboBox>
                        <vio:ToggleComboBox
                            Margin="0,0,12,0"
                            Content="A"
                            SyncContentWithSelection="True">
                            <vio:ToggleComboBox.ItemsSource>
                                <x:Array Type="{x:Type sys:String}">
                                    <sys:String>A</sys:String>
                                    <sys:String>B</sys:String>
                                    <sys:String>C</sys:String>
                                </x:Array>
                            </vio:ToggleComboBox.ItemsSource>
                        </vio:ToggleComboBox>
                        <vio:ToggleComboBox
                            Content="Times New Roman"
                            SyncContentWithSelection="True">
                            <vio:ToggleComboBox.ItemsSource>
                                <x:Array Type="{x:Type sys:String}">
                                    <sys:String>Arial</sys:String>
                                    <sys:String>Consolas</sys:String>
                                    <sys:String>Segoe UI</sys:String>
                                    <sys:String>Times New Roman</sys:String>
                                </x:Array>
                            </vio:ToggleComboBox.ItemsSource>
                        </vio:ToggleComboBox>
                    </StackPanel>
                    <TextBlock
                        Margin="0,12,0,8"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Fixed MinWidth (left-aligned content)" />
                    <vio:ToggleComboBox
                        MinWidth="220"
                        Content="Green"
                        SyncContentWithSelection="True">
                        <vio:ToggleComboBox.ItemsSource>
                            <x:Array Type="{x:Type sys:String}">
                                <sys:String>Red</sys:String>
                                <sys:String>Green</sys:String>
                                <sys:String>Blue</sys:String>
                                <sys:String>Orange</sys:String>
                            </x:Array>
                        </vio:ToggleComboBox.ItemsSource>
                    </vio:ToggleComboBox>
                </StackPanel>
            </Border>

            <!--  3. Cancelable selection  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_13850e5b0e}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_6d495b7e26}}" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock
                                Margin="0,0,0,8"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_5778ff39b2}}" />
                            <vio:ToggleComboBox
                                Content="{I18N {x:Static lang:LangKeys.Sample_6f6cb72d54}}"
                                IsSelectionCancelable="True"
                                SyncContentWithSelection="True">
                                <vio:ToggleComboBox.ItemsSource>
                                    <x:Array Type="{x:Type sys:String}">
                                        <sys:String>Small</sys:String>
                                        <sys:String>Medium</sys:String>
                                        <sys:String>Large</sys:String>
                                    </x:Array>
                                </vio:ToggleComboBox.ItemsSource>
                            </vio:ToggleComboBox>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_971c80bebe}}" />
                            <vio:ToggleComboBox
                                Content="{I18N {x:Static lang:LangKeys.Sample_6f6cb72d54}}"
                                IsSelectionCancelable="False"
                                SyncContentWithSelection="True">
                                <vio:ToggleComboBox.ItemsSource>
                                    <x:Array Type="{x:Type sys:String}">
                                        <sys:String>Small</sys:String>
                                        <sys:String>Medium</sys:String>
                                        <sys:String>Large</sys:String>
                                    </x:Array>
                                </vio:ToggleComboBox.ItemsSource>
                            </vio:ToggleComboBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  4. Command + DoubleCommand  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_66fff5b8e3}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_9488273dae}}" />
                    <StackPanel Orientation="Horizontal">
                        <vio:ToggleComboBox
                            x:Name="CommandToggleComboBox"
                            MinWidth="160"
                            Click="CommandToggleComboBox_OnClick"
                            Content="{I18N {x:Static lang:LangKeys.Sample_9639e32cab}}"
                            DoubleCommand="{Binding DoubleCommand}"
                            Icon="{ui:SymbolIcon Checkmark24}">
                            <vio:ToggleComboBox.ItemsSource>
                                <x:Array Type="{x:Type sys:String}">
                                    <sys:String>Apply</sys:String>
                                    <sys:String>Preview</sys:String>
                                    <sys:String>Reset</sys:String>
                                </x:Array>
                            </vio:ToggleComboBox.ItemsSource>
                        </vio:ToggleComboBox>
                        <TextBlock
                            x:Name="CommandStatusText"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{I18N {x:Static lang:LangKeys.Sample_136e16706d}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  5. DisplayMemberPath + objects  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_3dc7af023d}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_23b09dfdc7}}" />
                    <vio:ToggleComboBox
                        x:Name="ObjectToggleComboBox"
                        MinWidth="200"
                        Content="{I18N {x:Static lang:LangKeys.Sample_dbdced69d1}}"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Tools}"
                        SyncContentWithSelection="True" />
                </StackPanel>
            </Border>

            <!--  6. ItemTemplate  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_df74b5081d}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_f11b4b9255}}" />
                    <vio:ToggleComboBox
                        MinWidth="180"
                        Content="{I18N {x:Static lang:LangKeys.Sample_278f9a3d30}}"
                        ItemsSource="{Binding Colors}"
                        SyncContentWithSelection="False">
                        <vio:ToggleComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        Background="{Binding Brush}"
                                        CornerRadius="3" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </vio:ToggleComboBox.ItemTemplate>
                    </vio:ToggleComboBox>
                </StackPanel>
            </Border>

            <!--  7. Disabled + preselected  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_090903ad32}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_7e2b4a08c3}}" />
                    <StackPanel Orientation="Horizontal">
                        <vio:ToggleComboBox
                            MinWidth="140"
                            Margin="0,0,12,0"
                            Content="{I18N {x:Static lang:LangKeys.Sample_2627637e26}}"
                            IsChecked="True">
                            <vio:ToggleComboBox.ItemsSource>
                                <x:Array Type="{x:Type sys:String}">
                                    <sys:String>A</sys:String>
                                    <sys:String>B</sys:String>
                                </x:Array>
                            </vio:ToggleComboBox.ItemsSource>
                        </vio:ToggleComboBox>
                        <vio:ToggleComboBox
                            MinWidth="140"
                            Content="{I18N {x:Static lang:LangKeys.Sample_b9f5c797eb}}"
                            IsEnabled="False">
                            <vio:ToggleComboBox.ItemsSource>
                                <x:Array Type="{x:Type sys:String}">
                                    <sys:String>A</sys:String>
                                    <sys:String>B</sys:String>
                                </x:Array>
                            </vio:ToggleComboBox.ItemsSource>
                        </vio:ToggleComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
