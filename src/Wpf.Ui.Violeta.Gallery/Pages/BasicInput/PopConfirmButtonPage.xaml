<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.PopConfirmButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_PopConfirmButton}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,4"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_PopConfirmButton}}" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Sample_a7e3c91f20}}"
                TextWrapping="Wrap" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_b8f4d02a31}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_c9e5a13b42}}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:PopConfirmButton
                            Margin="0,0,12,0"
                            Appearance="Primary"
                            CloseButtonCommand="{Binding CloseCommand}"
                            Content="{I18N {x:Static lang:LangKeys.Sample_36fca802b9}}"
                            Message="{I18N {x:Static lang:LangKeys.Sample_25ebf791a8}}"
                            MessageBoxIcon="Warning"
                            PrimaryButtonCommand="{Binding PrimaryCommand}"
                            Title="{I18N {x:Static lang:LangKeys.Sample_14dae68097}}" />
                        <vio:PopConfirmButton
                            Appearance="Danger"
                            CloseButtonCommand="{Binding CloseCommand}"
                            Content="{I18N {x:Static lang:LangKeys.Sample_470db913c0}}"
                            Icon="{ui:SymbolIcon Delete24}"
                            Message="{I18N {x:Static lang:LangKeys.Sample_25ebf791a8}}"
                            MessageBoxIcon="Error"
                            PrimaryButtonCommand="{Binding PrimaryCommand}"
                            Title="{I18N {x:Static lang:LangKeys.Sample_14dae68097}}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="StatusText"
                        Margin="0,12,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_7a30ec46f3}}" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Primary / Secondary / Close" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Set SecondaryButtonText to show a third button (ContentDialog-style)."
                        TextWrapping="Wrap" />
                    <vio:PopConfirmButton
                        Appearance="Primary"
                        CloseButtonCommand="{Binding CloseCommand}"
                        Content="{I18N {x:Static lang:LangKeys.Sample_36fca802b9}}"
                        Message="{I18N {x:Static lang:LangKeys.Sample_25ebf791a8}}"
                        MessageBoxIcon="Question"
                        PrimaryButtonCommand="{Binding PrimaryCommand}"
                        PrimaryButtonText="Save"
                        SecondaryButtonCommand="{Binding SecondaryCommand}"
                        SecondaryButtonText="Don't save"
                        Title="{I18N {x:Static lang:LangKeys.Sample_14dae68097}}" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_d0f6b24c53}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_e1a7c35d64}}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <vio:PopConfirmButton
                            Margin="0,0,8,0"
                            Appearance="Secondary"
                            Content="Warning"
                            MessageBoxIcon="Warning"
                            PrimaryButtonCommand="{Binding PrimaryCommand}"
                            Title="Warning" />
                        <vio:PopConfirmButton
                            Margin="0,0,8,0"
                            Appearance="Secondary"
                            Content="Error"
                            MessageBoxIcon="Error"
                            PrimaryButtonCommand="{Binding PrimaryCommand}"
                            Title="Error" />
                        <vio:PopConfirmButton
                            Margin="0,0,8,0"
                            Appearance="Secondary"
                            Content="Information"
                            MessageBoxIcon="Information"
                            PrimaryButtonCommand="{Binding PrimaryCommand}"
                            Title="Information" />
                        <vio:PopConfirmButton
                            Margin="0,0,8,0"
                            Appearance="Secondary"
                            Content="Success"
                            MessageBoxIcon="Success"
                            PrimaryButtonCommand="{Binding PrimaryCommand}"
                            Title="Success" />
                        <vio:PopConfirmButton
                            Appearance="Secondary"
                            Content="Question"
                            MessageBoxIcon="Question"
                            PrimaryButtonCommand="{Binding PrimaryCommand}"
                            Title="Question" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_f2b8d46e75}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_03c9e57f86}}"
                        TextWrapping="Wrap" />
                    <Border
                        Padding="4"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <vio:ToolBar>
                            <vio:PopConfirmButton
                                CloseButtonCommand="{Binding CloseCommand}"
                                Content="{I18N {x:Static lang:LangKeys.Sample_470db913c0}}"
                                Icon="{ui:SymbolIcon Delete24}"
                                Message="{I18N {x:Static lang:LangKeys.Sample_25ebf791a8}}"
                                MessageBoxIcon="Warning"
                                PrimaryButtonCommand="{Binding PrimaryCommand}"
                                Style="{StaticResource ToolBarPopConfirmButtonStyle}"
                                Title="{I18N {x:Static lang:LangKeys.Sample_14dae68097}}" />
                            <vio:PopConfirmButton
                                CloseButtonCommand="{Binding CloseCommand}"
                                Content="{I18N {x:Static lang:LangKeys.Sample_36fca802b9}}"
                                Message="{I18N {x:Static lang:LangKeys.Sample_25ebf791a8}}"
                                MessageBoxIcon="Information"
                                PrimaryButtonCommand="{Binding PrimaryCommand}"
                                Style="{StaticResource ToolBarPopConfirmButtonStyle}"
                                Title="{I18N {x:Static lang:LangKeys.Sample_14dae68097}}" />
                        </vio:ToolBar>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
