<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.RangeSliderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="RangeSlider"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="RangeSlider" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_4cde06e616}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_c23c5bc472}}" />
                    <StackPanel>
                        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="120"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="Basic" />
                            <vio:RangeSlider
                                Width="320"
                                LowerValue="20"
                                Maximum="100"
                                Minimum="0"
                                UpperValue="80" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="120"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="Ticks + Snap" />
                            <vio:RangeSlider
                                Width="320"
                                IsSnapToTickEnabled="True"
                                LowerValue="20"
                                Maximum="100"
                                Minimum="0"
                                TickFrequency="10"
                                TickPlacement="BottomRight"
                                UpperValue="80" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="120"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="Disabled" />
                            <vio:RangeSlider
                                Width="320"
                                IsEnabled="False"
                                LowerValue="25"
                                Maximum="100"
                                Minimum="0"
                                UpperValue="75" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                MinWidth="120"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="ReadOnly" />
                            <vio:RangeSlider
                                Width="320"
                                IsReadOnly="True"
                                LowerValue="30"
                                Maximum="100"
                                Minimum="0"
                                UpperValue="60" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_75ac842f8e}}" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,24,0" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="80"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="Vertical" />
                            <vio:RangeSlider
                                Height="160"
                                LowerValue="20"
                                Maximum="100"
                                Minimum="0"
                                Orientation="Vertical"
                                UpperValue="80" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                MinWidth="100"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="Vertical + Ticks" />
                            <vio:RangeSlider
                                Height="160"
                                LowerValue="30"
                                Maximum="100"
                                Minimum="0"
                                Orientation="Vertical"
                                TickFrequency="10"
                                TickPlacement="Both"
                                UpperValue="70" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
