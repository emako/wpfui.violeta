<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.BasicInput.ButtonSpinnerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_ButtonSpinner}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_ButtonSpinner}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Gallery_Nav_Layout}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_5454e81038}}" />
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="220"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_c5e82a2b10}}" />
                            <vio:ButtonSpinner Width="200" Spin="ButtonSpinner_OnSpin">
                                <TextBlock
                                    x:Name="ButtonSpinnerDefaultValueText"
                                    VerticalAlignment="Center"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_e6803e21b9}}" />
                            </vio:ButtonSpinner>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="220"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_2b948774a3}}" />
                            <vio:ButtonSpinner
                                Width="200"
                                ButtonSpinnerLocation="Left"
                                Spin="ButtonSpinner_OnSpin">
                                <TextBlock
                                    x:Name="ButtonSpinnerLeftValueText"
                                    VerticalAlignment="Center"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_e6803e21b9}}" />
                            </vio:ButtonSpinner>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="220"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_c5c130941d}}" />
                            <vio:ButtonSpinner Width="200" ShowButtonSpinner="False">
                                <TextBlock VerticalAlignment="Center" Text="{I18N {x:Static lang:LangKeys.Sample_13e47b9559}}" />
                            </vio:ButtonSpinner>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="220"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_bf17e9c380}}" />
                            <vio:ButtonSpinner
                                Width="200"
                                Spin="ButtonSpinner_OnSpin"
                                Style="{DynamicResource SplitButtonSpinnerStyle}">
                                <TextBlock
                                    x:Name="ButtonSpinnerSplitRightValueText"
                                    VerticalAlignment="Center"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_e6803e21b9}}" />
                            </vio:ButtonSpinner>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                MinWidth="220"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_fcba73761d}}" />
                            <vio:ButtonSpinner
                                Width="200"
                                ButtonSpinnerLocation="Left"
                                Spin="ButtonSpinner_OnSpin"
                                Style="{DynamicResource SplitButtonSpinnerStyle}">
                                <TextBlock
                                    x:Name="ButtonSpinnerSplitLeftValueText"
                                    VerticalAlignment="Center"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_e6803e21b9}}" />
                            </vio:ButtonSpinner>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                MinWidth="220"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_b9f5c797eb}}" />
                            <vio:ButtonSpinner Width="200" IsEnabled="False">
                                <TextBlock VerticalAlignment="Center" Text="{I18N {x:Static lang:LangKeys.Sample_b9f5c797eb}}" />
                            </vio:ButtonSpinner>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
