<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Layout.FlexPanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_FlexPanel}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <vio:Page.Resources>
        <Style x:Key="DemoBox" TargetType="{x:Type Border}">
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style x:Key="DemoChip" BasedOn="{StaticResource DemoBox}" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="36" />
        </Style>
        <Style x:Key="BlueBox" BasedOn="{StaticResource DemoBox}" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#3B82F6" />
        </Style>
        <Style x:Key="GreenBox" BasedOn="{StaticResource DemoBox}" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#22C55E" />
        </Style>
        <Style x:Key="PurpleBox" BasedOn="{StaticResource DemoBox}" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#A855F7" />
        </Style>
        <Style x:Key="OrangeBox" BasedOn="{StaticResource DemoBox}" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#F97316" />
        </Style>
        <Style x:Key="PinkBox" BasedOn="{StaticResource DemoBox}" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#EC4899" />
        </Style>
        <Style x:Key="LabelText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="OptionLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="DemoSurface" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </vio:Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,8"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_FlexPanel}}" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Sample_f7a3b2c1d0}}"
                TextWrapping="Wrap" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_c4d0b9a8f7}}" />
                    <UniformGrid
                        Margin="0,0,0,12"
                        Columns="3"
                        Rows="2">
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Style="{StaticResource OptionLabel}" Text="{I18N {x:Static lang:LangKeys.Sample_80d6c5b4a3}}" />
                            <ComboBox x:Name="CbDirection" SelectedIndex="0">
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_flex01}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_flex02}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_flex03}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_flex04}}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Style="{StaticResource OptionLabel}" Text="{I18N {x:Static lang:LangKeys.Sample_79c5b4a392}}" />
                            <ComboBox x:Name="CbJustifyContent" SelectedIndex="0">
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_flex05}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_flex06}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_flex07}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_flex08}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_flex09}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_flex10}}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Style="{StaticResource OptionLabel}" Text="{I18N {x:Static lang:LangKeys.Sample_68b4a39281}}" />
                            <ComboBox x:Name="CbAlignItems" SelectedIndex="1">
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_flex11}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_flex12}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_flex05}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_flex06}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_flex07}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_flex13}}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Style="{StaticResource OptionLabel}" Text="{I18N {x:Static lang:LangKeys.Sample_57a3928170}}" />
                            <ComboBox x:Name="CbWrap" SelectedIndex="0">
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_flex14}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_flex15}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_flex16}}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource OptionLabel}" Text="{I18N {x:Static lang:LangKeys.Sample_469281706f}}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider
                                    x:Name="SliderGap"
                                    Grid.Column="0"
                                    Maximum="30"
                                    Minimum="0"
                                    Value="10" />
                                <TextBlock
                                    Grid.Column="1"
                                    Width="32"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding ElementName=SliderGap, Path=Value, StringFormat=F0}" />
                            </Grid>
                        </StackPanel>
                    </UniformGrid>
                    <Border MinHeight="120" Style="{StaticResource DemoSurface}">
                        <ui:FlexPanel
                            x:Name="DemoPanel"
                            Margin="10"
                            Gap="{Binding ElementName=SliderGap, Path=Value}">
                            <Border Style="{StaticResource DemoChip}">
                                <TextBlock Style="{StaticResource LabelText}" Text="1" />
                            </Border>
                            <Border Style="{StaticResource DemoChip}">
                                <TextBlock Style="{StaticResource LabelText}" Text="2" />
                            </Border>
                            <Border Style="{StaticResource DemoChip}">
                                <TextBlock Style="{StaticResource LabelText}" Text="3" />
                            </Border>
                            <Border Style="{StaticResource DemoChip}">
                                <TextBlock Style="{StaticResource LabelText}" Text="4" />
                            </Border>
                            <Border Style="{StaticResource DemoChip}">
                                <TextBlock Style="{StaticResource LabelText}" Text="5" />
                            </Border>
                        </ui:FlexPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_b3e9a8f7c6}}" />
                    <Border MinHeight="72" Style="{StaticResource DemoSurface}">
                        <ui:FlexPanel Margin="10" Gap="10">
                            <Border ui:FlexPanel.Grow="1" Style="{StaticResource BlueBox}">
                                <TextBlock Style="{StaticResource LabelText}" Text="{I18N {x:Static lang:LangKeys.Sample_3581706f5e}}" />
                            </Border>
                            <Border ui:FlexPanel.Grow="2" Style="{StaticResource GreenBox}">
                                <TextBlock Style="{StaticResource LabelText}" Text="{I18N {x:Static lang:LangKeys.Sample_24706f5e4d}}" />
                            </Border>
                            <Border ui:FlexPanel.Grow="1" Style="{StaticResource PurpleBox}">
                                <TextBlock Style="{StaticResource LabelText}" Text="{I18N {x:Static lang:LangKeys.Sample_3581706f5e}}" />
                            </Border>
                        </ui:FlexPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_a2f8e7d6b5}}" />
                    <Border MinHeight="160" Style="{StaticResource DemoSurface}">
                        <ui:FlexPanel Margin="10" Gap="10" Wrap="Wrap">
                            <Border Width="88" Style="{StaticResource BlueBox}">
                                <TextBlock Style="{StaticResource LabelText}" Text="{I18N {x:Static lang:LangKeys.Sample_flex_item01}}" />
                            </Border>
                            <Border Width="88" Style="{StaticResource GreenBox}">
                                <TextBlock Style="{StaticResource LabelText}" Text="{I18N {x:Static lang:LangKeys.Sample_flex_item02}}" />
                            </Border>
                            <Border Width="88" Style="{StaticResource PurpleBox}">
                                <TextBlock Style="{StaticResource LabelText}" Text="{I18N {x:Static lang:LangKeys.Sample_flex_item03}}" />
                            </Border>
                            <Border Width="88" Style="{StaticResource OrangeBox}">
                                <TextBlock Style="{StaticResource LabelText}" Text="{I18N {x:Static lang:LangKeys.Sample_flex_item04}}" />
                            </Border>
                            <Border Width="88" Style="{StaticResource PinkBox}">
                                <TextBlock Style="{StaticResource LabelText}" Text="{I18N {x:Static lang:LangKeys.Sample_flex_item05}}" />
                            </Border>
                            <Border Width="88" Style="{StaticResource BlueBox}">
                                <TextBlock Style="{StaticResource LabelText}" Text="{I18N {x:Static lang:LangKeys.Sample_flex_item06}}" />
                            </Border>
                            <Border Width="88" Style="{StaticResource GreenBox}">
                                <TextBlock Style="{StaticResource LabelText}" Text="{I18N {x:Static lang:LangKeys.Sample_flex_item07}}" />
                            </Border>
                            <Border Width="88" Style="{StaticResource PurpleBox}">
                                <TextBlock Style="{StaticResource LabelText}" Text="{I18N {x:Static lang:LangKeys.Sample_flex_item08}}" />
                            </Border>
                        </ui:FlexPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_91e7d6c5b4}}" />
                    <Border MinHeight="96" Style="{StaticResource DemoSurface}">
                        <ui:FlexPanel Margin="10" AlignItems="Stretch" Gap="10">
                            <Border ui:FlexPanel.AlignSelf="Start" Style="{StaticResource BlueBox}">
                                <TextBlock Style="{StaticResource LabelText}" Text="{I18N {x:Static lang:LangKeys.Sample_flex05}}" />
                            </Border>
                            <Border ui:FlexPanel.AlignSelf="Center" Style="{StaticResource GreenBox}">
                                <TextBlock Style="{StaticResource LabelText}" Text="{I18N {x:Static lang:LangKeys.Sample_flex07}}" />
                            </Border>
                            <Border ui:FlexPanel.AlignSelf="End" Style="{StaticResource PurpleBox}">
                                <TextBlock Style="{StaticResource LabelText}" Text="{I18N {x:Static lang:LangKeys.Sample_flex06}}" />
                            </Border>
                            <Border ui:FlexPanel.AlignSelf="Stretch" Style="{StaticResource OrangeBox}">
                                <TextBlock Style="{StaticResource LabelText}" Text="{I18N {x:Static lang:LangKeys.Sample_flex12}}" />
                            </Border>
                        </ui:FlexPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
