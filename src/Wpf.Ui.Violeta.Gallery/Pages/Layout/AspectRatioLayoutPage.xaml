<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Layout.AspectRatioLayoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_AspectRatioLayout}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_AspectRatioLayout}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_776feee78e}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_47b666a05d}}" />

                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <TextBlock Width="56" VerticalAlignment="Center" Text="{I18N {x:Static lang:LangKeys.Sample_32954654ac}}" />
                        <Slider
                            x:Name="AspectRatioWidthSlider"
                            Width="180"
                            Maximum="640"
                            Minimum="80"
                            Value="320" />
                        <TextBlock
                            Width="48"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding ElementName=AspectRatioWidthSlider, Path=Value, StringFormat=F0}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <TextBlock Width="56" VerticalAlignment="Center" Text="{I18N {x:Static lang:LangKeys.Sample_eec6c4bdbd}}" />
                        <Slider
                            x:Name="AspectRatioHeightSlider"
                            Width="180"
                            Maximum="360"
                            Minimum="80"
                            Value="160" />
                        <TextBlock
                            Width="48"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding ElementName=AspectRatioHeightSlider, Path=Value, StringFormat=F0}" />
                    </StackPanel>

                    <vio:AspectRatioLayout
                        Width="{Binding ElementName=AspectRatioWidthSlider, Path=Value}"
                        Height="{Binding ElementName=AspectRatioHeightSlider, Path=Value}"
                        HorizontalAlignment="Left"
                        AspectRatioTolerance="0.3">
                        <vio:AspectRatioLayoutItem AcceptAspectRatioMode="HorizontalRectangle">
                            <Border Background="Red" CornerRadius="6">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{I18N {x:Static lang:LangKeys.Sample_df9ef05bc0}}"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        Foreground="White"
                                        Text="{I18N {x:Static lang:LangKeys.Sample_08a8d819d9}}"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </vio:AspectRatioLayoutItem>
                        <vio:AspectRatioLayoutItem AcceptAspectRatioMode="Square">
                            <Border Background="Orange" CornerRadius="6">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Text="{I18N {x:Static lang:LangKeys.Sample_ceb46ca115}}"
                                        TextAlignment="Center" />
                                    <TextBlock Text="{I18N {x:Static lang:LangKeys.Sample_c917aaa403}}" TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </vio:AspectRatioLayoutItem>
                        <vio:AspectRatioLayoutItem AcceptAspectRatioMode="VerticalRectangle">
                            <Border Background="Green" CornerRadius="6">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{I18N {x:Static lang:LangKeys.Sample_35a7cc6b7a}}"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        Foreground="White"
                                        Text="{I18N {x:Static lang:LangKeys.Sample_f2ae179a7e}}"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </vio:AspectRatioLayoutItem>
                    </vio:AspectRatioLayout>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
