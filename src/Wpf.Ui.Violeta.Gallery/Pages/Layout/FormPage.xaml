<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Layout.FormPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="Form"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Form" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="LabelPosition = Top" />
                    <vio:Form Margin="0,8,0,0" LabelPosition="Top">
                        <vio:FormItem IsRequired="True" Label="Username">
                            <ui:TextBox Width="220" PlaceholderText="请输入用户名" />
                        </vio:FormItem>
                        <vio:FormItem Label="Email">
                            <ui:TextBox Width="220" PlaceholderText="example@email.com" />
                        </vio:FormItem>
                        <vio:FormItem Label="Notes">
                            <ui:TextBox
                                Width="220"
                                Height="60"
                                AcceptsReturn="True"
                                TextWrapping="Wrap" />
                        </vio:FormItem>
                    </vio:Form>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="LabelPosition = Left + FormGroup" />
                    <vio:Form
                        Margin="0,8,0,0"
                        LabelPosition="Left"
                        LabelWidth="*">
                        <vio:FormGroup Header="基本信息">
                            <vio:FormItem IsRequired="True" Label="姓名">
                                <ui:TextBox PlaceholderText="请输入姓名" />
                            </vio:FormItem>
                            <vio:FormItem Label="部门">
                                <ComboBox MinWidth="200">
                                    <ComboBoxItem Content="研发部" IsSelected="True" />
                                    <ComboBoxItem Content="设计部" />
                                    <ComboBoxItem Content="产品部" />
                                    <ComboBoxItem Content="运营部" />
                                </ComboBox>
                            </vio:FormItem>
                        </vio:FormGroup>
                        <vio:FormGroup Header="账号设置">
                            <vio:FormItem Label="启用通知">
                                <CheckBox IsChecked="True" />
                            </vio:FormItem>
                            <vio:FormItem Label="深色模式">
                                <ToggleButton IsChecked="True" />
                            </vio:FormItem>
                        </vio:FormGroup>
                        <vio:FormItem NoLabel="True">
                            <ui:Button Appearance="Primary" Content="提交" />
                        </vio:FormItem>
                    </vio:Form>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
