<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Layout.BorderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="Border"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Border" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="ClipToBounds + CornerRadius" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="内容按圆角外边缘裁剪。" />
                    <WrapPanel>
                        <ui:Border
                            Width="90"
                            Height="90"
                            Margin="0,0,16,16"
                            ClipToBounds="True"
                            CornerRadius="8">
                            <Rectangle Fill="Red" />
                        </ui:Border>
                        <ui:Border
                            Width="120"
                            Height="90"
                            Margin="0,0,16,16"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            ClipToBounds="True"
                            CornerRadius="12,4,12,4">
                            <Rectangle
                                Width="140"
                                Height="60"
                                Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                        </ui:Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="BorderThickness / BorderContentAdapter" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="无 Adapter 时内容可能盖住描边；Adapter 按内圆角裁剪。" />
                    <WrapPanel>
                        <ui:Border
                            Width="120"
                            Height="120"
                            Margin="0,0,16,0"
                            BorderBrush="Firebrick"
                            BorderThickness="5"
                            ClipToBounds="True"
                            CornerRadius="12">
                            <Rectangle Fill="DodgerBlue" />
                        </ui:Border>
                        <ui:Border
                            Width="120"
                            Height="120"
                            BorderBrush="Firebrick"
                            BorderThickness="5"
                            CornerRadius="12">
                            <ui:BorderContentAdapter>
                                <Rectangle Fill="DodgerBlue" />
                            </ui:BorderContentAdapter>
                        </ui:Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
