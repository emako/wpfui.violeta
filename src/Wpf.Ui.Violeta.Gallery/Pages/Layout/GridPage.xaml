<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Layout.GridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_Grid}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_Grid}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_7a1b2c3d4e}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_8b2c3d4e5f}}" />
                    <ui:Grid
                        Width="360"
                        Height="160"
                        HorizontalAlignment="Left"
                        ColumnDefinitions="auto,*,100"
                        RowDefinitions="auto,*">
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Text="{I18N {x:Static lang:LangKeys.Sample_b4c0b4ef70}}" />
                        <ui:TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            PlaceholderText="{I18N {x:Static lang:LangKeys.Sample_a7e0a4d8a3}}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,12,12,0"
                            VerticalAlignment="Top"
                            Text="{I18N {x:Static lang:LangKeys.Sample_a7e0a4d8a3}}" />
                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,12,0,0"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6" />
                    </ui:Grid>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_9c3d4e5f6a}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_a4d5e6f7b8}}" />
                    <ui:Grid
                        Width="360"
                        Height="160"
                        HorizontalAlignment="Left"
                        ColumnDefinitions="*,*,*"
                        HorizontalSpacing="8"
                        RowDefinitions="*,*"
                        VerticalSpacing="8">
                        <Border Background="#E74856" CornerRadius="6" />
                        <Border Background="#10893E" CornerRadius="6" />
                        <Border Background="#0078D4" CornerRadius="6" />
                        <Border Background="#FFB900" CornerRadius="6" />
                        <Border Background="#8764B8" CornerRadius="6" />
                        <Border Background="#00B7C3" CornerRadius="6" />
                    </ui:Grid>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_c5e6f7d8a9}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_d6f7a8b9c0}}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Grid.IsSharedSizeScope="True"
                        Margin="0,8,0,0"
                        MaxWidth="420">
                        <ui:Grid Margin="0,4">
                            <ui:Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GridFormLabel" />
                                <ColumnDefinition Width="*" MinWidth="160" />
                            </ui:Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{I18N {x:Static lang:LangKeys.Sample_60d0458ac6}}" />
                            <ui:TextBox
                                Grid.Column="1"
                                PlaceholderText="{I18N {x:Static lang:LangKeys.Sample_8093e3921d}}" />
                        </ui:Grid>
                        <ui:Grid Margin="0,4">
                            <ui:Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GridFormLabel" />
                                <ColumnDefinition Width="*" MinWidth="160" />
                            </ui:Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{I18N {x:Static lang:LangKeys.Sample_1e1459eeed}}" />
                            <ComboBox Grid.Column="1">
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_9176a628cc}}" IsSelected="True" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_829ec9c321}}" />
                                <ComboBoxItem Content="{I18N {x:Static lang:LangKeys.Sample_c5d34b60ac}}" />
                            </ComboBox>
                        </ui:Grid>
                        <ui:Grid Margin="0,4">
                            <ui:Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GridFormLabel" />
                                <ColumnDefinition Width="*" MinWidth="160" />
                            </ui:Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{I18N {x:Static lang:LangKeys.Sample_18d1485cc2}}" />
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="True" />
                        </ui:Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
