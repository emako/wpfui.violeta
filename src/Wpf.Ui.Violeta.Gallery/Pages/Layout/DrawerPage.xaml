<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Layout.DrawerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="Drawer"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Drawer" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_565fbc57f3}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_d994685ba5}}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_f8e7d6c5b4}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_f8e7d6c5b5}}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_f8e7d6c5b6}}" />
                    <vio:SelectableTextBlock
                        Margin="0,0,0,8"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="NavigationViewDefaultPaneBackground" />
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_f8e7d6c5b7}}" />
                    <vio:SelectableTextBlock
                        Margin="0,0,0,12"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text='Background="{DynamicResource NavigationViewDefaultPaneBackground}"' />
                    <WrapPanel Margin="0,0,0,12">
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ShowDrawer_Click"
                            Content="Left"
                            Tag="Left" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ShowDrawer_Click"
                            Content="Top"
                            Tag="Top" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ShowDrawer_Click"
                            Content="Right"
                            Tag="Right" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="ShowDrawer_Click"
                            Content="Bottom"
                            Tag="Bottom" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="CloseAll_Click"
                            Content="{I18N {x:Static lang:LangKeys.Sample_e125221047}}" />
                    </WrapPanel>

                    <Grid
                        Height="280"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        ClipToBounds="True">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="Drawer Container" />

                        <ui:Drawer
                            x:Name="LeftDrawer"
                            Width="180"
                            HorizontalAlignment="Left"
                            Placement="Left">
                            <Border Background="{DynamicResource NavigationViewDefaultPaneBackground}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="Drawer - Left" />
                            </Border>
                        </ui:Drawer>

                        <ui:Drawer
                            x:Name="TopDrawer"
                            Height="80"
                            VerticalAlignment="Top"
                            Placement="Top">
                            <Border Background="{DynamicResource NavigationViewDefaultPaneBackground}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="Drawer - Top" />
                            </Border>
                        </ui:Drawer>

                        <ui:Drawer
                            x:Name="RightDrawer"
                            Width="180"
                            HorizontalAlignment="Right"
                            Placement="Right">
                            <Border Background="{DynamicResource NavigationViewDefaultPaneBackground}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="Drawer - Right" />
                            </Border>
                        </ui:Drawer>

                        <ui:Drawer
                            x:Name="BottomDrawer"
                            Height="80"
                            VerticalAlignment="Bottom"
                            Placement="Bottom">
                            <Border Background="{DynamicResource NavigationViewDefaultPaneBackground}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="Drawer - Bottom" />
                            </Border>
                        </ui:Drawer>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
