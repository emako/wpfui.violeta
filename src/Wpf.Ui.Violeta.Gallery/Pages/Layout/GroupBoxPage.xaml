<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Layout.GroupBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_GroupBox}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_GroupBox}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_GroupBox_BasicTitle}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_GroupBox_BasicDesc}}"
                        TextWrapping="Wrap" />
                    <GroupBox Header="{I18N {x:Static lang:LangKeys.Sample_GroupBox_SettingsHeader}}">
                        <StackPanel>
                            <CheckBox Content="{I18N {x:Static lang:LangKeys.Sample_GroupBox_OptionAutoSave}}" IsChecked="True" />
                            <CheckBox Margin="0,8,0,0" Content="{I18N {x:Static lang:LangKeys.Sample_GroupBox_OptionNotify}}" />
                            <CheckBox Margin="0,8,0,0" Content="{I18N {x:Static lang:LangKeys.Sample_GroupBox_OptionTelemetry}}" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_GroupBox_NestedTitle}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_GroupBox_NestedDesc}}"
                        TextWrapping="Wrap" />
                    <GroupBox Header="{I18N {x:Static lang:LangKeys.Sample_GroupBox_AccountHeader}}">
                        <StackPanel>
                            <ui:TextBox
                                Margin="0,0,0,8"
                                PlaceholderText="{I18N {x:Static lang:LangKeys.Sample_GroupBox_DisplayName}}" />
                            <GroupBox Header="{I18N {x:Static lang:LangKeys.Sample_GroupBox_PrivacyHeader}}">
                                <StackPanel>
                                    <CheckBox Content="{I18N {x:Static lang:LangKeys.Sample_GroupBox_OptionPrivateProfile}}" IsChecked="True" />
                                    <CheckBox Margin="0,8,0,0" Content="{I18N {x:Static lang:LangKeys.Sample_GroupBox_OptionHideEmail}}" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
