<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Layout.CardControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_CardControl}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_CardControl}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_8f2ce987fd}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_9bf9a8e24d}}"
                        TextWrapping="Wrap" />
                    <ui:CardControl>
                        <ui:CardControl.Header>
                            <TextBlock Text="{I18N {x:Static lang:LangKeys.Sample_ecd0b43233}}" />
                        </ui:CardControl.Header>
                        <ui:CardControl.Content>
                            <ui:Button Content="{I18N {x:Static lang:LangKeys.Gallery_Page_Button}}" />
                        </ui:CardControl.Content>
                    </ui:CardControl>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_598e6bdee0}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_4b3ae6ebbf}}"
                        TextWrapping="Wrap" />
                    <ui:CardControl
                        Margin="4"
                        Padding="20,10"
                        Icon="{ui:SymbolIcon FlashSettings24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock
                                    FontTypography="BodyStrong"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_490309ef24}}"
                                    TextWrapping="WrapWithOverflow" />
                                <ui:TextBlock
                                    Appearance="Secondary"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_460daa68fb}}"
                                    TextWrapping="WrapWithOverflow" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch
                            HorizontalContentAlignment="Left"
                            OffContent="{I18N {x:Static lang:LangKeys.Sample_d15305d7a4}}"
                            OnContent="On" />
                    </ui:CardControl>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_478b28d0c0}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_6625c308e8}}"
                        TextWrapping="Wrap" />
                    <ui:CardControl
                        Margin="4"
                        Padding="20,10"
                        Icon="{ui:ImageIcon 'pack://application:,,,/Wpf.Ui.Violeta.Gallery;component/Resources/Images/wpfui.png'}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock
                                    FontTypography="BodyStrong"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_490309ef24}}"
                                    TextWrapping="WrapWithOverflow" />
                                <ui:TextBlock
                                    Appearance="Secondary"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_460daa68fb}}"
                                    TextWrapping="WrapWithOverflow" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <vio:DropDownButton Content="{I18N {x:Static lang:LangKeys.Sample_8b1a9953c4}}" Icon="{ui:SymbolIcon Fluent24}">
                            <vio:DropDownButton.Flyout>
                                <ContextMenu>
                                    <MenuItem Header="{I18N {x:Static lang:LangKeys.Sample_1bb125b89c}}" />
                                    <MenuItem Header="{I18N {x:Static lang:LangKeys.Sample_1063e38cb5}}" />
                                    <MenuItem Header="{I18N {x:Static lang:LangKeys.Sample_94966d9074}}" />
                                </ContextMenu>
                            </vio:DropDownButton.Flyout>
                        </vio:DropDownButton>
                    </ui:CardControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
