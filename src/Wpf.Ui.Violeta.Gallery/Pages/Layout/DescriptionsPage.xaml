<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Layout.DescriptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    xmlns:local="clr-namespace:Wpf.Ui.Violeta.Gallery.Pages.Layout"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_Descriptions}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_Descriptions}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_descriptions_inline}}" />
                    <vio:Descriptions
                        HorizontalAlignment="Stretch"
                        MaxWidth="400"
                        Margin="0,8,0,0"
                        LabelPosition="Left"
                        ItemAlignment="Center">
                        <vio:DescriptionsItem Label="User Count" Content="1,480,000" />
                        <vio:DescriptionsItem Label="7-day Retention" Content="98%" />
                        <vio:DescriptionsItem Label="Security Level" Content="III" />
                        <vio:DescriptionsItem Label="Category">
                            <Border
                                Padding="8,2"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <TextBlock FontSize="12" Text="E-Commerce" />
                            </Border>
                        </vio:DescriptionsItem>
                        <vio:DescriptionsItem Label="Verification" Content="Unverified" />
                    </vio:Descriptions>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_descriptions_binding}}" />
                    <vio:Descriptions
                        HorizontalAlignment="Stretch"
                        MaxWidth="400"
                        Margin="0,8,0,0"
                        ItemsSource="{Binding DescriptionItems, RelativeSource={RelativeSource AncestorType=local:DescriptionsPage}}"
                        LabelMemberPath="Label"
                        DisplayMemberPath="Description"
                        LabelPosition="Left"
                        ItemAlignment="Center" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_descriptions_horizontal}}" />
                    <StackPanel Margin="0,8,0,0">
                        <Border
                            Margin="0,0,0,8"
                            Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <vio:Descriptions
                                Size="Small"
                                Orientation="Horizontal"
                                LabelPosition="Top">
                                <vio:DescriptionsItem Label="User Count" Content="1,480,000" />
                                <vio:DescriptionsItem Label="7-Day Retention" Content="98%" />
                                <vio:DescriptionsItem Label="Security Level" Content="Level 3" />
                            </vio:Descriptions>
                        </Border>
                        <Border
                            Margin="0,0,0,8"
                            Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <vio:Descriptions Orientation="Horizontal" LabelPosition="Top">
                                <vio:DescriptionsItem Label="User Count" Content="1,480,000" />
                                <vio:DescriptionsItem Label="7-Day Retention" Content="98%" />
                                <vio:DescriptionsItem Label="Security Level" Content="Level 3" />
                            </vio:Descriptions>
                        </Border>
                        <Border
                            Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <vio:Descriptions
                                Size="Large"
                                Orientation="Horizontal"
                                LabelPosition="Top">
                                <vio:DescriptionsItem Label="User Count" Content="1,480,000" />
                                <vio:DescriptionsItem Label="7-Day Retention" Content="98%" />
                                <vio:DescriptionsItem Label="Security Level" Content="Level 3" />
                            </vio:Descriptions>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_descriptions_column_wrap}}" />
                    <vio:Descriptions
                        HorizontalAlignment="Stretch"
                        Margin="0,8,0,0"
                        ItemsSource="{Binding DescriptionItems2, RelativeSource={RelativeSource AncestorType=local:DescriptionsPage}}"
                        LabelMemberPath="Label"
                        ItemAlignment="Plain">
                        <vio:Descriptions.ItemsPanel>
                            <ItemsPanelTemplate>
                                <vio:ColumnWrapPanel Column="5" />
                            </ItemsPanelTemplate>
                        </vio:Descriptions.ItemsPanel>
                        <vio:Descriptions.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,0,8,0" Text="{Binding Description}" />
                            </DataTemplate>
                        </vio:Descriptions.ItemTemplate>
                    </vio:Descriptions>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
