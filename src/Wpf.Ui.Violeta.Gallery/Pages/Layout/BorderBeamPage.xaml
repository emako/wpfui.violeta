<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Layout.BorderBeamPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_BorderBeam}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_BorderBeam}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_b7e4a1c8d2}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_c8f5b2d9e3}}"
                        TextWrapping="Wrap" />
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,16">
                            <vio:BorderBeam
                                Width="280"
                                MinHeight="160"
                                BeamSize="100"
                                Duration="0:0:6"
                                LineWidth="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="BorderBeam" />
                                        <Border
                                            HorizontalAlignment="Right"
                                            Padding="8,2"
                                            Background="#FF52C41A"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="White"
                                                Text="6.4.0" />
                                        </Border>
                                    </Grid>
                                    <vio:Skeleton
                                        Height="12"
                                        Margin="0,0,0,8"
                                        IsActive="True"
                                        IsLoading="True" />
                                    <vio:Skeleton
                                        Height="12"
                                        Margin="0,0,0,8"
                                        IsActive="True"
                                        IsLoading="True" />
                                    <vio:Skeleton
                                        Width="180"
                                        Height="12"
                                        HorizontalAlignment="Center"
                                        IsActive="True"
                                        IsLoading="True" />
                                </StackPanel>
                            </vio:BorderBeam>
                            <TextBlock
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_d9g6c3e0f4}}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,16">
                            <vio:BorderBeam
                                Width="280"
                                MinHeight="160"
                                BeamHighlightColor="#FF60A5FA"
                                BeamColor="#FF2563EB"
                                BeamSize="120"
                                Count="2"
                                Duration="0:0:8"
                                LineWidth="2">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,12"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{I18N {x:Static lang:LangKeys.Sample_e0h7d4f1g5}}" />
                                    <TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{I18N {x:Static lang:LangKeys.Sample_f1i8e5g2h6}}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </vio:BorderBeam>
                            <TextBlock
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{I18N {x:Static lang:LangKeys.Sample_g2j9f6h3i7}}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_h3k0g7i4j8}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_i4l1h8j5k9}}"
                        TextWrapping="Wrap" />
                    <vio:BorderBeam
                        MaxWidth="520"
                        HorizontalAlignment="Left"
                        IsActive="{Binding IsOn, ElementName=ActiveToggle, FallbackValue=True, TargetNullValue=True}"
                        Style="{DynamicResource SecondaryBorderBeamStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Text="{I18N {x:Static lang:LangKeys.Sample_j5m2i9k6l0}}" />
                            <vio:ToggleSwitch x:Name="ActiveToggle" IsOn="True" />
                        </StackPanel>
                    </vio:BorderBeam>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</vio:Page>
