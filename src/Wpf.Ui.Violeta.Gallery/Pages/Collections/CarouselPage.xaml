<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Collections.CarouselPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_Carousel}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,4"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_Carousel}}" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Sample_9411b11d27}}" />

            <!--  Default + Nav  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_18c63459a2}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_d4ed947d9d}}" />
                    <vio:Carousel
                        Height="180"
                        MaxWidth="520"
                        HorizontalAlignment="Left"
                        Circular="True">
                        <vio:CarouselItem>
                            <Border Background="#2060C0" CornerRadius="6">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_c3e94a2a4d}}" />
                            </Border>
                        </vio:CarouselItem>
                        <vio:CarouselItem>
                            <Border Background="#20A060" CornerRadius="6">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_28db7c9a8d}}" />
                            </Border>
                        </vio:CarouselItem>
                        <vio:CarouselItem>
                            <Border Background="#C04020" CornerRadius="6">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_f268cd05d3}}" />
                            </Border>
                        </vio:CarouselItem>
                        <vio:CarouselItem>
                            <Border Background="#8040C0" CornerRadius="6">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_4de2a48a5d}}" />
                            </Border>
                        </vio:CarouselItem>
                    </vio:Carousel>
                </StackPanel>
            </Border>

            <!--  Brand Nav + Autoplay  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_5afe3a1529}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_e2eab3c10c}}" />
                    <vio:Carousel
                        Height="180"
                        MaxWidth="520"
                        HorizontalAlignment="Left"
                        AutoplayInterval="3000"
                        Circular="True"
                        IsAutoplayEnabled="True">
                        <vio:Carousel.Nav>
                            <vio:CarouselNav Appearance="Brand" />
                        </vio:Carousel.Nav>
                        <vio:CarouselItem>
                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="6">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    Foreground="White"
                                    Text="1" />
                            </Border>
                        </vio:CarouselItem>
                        <vio:CarouselItem>
                            <Border Background="{DynamicResource SystemFillColorSuccessBrush}" CornerRadius="6">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    Foreground="White"
                                    Text="2" />
                            </Border>
                        </vio:CarouselItem>
                        <vio:CarouselItem>
                            <Border Background="{DynamicResource SystemFillColorCautionBrush}" CornerRadius="6">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    Foreground="White"
                                    Text="3" />
                            </Border>
                        </vio:CarouselItem>
                    </vio:Carousel>
                </StackPanel>
            </Border>

            <!--  Fade + Draggable  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_ea9c482c64}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_7261a4dcf2}}" />
                    <vio:Carousel
                        Height="180"
                        MaxWidth="520"
                        HorizontalAlignment="Left"
                        Circular="True"
                        Draggable="True"
                        Motion="Fade">
                        <vio:Carousel.Nav>
                            <vio:CarouselNav />
                        </vio:Carousel.Nav>
                        <vio:CarouselItem>
                            <Border Background="#1A5F7A" CornerRadius="6">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Foreground="White"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_d9b735f827}}" />
                            </Border>
                        </vio:CarouselItem>
                        <vio:CarouselItem>
                            <Border Background="#159895" CornerRadius="6">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Foreground="White"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_f67bcc6ac3}}" />
                            </Border>
                        </vio:CarouselItem>
                        <vio:CarouselItem>
                            <Border Background="#57C5B6" CornerRadius="6">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Foreground="White"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_92b6558177}}" />
                            </Border>
                        </vio:CarouselItem>
                    </vio:Carousel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
