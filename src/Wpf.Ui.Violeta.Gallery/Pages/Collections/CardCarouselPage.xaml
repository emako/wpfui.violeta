<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Collections.CardCarouselPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_CardCarousel}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,4"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_CardCarousel}}" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{I18N {x:Static lang:LangKeys.Sample_d5be96d71e}}" />

            <!--  Default + arrows + dots  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_18c63459a2}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_9d8875cae7}}" />
                    <vio:CardCarousel
                        Height="280"
                        MaxWidth="720"
                        HorizontalAlignment="Left">
                        <vio:CardCarouselItem>
                            <Border Background="#2060C0">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_742c77afec}}" />
                            </Border>
                        </vio:CardCarouselItem>
                        <vio:CardCarouselItem>
                            <Border Background="#20A060">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_6fa1262c62}}" />
                            </Border>
                        </vio:CardCarouselItem>
                        <vio:CardCarouselItem>
                            <Border Background="#C04020">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_5aa55d6b93}}" />
                            </Border>
                        </vio:CardCarouselItem>
                        <vio:CardCarouselItem>
                            <Border Background="#8040C0">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_0d631fde3b}}" />
                            </Border>
                        </vio:CardCarouselItem>
                        <vio:CardCarouselItem>
                            <Border Background="#A07020">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{I18N {x:Static lang:LangKeys.Sample_aec2b16989}}" />
                            </Border>
                        </vio:CardCarouselItem>
                    </vio:CardCarousel>
                </StackPanel>
            </Border>

            <!--  Autoplay  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_05b1dc7759}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_eabd09afef}}" />
                    <vio:CardCarousel
                        Height="280"
                        MaxWidth="720"
                        HorizontalAlignment="Left"
                        AutoplayInterval="2000"
                        IsAutoplayEnabled="True"
                        ShowArrows="False">
                        <vio:CardCarousel.Nav>
                            <vio:CarouselNav Appearance="Brand" />
                        </vio:CardCarousel.Nav>
                        <vio:CardCarouselItem>
                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="32"
                                    Foreground="White"
                                    Text="1" />
                            </Border>
                        </vio:CardCarouselItem>
                        <vio:CardCarouselItem>
                            <Border Background="{DynamicResource SystemFillColorSuccessBrush}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="32"
                                    Foreground="White"
                                    Text="2" />
                            </Border>
                        </vio:CardCarouselItem>
                        <vio:CardCarouselItem>
                            <Border Background="{DynamicResource SystemFillColorCautionBrush}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="32"
                                    Foreground="White"
                                    Text="3" />
                            </Border>
                        </vio:CardCarouselItem>
                        <vio:CardCarouselItem>
                            <Border Background="{DynamicResource SystemFillColorCriticalBrush}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="32"
                                    Foreground="White"
                                    Text="4" />
                            </Border>
                        </vio:CardCarouselItem>
                    </vio:CardCarousel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
