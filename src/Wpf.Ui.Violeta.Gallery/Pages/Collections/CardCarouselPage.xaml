<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Collections.CardCarouselPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="CardCarousel"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,4"
                FontSize="20"
                FontWeight="SemiBold"
                Text="CardCarousel" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Cover-flow card carousel with left / center / right slots. Chrome uses WPF UI Card brushes." />

            <!--  Default + arrows + dots  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Default" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Click a side card, dots, or arrows to rotate. Keyboard Left / Right also works." />
                    <vio:CardCarousel
                        Height="280"
                        MaxWidth="720"
                        HorizontalAlignment="Left">
                        <vio:CardCarouselItem>
                            <Border Background="#2060C0">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Card 1" />
                            </Border>
                        </vio:CardCarouselItem>
                        <vio:CardCarouselItem>
                            <Border Background="#20A060">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Card 2" />
                            </Border>
                        </vio:CardCarouselItem>
                        <vio:CardCarouselItem>
                            <Border Background="#C04020">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Card 3" />
                            </Border>
                        </vio:CardCarouselItem>
                        <vio:CardCarouselItem>
                            <Border Background="#8040C0">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Card 4" />
                            </Border>
                        </vio:CardCarouselItem>
                        <vio:CardCarouselItem>
                            <Border Background="#A07020">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Card 5" />
                            </Border>
                        </vio:CardCarouselItem>
                    </vio:CardCarousel>
                </StackPanel>
            </Border>

            <!--  Autoplay  -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Autoplay" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="CarouselNav Appearance=Brand, IsAutoplayEnabled, 2s interval. Hover pauses autoplay." />
                    <vio:CardCarousel
                        Height="280"
                        MaxWidth="720"
                        HorizontalAlignment="Left"
                        AutoplayInterval="2000"
                        IsAutoplayEnabled="True"
                        ShowArrows="False">
                        <vio:CardCarousel.Nav>
                            <vio:CarouselNav Appearance="Brand" />
                        </vio:CardCarousel.Nav>
                        <vio:CardCarouselItem>
                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="32"
                                    Foreground="White"
                                    Text="1" />
                            </Border>
                        </vio:CardCarouselItem>
                        <vio:CardCarouselItem>
                            <Border Background="{DynamicResource SystemFillColorSuccessBrush}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="32"
                                    Foreground="White"
                                    Text="2" />
                            </Border>
                        </vio:CardCarouselItem>
                        <vio:CardCarouselItem>
                            <Border Background="{DynamicResource SystemFillColorCautionBrush}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="32"
                                    Foreground="White"
                                    Text="3" />
                            </Border>
                        </vio:CardCarouselItem>
                        <vio:CardCarouselItem>
                            <Border Background="{DynamicResource SystemFillColorCriticalBrush}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="32"
                                    Foreground="White"
                                    Text="4" />
                            </Border>
                        </vio:CardCarouselItem>
                    </vio:CardCarousel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
