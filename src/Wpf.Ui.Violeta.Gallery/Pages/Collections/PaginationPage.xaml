<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Collections.PaginationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="Pagination"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Pagination" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_1567bdcc25}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_23731d5885}}" />

                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <TextBlock
                            MinWidth="140"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="Basic (5 pages)" />
                        <vio:Pagination
                            PageSize="10"
                            TotalCount="50" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <TextBlock
                            MinWidth="140"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="Many pages" />
                        <vio:Pagination
                            CurrentPage="3"
                            PageSize="10"
                            TotalCount="1000" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <TextBlock
                            MinWidth="140"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="With QuickJump" />
                        <vio:Pagination
                            PageSize="10"
                            ShowQuickJump="True"
                            TotalCount="1000" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <TextBlock
                            MinWidth="140"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="Tiny" />
                        <vio:Pagination
                            PageSize="10"
                            Style="{DynamicResource DefaultTinyPaginationStyle}"
                            TotalCount="1000" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            MinWidth="140"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="Page Size Selector" />
                        <vio:Pagination
                            PageSize="10"
                            ShowPageSizeSelector="True"
                            TotalCount="1000" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
