<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Collections.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="Timeline"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Timeline" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Timeline — 时间线（声明式）" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="垂直时间线布局，展示事件顺序。" />
                    <vio:Timeline>
                        <vio:TimelineItem Header="项目启动">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="2024-01-01" />
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="项目正式立项，完成需求文档。" />
                            </StackPanel>
                        </vio:TimelineItem>
                        <vio:TimelineItem Header="设计阶段">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="2024-02-15" />
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="UI 设计稿完成，通过评审。" />
                            </StackPanel>
                        </vio:TimelineItem>
                        <vio:TimelineItem Header="开发完成">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="2024-05-01" />
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="核心功能开发完毕，进入测试阶段。" />
                            </StackPanel>
                        </vio:TimelineItem>
                        <vio:TimelineItem Header="正式发布">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="2024-06-01" />
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="v1.0 正式对外发布。" />
                            </StackPanel>
                        </vio:TimelineItem>
                    </vio:Timeline>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Timeline — Mode / Type（Test 演示）" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Alternate 模式与不同节点类型。" />
                    <vio:Timeline Mode="Alternate">
                        <vio:TimelineItem
                            Content="First item"
                            Header="Step One"
                            Position="Left"
                            Type="Default" />
                        <vio:TimelineItem
                            Content="Second item"
                            Header="Step Two"
                            Position="Right"
                            Type="Success" />
                        <vio:TimelineItem
                            Content="Third item"
                            Header="Step Three"
                            Position="Separate"
                            Type="Warning" />
                        <vio:TimelineItem
                            Content="Fourth item"
                            Header="Step Four"
                            Position="Separate"
                            Type="Ongoing" />
                        <vio:TimelineItem
                            Content="Fifth item"
                            Header="Step Five"
                            Position="Separate"
                            Type="Error" />
                    </vio:Timeline>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Timeline — 数据绑定" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="通过 ItemsSource 与 MemberPath 绑定。" />
                    <WrapPanel>
                        <vio:Timeline
                            Margin="0,0,24,0"
                            ContentMemberPath="Description"
                            HeaderMemberPath="Header"
                            ItemsSource="{Binding TimelineItems}"
                            Mode="Left"
                            TimeFormat="yyyy-MM-dd"
                            TimeMemberPath="Time" />
                        <vio:Timeline
                            ContentMemberPath="Description"
                            HeaderMemberPath="Header"
                            ItemsSource="{Binding TimelineItems}"
                            Mode="Right"
                            TimeFormat="yyyy-MM-dd"
                            TimeMemberPath="Time" />
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
