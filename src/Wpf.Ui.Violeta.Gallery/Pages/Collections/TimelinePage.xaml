<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Collections.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="Timeline"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Timeline" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_71df92bd0f}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_452e6c9afa}}" />
                    <vio:Timeline>
                        <vio:TimelineItem Header="{I18N {x:Static lang:LangKeys.Sample_484aefb490}}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="2024-01-01" />
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{I18N {x:Static lang:LangKeys.Sample_c0ebbe10c1}}" />
                            </StackPanel>
                        </vio:TimelineItem>
                        <vio:TimelineItem Header="{I18N {x:Static lang:LangKeys.Sample_6fe4c8e483}}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="2024-02-15" />
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{I18N {x:Static lang:LangKeys.Sample_b250f38e10}}" />
                            </StackPanel>
                        </vio:TimelineItem>
                        <vio:TimelineItem Header="{I18N {x:Static lang:LangKeys.Sample_f1d86ff89e}}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="2024-05-01" />
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{I18N {x:Static lang:LangKeys.Sample_adf525b652}}" />
                            </StackPanel>
                        </vio:TimelineItem>
                        <vio:TimelineItem Header="{I18N {x:Static lang:LangKeys.Sample_95a352a546}}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="2024-06-01" />
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{I18N {x:Static lang:LangKeys.Sample_f072efab93}}" />
                            </StackPanel>
                        </vio:TimelineItem>
                    </vio:Timeline>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_9de44749b0}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_f699b2bc6e}}" />
                    <vio:Timeline Mode="Alternate">
                        <vio:TimelineItem
                            Content="First item"
                            Header="Step One"
                            Position="Left"
                            Type="Default" />
                        <vio:TimelineItem
                            Content="Second item"
                            Header="Step Two"
                            Position="Right"
                            Type="Success" />
                        <vio:TimelineItem
                            Content="Third item"
                            Header="Step Three"
                            Position="Separate"
                            Type="Warning" />
                        <vio:TimelineItem
                            Content="Fourth item"
                            Header="Step Four"
                            Position="Separate"
                            Type="Ongoing" />
                        <vio:TimelineItem
                            Content="Fifth item"
                            Header="Step Five"
                            Position="Separate"
                            Type="Error" />
                    </vio:Timeline>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_e4f76ad96c}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_77bc5793f7}}" />
                    <WrapPanel>
                        <vio:Timeline
                            Margin="0,0,24,0"
                            ContentMemberPath="Description"
                            HeaderMemberPath="Header"
                            ItemsSource="{Binding TimelineItems}"
                            Mode="Left"
                            TimeFormat="yyyy-MM-dd"
                            TimeMemberPath="Time" />
                        <vio:Timeline
                            ContentMemberPath="Description"
                            HeaderMemberPath="Header"
                            ItemsSource="{Binding TimelineItems}"
                            Mode="Right"
                            TimeFormat="yyyy-MM-dd"
                            TimeMemberPath="Time" />
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
