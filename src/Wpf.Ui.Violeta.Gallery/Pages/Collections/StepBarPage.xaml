<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Collections.StepBarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_StepBar}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_StepBar}}" />

            <!-- Basic Top + Prev/Next -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_92fb2b0255}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_0714f07c9c}}" />

                    <vio:StepBar StepIndex="{Binding StepIndex, Mode=TwoWay}">
                        <vio:StepBarItem Content="{I18N {x:Static lang:LangKeys.Sample_51a5a9cd6d}}" />
                        <vio:StepBarItem Content="{I18N {x:Static lang:LangKeys.Sample_2da752eef4}}" />
                        <vio:StepBarItem Content="{I18N {x:Static lang:LangKeys.Sample_1fac3c1795}}" />
                        <vio:StepBarItem Content="{I18N {x:Static lang:LangKeys.Sample_3b5365276d}}" />
                    </vio:StepBar>

                    <StackPanel
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:Button
                            MinWidth="120"
                            Margin="0,0,12,0"
                            Appearance="Primary"
                            Command="{Binding PrevCommand}"
                            Content="{I18N {x:Static lang:LangKeys.Sample_50af0e23e5}}" />
                        <ui:Button
                            MinWidth="120"
                            Appearance="Primary"
                            Command="{Binding NextCommand}"
                            Content="{I18N {x:Static lang:LangKeys.Sample_7c707697a4}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Bottom + mouse selectable -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_a2d88998cb}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_f4b80256c2}}" />

                    <vio:StepBar Dock="Bottom" IsMouseSelectable="True">
                        <vio:StepBarItem Content="{I18N {x:Static lang:LangKeys.Sample_51a5a9cd6d}}" />
                        <vio:StepBarItem Content="{I18N {x:Static lang:LangKeys.Sample_2da752eef4}}" />
                        <vio:StepBarItem Content="{I18N {x:Static lang:LangKeys.Sample_1fac3c1795}}" />
                        <vio:StepBarItem Content="{I18N {x:Static lang:LangKeys.Sample_3b5365276d}}" />
                    </vio:StepBar>
                </StackPanel>
            </Border>

            <!-- Vertical Left / Right with ItemsSource -->
            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_c458efa8d5}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_d6e9f0a1b2}}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <vio:StepBar
                            Grid.Column="0"
                            Margin="0,0,16,0"
                            Dock="Left"
                            ItemsSource="{Binding StepItems}">
                            <vio:StepBar.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontSize="14" FontWeight="SemiBold">
                                            <Run Text="{Binding Header}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding Index, RelativeSource={RelativeSource AncestorType=vio:StepBarItem}}" />
                                        </TextBlock>
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Content}" />
                                    </StackPanel>
                                </DataTemplate>
                            </vio:StepBar.ItemTemplate>
                        </vio:StepBar>

                        <vio:StepBar
                            Grid.Column="1"
                            Dock="Right"
                            IsMouseSelectable="True"
                            ItemsSource="{Binding StepItems}">
                            <vio:StepBar.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontSize="14" FontWeight="SemiBold">
                                            <Run Text="{Binding Header}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding Index, RelativeSource={RelativeSource AncestorType=vio:StepBarItem}}" />
                                        </TextBlock>
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Content}" />
                                    </StackPanel>
                                </DataTemplate>
                            </vio:StepBar.ItemTemplate>
                        </vio:StepBar>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
