<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Collections.TreeListViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    xmlns:lang="clr-namespace:Wpf.Ui.Violeta.Gallery.Globalization"
    Title="{I18N {x:Static lang:LangKeys.Gallery_Page_TreeListView}}"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{I18N {x:Static lang:LangKeys.Gallery_Page_TreeListView}}" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{I18N {x:Static lang:LangKeys.Sample_9d268b366c}}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{I18N {x:Static lang:LangKeys.Sample_0d838a9c7d}}" />
                    <ui:TreeListView
                        x:Name="StaffTreeListView"
                        Height="280"
                        ItemsSource="{Binding StaffList}">
                        <ui:TreeListView.Columns>
                            <GridViewColumnCollection>
                                <ui:GridViewColumn Width="280" Header="{I18N {x:Static lang:LangKeys.Sample_60d0458ac6}}">
                                    <ui:GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:TreeRowExpander Content="{Binding Name}" />
                                        </DataTemplate>
                                    </ui:GridViewColumn.CellTemplate>
                                </ui:GridViewColumn>
                                <ui:GridViewColumn
                                    Width="80"
                                    DisplayMemberBinding="{Binding Age}"
                                    Header="{I18N {x:Static lang:LangKeys.Sample_a01a996323}}" />
                                <ui:GridViewColumn
                                    Width="80"
                                    DisplayMemberBinding="{Binding Sex}"
                                    Header="{I18N {x:Static lang:LangKeys.Sample_787b5677e3}}" />
                                <ui:GridViewColumn
                                    Width="120"
                                    DisplayMemberBinding="{Binding Duty}"
                                    Header="{I18N {x:Static lang:LangKeys.Sample_b652de80d6}}" />
                                <ui:GridViewColumn Width="100" Header="{I18N {x:Static lang:LangKeys.Sample_3fea7ca76c}}">
                                    <ui:GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:ToggleSwitch IsChecked="{Binding IsChecked}" />
                                        </DataTemplate>
                                    </ui:GridViewColumn.CellTemplate>
                                </ui:GridViewColumn>
                            </GridViewColumnCollection>
                        </ui:TreeListView.Columns>
                        <ui:TreeListView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding StaffList}" />
                        </ui:TreeListView.ItemTemplate>
                    </ui:TreeListView>
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <ui:Button Click="AddStaffNode_Click" Content="{I18N {x:Static lang:LangKeys.Sample_f68216034d}}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Click="ChangeStaffNode_Click"
                            Content="{I18N {x:Static lang:LangKeys.Sample_574256110b}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
