<vio:Page
    x:Class="Wpf.Ui.Violeta.Gallery.Pages.Collections.FlipViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="FlipView"
    d:Background="#1C1C1C"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24,16,24,24">

            <TextBlock
                Margin="0,0,0,16"
                FontSize="20"
                FontWeight="SemiBold"
                Text="FlipView" />

            <Border
                Margin="0,0,0,16"
                Padding="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="FlipView — 翻转视图" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="类似轮播图的翻转视图控件，左右切换内容。" />
                    <TextBlock
                        Margin="0,0,0,8"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="Auto（悬停显示按钮）" />
                    <vio:FlipView
                        Height="160"
                        MaxWidth="500"
                        HorizontalAlignment="Left">
                        <vio:FlipViewItem>
                            <Border Background="#2060C0" CornerRadius="6">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="第一页 — 欢迎使用 Violeta" />
                            </Border>
                        </vio:FlipViewItem>
                        <vio:FlipViewItem>
                            <Border Background="#20A060" CornerRadius="6">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="第二页 — Fluent Design" />
                            </Border>
                        </vio:FlipViewItem>
                        <vio:FlipViewItem>
                            <Border Background="#C04020" CornerRadius="6">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="第三页 — 多框架支持" />
                            </Border>
                        </vio:FlipViewItem>
                    </vio:FlipView>

                    <TextBlock
                        Margin="0,16,0,8"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="NavigationButtonsVisibility=Visible" />
                    <vio:FlipView
                        Width="400"
                        Height="160"
                        HorizontalAlignment="Left"
                        NavigationButtonsVisibility="Visible">
                        <vio:FlipViewItem>
                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    Foreground="White"
                                    Text="1" />
                            </Border>
                        </vio:FlipViewItem>
                        <vio:FlipViewItem>
                            <Border Background="{DynamicResource SystemFillColorSuccessBrush}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    Foreground="White"
                                    Text="2" />
                            </Border>
                        </vio:FlipViewItem>
                        <vio:FlipViewItem>
                            <Border Background="{DynamicResource SystemFillColorCautionBrush}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    Foreground="White"
                                    Text="3" />
                            </Border>
                        </vio:FlipViewItem>
                    </vio:FlipView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</vio:Page>
