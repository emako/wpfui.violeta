<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
    xmlns:vio="clr-namespace:Wpf.Ui.Violeta.Controls">

    <!--
        Hotfix: Enable DropDownFlyoutAssist on SplitButton so Flyout ContextMenu
        uses DropDownFlyoutContextMenuStyle (no From=-90 slide over the button).
        Keeps the upstream DefaultUiSplitButtonStyle template intact.
    -->
    <Style
        x:Key="HotfixUiSplitButtonStyle"
        BasedOn="{StaticResource DefaultUiSplitButtonStyle}"
        TargetType="{x:Type controls:SplitButton}">
        <Setter Property="vio:DropDownFlyoutAssist.IsEnabled" Value="True" />
    </Style>

    <Style BasedOn="{StaticResource HotfixUiSplitButtonStyle}" TargetType="{x:Type controls:SplitButton}" />

    <Style BasedOn="{StaticResource HotfixUiSplitButtonStyle}" TargetType="{x:Type vio:SplitButton}" />

</ResourceDictionary>
