<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
    xmlns:local="clr-namespace:Wpf.Ui.Violeta.Controls">

    <!--
        Hotfix: Wpf.Ui.Controls.CalendarDatePicker (Button subclass).
        BasedOn Violeta DefaultUiButtonStyle so chrome (incl. pressed) matches other Buttons.
        Popup: UiCalendarDatePickerHotfix applies CalendarDatePickerCalendarStyle
        (ComboBoxDropDownBackground + ThemeShadowChrome).
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui.Violeta;component/Hotfix/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <controls:SymbolIcon
        x:Key="CalendarPickerIcon"
        x:Shared="False"
        Symbol="CalendarRtl24" />

    <Style
        x:Key="DefaultUiCalendarDatePickerStyle"
        BasedOn="{StaticResource DefaultUiButtonStyle}"
        TargetType="{x:Type controls:CalendarDatePicker}">
        <Setter Property="Icon" Value="{StaticResource CalendarPickerIcon}" />
    </Style>

    <Style BasedOn="{StaticResource DefaultUiCalendarDatePickerStyle}" TargetType="{x:Type controls:CalendarDatePicker}" />

</ResourceDictionary>
