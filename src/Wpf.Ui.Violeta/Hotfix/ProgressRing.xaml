<!--
    Hotfix: WinUI ProgressRing template and indeterminate animation (from UI.WPF.Modern).
    Overrides the default WPF-UI ProgressRing style; colors reuse ProgressRing*ThemeBrush resources.
    Includes Value=0 ring hide fix (#86).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:compat="clr-namespace:Wpf.Ui.Violeta.Controls.Compat"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Wpf.Ui.Violeta.Controls">

    <sys:Double x:Key="ProgressRingStrokeThickness">3</sys:Double>

    <Style TargetType="{x:Type local:ProgressRingPresenter}">
        <Setter Property="Background" Value="{DynamicResource ProgressRingBackgroundThemeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressRingForegroundThemeBrush}" />
        <Setter Property="StrokeThickness" Value="{StaticResource ProgressRingStrokeThickness}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ProgressRingPresenter}">
                    <Grid x:Name="Root">
                        <!--  Gray outline of Progress Ring  -->
                        <Path
                            Data="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.OutlinePath}"
                            Fill="Transparent"
                            Stroke="{TemplateBinding Background}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="{TemplateBinding StrokeThickness}" />
                        <!--  Progress Ring  -->
                        <Path
                            x:Name="Path_Ring"
                            Data="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.RingPath}"
                            Fill="Transparent"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="{TemplateBinding StrokeThickness}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Value" Value="0">
                            <Setter TargetName="Path_Ring" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultProgressRingStyle" TargetType="{x:Type ui:ProgressRing}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressRingForegroundThemeBrush}" />
        <Setter Property="CoverRingStroke" Value="{DynamicResource ProgressRingBackgroundThemeBrush}" />
        <Setter Property="compat:ProgressRingHelper.StrokeThickness" Value="{DynamicResource ProgressRingStrokeThickness}" />
        <Setter Property="compat:ProgressRingHelper.IsEnabled" Value="True" />
        <Setter Property="compat:ProgressRingHelper.IsActive" Value="True" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:ProgressRing}">
                    <Border
                        x:Name="LayoutRoot"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <Border.Resources>
                            <Storyboard x:Key="ActiveToDeterminateActiveStoryboard">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Presenter" Storyboard.TargetProperty="Value">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                    <SplineDoubleKeyFrame
                                        KeySpline="0.1,0.9 0.2,1"
                                        KeyTime="0:0:0.367"
                                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(compat:ProgressRingHelper.TemplateSettings).NormalizedRange}" />
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Presenter" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                            <Storyboard x:Key="InactiveToDeterminateActiveStoryboard">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Presenter" Storyboard.TargetProperty="Value">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                    <SplineDoubleKeyFrame
                                        KeySpline="0.1,0.9 0.2,1"
                                        KeyTime="0:0:0.367"
                                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(compat:ProgressRingHelper.TemplateSettings).NormalizedRange}" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </Border.Resources>
                        <Viewbox Stretch="Fill">
                            <local:ProgressRingPresenter
                                x:Name="Presenter"
                                Width="32"
                                Height="32"
                                Background="{TemplateBinding CoverRingStroke}"
                                Foreground="{TemplateBinding Foreground}"
                                RenderTransformOrigin="0.5,0.5"
                                StrokeThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(compat:ProgressRingHelper.StrokeThickness)}"
                                Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=(compat:ProgressRingHelper.TemplateSettings).NormalizedRange}">
                                <local:ProgressRingPresenter.RenderTransform>
                                    <RotateTransform />
                                </local:ProgressRingPresenter.RenderTransform>
                            </local:ProgressRingPresenter>
                        </Viewbox>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ActiveStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition
                                        Storyboard="{StaticResource ActiveToDeterminateActiveStoryboard}"
                                        From="Active"
                                        To="DeterminateActive" />
                                    <VisualTransition
                                        Storyboard="{StaticResource InactiveToDeterminateActiveStoryboard}"
                                        From="Inactive"
                                        To="DeterminateActive" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Inactive">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Presenter" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="DeterminateActive" />
                                <VisualState x:Name="Active">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Presenter" Storyboard.TargetProperty="Value">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1" Value="0.5" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Presenter" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="90" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2" Value="1170" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultProgressRingStyle}" TargetType="{x:Type ui:ProgressRing}" />

</ResourceDictionary>
