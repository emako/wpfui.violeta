<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Wpf.Ui.Violeta.Controls">

    <Style TargetType="{x:Type local:VolumeView}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="BarWidth" Value="3" />
        <Setter Property="BarSpacing" Value="1.5" />
        <Setter Property="Bar1Height" Value="5" />
        <Setter Property="Bar2Height" Value="8.5" />
        <Setter Property="Bar3Height" Value="12" />
        <Setter Property="CornerRadius" Value="1.5" />
        <Setter Property="InactiveFill" Value="{DynamicResource VolumeViewInactiveFillBrush}" />
        <Setter Property="Level1Fill" Value="{DynamicResource VolumeViewLevel1FillBrush}" />
        <Setter Property="Level2Fill" Value="{DynamicResource VolumeViewLevel2FillBrush}" />
        <Setter Property="Level3Fill" Value="{DynamicResource VolumeViewLevel3FillBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VolumeView}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <!--
                            Glyph is authored in a 16×16 square (bars 3×5 / 8.5 / 12, gap 1.5),
                            then scaled by Width/Height so pill height follows the control size.
                        -->
                        <Viewbox Stretch="{TemplateBinding Stretch}">
                            <Grid Width="16" Height="16">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Border
                                        x:Name="PART_Bar1"
                                        Width="{TemplateBinding BarWidth}"
                                        Height="{TemplateBinding Bar1Height}"
                                        VerticalAlignment="Bottom"
                                        Background="{TemplateBinding InactiveFill}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                    <Border Width="{TemplateBinding BarSpacing}" />
                                    <Border
                                        x:Name="PART_Bar2"
                                        Width="{TemplateBinding BarWidth}"
                                        Height="{TemplateBinding Bar2Height}"
                                        VerticalAlignment="Bottom"
                                        Background="{TemplateBinding InactiveFill}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                    <Border Width="{TemplateBinding BarSpacing}" />
                                    <Border
                                        x:Name="PART_Bar3"
                                        Width="{TemplateBinding BarWidth}"
                                        Height="{TemplateBinding Bar3Height}"
                                        VerticalAlignment="Bottom"
                                        Background="{TemplateBinding InactiveFill}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                </StackPanel>
                            </Grid>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Volume" Value="1">
                            <Setter TargetName="PART_Bar1" Property="Background" Value="{Binding Level1Fill, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="Volume" Value="2">
                            <Setter TargetName="PART_Bar1" Property="Background" Value="{Binding Level2Fill, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="PART_Bar2" Property="Background" Value="{Binding Level2Fill, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="Volume" Value="3">
                            <Setter TargetName="PART_Bar1" Property="Background" Value="{Binding Level3Fill, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="PART_Bar2" Property="Background" Value="{Binding Level3Fill, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="PART_Bar3" Property="Background" Value="{Binding Level3Fill, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
