<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Wpf.Ui.Violeta.Controls"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="CardProgressIndicatorHeight">3</sys:Double>

    <Style x:Key="DefaultCardProgressStyle" TargetType="{x:Type local:CardProgress}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
        <Setter Property="Background" Value="{DynamicResource CardBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource CardForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThemeThickness}" />
        <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="ProgressForeground" Value="{DynamicResource ProgressBarForeground}" />
        <Setter Property="ProgressBackground" Value="{DynamicResource ProgressBarBackground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CardProgress}">
                    <Grid SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <Border
                            x:Name="ContentBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>

                        <!--
                            Full-size TextBox accent path. Progress is a left clip of that path,
                            so corners stay on the card radius instead of on the short bar.
                        -->
                        <local:CardProgressIndicator
                            x:Name="PART_Indicator"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            FillBrush="{TemplateBinding ProgressForeground}"
                            IndicatorThickness="{StaticResource CardProgressIndicatorHeight}"
                            IsIndeterminate="{TemplateBinding IsIndeterminate}"
                            Maximum="{TemplateBinding Maximum}"
                            Minimum="{TemplateBinding Minimum}"
                            ShowError="{TemplateBinding ShowError}"
                            ShowPaused="{TemplateBinding ShowPaused}"
                            TrackBrush="{TemplateBinding ProgressBackground}"
                            Value="{TemplateBinding Value}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource CardBackgroundDisabled}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource CardBorderBrushDisabled}" />
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultCardProgressStyle}" TargetType="{x:Type local:CardProgress}" />

    <Style
        x:Key="SecondaryCardProgressStyle"
        BasedOn="{StaticResource DefaultCardProgressStyle}"
        TargetType="{x:Type local:CardProgress}">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>

</ResourceDictionary>
