<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Wpf.Ui.Violeta.Controls">

    <!--  BasedOn StaticResource only resolves within this dictionary (and its merges), not sibling MergedDictionaries.  -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui.Violeta;component/Controls/ToggleComboBox/ToggleComboBox.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Toolbar ToggleComboBox:
        - Unchecked: transparent chrome; SubtleFill hover / press (same as ToolBarButtonStyle)
        - Checked: ToggleButton accent fill + foreground (same as ToolBarToggleButtonStyle)
        Keeps DefaultToggleComboBoxStyle template; only retargets fill / border brushes.
    -->
    <Style
        x:Key="SimpleToggleComboBoxStyle"
        BasedOn="{StaticResource DefaultToggleComboBoxStyle}"
        TargetType="{x:Type local:ToggleComboBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Tag" Value="ToolBar" />
        <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForeground}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <!--  Transparent toolbar chrome uses SubtleFill so hover is visible on light surfaces.  -->
        <Setter Property="MouseOverBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="MouseOverBorderBrush" Value="{DynamicResource ButtonBorderBrushPointerOver}" />
        <!--  WinUI SplitButtonCommandBarStyle: unfocused segment uses SubtleFill tertiary.  -->
        <Setter Property="MouseOverSecondaryBackground" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        <Setter Property="PressedBackground" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        <Setter Property="PressedSecondaryBackground" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        <Setter Property="PressedBorderBrush" Value="{DynamicResource ButtonBorderBrushPressed}" />
    </Style>

    <Style
        x:Key="ToolBarToggleComboBoxStyle"
        BasedOn="{StaticResource SimpleToggleComboBoxStyle}"
        TargetType="{x:Type local:ToggleComboBox}">
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="False" />
                    <Condition Property="IsChecked" Value="False" />
                </MultiTrigger.Conditions>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="False" />
                    <Condition Property="IsChecked" Value="True" />
                </MultiTrigger.Conditions>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
