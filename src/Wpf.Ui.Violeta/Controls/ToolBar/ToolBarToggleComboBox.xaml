<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Wpf.Ui.Violeta.Controls">

    <!--  BasedOn StaticResource only resolves within this dictionary (and its merges), not sibling MergedDictionaries.  -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui.Violeta;component/Controls/ToggleComboBox/ToggleComboBox.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Toolbar ToggleComboBox:
        - Unchecked: transparent chrome; SubtleFill hover / press (same as ToolBarButtonStyle)
        - Checked: ToggleButton accent fill + foreground (same as ToolBarToggleButtonStyle)
        - Chevron: DropDownButton-tight inset (4,0,6,0) via Style.Resources override of
        DefaultToggleComboBoxChevronStyle (template uses DynamicResource).
        Keeps DefaultToggleComboBoxStyle template; only retargets fill / border brushes + chevron inset.
    -->
    <Style
        x:Key="SimpleToggleComboBoxStyle"
        BasedOn="{StaticResource DefaultToggleComboBoxStyle}"
        TargetType="{x:Type local:ToggleComboBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Tag" Value="ToolBar" />
        <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForeground}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <!--  Transparent toolbar chrome uses SubtleFill so hover is visible on light surfaces.  -->
        <Setter Property="MouseOverBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="MouseOverBorderBrush" Value="{DynamicResource ButtonBorderBrushPointerOver}" />
        <!--  WinUI SplitButtonCommandBarStyle: unfocused segment uses SubtleFill tertiary.  -->
        <Setter Property="MouseOverSecondaryBackground" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        <Setter Property="PressedBackground" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        <Setter Property="PressedSecondaryBackground" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        <Setter Property="PressedBorderBrush" Value="{DynamicResource ButtonBorderBrushPressed}" />
    </Style>

    <Style
        x:Key="ToolBarToggleComboBoxStyle"
        BasedOn="{StaticResource SimpleToggleComboBoxStyle}"
        TargetType="{x:Type local:ToggleComboBox}">
        <!--
            Same key as DefaultToggleComboBoxChevronStyle so the template's DynamicResource
            resolves to this compact inset (matches ToolBarSplitButtonStyle chevron).
        -->
        <Style.Resources>
            <Style x:Key="DefaultToggleComboBoxChevronStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Border.CornerRadius" Value="0" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border
                                x:Name="ContentBorder"
                                Padding="4,0,6,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding Border.CornerRadius}">
                                <ContentPresenter
                                    x:Name="PART_ContentHost"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="False" />
                    <Condition Property="IsChecked" Value="False" />
                </MultiTrigger.Conditions>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="False" />
                    <Condition Property="IsChecked" Value="True" />
                </MultiTrigger.Conditions>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
