<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Wpf.Ui.Violeta.Controls">

    <Style TargetType="local:OutlineTextBlock">
        <Setter Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

</ResourceDictionary>
