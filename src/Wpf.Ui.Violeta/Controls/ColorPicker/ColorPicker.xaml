<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Wpf.Ui.Violeta.Converters"
    xmlns:local="clr-namespace:Wpf.Ui.Violeta.Controls">

    <BooleanToVisibilityConverter x:Key="ColorPickerBooleanToVisibilityConverter" />
    <converters:ToBrushConverter x:Key="ColorPickerFlyoutToBrushConverter" />
    <converters:ColorToHexConverter x:Key="ColorPickerHexConverter" />

    <DataTemplate x:Key="ColorPickerSwatchContentTemplate">
        <Grid MinWidth="{Binding ActualHeight, RelativeSource={RelativeSource Self}}">
            <Border
                Margin="1,1,0,1"
                Background="{DynamicResource ColorControlCheckeredBackgroundBrush}"
                CornerRadius="{DynamicResource ColorPickerCornerRadius}" />
            <Border
                Margin="1,1,0,1"
                Background="{Binding Converter={StaticResource ColorPickerFlyoutToBrushConverter}}"
                CornerRadius="{DynamicResource ColorPickerCornerRadius}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="HexColorPickerContentTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Grid.Column="0"
                Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                MinWidth="20">
                <Border
                    Margin="1,1,0,1"
                    Background="{DynamicResource ColorControlCheckeredBackgroundBrush}"
                    CornerRadius="{DynamicResource ColorPickerCornerRadius}" />
                <Border
                    Margin="1,1,0,1"
                    Background="{Binding HsvColor, RelativeSource={RelativeSource AncestorType={x:Type local:ColorPicker}}, Converter={StaticResource ColorPickerFlyoutToBrushConverter}}"
                    CornerRadius="{DynamicResource ColorPickerCornerRadius}" />
            </Grid>
            <TextBlock
                Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <Run Text="#" />
                <Run Text="{Binding Color, RelativeSource={RelativeSource AncestorType={x:Type local:ColorPicker}}, Converter={StaticResource ColorPickerHexConverter}, Mode=OneWay}" />
            </TextBlock>
        </Grid>
    </DataTemplate>

    <Style x:Key="ColorPickerFlyoutButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,0,8,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource ColorPickerCornerRadius}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter
                                Grid.Column="0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                FontSize="10"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="&#xE70D;" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Default ColorPicker: embeds ColorView in Popup  -->
    <Style TargetType="{x:Type local:ColorPicker}">
        <Setter Property="HexInputAlphaPosition" Value="Trailing" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="0,0,8,0" />
        <Setter Property="MinHeight" Value="{DynamicResource ColorPickerMinHeight}" />
        <Setter Property="Palette" Value="{DynamicResource SemiColorPalette}" />
        <Setter Property="Content" Value="{Binding HsvColor, RelativeSource={RelativeSource Self}}" />
        <Setter Property="ContentTemplate" Value="{StaticResource ColorPickerSwatchContentTemplate}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ColorPicker}">
                    <Grid>
                        <ToggleButton
                            x:Name="PART_FlyoutButton"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            MinWidth="{TemplateBinding MinWidth}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Style="{StaticResource ColorPickerFlyoutButtonStyle}" />
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            IsOpen="{Binding IsChecked, ElementName=PART_FlyoutButton, Mode=TwoWay}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=PART_FlyoutButton}"
                            PopupAnimation="Fade"
                            StaysOpen="False">
                            <Border
                                Margin="0,4,0,0"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="16"
                                        Direction="270"
                                        Opacity="0.2"
                                        ShadowDepth="4" />
                                </Border.Effect>
                                <local:ColorView
                                    Width="300"
                                    Height="300"
                                    ColorModel="{Binding ColorModel, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                    ColorSpectrumComponents="{Binding ColorSpectrumComponents, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColorSpectrumShape="{Binding ColorSpectrumShape, RelativeSource={RelativeSource TemplatedParent}}"
                                    HexInputAlphaPosition="{Binding HexInputAlphaPosition, RelativeSource={RelativeSource TemplatedParent}}"
                                    HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                    IsAccentColorsVisible="{Binding IsAccentColorsVisible, RelativeSource={RelativeSource TemplatedParent}}"
                                    IsAlphaEnabled="{Binding IsAlphaEnabled, RelativeSource={RelativeSource TemplatedParent}}"
                                    IsAlphaVisible="{Binding IsAlphaVisible, RelativeSource={RelativeSource TemplatedParent}}"
                                    IsColorComponentsVisible="{Binding IsColorComponentsVisible, RelativeSource={RelativeSource TemplatedParent}}"
                                    IsColorModelVisible="{Binding IsColorModelVisible, RelativeSource={RelativeSource TemplatedParent}}"
                                    IsColorPaletteVisible="{Binding IsColorPaletteVisible, RelativeSource={RelativeSource TemplatedParent}}"
                                    IsColorPreviewVisible="{Binding IsColorPreviewVisible, RelativeSource={RelativeSource TemplatedParent}}"
                                    IsColorSpectrumSliderVisible="{Binding IsColorSpectrumSliderVisible, RelativeSource={RelativeSource TemplatedParent}}"
                                    IsColorSpectrumVisible="{Binding IsColorSpectrumVisible, RelativeSource={RelativeSource TemplatedParent}}"
                                    IsComponentSliderVisible="{Binding IsComponentSliderVisible, RelativeSource={RelativeSource TemplatedParent}}"
                                    IsComponentTextInputVisible="{Binding IsComponentTextInputVisible, RelativeSource={RelativeSource TemplatedParent}}"
                                    IsHexInputVisible="{Binding IsHexInputVisible, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHue="{Binding MaxHue, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxSaturation="{Binding MaxSaturation, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxValue="{Binding MaxValue, RelativeSource={RelativeSource TemplatedParent}}"
                                    MinHue="{Binding MinHue, RelativeSource={RelativeSource TemplatedParent}}"
                                    MinSaturation="{Binding MinSaturation, RelativeSource={RelativeSource TemplatedParent}}"
                                    MinValue="{Binding MinValue, RelativeSource={RelativeSource TemplatedParent}}"
                                    Palette="{Binding Palette, RelativeSource={RelativeSource TemplatedParent}}"
                                    SelectedIndex="{Binding SelectedIndex, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                    Color="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="HexColorPicker"
        BasedOn="{StaticResource {x:Type local:ColorPicker}}"
        TargetType="{x:Type local:ColorPicker}">
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Content" Value="{Binding ., RelativeSource={RelativeSource Self}}" />
        <Setter Property="ContentTemplate" Value="{StaticResource HexColorPickerContentTemplate}" />
    </Style>

    <!--  SimpleColorPicker: embeds SimpleColorView  -->
    <Style x:Key="SimpleColorPicker" TargetType="{x:Type local:ColorPicker}">
        <Setter Property="HexInputAlphaPosition" Value="Trailing" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="0,0,8,0" />
        <Setter Property="MinHeight" Value="{DynamicResource ColorPickerMinHeight}" />
        <Setter Property="ColorSpectrumComponents" Value="SaturationValue" />
        <Setter Property="Palette" Value="{DynamicResource SemiColorPalette}" />
        <Setter Property="Content" Value="{Binding HsvColor, RelativeSource={RelativeSource Self}}" />
        <Setter Property="ContentTemplate" Value="{StaticResource ColorPickerSwatchContentTemplate}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ColorPicker}">
                    <Grid>
                        <ToggleButton
                            x:Name="PART_FlyoutButton"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            MinWidth="{TemplateBinding MinWidth}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Style="{StaticResource ColorPickerFlyoutButtonStyle}" />
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            IsOpen="{Binding IsChecked, ElementName=PART_FlyoutButton, Mode=TwoWay}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=PART_FlyoutButton}"
                            PopupAnimation="Fade"
                            StaysOpen="False">
                            <Border
                                Margin="0,4,0,0"
                                Padding="8"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="16"
                                        Direction="270"
                                        Opacity="0.2"
                                        ShadowDepth="4" />
                                </Border.Effect>
                                <local:ColorView
                                    Width="280"
                                    MinHeight="280"
                                    ColorSpectrumComponents="{Binding ColorSpectrumComponents, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColorSpectrumShape="{Binding ColorSpectrumShape, RelativeSource={RelativeSource TemplatedParent}}"
                                    HexInputAlphaPosition="{Binding HexInputAlphaPosition, RelativeSource={RelativeSource TemplatedParent}}"
                                    HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                    IsAccentColorsVisible="{Binding IsAccentColorsVisible, RelativeSource={RelativeSource TemplatedParent}}"
                                    IsAlphaEnabled="{Binding IsAlphaEnabled, RelativeSource={RelativeSource TemplatedParent}}"
                                    IsAlphaVisible="{Binding IsAlphaVisible, RelativeSource={RelativeSource TemplatedParent}}"
                                    IsColorSpectrumSliderVisible="{Binding IsColorSpectrumSliderVisible, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHue="{Binding MaxHue, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxSaturation="{Binding MaxSaturation, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxValue="{Binding MaxValue, RelativeSource={RelativeSource TemplatedParent}}"
                                    MinHue="{Binding MinHue, RelativeSource={RelativeSource TemplatedParent}}"
                                    MinSaturation="{Binding MinSaturation, RelativeSource={RelativeSource TemplatedParent}}"
                                    MinValue="{Binding MinValue, RelativeSource={RelativeSource TemplatedParent}}"
                                    Style="{DynamicResource SimpleColorView}"
                                    Color="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="HexSimpleColorPicker"
        BasedOn="{StaticResource SimpleColorPicker}"
        TargetType="{x:Type local:ColorPicker}">
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Content" Value="{Binding ., RelativeSource={RelativeSource Self}}" />
        <Setter Property="ContentTemplate" Value="{StaticResource HexColorPickerContentTemplate}" />
    </Style>

</ResourceDictionary>
