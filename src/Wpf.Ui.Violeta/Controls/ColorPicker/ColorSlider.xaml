<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Wpf.Ui.Violeta.Controls"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:Double x:Key="ColorSliderCornerRadiusSize">4</system:Double>

    <Style x:Key="ColorSliderThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorSliderDefaultBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Width" Value="{DynamicResource ColorSliderWidth}" />
        <Setter Property="Height" Value="{DynamicResource ColorSliderWidth}" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border
                        Margin="1"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource ColorSliderThumbCornerRadius}">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="2"
                                Direction="0"
                                Opacity="0.35"
                                ShadowDepth="0"
                                Color="White" />
                        </Border.Effect>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ColorSliderHorizontalTemplate" TargetType="{x:Type local:ColorSlider}">
        <Border
            Background="Transparent"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
            <Grid Margin="{TemplateBinding Padding}">
                <!--
                    Use Rectangle+RadiusX/Y (same as ColorSpectrum) instead of Border+CornerRadius.
                    WPF does not reliably clip ImageBrush backgrounds to Border.CornerRadius,
                    which often shows up as a missing round on the right edge.
                -->
                <Rectangle
                    Height="{DynamicResource ColorSliderWidth}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Fill="{DynamicResource ColorControlCheckeredBackgroundBrush}"
                    RadiusX="{DynamicResource ColorSliderCornerRadiusSize}"
                    RadiusY="{DynamicResource ColorSliderCornerRadiusSize}" />
                <Rectangle
                    Height="{DynamicResource ColorSliderWidth}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Fill="{TemplateBinding Background}"
                    RadiusX="{DynamicResource ColorSliderCornerRadiusSize}"
                    RadiusY="{DynamicResource ColorSliderCornerRadiusSize}" />
                <Track
                    x:Name="PART_Track"
                    Height="{DynamicResource ColorSliderWidth}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton
                            x:Name="PART_DecreaseButton"
                            Command="Slider.DecreaseLarge"
                            Focusable="False"
                            Style="{x:Null}">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                    <Border Margin="0,-8" Background="Transparent" />
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb x:Name="ColorSliderThumb" Style="{StaticResource ColorSliderThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton
                            x:Name="PART_IncreaseButton"
                            Command="Slider.IncreaseLarge"
                            Focusable="False"
                            Style="{x:Null}">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                    <Border Margin="0,-8" Background="Transparent" />
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ColorSliderThumb" Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsDarkSelector" Value="True">
                <Setter TargetName="ColorSliderThumb" Property="BorderBrush" Value="{DynamicResource ColorSliderDarkBorderBrush}" />
            </Trigger>
            <Trigger Property="IsLightSelector" Value="True">
                <Setter TargetName="ColorSliderThumb" Property="BorderBrush" Value="{DynamicResource ColorSliderLightBorderBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="ColorSliderVerticalTemplate" TargetType="{x:Type local:ColorSlider}">
        <Border
            Background="Transparent"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
            <Grid Margin="{TemplateBinding Padding}">
                <Rectangle
                    Width="{DynamicResource ColorSliderWidth}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Fill="{DynamicResource ColorControlCheckeredBackgroundBrush}"
                    RadiusX="{DynamicResource ColorSliderCornerRadiusSize}"
                    RadiusY="{DynamicResource ColorSliderCornerRadiusSize}" />
                <Rectangle
                    Width="{DynamicResource ColorSliderWidth}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Fill="{TemplateBinding Background}"
                    RadiusX="{DynamicResource ColorSliderCornerRadiusSize}"
                    RadiusY="{DynamicResource ColorSliderCornerRadiusSize}" />
                <Track
                    x:Name="PART_Track"
                    Width="{DynamicResource ColorSliderWidth}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Orientation="Vertical">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton
                            x:Name="PART_DecreaseButton"
                            Command="Slider.DecreaseLarge"
                            Focusable="False"
                            Style="{x:Null}">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                    <Border Margin="-8,0" Background="Transparent" />
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb x:Name="ColorSliderThumb" Style="{StaticResource ColorSliderThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton
                            x:Name="PART_IncreaseButton"
                            Command="Slider.IncreaseLarge"
                            Focusable="False"
                            Style="{x:Null}">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                    <Border Margin="-8,0" Background="Transparent" />
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ColorSliderThumb" Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsDarkSelector" Value="True">
                <Setter TargetName="ColorSliderThumb" Property="BorderBrush" Value="{DynamicResource ColorSliderDarkBorderBrush}" />
            </Trigger>
            <Trigger Property="IsLightSelector" Value="True">
                <Setter TargetName="ColorSliderThumb" Property="BorderBrush" Value="{DynamicResource ColorSliderLightBorderBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type local:ColorSlider}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Height" Value="{DynamicResource ColorSliderWidth}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource ColorSliderHorizontalTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="{DynamicResource ColorSliderWidth}" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Template" Value="{StaticResource ColorSliderVerticalTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
