    <!--  Match WinUI ColorPicker channel editors: ~32px tall, comfortable padding & row gap  -->
    <sys:Double x:Key="ColorViewNumericUpDownWidth">88</sys:Double>
    <sys:Double x:Key="ColorViewNumericUpDownMinHeight">32</sys:Double>
    <Thickness x:Key="ColorViewNumericUpDownPadding">8,0,8,0</Thickness>
    <Thickness x:Key="ColorViewNumericUpDownMargin">0,6,12,6</Thickness>
    <sys:Double x:Key="ColorSliderWidth">12</sys:Double>
    <CornerRadius x:Key="ColorSliderCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ColorSliderThumbCornerRadius">999</CornerRadius>
    <sys:Double x:Key="ColorPreviewerAccentSectionWidth">80</sys:Double>
    <sys:Double x:Key="ColorPreviewerAccentSectionHeight">20</sys:Double>
    <sys:Double x:Key="ColorPreviewerHeight">48</sys:Double>
    <CornerRadius x:Key="ColorPreviewerCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ColorSpectrumCornerRadius">4</CornerRadius>
    <sys:Double x:Key="ColorPickerMinHeight">32</sys:Double>
    <CornerRadius x:Key="ColorPickerCornerRadius">4</CornerRadius>

    <!--  Default palette fallback (theme may override SemiColorPalette)  -->
    <local:SemiColorLightPalette x:Key="SemiColorPalette" />

    <Style x:Key="ColorViewPaletteListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid SnapsToDevicePixels="False">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <Rectangle
                            x:Name="BorderRectangle"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsHitTestVisible="False"
                            Opacity="0"
                            Stroke="Transparent"
                            StrokeThickness="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BorderRectangle" Property="Opacity" Value="0.5" />
                            <Setter TargetName="BorderRectangle" Property="Stroke" Value="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ContrastBrushConverter}}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="BorderRectangle" Property="Opacity" Value="1" />
                            <Setter TargetName="BorderRectangle" Property="Stroke" Value="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ContrastBrushConverter}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ColorView tab headers: TabStripItem with accent selected color for icon Path Fill  -->
    <Style
        x:Key="ColorViewTabStripItemStyle"
        BasedOn="{StaticResource DefaultTabStripItemStyle}"
        TargetType="{x:Type local:TabStripItem}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ColorViewTabItemSelectedForeground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Default ColorView  -->
    <Style TargetType="{x:Type local:ColorView}">
        <Setter Property="HexInputAlphaPosition" Value="Trailing" />
        <Setter Property="Width" Value="300" />
        <Setter Property="Height" Value="360" />
        <Setter Property="Palette" Value="{DynamicResource SemiColorPalette}" />
        <Setter Property="Background" Value="{DynamicResource ColorViewContentBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ColorView}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource ColorViewContentBorderBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <local:TabStrip
                                x:Name="PART_TabStrip"
                                Grid.Row="0"
                                HorizontalContentAlignment="Stretch"
                                IndicatorAnimation="Fluent"
                                ItemContainerStyle="{StaticResource ColorViewTabStripItemStyle}"
                                SelectedIndex="{Binding SelectedIndex, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}">
                                <local:TabStrip.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </local:TabStrip.ItemsPanel>
                                <local:TabStripItem Visibility="{Binding IsColorSpectrumVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="{StaticResource ColorViewSpectrumIconGlyph}"
                                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:TabStripItem}}}"
                                        Stretch="Uniform" />
                                </local:TabStripItem>
                                <local:TabStripItem Visibility="{Binding IsColorPaletteVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="{StaticResource ColorViewPaletteIconGlyph}"
                                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:TabStripItem}}}"
                                        Stretch="Uniform" />
                                </local:TabStripItem>
                                <local:TabStripItem Visibility="{Binding IsColorComponentsVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="{StaticResource ColorViewComponentsIconGlyph}"
                                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:TabStripItem}}}"
                                        Stretch="Uniform" />
                                </local:TabStripItem>
                            </local:TabStrip>

                            <Grid Grid.Row="1">
                                <!--  Spectrum  -->
                                <Grid
                                    x:Name="SpectrumPanel"
                                    Margin="12"
                                    Visibility="{Binding SelectedIndex, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=0}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" MinWidth="32" />
                                    </Grid.ColumnDefinitions>
                                    <local:ColorSlider
                                        x:Name="ColorSpectrumThirdComponentSlider"
                                        Grid.Column="0"
                                        Margin="0,0,12,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Stretch"
                                        ColorComponent="{Binding ThirdComponent, ElementName=ColorSpectrum}"
                                        ColorModel="Hsva"
                                        HsvColor="{Binding HsvColor, ElementName=ColorSpectrum, Mode=TwoWay}"
                                        IsAlphaVisible="False"
                                        IsPerceptive="True"
                                        Orientation="Vertical"
                                        Visibility="{Binding IsColorSpectrumSliderVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <local:ColorSpectrum
                                        x:Name="ColorSpectrum"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Components="{TemplateBinding ColorSpectrumComponents}"
                                        HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        MaxHue="{TemplateBinding MaxHue}"
                                        MaxSaturation="{TemplateBinding MaxSaturation}"
                                        MaxValue="{TemplateBinding MaxValue}"
                                        MinHue="{TemplateBinding MinHue}"
                                        MinSaturation="{TemplateBinding MinSaturation}"
                                        MinValue="{TemplateBinding MinValue}"
                                        Shape="{TemplateBinding ColorSpectrumShape}" />
                                    <local:ColorSlider
                                        x:Name="ColorSpectrumAlphaSlider"
                                        Grid.Column="2"
                                        Margin="12,0,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Stretch"
                                        ColorComponent="Alpha"
                                        ColorModel="Hsva"
                                        HsvColor="{Binding HsvColor, ElementName=ColorSpectrum, Mode=TwoWay}"
                                        IsEnabled="{TemplateBinding IsAlphaEnabled}"
                                        Orientation="Vertical"
                                        Visibility="{Binding IsAlphaVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>

                                <!--  Palette  -->
                                <ListBox
                                    x:Name="PalettePanel"
                                    Margin="12"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource ColorViewPaletteListBoxItemStyle}"
                                    ItemsSource="{TemplateBinding PaletteColors}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    SelectedItem="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, Converter={StaticResource DoNothingForNullConverter}}"
                                    SnapsToDevicePixels="False"
                                    Visibility="{Binding SelectedIndex, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type media:Color}">
                                            <Border
                                                MinHeight="28"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                ToolTip="{Binding Converter={StaticResource ColorToDisplayNameConverter}}">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding}" />
                                                </Border.Background>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding PaletteColumnCount, RelativeSource={RelativeSource AncestorType={x:Type local:ColorView}}}" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>

                                <!--  Components  -->
                                <Grid
                                    x:Name="ComponentsPanel"
                                    Margin="12"
                                    SnapsToDevicePixels="False"
                                    Visibility="{Binding SelectedIndex, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=2}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" MinHeight="44" />
                                        <RowDefinition Height="*" MinHeight="44" />
                                        <RowDefinition Height="*" MinHeight="44" />
                                        <RowDefinition Height="*" MinHeight="44" />
                                        <RowDefinition Height="8" />
                                    </Grid.RowDefinitions>

                                    <Grid
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            x:Name="ColorModelComboBox"
                                            VerticalAlignment="Center"
                                            SelectedValue="{Binding ColorModel, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                            SelectedValuePath="Tag"
                                            Visibility="{Binding IsColorModelVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ComboBoxItem Content="RGB" Tag="{x:Static local:ColorModel.Rgba}" />
                                            <ComboBoxItem Content="HSV" Tag="{x:Static local:ColorModel.Hsva}" />
                                        </ComboBox>
                                        <ui:TextBox
                                            x:Name="PART_HexTextBox"
                                            Grid.Column="2"
                                            MaxLength="8"
                                            ClearButtonEnabled="True"
                                            Style="{DynamicResource PrefixTextBoxStyle}"
                                            VerticalContentAlignment="Center"
                                            Visibility="{Binding IsHexInputVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            local:InputAssist.Prefix="#" />
                                    </Grid>

                                    <local:NumericDoubleUpDown
                                        x:Name="Component1NumericUpDown"
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Width="{DynamicResource ColorViewNumericUpDownWidth}"
                                        Height="{DynamicResource ColorViewNumericUpDownMinHeight}"
                                        MinHeight="{DynamicResource ColorViewNumericUpDownMinHeight}"
                                        Margin="{DynamicResource ColorViewNumericUpDownMargin}"
                                        Padding="{DynamicResource ColorViewNumericUpDownPadding}"
                                        Style="{DynamicResource PrefixNumericDoubleUpDownStyle}"
                                        InnerLeftContent="R"
                                        Maximum="{Binding Maximum, ElementName=Component1Slider}"
                                        Minimum="{Binding Minimum, ElementName=Component1Slider}"
                                        Visibility="{Binding IsComponentTextInputVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Value="{Binding Value, ElementName=Component1Slider, Mode=TwoWay}" />
                                    <local:ColorSlider
                                        x:Name="Component1Slider"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Color="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        ColorComponent="Component1"
                                        ColorModel="{TemplateBinding ColorModel}"
                                        HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        IsRoundingEnabled="True"
                                        IsSnapToTickEnabled="True"
                                        Orientation="Horizontal"
                                        TickFrequency="1"
                                        Visibility="{Binding IsComponentSliderVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <local:NumericDoubleUpDown
                                        x:Name="Component2NumericUpDown"
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Width="{DynamicResource ColorViewNumericUpDownWidth}"
                                        Height="{DynamicResource ColorViewNumericUpDownMinHeight}"
                                        MinHeight="{DynamicResource ColorViewNumericUpDownMinHeight}"
                                        Margin="{DynamicResource ColorViewNumericUpDownMargin}"
                                        Padding="{DynamicResource ColorViewNumericUpDownPadding}"
                                        Style="{DynamicResource PrefixNumericDoubleUpDownStyle}"
                                        InnerLeftContent="G"
                                        Maximum="{Binding Maximum, ElementName=Component2Slider}"
                                        Minimum="{Binding Minimum, ElementName=Component2Slider}"
                                        Visibility="{Binding IsComponentTextInputVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Value="{Binding Value, ElementName=Component2Slider, Mode=TwoWay}" />
                                    <local:ColorSlider
                                        x:Name="Component2Slider"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Color="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        ColorComponent="Component2"
                                        ColorModel="{TemplateBinding ColorModel}"
                                        HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        IsRoundingEnabled="True"
                                        IsSnapToTickEnabled="True"
                                        Orientation="Horizontal"
                                        TickFrequency="1"
                                        Visibility="{Binding IsComponentSliderVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <local:NumericDoubleUpDown
                                        x:Name="Component3NumericUpDown"
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Width="{DynamicResource ColorViewNumericUpDownWidth}"
                                        Height="{DynamicResource ColorViewNumericUpDownMinHeight}"
                                        MinHeight="{DynamicResource ColorViewNumericUpDownMinHeight}"
                                        Margin="{DynamicResource ColorViewNumericUpDownMargin}"
                                        Padding="{DynamicResource ColorViewNumericUpDownPadding}"
                                        Style="{DynamicResource PrefixNumericDoubleUpDownStyle}"
                                        InnerLeftContent="B"
                                        Maximum="{Binding Maximum, ElementName=Component3Slider}"
                                        Minimum="{Binding Minimum, ElementName=Component3Slider}"
                                        Visibility="{Binding IsComponentTextInputVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Value="{Binding Value, ElementName=Component3Slider, Mode=TwoWay}" />
                                    <local:ColorSlider
                                        x:Name="Component3Slider"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Color="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        ColorComponent="Component3"
                                        ColorModel="{TemplateBinding ColorModel}"
                                        HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        IsRoundingEnabled="True"
                                        IsSnapToTickEnabled="True"
                                        Orientation="Horizontal"
                                        TickFrequency="1"
                                        Visibility="{Binding IsComponentSliderVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <local:NumericDoubleUpDown
                                        x:Name="AlphaComponentNumericUpDown"
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Width="{DynamicResource ColorViewNumericUpDownWidth}"
                                        Height="{DynamicResource ColorViewNumericUpDownMinHeight}"
                                        MinHeight="{DynamicResource ColorViewNumericUpDownMinHeight}"
                                        Margin="{DynamicResource ColorViewNumericUpDownMargin}"
                                        Padding="{DynamicResource ColorViewNumericUpDownPadding}"
                                        Style="{DynamicResource PrefixNumericDoubleUpDownStyle}"
                                        InnerLeftContent="A"
                                        IsEnabled="{TemplateBinding IsAlphaEnabled}"
                                        Maximum="{Binding Maximum, ElementName=AlphaComponentSlider}"
                                        Minimum="{Binding Minimum, ElementName=AlphaComponentSlider}"
                                        Value="{Binding Value, ElementName=AlphaComponentSlider, Mode=TwoWay}">
                                        <local:NumericDoubleUpDown.Visibility>
                                            <MultiBinding Converter="{StaticResource BoolAndToVisibilityConverter}">
                                                <Binding Path="IsAlphaVisible" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding Path="IsComponentTextInputVisible" RelativeSource="{RelativeSource TemplatedParent}" />
                                            </MultiBinding>
                                        </local:NumericDoubleUpDown.Visibility>
                                    </local:NumericDoubleUpDown>
                                    <local:ColorSlider
                                        x:Name="AlphaComponentSlider"
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Color="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        ColorComponent="Alpha"
                                        ColorModel="{TemplateBinding ColorModel}"
                                        HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        IsEnabled="{TemplateBinding IsAlphaEnabled}"
                                        IsRoundingEnabled="True"
                                        IsSnapToTickEnabled="True"
                                        Orientation="Horizontal"
                                        TickFrequency="1">
                                        <local:ColorSlider.Visibility>
                                            <MultiBinding Converter="{StaticResource BoolAndToVisibilityConverter}">
                                                <Binding Path="IsAlphaVisible" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding Path="IsComponentSliderVisible" RelativeSource="{RelativeSource TemplatedParent}" />
                                            </MultiBinding>
                                        </local:ColorSlider.Visibility>
                                    </local:ColorSlider>
                                </Grid>
                            </Grid>

                            <local:ColorPreviewer
                                Grid.Row="2"
                                Margin="12,0,12,12"
                                HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                IsAccentColorsVisible="{TemplateBinding IsAccentColorsVisible}"
                                Visibility="{Binding IsColorPreviewVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ColorModel" Value="Hsva">
                            <Setter TargetName="Component1NumericUpDown" Property="InnerLeftContent" Value="H" />
                            <Setter TargetName="Component2NumericUpDown" Property="InnerLeftContent" Value="S" />
                            <Setter TargetName="Component3NumericUpDown" Property="InnerLeftContent" Value="V" />
                        </Trigger>
                        <Trigger Property="ColorModel" Value="Rgba">
                            <Setter TargetName="Component1NumericUpDown" Property="InnerLeftContent" Value="R" />
                            <Setter TargetName="Component2NumericUpDown" Property="InnerLeftContent" Value="G" />
                            <Setter TargetName="Component3NumericUpDown" Property="InnerLeftContent" Value="B" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  SimpleColorView  -->
    <Style x:Key="SimpleColorView" TargetType="{x:Type local:ColorView}">
        <Setter Property="HexInputAlphaPosition" Value="Trailing" />
        <Setter Property="Width" Value="320" />
        <Setter Property="ColorSpectrumComponents" Value="SaturationValue" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ColorView}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="200" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            ClipToBounds="True"
                            CornerRadius="8,8,0,0">
                            <local:ColorSpectrum
                                x:Name="ColorSpectrum"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Components="{TemplateBinding ColorSpectrumComponents}"
                                HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                MaxHue="{TemplateBinding MaxHue}"
                                MaxSaturation="{TemplateBinding MaxSaturation}"
                                MaxValue="{TemplateBinding MaxValue}"
                                MinHue="{TemplateBinding MinHue}"
                                MinSaturation="{TemplateBinding MinSaturation}"
                                MinValue="{TemplateBinding MinValue}"
                                Shape="{TemplateBinding ColorSpectrumShape}" />
                        </Border>

                        <local:ColorSlider
                            x:Name="ColorSpectrumThirdComponentSlider"
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            ColorComponent="{Binding ThirdComponent, ElementName=ColorSpectrum}"
                            ColorModel="Hsva"
                            HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            IsAlphaVisible="False"
                            IsPerceptive="True"
                            Orientation="Horizontal"
                            Visibility="{Binding IsColorSpectrumSliderVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <local:ColorSlider
                            x:Name="ColorSpectrumAlphaSlider"
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            ColorComponent="Alpha"
                            ColorModel="Hsva"
                            HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            IsEnabled="{TemplateBinding IsAlphaEnabled}"
                            IsRoundingEnabled="True"
                            IsSnapToTickEnabled="True"
                            Orientation="Horizontal"
                            TickFrequency="1"
                            Visibility="{Binding IsAlphaVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Grid
                            Grid.Row="3"
                            Margin="0,8,0,0"
                            MinHeight="{DynamicResource TextControlThemeMinHeight}"
                            HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Width="20"
                                Height="20"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Background="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ColorPickerToBrushConverter}}"
                                CornerRadius="4" />

                            <Grid
                                x:Name="PART_TextBoxPanel"
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                VerticalAlignment="Stretch">
                                <Grid
                                    x:Name="HexInputPanel"
                                    Visibility="Visible">
                                    <ui:TextBox
                                        x:Name="PART_HexTextBox"
                                        MinHeight="{DynamicResource TextControlThemeMinHeight}"
                                        VerticalAlignment="Stretch"
                                        MaxLength="8"
                                        ClearButtonEnabled="True"
                                        Style="{DynamicResource PrefixTextBoxStyle}"
                                        VerticalContentAlignment="Center"
                                        local:InputAssist.Prefix="#" />
                                </Grid>
                                <ui:TextBox
                                    x:Name="PART_RgbaTextBox"
                                    MinHeight="{DynamicResource TextControlThemeMinHeight}"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    Style="{DynamicResource PrefixTextBoxStyle}"
                                    ClearButtonEnabled="False"
                                    Text="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Converter={converters:ColorToTextConverter}, Mode=TwoWay}"
                                    Visibility="Collapsed" />
                                <ui:TextBox
                                    x:Name="PART_HsvaTextBox"
                                    MinHeight="{DynamicResource TextControlThemeMinHeight}"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    Style="{DynamicResource PrefixTextBoxStyle}"
                                    ClearButtonEnabled="False"
                                    Text="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Converter={converters:HsvColorToTextConverter}, Mode=TwoWay}"
                                    Visibility="Collapsed" />
                            </Grid>

                            <local:NumericDoubleUpDown
                                x:Name="AlphaComponentNumericUpDown"
                                Grid.Column="2"
                                Width="68"
                                MinHeight="{DynamicResource TextControlThemeMinHeight}"
                                Margin="0,0,8,0"
                                VerticalAlignment="Stretch"
                                Style="{DynamicResource PrefixNumericDoubleUpDownStyle}"
                                InnerRightContent="%"
                                IsEnabled="{TemplateBinding IsAlphaEnabled}"
                                Maximum="{Binding Maximum, ElementName=ColorSpectrumAlphaSlider}"
                                Minimum="{Binding Minimum, ElementName=ColorSpectrumAlphaSlider}"
                                Visibility="{Binding IsAlphaVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Value="{Binding Value, ElementName=ColorSpectrumAlphaSlider, Mode=TwoWay}" />

                            <ComboBox
                                x:Name="ColorModelComboBox"
                                Grid.Column="3"
                                Width="88"
                                MinHeight="{DynamicResource TextControlThemeMinHeight}"
                                VerticalAlignment="Stretch"
                                SelectedIndex="0">
                                <ComboBoxItem Content="Hex" />
                                <ComboBoxItem Content="Rgba" />
                                <ComboBoxItem Content="Hsva" />
                            </ComboBox>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=ColorModelComboBox}" Value="0">
                            <Setter TargetName="HexInputPanel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_RgbaTextBox" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_HsvaTextBox" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=ColorModelComboBox}" Value="1">
                            <Setter TargetName="HexInputPanel" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_RgbaTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_HsvaTextBox" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=ColorModelComboBox}" Value="2">
                            <Setter TargetName="HexInputPanel" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_RgbaTextBox" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_HsvaTextBox" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
