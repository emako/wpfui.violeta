<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Wpf.Ui.Violeta.Converters"
    xmlns:local="clr-namespace:Wpf.Ui.Violeta.Controls">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <converters:ToBrushConverter x:Key="ToBrushConverter" />
    <converters:AccentColorConverter x:Key="AccentColorConverter" />
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

    <Style TargetType="{x:Type local:ColorPreviewer}">
        <Setter Property="Height" Value="{DynamicResource ColorPreviewerHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ColorPreviewer}">
                    <Grid>
                        <!--  Preview with accent shades  -->
                        <Grid Visibility="{TemplateBinding IsAccentColorsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                Grid.Column="0"
                                Width="{DynamicResource ColorPreviewerAccentSectionWidth}"
                                Height="{DynamicResource ColorPreviewerAccentSectionHeight}"
                                VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Background="{DynamicResource ColorControlCheckeredBackgroundBrush}"
                                    CornerRadius="{DynamicResource ColorPreviewerCornerRadius}" />
                                <Border
                                    x:Name="PART_AccentDecrement2Border"
                                    Grid.Column="0"
                                    Background="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource AccentColorConverter}, ConverterParameter=-2}"
                                    CornerRadius="{DynamicResource ColorPreviewerCornerRadius}"
                                    Tag="-2" />
                                <Border
                                    x:Name="PART_AccentDecrement1Border"
                                    Grid.Column="1"
                                    Background="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource AccentColorConverter}, ConverterParameter=-1}"
                                    Tag="-1" />
                            </Grid>

                            <Border
                                Grid.Column="1"
                                Margin="0,8"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                CornerRadius="{DynamicResource ColorPreviewerCornerRadius}">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="12"
                                        Direction="270"
                                        Opacity="0.18"
                                        ShadowDepth="2" />
                                </Border.Effect>
                                <Grid>
                                    <Border Background="{DynamicResource ColorControlCheckeredBackgroundBrush}" CornerRadius="{DynamicResource ColorPreviewerCornerRadius}" />
                                    <Border Background="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ToBrushConverter}}" CornerRadius="{DynamicResource ColorPreviewerCornerRadius}" />
                                </Grid>
                            </Border>

                            <Grid
                                Grid.Column="2"
                                Width="{DynamicResource ColorPreviewerAccentSectionWidth}"
                                Height="{DynamicResource ColorPreviewerAccentSectionHeight}"
                                VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Background="{DynamicResource ColorControlCheckeredBackgroundBrush}"
                                    CornerRadius="{DynamicResource ColorPreviewerCornerRadius}" />
                                <Border
                                    x:Name="PART_AccentIncrement1Border"
                                    Grid.Column="0"
                                    Background="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource AccentColorConverter}, ConverterParameter=1}"
                                    Tag="1" />
                                <Border
                                    x:Name="PART_AccentIncrement2Border"
                                    Grid.Column="1"
                                    Background="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource AccentColorConverter}, ConverterParameter=2}"
                                    CornerRadius="{DynamicResource ColorPreviewerCornerRadius}"
                                    Tag="2" />
                            </Grid>
                        </Grid>

                        <!--  Preview only  -->
                        <Border
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            CornerRadius="{DynamicResource ColorPreviewerCornerRadius}"
                            Visibility="{TemplateBinding IsAccentColorsVisible,
                                                         Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Grid>
                                <Border Background="{DynamicResource ColorControlCheckeredBackgroundBrush}" CornerRadius="{DynamicResource ColorPreviewerCornerRadius}" />
                                <Border Background="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ToBrushConverter}}" CornerRadius="{DynamicResource ColorPreviewerCornerRadius}" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
