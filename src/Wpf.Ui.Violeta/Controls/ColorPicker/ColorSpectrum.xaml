<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Wpf.Ui.Violeta.Controls">

    <Style TargetType="{x:Type local:ColorSpectrum}">
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ColorSpectrum}">
                    <Grid
                        x:Name="PART_LayoutRoot"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        ClipToBounds="True"
                        SnapsToDevicePixels="True">
                        <Grid
                            x:Name="PART_SizingPanel"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            ClipToBounds="True">
                            <Rectangle
                                x:Name="PART_SpectrumRectangle"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"
                                RadiusX="4"
                                RadiusY="4"
                                Visibility="Visible" />
                            <Rectangle
                                x:Name="PART_SpectrumOverlayRectangle"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"
                                RadiusX="4"
                                RadiusY="4"
                                Visibility="Visible" />
                            <Ellipse
                                x:Name="PART_SpectrumEllipse"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                            <Ellipse
                                x:Name="PART_SpectrumOverlayEllipse"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                            <Canvas
                                x:Name="PART_InputTarget"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="Transparent">
                                <Grid
                                    x:Name="PART_SelectionEllipsePanel"
                                    Width="16"
                                    Height="16">
                                    <Ellipse
                                        x:Name="FocusEllipse"
                                        Margin="-2"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        IsHitTestVisible="False"
                                        Stroke="{DynamicResource ColorSliderLightBorderBrush}"
                                        StrokeThickness="2"
                                        Visibility="Collapsed" />
                                    <Ellipse
                                        x:Name="SelectionEllipse"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        IsHitTestVisible="False"
                                        Stroke="{DynamicResource ColorSliderDarkBorderBrush}"
                                        StrokeThickness="2" />
                                </Grid>
                            </Canvas>
                            <Rectangle
                                x:Name="BorderRectangle"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"
                                RadiusX="4"
                                RadiusY="4"
                                Stroke="{DynamicResource ColorSpectrumBorderBrush}"
                                StrokeThickness="1" />
                            <Ellipse
                                x:Name="BorderEllipse"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"
                                Stroke="{DynamicResource ColorSpectrumBorderBrush}"
                                StrokeThickness="1"
                                Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Shape" Value="Ring">
                            <Setter TargetName="PART_SpectrumRectangle" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_SpectrumOverlayRectangle" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BorderRectangle" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_SpectrumEllipse" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_SpectrumOverlayEllipse" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BorderEllipse" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsLightSelector" Value="True">
                            <Setter TargetName="FocusEllipse" Property="Stroke" Value="{DynamicResource ColorSliderDarkBorderBrush}" />
                            <Setter TargetName="SelectionEllipse" Property="Stroke" Value="{DynamicResource ColorSliderLightBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsLargeSelector" Value="True">
                            <Setter TargetName="PART_SelectionEllipsePanel" Property="Width" Value="48" />
                            <Setter TargetName="PART_SelectionEllipsePanel" Property="Height" Value="48" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusEllipse" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SelectionEllipse" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsLightSelector" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SelectionEllipse" Property="Opacity" Value="0.8" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
