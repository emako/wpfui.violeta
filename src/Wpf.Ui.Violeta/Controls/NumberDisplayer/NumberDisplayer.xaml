<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Wpf.Ui.Violeta.Controls">

    <!--
        NumberDisplayer — WPF port of Ursa.Avalonia NumberDisplayer.
        Shared base style + one implicit style per concrete type (WPF default-style
        lookup requires DefaultStyleKey to match the element's own type).
    -->
    <Style x:Key="BaseNumberDisplayerStyle" TargetType="{x:Type local:NumberDisplayerBase}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Duration">
            <Setter.Value>
                <Duration>0:0:0.2</Duration>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:NumberDisplayerBase}">
                    <TextBlock
                        Background="{TemplateBinding Background}"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontSize="{TemplateBinding FontSize}"
                        FontStretch="{TemplateBinding FontStretch}"
                        FontStyle="{TemplateBinding FontStyle}"
                        FontWeight="{TemplateBinding FontWeight}"
                        Foreground="{TemplateBinding Foreground}"
                        Text="{TemplateBinding InternalText}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelectable" Value="True">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:NumberDisplayerBase}">
                            <local:SelectableTextBlock
                                Background="{TemplateBinding Background}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontStretch="{TemplateBinding FontStretch}"
                                FontStyle="{TemplateBinding FontStyle}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding InternalText}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource BaseNumberDisplayerStyle}" TargetType="{x:Type local:Int32Displayer}" />
    <Style BasedOn="{StaticResource BaseNumberDisplayerStyle}" TargetType="{x:Type local:Int64Displayer}" />
    <Style BasedOn="{StaticResource BaseNumberDisplayerStyle}" TargetType="{x:Type local:DoubleDisplayer}" />
    <Style BasedOn="{StaticResource BaseNumberDisplayerStyle}" TargetType="{x:Type local:DateDisplay}" />

</ResourceDictionary>
