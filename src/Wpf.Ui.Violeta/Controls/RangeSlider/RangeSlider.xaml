<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Wpf.Ui.Violeta.Controls">

    <!--
        Thumb style – mirrors Slider's UiSliderThumbStyle (Fluent motion + AutoToolTip attach).
    -->
    <Style x:Key="RangeSliderThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Height" Value="20" />
        <Setter Property="Width" Value="20" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SliderThumbBackground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SliderOuterThumbBackground}" />
        <Setter Property="local:SliderHelper.Attach" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="16">
                        <Ellipse
                            x:Name="SliderInnerThumb"
                            Width="12"
                            Height="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{TemplateBinding Foreground}"
                            RenderTransformOrigin="0.5,0.5"
                            Stroke="Transparent"
                            StrokeThickness="0">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SliderInnerThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                            <SplineDoubleKeyFrame
                                                KeySpline="{DynamicResource ControlFastOutSlowInKeySpline}"
                                                KeyTime="{DynamicResource ControlFastAnimationDuration}"
                                                Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SliderInnerThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                            <SplineDoubleKeyFrame
                                                KeySpline="{DynamicResource ControlFastOutSlowInKeySpline}"
                                                KeyTime="{DynamicResource ControlFastAnimationDuration}"
                                                Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SliderInnerThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                            <SplineDoubleKeyFrame
                                                KeySpline="{DynamicResource ControlFastOutSlowInKeySpline}"
                                                KeyTime="{DynamicResource ControlNormalAnimationDuration}"
                                                Value="1.167" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SliderInnerThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                            <SplineDoubleKeyFrame
                                                KeySpline="{DynamicResource ControlFastOutSlowInKeySpline}"
                                                KeyTime="{DynamicResource ControlNormalAnimationDuration}"
                                                Value="1.167" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SliderInnerThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                            <SplineDoubleKeyFrame
                                                KeySpline="{DynamicResource ControlFastOutSlowInKeySpline}"
                                                KeyTime="{DynamicResource ControlNormalAnimationDuration}"
                                                Value="0.83" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SliderInnerThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                            <SplineDoubleKeyFrame
                                                KeySpline="{DynamicResource ControlFastOutSlowInKeySpline}"
                                                KeyTime="{DynamicResource ControlNormalAnimationDuration}"
                                                Value="0.83" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SliderInnerThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                            <SplineDoubleKeyFrame
                                                KeySpline="{DynamicResource ControlFastOutSlowInKeySpline}"
                                                KeyTime="{DynamicResource ControlFastAnimationDuration}"
                                                Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SliderInnerThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                            <SplineDoubleKeyFrame
                                                KeySpline="{DynamicResource ControlFastOutSlowInKeySpline}"
                                                KeyTime="{DynamicResource ControlFastAnimationDuration}"
                                                Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Horizontal RangeSlider template
    -->
    <ControlTemplate x:Key="UiHorizontalRangeSlider" TargetType="{x:Type local:RangeSlider}">
        <Grid x:Name="RootGrid" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TickBar
                x:Name="PART_TopTick"
                Grid.Row="0"
                Height="6"
                Fill="{DynamicResource SliderTickBarFill}"
                Maximum="{TemplateBinding Maximum}"
                Minimum="{TemplateBinding Minimum}"
                Placement="Top"
                SnapsToDevicePixels="True"
                TickFrequency="{TemplateBinding TickFrequency}"
                Visibility="Collapsed" />

            <Border
                x:Name="TrackBackground"
                Grid.Row="1"
                Height="{DynamicResource SliderTrackHeight}"
                Margin="0"
                Background="{DynamicResource SliderTrackFill}"
                BorderThickness="0"
                CornerRadius="2"
                IsHitTestVisible="False" />

            <local:RangeTrack
                x:Name="PART_Track"
                Grid.Row="1"
                LowerValue="{Binding LowerValue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                Maximum="{TemplateBinding Maximum}"
                Minimum="{TemplateBinding Minimum}"
                Orientation="{TemplateBinding Orientation}"
                SelectionRangeFill="{DynamicResource SliderTrackValueFill}"
                UpperValue="{Binding UpperValue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <local:RangeTrack.LowerThumb>
                    <Thumb x:Name="PART_LowerThumb" Style="{StaticResource RangeSliderThumbStyle}" />
                </local:RangeTrack.LowerThumb>
                <local:RangeTrack.UpperThumb>
                    <Thumb x:Name="PART_UpperThumb" Style="{StaticResource RangeSliderThumbStyle}" />
                </local:RangeTrack.UpperThumb>
            </local:RangeTrack>

            <TickBar
                x:Name="PART_BottomTick"
                Grid.Row="2"
                Height="6"
                Fill="{DynamicResource SliderTickBarFill}"
                Maximum="{TemplateBinding Maximum}"
                Minimum="{TemplateBinding Minimum}"
                Placement="Bottom"
                SnapsToDevicePixels="True"
                TickFrequency="{TemplateBinding TickFrequency}"
                Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="TickPlacement" Value="TopLeft">
                <Setter TargetName="PART_TopTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="BottomRight">
                <Setter TargetName="PART_BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="Both">
                <Setter TargetName="PART_TopTick" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource SliderTrackFillPointerOver}" />
                <Setter TargetName="PART_Track" Property="SelectionRangeFill" Value="{DynamicResource SliderTrackValueFillPointerOver}" />
                <Setter TargetName="PART_LowerThumb" Property="Foreground" Value="{DynamicResource SliderThumbBackgroundPointerOver}" />
                <Setter TargetName="PART_UpperThumb" Property="Foreground" Value="{DynamicResource SliderThumbBackgroundPointerOver}" />
            </Trigger>
            <Trigger SourceName="PART_LowerThumb" Property="IsDragging" Value="True">
                <Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource SliderTrackFillPressed}" />
                <Setter TargetName="PART_Track" Property="SelectionRangeFill" Value="{DynamicResource SliderTrackValueFillPressed}" />
                <Setter TargetName="PART_LowerThumb" Property="Foreground" Value="{DynamicResource SliderThumbBackgroundPressed}" />
            </Trigger>
            <Trigger SourceName="PART_UpperThumb" Property="IsDragging" Value="True">
                <Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource SliderTrackFillPressed}" />
                <Setter TargetName="PART_Track" Property="SelectionRangeFill" Value="{DynamicResource SliderTrackValueFillPressed}" />
                <Setter TargetName="PART_UpperThumb" Property="Foreground" Value="{DynamicResource SliderThumbBackgroundPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource SliderTrackFillDisabled}" />
                <Setter TargetName="PART_Track" Property="SelectionRangeFill" Value="{DynamicResource SliderTrackValueFillDisabled}" />
                <Setter TargetName="PART_LowerThumb" Property="Foreground" Value="{DynamicResource SliderThumbBackgroundDisabled}" />
                <Setter TargetName="PART_UpperThumb" Property="Foreground" Value="{DynamicResource SliderThumbBackgroundDisabled}" />
                <Setter TargetName="PART_LowerThumb" Property="Opacity" Value="0.4" />
                <Setter TargetName="PART_UpperThumb" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        Vertical RangeSlider template
    -->
    <ControlTemplate x:Key="UiVerticalRangeSlider" TargetType="{x:Type local:RangeSlider}">
        <Grid x:Name="RootGrid" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" MinWidth="{TemplateBinding MinWidth}" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TickBar
                x:Name="PART_LeftTick"
                Grid.Column="0"
                Width="6"
                Fill="{DynamicResource SliderTickBarFill}"
                Maximum="{TemplateBinding Maximum}"
                Minimum="{TemplateBinding Minimum}"
                Placement="Left"
                SnapsToDevicePixels="True"
                TickFrequency="{TemplateBinding TickFrequency}"
                Visibility="Collapsed" />

            <Border
                x:Name="TrackBackground"
                Grid.Column="1"
                Width="{DynamicResource SliderTrackHeight}"
                Margin="0"
                Background="{DynamicResource SliderTrackFill}"
                BorderThickness="0"
                CornerRadius="2"
                IsHitTestVisible="False" />

            <local:RangeTrack
                x:Name="PART_Track"
                Grid.Column="1"
                LowerValue="{Binding LowerValue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                Maximum="{TemplateBinding Maximum}"
                Minimum="{TemplateBinding Minimum}"
                Orientation="{TemplateBinding Orientation}"
                SelectionRangeFill="{DynamicResource SliderTrackValueFill}"
                UpperValue="{Binding UpperValue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <local:RangeTrack.LowerThumb>
                    <Thumb x:Name="PART_LowerThumb" Style="{StaticResource RangeSliderThumbStyle}" />
                </local:RangeTrack.LowerThumb>
                <local:RangeTrack.UpperThumb>
                    <Thumb x:Name="PART_UpperThumb" Style="{StaticResource RangeSliderThumbStyle}" />
                </local:RangeTrack.UpperThumb>
            </local:RangeTrack>

            <TickBar
                x:Name="PART_RightTick"
                Grid.Column="2"
                Width="6"
                Fill="{DynamicResource SliderTickBarFill}"
                Maximum="{TemplateBinding Maximum}"
                Minimum="{TemplateBinding Minimum}"
                Placement="Right"
                SnapsToDevicePixels="True"
                TickFrequency="{TemplateBinding TickFrequency}"
                Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="TickPlacement" Value="TopLeft">
                <Setter TargetName="PART_LeftTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="BottomRight">
                <Setter TargetName="PART_RightTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="Both">
                <Setter TargetName="PART_LeftTick" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_RightTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource SliderTrackFillPointerOver}" />
                <Setter TargetName="PART_Track" Property="SelectionRangeFill" Value="{DynamicResource SliderTrackValueFillPointerOver}" />
                <Setter TargetName="PART_LowerThumb" Property="Foreground" Value="{DynamicResource SliderThumbBackgroundPointerOver}" />
                <Setter TargetName="PART_UpperThumb" Property="Foreground" Value="{DynamicResource SliderThumbBackgroundPointerOver}" />
            </Trigger>
            <Trigger SourceName="PART_LowerThumb" Property="IsDragging" Value="True">
                <Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource SliderTrackFillPressed}" />
                <Setter TargetName="PART_Track" Property="SelectionRangeFill" Value="{DynamicResource SliderTrackValueFillPressed}" />
                <Setter TargetName="PART_LowerThumb" Property="Foreground" Value="{DynamicResource SliderThumbBackgroundPressed}" />
            </Trigger>
            <Trigger SourceName="PART_UpperThumb" Property="IsDragging" Value="True">
                <Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource SliderTrackFillPressed}" />
                <Setter TargetName="PART_Track" Property="SelectionRangeFill" Value="{DynamicResource SliderTrackValueFillPressed}" />
                <Setter TargetName="PART_UpperThumb" Property="Foreground" Value="{DynamicResource SliderThumbBackgroundPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource SliderTrackFillDisabled}" />
                <Setter TargetName="PART_Track" Property="SelectionRangeFill" Value="{DynamicResource SliderTrackValueFillDisabled}" />
                <Setter TargetName="PART_LowerThumb" Property="Foreground" Value="{DynamicResource SliderThumbBackgroundDisabled}" />
                <Setter TargetName="PART_UpperThumb" Property="Foreground" Value="{DynamicResource SliderThumbBackgroundDisabled}" />
                <Setter TargetName="PART_LowerThumb" Property="Opacity" Value="0.4" />
                <Setter TargetName="PART_UpperThumb" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DefaultRangeSliderStyle" TargetType="{x:Type local:RangeSlider}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="AutoToolTipPlacement" Value="TopLeft" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template" Value="{StaticResource UiHorizontalRangeSlider}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="104" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Template" Value="{StaticResource UiVerticalRangeSlider}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource DefaultRangeSliderStyle}" TargetType="{x:Type local:RangeSlider}" />

</ResourceDictionary>
