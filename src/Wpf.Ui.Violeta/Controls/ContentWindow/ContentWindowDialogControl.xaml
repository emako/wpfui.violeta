<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Wpf.Ui.Violeta.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Style x:Key="DefaultVioletaContentWindowDialogControlStyle" TargetType="{x:Type local:ContentWindowDialogControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ContentWindowDialogControl}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <Grid
                                MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center" ContentSource="Content" />
                            </Grid>
                        </ScrollViewer>
                        <StackPanel
                            Grid.Row="1"
                            Margin="0,24"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <ui:Button
                                x:Name="SecondaryButton"
                                MinWidth="90"
                                Margin="0,0,24,0"
                                Appearance="Secondary"
                                Content="{TemplateBinding SecondaryButtonText}" />
                            <ui:Button
                                x:Name="PrimaryButton"
                                MinWidth="90"
                                Appearance="Primary"
                                Content="{TemplateBinding PrimaryButtonText}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultVioletaContentWindowDialogControlStyle}" TargetType="{x:Type local:ContentWindowDialogControl}" />

</ResourceDictionary>
