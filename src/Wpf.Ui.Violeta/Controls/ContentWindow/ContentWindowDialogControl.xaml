<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Wpf.Ui.Violeta.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Style x:Key="DefaultVioletaContentWindowDialogControlStyle" TargetType="{x:Type local:ContentWindowDialogControl}">
        <Setter Property="Padding" Value="{DynamicResource ContentDialogPadding}" />
        <Setter Property="BusyBackground" Value="{DynamicResource StripedBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ContentWindowDialogControl}">
                    <local:BusyMask
                        Background="{TemplateBinding BusyBackground}"
                        BusyContent="{TemplateBinding BusyContent}"
                        BusyContentMargin="{TemplateBinding BusyContentMargin}"
                        IndicatorType="{TemplateBinding IndicatorType}"
                        IsBusy="{TemplateBinding IsBusy}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ui:DynamicScrollViewer
                                Grid.Row="0"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <Grid MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ui:DynamicScrollViewer}}">
                                    <ContentPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        ContentSource="Content" />
                                </Grid>
                            </ui:DynamicScrollViewer>

                            <Grid
                                x:Name="CommandArea"
                                Grid.Row="1"
                                Margin="0,24,0,0"
                                VerticalAlignment="Center">
                                <ui:Button
                                    x:Name="PrimaryButton"
                                    MinWidth="90"
                                    Margin="0,0,8,0"
                                    Content="{TemplateBinding PrimaryButtonText}"
                                    IsEnabled="{TemplateBinding IsPrimaryButtonEnabled}" />
                                <ui:Button
                                    x:Name="SecondaryButton"
                                    MinWidth="90"
                                    Margin="0,0,8,0"
                                    Content="{TemplateBinding SecondaryButtonText}"
                                    IsEnabled="{TemplateBinding IsSecondaryButtonEnabled}" />
                                <ui:Button
                                    x:Name="CloseButton"
                                    MinWidth="90"
                                    Content="{TemplateBinding CloseButtonText}" />
                            </Grid>
                        </Grid>
                    </local:BusyMask>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultVioletaContentWindowDialogControlStyle}" TargetType="{x:Type local:ContentWindowDialogControl}" />

</ResourceDictionary>
