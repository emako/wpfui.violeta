<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        EmptySimpleLogo geometry (HandyControl EmptyBaseStyle).
        Uses EmptySimpleLogoNeutralBrush — mid-contrast chrome that reads on
        common card/page surfaces without EmptySimpleLogoPreviewBackgroundBrush.
        Theme DrawingBrushes live in Resources/Theme/{Light|Dark}.xaml.
    -->
    <Rectangle
        x:Key="LogoRectangle4Empty"
        Width="64"
        Height="41"
        HorizontalAlignment="Center"
        x:Shared="False"
        Fill="{DynamicResource EmptySimpleLogoNeutralBrush}" />

</ResourceDictionary>
