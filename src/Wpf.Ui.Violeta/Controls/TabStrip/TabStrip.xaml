<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Wpf.Ui.Violeta.Controls">

    <!--
        ╔══════════════════════════════════════════════════════════════╗
        ║                  LINE (default) – TabStripItem               ║
        ║                                                              ║
        ║  • Transparent background, 2 px bottom-border indicator      ║
        ║  • Selected: accent underline + primary text + SemiBold      ║
        ║  • Hover: subtle fill + primary text                         ║
        ╚══════════════════════════════════════════════════════════════╝
    -->
    <Style x:Key="DefaultTabStripItemStyle" TargetType="{x:Type local:TabStripItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TabStripItem}">
                    <Border
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  Selected  -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding IsSelectedItemBold, RelativeSource={RelativeSource AncestorType={x:Type local:TabStrip}}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </MultiDataTrigger>
                        <!--  Hover (not selected)  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                        </MultiTrigger>
                        <!--  Disabled  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Auto-applied default style for TabStripItem  -->
    <Style BasedOn="{StaticResource DefaultTabStripItemStyle}" TargetType="{x:Type local:TabStripItem}" />

    <!--
        ╔══════════════════════════════════════════════════════════════╗
        ║               LINE (default) – TabStrip container            ║
        ║                                                              ║
        ║  • Horizontal: items row + bottom separator                  ║
        ║  • Vertical: items column + right separator                  ║
        ╚══════════════════════════════════════════════════════════════╝
    -->
    <Style TargetType="{x:Type local:TabStrip}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type local:TabStrip}}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TabStrip}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="Col0" Width="*" />
                                <ColumnDefinition x:Name="Col1" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="Row0" Height="*" />
                                <!--  1 px separator (collapsed via IsSeparatorVisible)  -->
                                <RowDefinition x:Name="SeparatorRow" Height="1" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0">
                                <ItemsPresenter />
                                <Rectangle
                                    x:Name="PART_Indicator"
                                    Width="0"
                                    Height="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                    IsHitTestVisible="False"
                                    RadiusX="2"
                                    RadiusY="2"
                                    RenderTransformOrigin="0.5,0.5"
                                    SnapsToDevicePixels="False">
                                    <!--  Replaced with a fresh, unfrozen ScaleTransform in code-behind — see TabStrip.OnApplyTemplate  -->
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <Rectangle
                                x:Name="PART_Separator"
                                Grid.Row="1"
                                Grid.Column="0"
                                Fill="{DynamicResource ControlStrokeColorDefaultBrush}"
                                SnapsToDevicePixels="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="SeparatorRow" Property="Height" Value="0" />
                            <Setter TargetName="Col1" Property="Width" Value="1" />
                            <Setter TargetName="PART_Separator" Property="Grid.Row" Value="0" />
                            <Setter TargetName="PART_Separator" Property="Grid.Column" Value="1" />
                            <Setter TargetName="PART_Indicator" Property="Width" Value="2" />
                            <Setter TargetName="PART_Indicator" Property="Height" Value="0" />
                            <Setter TargetName="PART_Indicator" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="PART_Indicator" Property="VerticalAlignment" Value="Top" />
                        </Trigger>
                        <Trigger Property="IsSeparatorVisible" Value="False">
                            <Setter TargetName="SeparatorRow" Property="Height" Value="0" />
                            <Setter TargetName="Col1" Property="Width" Value="0" />
                            <Setter TargetName="PART_Separator" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ╔══════════════════════════════════════════════════════════════╗
        ║                    CARD – TabStripItem                       ║
        ║                                                              ║
        ║  • Rounded top corners (horizontal) or left corners (vertical) ║
        ║  • Selected: border minus bottom/right to overlap separator  ║
        ╚══════════════════════════════════════════════════════════════╝
    -->
    <Style x:Key="CardTabStripItemStyle" TargetType="{x:Type local:TabStripItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <!--
            Border is always 3-sided so the selected state only swaps colors,
            never the box size — sizing the border in via a trigger shifts
            every following item and makes the row visibly jump on selection.
        -->
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TabStripItem}">
                    <Border
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4,4,0,0"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  Selected: show 3-sided border + card bg + overlap separator by 1 px  -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type local:TabStrip}}}" Value="Horizontal" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Root" Property="Margin" Value="0,0,0,-1" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding IsSelectedItemBold, RelativeSource={RelativeSource AncestorType={x:Type local:TabStrip}}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </MultiDataTrigger>
                        <!--  Hover (not selected)  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </MultiTrigger>
                        <!--  Disabled  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <!--  Vertical layout  -->
                        <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type local:TabStrip}}}" Value="Vertical">
                            <Setter Property="BorderThickness" Value="1,1,0,1" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Setter TargetName="Root" Property="CornerRadius" Value="4,0,0,4" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type local:TabStrip}}}" Value="Vertical" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Root" Property="Margin" Value="0,0,-1,0" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Card TabStrip — inherits container + separator from default; sets card item style  -->
    <Style
        x:Key="CardTabStripStyle"
        BasedOn="{StaticResource {x:Type local:TabStrip}}"
        TargetType="{x:Type local:TabStrip}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource CardTabStripItemStyle}" />
    </Style>

    <!--
        ╔══════════════════════════════════════════════════════════════╗
        ║                   BUTTON – TabStripItem                      ║
        ║                                                              ║
        ║  • Pill-shaped items (ControlCornerRadius)                   ║
        ║  • Selected: sliding accent pill + on-accent text            ║
        ║  • No separator line                                         ║
        ╚══════════════════════════════════════════════════════════════╝
    -->
    <Style x:Key="ButtonTabStripItemStyle" TargetType="{x:Type local:TabStripItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TabStripItem}">
                    <Border
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  Selected: on-accent text; fill comes from the sliding PART_Indicator  -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding IsSelectedItemBold, RelativeSource={RelativeSource AncestorType={x:Type local:TabStrip}}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </MultiDataTrigger>
                        <!--  Hover (not selected)  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </MultiTrigger>
                        <!--  Disabled  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Button TabStrip — single card wrapping all items  -->
    <Style x:Key="ButtonTabStripStyle" TargetType="{x:Type local:TabStrip}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ButtonTabStripItemStyle}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type local:TabStrip}}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TabStrip}">
                    <!--  Single card, no separator; pill indicator slides behind items  -->
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ClipToBounds="True"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Border
                                x:Name="PART_Indicator"
                                Width="0"
                                Height="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                IsHitTestVisible="False"
                                RenderTransformOrigin="0.5,0.5"
                                SnapsToDevicePixels="False">
                                <!--  Replaced with a fresh, unfrozen ScaleTransform in code-behind — see TabStrip.OnApplyTemplate  -->
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                            <ItemsPresenter />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
