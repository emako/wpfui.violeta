<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Wpf.Ui.Violeta.Controls">

    <Style TargetType="{x:Type local:FlipNumber}">
        <Setter Property="FontSize" Value="70" />
        <Setter Property="Foreground" Value="{DynamicResource FlipNumberForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource FlipNumberBackgroundBrush}" />
        <Setter Property="Width" Value="120" />
        <Setter Property="Height" Value="180" />
        <Setter Property="Camera">
            <Setter.Value>
                <PerspectiveCamera Position="0,0,120" LookDirection="0,0,-1" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:FlipClock}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FlipClock}">
                    <StackPanel Orientation="Horizontal">
                        <local:FlipNumber Margin="-20" Number="{Binding NumberList[0], RelativeSource={RelativeSource TemplatedParent}}" />
                        <local:FlipNumber Margin="-20" Number="{Binding NumberList[1], RelativeSource={RelativeSource TemplatedParent}}" />
                        <local:FlipNumber Margin="0,-20,-20,-20" Number="{Binding NumberList[2], RelativeSource={RelativeSource TemplatedParent}}" />
                        <local:FlipNumber Margin="-20" Number="{Binding NumberList[3], RelativeSource={RelativeSource TemplatedParent}}" />
                        <local:FlipNumber Margin="0,-20,-20,-20" Number="{Binding NumberList[4], RelativeSource={RelativeSource TemplatedParent}}" />
                        <local:FlipNumber Margin="-20" Number="{Binding NumberList[5], RelativeSource={RelativeSource TemplatedParent}}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
