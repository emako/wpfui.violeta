<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <FontFamily x:Key="MarkdownFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MarkdownMonoFontFamily">Cascadia Mono, Consolas, Courier New, Microsoft YaHei UI</FontFamily>

    <system:Double x:Key="MarkdownFontSize">14</system:Double>
    <system:Double x:Key="MarkdownScriptFontSize">10</system:Double>
    <system:Double x:Key="MarkdownHeading1FontSize">28</system:Double>
    <system:Double x:Key="MarkdownHeading2FontSize">22</system:Double>
    <system:Double x:Key="MarkdownHeading3FontSize">18</system:Double>
    <system:Double x:Key="MarkdownHeading4FontSize">16</system:Double>
    <system:Double x:Key="MarkdownHeading5FontSize">14</system:Double>
    <system:Double x:Key="MarkdownHeading6FontSize">13</system:Double>

</ResourceDictionary>
