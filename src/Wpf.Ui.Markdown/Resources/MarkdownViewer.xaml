<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="clr-namespace:Wpf.Ui.Markdown"
    xmlns:mdc="clr-namespace:Wpf.Ui.Markdown.Controls">

    <Style x:Key="DefaultMarkdownScrollViewerStyle" TargetType="{x:Type md:MarkdownScrollViewer}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsToolBarVisible" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style BasedOn="{StaticResource DefaultMarkdownScrollViewerStyle}" TargetType="{x:Type md:MarkdownScrollViewer}" />
    <Style BasedOn="{StaticResource DefaultMarkdownScrollViewerStyle}" TargetType="{x:Type mdc:MarkdownViewer}" />

</ResourceDictionary>
