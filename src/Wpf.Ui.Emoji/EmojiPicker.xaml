<UserControl
    x:Class="Wpf.Ui.Emoji.EmojiPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:emoji="clr-namespace:Wpf.Ui.Emoji"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:stfu="clr-namespace:Stfu.Wpf"
    x:Name="UserControl_Root"
    Width="32"
    d:DesignHeight="32"
    mc:Ignorable="d">

    <FrameworkElement.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

    </FrameworkElement.Resources>

    <Grid>
        <ToggleButton
            x:Name="Button_INTERNAL"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsHitTestVisible="{Binding IsOpen, ElementName=Popup_INTERNAL, Mode=OneWay, Converter={stfu:BoolInverter}}">
            <Viewbox
                Width="{Binding ElementName=UserControl_Root, Path=PickerEmojiItemSize}"
                Height="{Binding RelativeSource={RelativeSource Self}, Path=Width}"
                Margin="4">
                <Image
                    x:Name="Image"
                    Width="24"
                    Height="24"
                    emoji:EmojiImage.Source="{Binding ElementName=UserControl_Root, Mode=OneWay, Path=Selection, UpdateSourceTrigger=PropertyChanged}" />
            </Viewbox>
        </ToggleButton>

        <Popup
            x:Name="Popup_INTERNAL"
            Width="375"
            Height="320"
            Margin="0"
            AllowsTransparency="True"
            IsOpen="{Binding IsChecked, ElementName=Button_INTERNAL, Mode=TwoWay}"
            KeyDown="OnPopupKeyDown"
            Loaded="OnPopupLoaded"
            StaysOpen="False">
            <Border Style="{Binding PopupBorderStyle, ElementName=UserControl_Root}">
                <emoji:TabbedEmojiList
                    x:Name="TabbedEmojiList_EmojiList"
                    x:FieldModifier="public"
                    EmojiItemSize="{Binding EmojiItemSize, ElementName=UserControl_Root}"
                    EmojiPicked="TabbedEmojiList_EmojiList_EmojiPicked"
                    PopupBorderStyle="{Binding PopupBorderStyle, ElementName=UserControl_Root}" />
            </Border>
        </Popup>
    </Grid>

</UserControl>
