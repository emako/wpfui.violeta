<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="EmojiPopupBackgroundBrush" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="EmojiPopupBorderBrush" Color="#FF404040" />

    <Style x:Key="EmojiPopupBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource EmojiPopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource EmojiPopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

</ResourceDictionary>
